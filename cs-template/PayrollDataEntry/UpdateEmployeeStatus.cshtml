@{
    ViewBag.Title = "Update Employee Status";
    Layout = "~/Views/Shared/Layout/_adminPayrollLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Tax Table </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#"> Payroll Data Entry </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Update Employee Status
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body" id="app">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Update Employee Status  </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">

                            <div class="card-body">

                                 
                             <div class="row">

                        <div class="col-sm-1">  </div>

                        <div class="col-sm-4">

                            <div class="form-group">
                                <label> <strong> Select Employee: </strong>  </label>

                                <input id="employeeId" v-model="employeeId" type="text" class="form-control" />

                               <span class="text-danger" v-if="!$v.employeeId.required && $v.employeeId.$dirty && employeeId == ''"> Select Employee field is required </span>

                            </div>

                            <div class="form-group">
                                <label> <strong> Employee Status: </strong>  </label>

                                <select class="form-control" v-model="statusId" ref="statusId">
                                    <option value=""> Select Status </option>
                                    <option :value="status.id" v-for="status in statusList"> {{status.name}} </option>
                                </select>

                                <span class="text-danger" v-if="!$v.statusId.required && $v.statusId.$dirty && statusId == ''"> Status field is required </span>

                            </div>
                            
                            <div class="form-group">
                                
                                <label> <strong> Reason: </strong> </label>

                                <textarea class="form-control" v-model="reason" ref="reason" placeholder="Reason..."></textarea>

                                <span class="text-danger" v-if="!$v.reason.required && $v.reason.$dirty && reason == ''"> Reason field is required </span>

                            </div>
                            


                        </div>

                    </div>

                            <div class="row">

                                <div class="col-sm-1">  </div>

                                <div class="col-sm-5">
                                    <button type="button" class="btn btn-primary" :disabled="isLoading" v-on:click="updateEmployeeStatus()">
                                        Update

                                          <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                                    </button>

                                </div>


                            </div>


                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="~/libs/vuelidate/vuelidate.min.js"></script>
<script src="~/libs/vuelidate/validators.min.js"></script>

<script src="~/js/payroll/data-entry/update-employee-status.js" asp-append-version="true"></script>