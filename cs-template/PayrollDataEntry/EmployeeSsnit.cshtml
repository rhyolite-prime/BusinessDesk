@{
    ViewBag.Title = "Employee SSNIT";
    Layout = "~/Views/Shared/Layout/_adminPayrollLayout.cshtml";
}

 

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Employee SSNIT </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#">Payroll Data Entry </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Employee SSNIT
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Employee SSNIT  </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">

                                    <div class="col-sm-4"></div>
                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label> <strong> Search Employee: </strong>  </label>
                                            <input id="employeeId" v-model="employeeId" type="text" class="form-control" />

                                        </div>

                                    </div>
                                   <div class="col-sm-4"></div>

                                </div>
                                <hr />

                            <div class="row">

                                <div class="col-sm-3"></div>

                                <div class="col-sm-4 mb-1">

                                    <h4> <strong> Social Security </strong>  </h4>

                                </div>

                            </div>
                            
                            <div class="row mb-3">
                                                            
                                <div class="col-sm-3">  </div>
                                                            
                                <div class="col-md- mx-3">
                                                                
                                    <label class="form-check-label">
                                        <input class="form-check-input" type="checkbox" v-model="paySocialSecurityFund"> <strong> Pay Social Security Fund ? </strong>
                                    </label>
                                                                
                                </div>
                                                            
                            </div>
                            
                            
                            <div class="row">

                                    <div class="col-sm-3">

                                        <img src="https://res.cloudinary.com/rhyoliteprime/image/upload/v1533814738/images_6.png" class="height-150" style="width:150px" alt="employee_info" id="empImage" name="empImage">
                                        <br /> <br />
                                        <div class="custom-file col-md-10">
                                            <input type="file" class="custom-file-input col-md-12" id="inputGroupFile01" name="myfile" v-on:change="previewImage(event)">
                                        </div>

                                    </div>

                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label> <strong> Social Security No: </strong>  </label>
                                            <input type="text" class="form-control" v-model="socialSecurityNo" ref="socialSecurityNo" placeholder="Social Security No">
                                            <span class="text-danger" v-if="!$v.socialSecurityNo.required && $v.socialSecurityNo.$dirty && socialSecurityNo == ''"> Social Security No field is required </span>

                                        </div>

                                        <div class="form-group">
                                            <label> <strong> Employer Contribution: </strong>  </label>
                                            <input v-model="socialSecurityFundEmployerContribution" class="form-control" type="number" step="0.01" min="0" @@blur="formatToTwoDecimalPlaces('socialSecurityFundEmployerContribution')"/>
                                        </div>


                                    </div>

                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label> <strong> Employee Contribution: </strong>  </label>
                                            <input v-model="socialSecurityFundEmployeeContribution" class="form-control" type="number" step="0.01" min="0" @@blur="formatToTwoDecimalPlaces('socialSecurityFundEmployeeContribution')"/>
                                        </div>



                                    </div>

                                </div>


                            <div class="row">

                                <div class="col-sm-3"></div>

                                <div class="col-sm-4 mb-1">

                                    <h4> <strong> Provident Fund </strong>  </h4>

                                </div>

                            </div>
                            
                            <div class="row mb-3">
                                                                                                                    
                                <div class="col-sm-3">  </div>
                                                                                                                    
                                <div class="col-md-2 mx-2">
                                                                                                                        
                                    <label class="form-check-label">
                                        <input class="form-check-input" type="checkbox" v-model="payProvidentFund"> <strong> Pay Provident Fund ? </strong>
                                    </label>
                                                                                                                                                                                        
                                </div>
                                                                                                                    
                            </div>
                            

                            <div class="row">

                                    <div class="col-sm-3"></div>

                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label> <strong> Employee Contribution: </strong>  </label>
                                            <input v-model="providentFundEmployeeContribution" class="form-control" type="number" step="0.01" min="0" @@blur="formatToTwoDecimalPlaces('providentFundEmployeeContribution')"/>

                                        </div>

                                    </div>

                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label> <strong> Employer Contribution: </strong>  </label>
                                            <input v-model="providentFundEmployerContribution" class="form-control" type="number" step="0.01" min="0" @@blur="formatToTwoDecimalPlaces('providentFundEmployerContribution')"/>

                                        </div>
                                    </div>

                                </div>


                            <div class="row">

                                <div class="col-sm-3"></div>

                                <div class="col-sm-4 mb-1 mt-1">

                                    <h4> <strong> Second Provident Fund </strong>  </h4>

                                </div>

                            </div>
                            
                            <div class="row mb-3">
                                                                                                                    
                                <div class="col-sm-3">  </div>
                                                                                                                    
                                <div class="col-md- mx-3">
                                                                                                                        
                                    <label class="form-check-label">
                                        <input class="form-check-input" type="checkbox" v-model="paySecondProvidentFund"> <strong> Pay Second Provident Fund ? </strong>
                                    </label>
                                                                                                                        
                                </div>
                                                                                                                    
                            </div>
                            

                                
                            <div class="row">

                                    <div class="col-sm-3"></div>

                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label> <strong> Employee Contribution: </strong>  </label>
                                            <input v-model="secondProvidentFundEmployeeContribution" class="form-control" type="number" step="0.01" min="0" @@blur="formatToTwoDecimalPlaces('secondProvidentFundEmployeeContribution')"/>
                                        </div>

                                    </div>

                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label> <strong> Employer Contribution: </strong>  </label>
                                            <input v-model="secondProvidentFundEmployerContribution" class="form-control" type="number" step="0.01" min="0" @@blur="formatToTwoDecimalPlaces('secondProvidentFundEmployerContribution')"/>
                                        </div>
                                    </div>

                                </div>



                            <div class="row">

                                <div class="col-sm-3"></div>

                                <div class="col-sm-4 mb-1 mt-1">

                                    <h4> <strong> SuperAnnuation </strong>  </h4>

                                </div>

                            </div>
                            
                            <div class="row">

                                    <div class="col-sm-3"></div>

                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label> <strong> Employee Contribution: </strong>  </label>
                                            <input v-model="superAnnuationEmployeeContribution" class="form-control" type="number" step="0.01" min="0" @@blur="formatToTwoDecimalPlaces('superAnnuationEmployeeContribution')"/>
                                        </div>

                                    </div>

                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label> <strong> Employer Contribution: </strong>  </label>
                                            <input v-model="superAnnuationEmployerContribution" class="form-control" type="number" step="0.01" min="0" @@blur="formatToTwoDecimalPlaces('superAnnuationEmployerContribution')"/>
                                        </div>
                                    </div>

                                </div>

                                <hr />

                                <div class="row">
                                    <div class="col-sm-3"></div>
                                    
                                    <div class="col-sm-4">
                                        <button type="button" v-on:click="resetForm()" class="btn btn-warning"> <i class="bx bx-reset"></i> Reset </button>
                                    </div>
                                    
                                    <div class="col-sm-4">
                                        <button type="button" :disabled="isLoading" v-on:click="saveSnitInfo()" class="btn btn-primary" style="float: right;">

                                            Save

                                            <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>



<script src="~/libs/vuelidate/vuelidate.min.js"></script>
<script src="~/libs/vuelidate/validators.min.js"></script>
<script src="~/libs/v-money/v-money.js"></script>

<script src="~/js/payroll/data-entry/employee-ssnit.js" asp-append-version="true"></script>
