@using RhyoliteOrbitUi.Models.GeneralLedger
@{
    ViewData["Title"] = "General Ledger | Journal Entries";
    Layout = "~/Views/Shared/_generalLedgerLayout.cshtml";
    PagedRecords<JournalTransaction> pagedJournalTransactions = Model.PagedJournalTransactions;
}

<div class="content" id="app" v-cloak>
    <!-- LISTING VIEW -->
    <div v-show="currentView === 'list'">
        <!-- Header -->
        <div class="page-header d-flex align-items-center justify-content-between flex-wrap row-gap-3 mb-4">
            <div class="page-title">
                <h4 class="fw-bold mb-1">Journal Entries</h4>
                <h6 class="text-muted fs-13 mb-0">View, search, and record manual or API journal entries.</h6>
            </div>
            <div>
                <button type="button" class="btn btn-primary d-inline-flex align-items-center shadow-sm" @@click="goToCreateView">
                    <i class="ti ti-plus me-1"></i>Add Journal Entry
                </button>
            </div>
        </div>

        <!-- Listing Table Card -->
        <div class="card shadow-sm border border-light-subtle">
            <!-- Toolbar -->
            <div class="card-header bg-light d-flex align-items-center justify-content-between py-2 px-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-danger" :disabled="!selectedBatches.length" @@click="deleteSelectedBatches" title="Delete Selected">
                        <i class="ti ti-trash"></i>
                    </button>
                    @*<button class="btn btn-sm btn-outline-secondary" @@click="exportSelected" :disabled="!selectedBatches.length" title="Save/Export Selection">
                        <i class="ti ti-device-floppy"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @@click="clearSelection" :disabled="!selectedBatches.length" title="Cancel Selection">
                        <i class="ti ti-x"></i>
                    </button>*@
                </div>
                <!-- Search Box -->
                <div class="search-set p-0 m-0">
                    <div class="search-input position-relative">
                        <span class="position-absolute top-50 start-0 translate-middle-y ps-2 text-muted">
                            <i class="ti ti-search fs-14"></i>
                        </span>
                        <input type="search" v-model="searchQuery" class="form-control form-control-sm ps-4" placeholder="Search batches...">
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-dark fw-bold">
                            <tr>
                                <th style="width: 40px;"></th>
                                <th style="width: 40px;">
                                    <input type="checkbox" class="form-check-input" @@change="toggleAllBatches" :checked="isAllBatchesSelected">
                                </th>
                                <th class="text-dark fw-semibold">Batch No.</th>
                                <th class="text-dark fw-semibold">Batch Date</th>
                                <th class="text-dark fw-semibold text-end">Total Debit</th>
                                <th class="text-dark fw-semibold text-end">Total Credit</th>
                                <th class="text-center text-dark fw-semibold" style="width: 100px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (pagedJournalTransactions?.Data != null && pagedJournalTransactions.Data.Any())
                            {
                                @foreach (var batch in pagedJournalTransactions.Data)
                                {
                                    <!-- Top Level Batch Row -->
                                    <tr :class="{ 'bg-light-50': isExpanded('@batch.BatchNumber') }">
                                        <td class="text-center">
                                            <button type="button" class="btn btn-link btn-sm p-0 text-secondary" @@click="toggleExpand('@batch.BatchNumber')">
                                                <i class="ti fs-16" :class="isExpanded('@batch.BatchNumber') ? 'ti-chevron-down' : 'ti-chevron-right'"></i>
                                            </button>
                                        </td>
                                        <td>
                                            <input type="checkbox" class="form-check-input" v-model="selectedBatches" value="@batch.BatchNumber">
                                        </td>
                                        <td class="fw-semibold text-dark">#@batch.BatchNumber</td>
                                        <td>@batch.BatchDate.ToString("MMM dd, yyyy")</td>
                                        <td class="text-end fw-semibold text-success">{{ formatCurrency(@batch.TotalDebit) }}</td>
                                        <td class="text-end fw-semibold text-primary">{{ formatCurrency(@batch.TotalCredit) }}</td>
                                        <td class="text-center">
                                            <div class="d-flex align-items-center justify-content-center gap-2">
                                                <button type="button" class="btn btn-sm btn-primary p-1" @@click="editBatch('@batch.BatchNumber')" title="Expand Details">
                                                    <i class="ti ti-edit fs-14"></i>
                                                </button>
                                                
                                                <button type="button" class="btn btn-sm btn-light p-1" @@click="toggleExpand('@batch.BatchNumber')" title="Expand Details">
                                                    <i class="ti ti-eye fs-14"></i>
                                                </button>
                                                
                                                <button type="button" class="btn btn-sm btn-outline-danger p-1" @@click="confirmDelete('@batch.Id')" title="Delete Batch">
                                                    <i class="ti ti-trash fs-14"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>

                                    <!-- Inner Detail Expanded Row -->
                                    <tr v-show="isExpanded('@batch.BatchNumber')">
                                        <td colspan="7" class="p-3 bg-light-50 border-top-0">
                                            <div class="card shadow-sm border border-light-subtle mb-0">
                                                <!-- Sub Toolbar -->
                                                <div class="card-header bg-white py-2 px-3 border-bottom d-flex align-items-center justify-content-between">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="badge bg-secondary">Lines (@batch.Details.Count)</span>
                                                       
                                                        <!-- Sub Toolbar Edit Button -->
                                                        <button class="btn btn-sm btn-light p-1" 
                                                                title="Edit Batch Details" 
                                                                @@click="editBatch('@batch.BatchNumber')" 
                                                                :disabled="loadingBatchNo === '@batch.BatchNumber'">
                                                            <span v-if="loadingBatchNo === '@batch.BatchNumber'" 
                                                                  class="spinner-border spinner-border-sm text-warning" 
                                                                  role="status" 
                                                                  aria-hidden="true"></span>
                                                            <i v-else class="ti ti-edit text-warning"></i>
                                                        </button>
                                                        
                                                    </div>
                                                    <div class="search-set p-0 m-0">
                                                        <div class="search-input position-relative">
                                                            <span class="position-absolute top-50 start-0 translate-middle-y ps-2 text-muted">
                                                                <i class="ti ti-search fs-12"></i>
                                                            </span>
                                                            <input type="search" v-model="detailSearch['@batch.BatchNumber']" class="form-control form-control-sm ps-4" style="max-width: 200px;" placeholder="Filter lines...">
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Nested Detail Table -->
                                                <div class="card-body p-0">
                                                    <div class="table-responsive">
                                                        <table class="table table-sm align-middle table-bordered mb-0">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th class="fs-12 text-muted fw-semibold">Reference No.</th>
                                                                    <th class="fs-12 text-muted fw-semibold">Account Name</th>
                                                                    <th class="fs-12 text-muted fw-semibold">Description</th>
                                                                    <th class="fs-12 text-muted fw-semibold text-end">Debit Amount</th>
                                                                    <th class="fs-12 text-muted fw-semibold text-end">Credit Amount</th>
                                                                    <th class="fs-12 text-muted fw-semibold">Organizational Unit</th>
                                                                    <th class="fs-12 text-muted fw-semibold">Transaction Date</th>
                                                                    <th class="fs-12 text-muted fw-semibold">Cheque No.</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var line in batch.Details)
                                                                {
                                                                    <tr v-show="!detailSearch['@batch.BatchNumber'] || '@line.AccountName?.ToLower()'.includes(detailSearch['@batch.BatchNumber'].toLowerCase()) || '@line.Description?.ToLower()'.includes(detailSearch['@batch.BatchNumber'].toLowerCase())">
                                                                        <td class="fw-semibold text-dark    ">@line.ReferenceNumber</td>
                                                                        <td class="fw-semibold text-dark">@line.AccountName</td>
                                                                        <td class="fw-semibold text-dark">@line.Description</td>
                                                                        <td class="text-end fw-semibold text-success"> @line.CurrencyCode @line.LocalDebit </td>
                                                                        <td class="text-end fw-semibold text-primary"> @line.CurrencyCode @line.LocalCredit </td>
                                                                        <td><span class="fw-semibold text-dark">@line.OuName</span></td>
                                                                        <td class="fw-semibold text-dark">@batch.BatchDate.ToString("MMM dd, yyyy")</td>
                                                                        <td class="fw-semibold text-dark">@(string.IsNullOrEmpty(line.ChequeNo) ? "-" : line.ChequeNo)</td>
                                                                    </tr>
                                                                }
                                                                <!-- Total inside Expanded Detail -->
                                                                <tr class="table-lightfw-bold border-top-2">
                                                                    <td colspan="3" class="text-end fw-bold text-dark text-uppercase">Total</td>
                                                                    <td class="text-end fw-bold text-success"> GHS @batch.TotalDebit </td>
                                                                    <td class="text-end fw-bold text-primary"> GHS @batch.TotalCredit </td>
                                                                    <td colspan="3"></td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        <i class="ti ti-info-circle fs-20 mb-2"></i>
                                        <p class="mb-0">No journal batches found matching your search.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Footer Pagination -->
                <div class="dataTables_paginate paging_simple_numbers justify-content-between d-flex align-items-center p-3 border-top" id="DataTables_Table_0_paginate">
                    @if (pagedJournalTransactions != null)
                    {
                        <!-- Summary -->
                        <div class="text-muted fs-14">
                            Showing @pagedJournalTransactions.LowerBound to @pagedJournalTransactions.UpperBound of @pagedJournalTransactions.TotalCount entries
                        </div>

                        <!-- Pagination -->
                        <ul class="pagination mb-0">

                            @{
                                int counter = 1;
                                int initPage = 1;
                                int currentPage = pagedJournalTransactions.PageNo;
                                int pages = pagedJournalTransactions.TotalPages;
                                if (currentPage > 9 && pages > 10)
                                {
                                    initPage = currentPage - 5;
                                }
                            }

                            @for (int i = initPage; i <= pages; i++)
                            {
                                string active = string.Empty;
                                if (i == currentPage)
                                {
                                    active = "active";
                                }

                                string? url = Url.Action("Journal", "GeneralLedger", new { 
                                    pageNo = i, 
                                    pageSize = pagedJournalTransactions.PageSize
                                });

                                <li class="paginate_button page-item @active">
                                    <a href="@url" aria-controls="DataTables_Table_0" role="link" aria-current="page" data-dt-idx="0" tabindex="0" class="page-link">@i</a>
                                </li>

                                counter++;

                                if (counter > 10)
                                {
                                    break;
                                }
                            }

                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- CREATION VIEW (MULTI-CURRENCY) -->
    <div v-show="currentView === 'create'">
        
        <!-- Header -->
        <div class="page-header d-flex align-items-center justify-content-between flex-wrap row-gap-3 mb-4">
            <div class="page-title">
                <h4 class="fw-bold mb-1">{{ isEditMode ? 'Edit Journal Entry' : 'Journal Entry' }}</h4>
                <h6 class="text-muted fs-13 mb-0">
                    {{ isEditMode ? 'Modify existing journal transaction batch.' : 'Create a new local or multi-currency journal transaction batch.' }}
                </h6>
            </div>
            <div>
                <button type="button" class="btn btn-outline-secondary d-inline-flex align-items-center shadow-sm" @@click="goToListView" :disabled="isLoadingBatch">
                    <i class="ti ti-arrow-left me-1"></i>Back to List
                </button>
            </div>
        </div>
        
        <!-- Creation Form Card -->
        <div class="card shadow-sm border border-light-subtle mb-4">
            
            <!-- Form Face Loading Overlay -->
            <div v-if="isLoadingBatch" class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center bg-white bg-opacity-75" style="z-index: 1050; border-radius: inherit;">
                <div class="spinner-border text-primary mb-2" role="status" style="width: 2.5rem; height: 2.5rem;">
                    <span class="visually-hidden">Loading journal details...</span>
                </div>
                <span class="fw-semibold text-secondary fs-15">Loading journal batch details...</span>
            </div>
            
            <div class="card-body">
                <!-- Row 1: Batch Info -->
                <div class="row g-3 align-items-end mb-4">
                    <div class="col-md-2">
                        <div class="form-group mb-0">
                            <label class="form-label fw-bold text-dark mb-1">
                                Batch No# <span class="text-danger">*</span>
                                <i v-show="isBatchNoLoading" class="ti ti-loader-2 me-1 text-primary ms-1 align-middle" aria-label="Generating batch number…"></i>
                            </label>
                            <input type="text" class="form-control bg-light" :value="isBatchNoLoading ? 'Generating...' : newBatch.batchNo" required readonly placeholder="Auto-generated">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group mb-0">
                            <label class="form-label fw-bold text-dark mb-1">Batch Date: <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" v-model="newBatch.batchDate" required>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group mb-0 d-flex flex-column justify-content-end h-100 pb-2">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" id="isMultiCurrencyToggle" v-model="newBatch.isMultiCurrency">
                                <label class="form-check-label fw-bold text-dark" for="isMultiCurrencyToggle">Is Multi Currency?</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-0">
                            <label class="form-label fw-bold text-dark mb-1">OU (Cost Center): <span class="text-danger">*</span></label>
                            <v-select
                                class="bg-white"
                                :options="costCenterList"
                                label="formattedName"
                                :reduce="costCenter => costCenter.id"
                                v-model="newBatch.ouId"
                                placeholder="Select Cost Center">
                            </v-select>
                        </div>
                    </div>
                    <div class="col-md-2">

                        <button type="button" class="btn btn-primary w-100 fw-bold shadow-sm" @@click="saveJournal" :disabled="isSaving">
                            <span v-if="isSaving" class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            {{ isEditMode ? 'Update Journal' : 'Save Journal' }}
                        </button>


                    </div>
                </div>

                <!-- Form Row Buttons -->
                <div class="d-flex align-items-center gap-2 mb-3">
                    <button type="button" class="btn btn-success d-inline-flex align-items-center shadow-sm px-3" @@click="addRow">
                        <i class="ti ti-plus me-1"></i>Add Row
                    </button>
                    <button type="button" class="btn btn-danger d-inline-flex align-items-center shadow-sm px-3" @@click="removeLastRow" :disabled="newBatch.lines.length <= 1">
                        <i class="ti ti-minus me-1"></i>Remove Last Row
                    </button>
                </div>

                <!-- Blue Alert Banner -->
                <div class="alert alert-info border-0 shadow-sm d-flex align-items-center py-2 px-3 mb-3 text-white bg-info-500" style="background-color: #3b82f6 !important; border-radius: 4px;">
                    <i class="ti ti-arrow-right-circle fs-16 me-2"></i>
                    <span class="fs-13 fw-medium">Scroll to the right to view additional journal fields.</span>
                </div>

                <!-- Grid Table -->
                <div class="table-responsive border border-light-subtle rounded mb-3">
                    <table class="table align-middle mb-0" :style="{ minWidth: newBatch.isMultiCurrency ? '2400px' : '1500px' }">
                        <thead class="table-light">
                        <tr>
                            <th style="width: 60px;" class="text-center"></th>
                            <th style="width: 150px;">Ref No.</th>
                            <th :style="{ width: newBatch.isMultiCurrency ? '450px' : '280px' }">G/L Account <span class="text-danger">*</span></th>
                            <th style="width: 180px;">Description</th>
                            <th style="width: 120px;" class="text-end">{{ newBatch.isMultiCurrency ? 'Local Debit' : 'Debit Amount' }}</th>
                            <th style="width: 120px;" class="text-end">{{ newBatch.isMultiCurrency ? 'Local Credit' : 'Credit Amount' }}</th>
                            <th style="width: 400px;">Cost Center (OU) <span class="text-danger">*</span></th>
                            <th style="width: 120px;">Cheque No.</th>

                            <th style="width: 300px;" v-if="newBatch.isMultiCurrency">Currency <span class="text-danger">*</span></th>
                            <th style="width: 150px;" v-if="newBatch.isMultiCurrency">Rate</th>
                            <th style="width: 120px;" class="text-end" v-if="newBatch.isMultiCurrency">Foreign Debit</th>
                            <th style="width: 120px;" class="text-end" v-if="newBatch.isMultiCurrency">Foreign Credit</th>
                            <th style="width: 160px;" v-if="newBatch.isMultiCurrency">Recipient</th>

                            <th style="width: 60px;" class="text-center">Action</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr v-for="(line, index) in newBatch.lines" :key="line.id">

                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-danger p-1" @@click="removeRow(index)" :disabled="newBatch.lines.length <= 1">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </td>

                            <td>
                                <input type="text" class="form-control form-control-sm" v-model="line.refNo">
                            </td>

                            <td>
                                <v-select
                                    class="bg-white"
                                    :options="glAccountList"
                                    label="name"
                                    :reduce="account => account.id"
                                    v-model="line.accountId"
                                    @@update:model-value="onGlAccountSelected(glAccountList.find(a => a.id === $event), line)"
                                    placeholder="Select Account"
                                    :append-to-body="true">
                                </v-select>
                            </td>

                            <td>
                                <input type="text" class="form-control form-control-sm" v-model="line.description">
                            </td>
                            <td>
                                <money3 
                                    class="form-control form-control-sm text-end fw-semibold" 
                                    v-model.number="line.localDebit" 
                                    v-bind="moneyConfig" 
                                    :disabled="newBatch.isMultiCurrency && !line.isLocal" 
                                    @@update:model-value="onLineValChange(line, 'localDebit')">
                                </money3>
                            </td>
                            <td>
                                <money3 
                                    class="form-control form-control-sm text-end fw-semibold" 
                                    v-model.number="line.localCredit" 
                                    v-bind="moneyConfig" 
                                    :disabled="newBatch.isMultiCurrency && !line.isLocal" 
                                    @@update:model-value="onLineValChange(line, 'localCredit')">
                                </money3>
                            </td>

                            <td>
                                <v-select
                                    class="bg-white"
                                    :options="costCenterList"
                                    label="formattedName"
                                    :reduce="costCenter => costCenter.id"
                                    v-model="line.ouId"
                                    placeholder="Select Cost Center"
                                    :append-to-body="true">
                                </v-select>
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm" v-model="line.chequeNo">
                            </td>

                            <td v-if="newBatch.isMultiCurrency">
                                <select class="form-select form-select-sm" v-model="line.currencyId" disabled>
                                    <option v-for="currency in currencyList" :key="currency.id" :value="currency.id">{{ currency.name }}</option>
                                </select>
                            </td>
                            <td v-if="newBatch.isMultiCurrency">
                                <money3 class="form-control form-control-sm text-end" v-model.number="line.buyRate" :disabled="true" @@change="onLineValChange(line, 'rate')"></money3>
                            </td>
                            <td v-if="newBatch.isMultiCurrency">
                                <money3 
                                    class="form-control form-control-sm text-end" 
                                    v-model.number="line.foreignDebit" 
                                    v-bind="moneyConfig" 
                                    :disabled="line.isLocal" 
                                    @@update:model-value="onLineValChange(line, 'foreignDebit')">
                                </money3>
                            </td>
                            <td v-if="newBatch.isMultiCurrency">
                                <money3 
                                    class="form-control form-control-sm text-end" 
                                    v-model.number="line.foreignCredit" 
                                    v-bind="moneyConfig" 
                                    :disabled="line.isLocal" 
                                    @@update:model-value="onLineValChange(line, 'foreignCredit')">
                                </money3>
                            </td>
                            <td v-if="newBatch.isMultiCurrency">
                                <input type="text" class="form-control form-control-sm" v-model="line.recipient">
                            </td>

                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-danger p-1" @@click="removeRow(index)" :disabled="newBatch.lines.length <= 1">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </td>
                        </tr>

                        <!-- Totals Row -->
                        <tr class="table-light fw-bold border-top-2">
                            <td colspan="4" class="text-end text-uppercase fw-bold py-3">TOTAL</td>
                            <td class="text-end text-success fw-bold fs-14">{{ formatCurrency(totalLocalDebits) }}</td>
                            <td class="text-end text-primary fw-bold fs-14">{{ formatCurrency(totalLocalCredits) }}</td>
                            <td :colspan="newBatch.isMultiCurrency ? 8 : 3"></td>
                        </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Balanced Check / Warning -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div v-if="!isBalanced" class="alert alert-warning border-0 d-flex align-items-center py-2 px-3 mb-0">
                            <i class="ti ti-alert-triangle fs-16 me-2"></i>
                            <span class="fs-13 fw-semibold">Warning: Journal is unbalanced. Debits must equal Credits (Difference: {{ formatCurrency(Math.abs(totalLocalDebits - totalLocalCredits)) }}).</span>
                        </div>
                        <div v-else class="alert alert-success border-0 d-flex align-items-center py-2 px-3 mb-0">
                            <i class="ti ti-circle-check fs-16 me-2"></i>
                            <span class="fs-13 fw-semibold">Journal is balanced. Debits equal Credits.</span>
                        </div>
                    </div>
                </div>

                <!-- Footer Save/Cancel -->
                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <button type="button" class="btn btn-secondary px-4" @@click="goToListView" :disabled="isSaving">Cancel</button>
                    <button type="button" class="btn btn-primary px-4 fw-bold shadow-sm" @@click="saveJournal" :disabled="isSaving">
                        <span v-if="isSaving" class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        {{ isEditMode ? 'Update Journal' : 'Save Journal' }}
                    </button>
                </div>
            </div>
        </div>


    </div>
    
    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow">
                <div class="modal-body text-center p-4">
                    <div class="text-danger mb-3">
                        <i class="ti ti-alert-triangle fs-40"></i>
                    </div>
                    <h5 class="mb-2">Are you sure?</h5>
                    <p class="text-muted mb-4">You won't be able to revert this action!</p>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-light" @@click="closeDeleteModal" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" @@click="deleteBatch" :disabled="isLoading">
                            <span v-if="isLoading" class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            Yes, delete it
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
</div>

