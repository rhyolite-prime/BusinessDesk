@using Newtonsoft.Json
@using RhyoliteOrbitUi.Models.GeneralLedger
@{
    ViewData["Title"] = "Setups | Account Details";
    Layout = "~/Views/Shared/_generalLedgerLayout.cshtml";
	PagedRecords<CoaDetail> pagedAccountDetails = Model.PagedAccountDetails;
}

<div class="content" id="app" v-cloak>
    <div class="page-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
        <div class="page-title">
            <h4 class="fw-bold mb-1">Chart of Account Details</h4>
            <h6 class="text-muted fs-13 mb-0">View and manage specific ledger accounts.</h6>
        </div>
        
        <div class="page-btn d-flex align-items-center gap-3">
            <a href="#" class="btn btn-outline-light border shadow-sm d-inline-flex align-items-center text-dark">
                <i class="ti ti-file-text me-2 fs-16"></i>View Report
            </a>
            <a href="#" @@click.prevent="resetModal" class="btn btn-primary d-inline-flex align-items-center shadow-sm">
                <i class="ti ti-circle-plus me-2 fs-16"></i>Add Account Detail
            </a>
        </div>
    </div>
                    
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3 py-3 border-bottom-0">
            <div class="search-set">
                <div class="search-input position-relative">
                    <span class="btn-searchset position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"><i class="ti ti-search fs-14"></i></span>
                    <input type="search" class="form-control form-control-sm ps-5" placeholder="Search accounts..." style="width: 250px;">
                </div>
            </div>
             
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Account Info</th>
                            <th>Account Control Source</th>
                            <th>Currency</th>
                            <th>Status</th>
                            <th class="text-end no-sort">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if(pagedAccountDetails?.Data != null && pagedAccountDetails.Data.Any())
                    {
                        @foreach (var accountDetail in pagedAccountDetails.Data)
                        {
                            <tr class="transition-all">
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold text-dark">@accountDetail.AccountName</span>
                                        <span class="fs-13 text-muted mt-1">#@accountDetail.AccountNo</span>
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var headerName = accountDetail.AccountControlName?.ToLower() ?? "";
                                        var badgeClass = "bg-primary-transparent text-primary";
                                        var dotClass = "bg-primary";
                                        
                                        if (headerName.Contains("asset")) { badgeClass = "bg-info-transparent text-info"; dotClass = "bg-info"; }
                                        else if (headerName.Contains("liabilit")) { badgeClass = "bg-warning-transparent text-warning"; dotClass = "bg-warning"; }
                                        else if (headerName.Contains("equit") || headerName.Contains("capital")) { badgeClass = "bg-secondary-transparent text-secondary"; dotClass = "bg-secondary"; }
                                        else if (headerName.Contains("revenu") || headerName.Contains("income")) { badgeClass = "bg-success-transparent text-success"; dotClass = "bg-success"; }
                                        else if (headerName.Contains("expens") || headerName.Contains("cost")) { badgeClass = "bg-danger-transparent text-danger"; dotClass = "bg-danger"; }
                                    }
                                    <div class="d-flex align-items-center gap-2 text-muted fs-14">
                                        <i class="ti ti-git-branch text-secondary"></i>
                                        <span class="badge @badgeClass px-3 py-1.5 rounded-pill fs-12 d-inline-flex align-items-center gap-1">
                                            <span class="rounded-circle @dotClass" style="width: 6px; height: 6px;"></span>
                                            @accountDetail.AccountControlName
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-warning-transparent text-warning px-3 py-1.5 rounded-pill fs-12" title="@accountDetail.CurrencyName">@accountDetail.CurrencyCode</span>
                                </td>
                                <td>
                                    @if (accountDetail.Status == 1)
                                    {
                                        <span class="badge bg-success-transparent text-success px-3 py-1.5 rounded-pill fs-12 d-inline-flex align-items-center gap-1">
                                            <span class="rounded-circle bg-success" style="width: 6px; height: 6px;"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-transparent text-danger px-3 py-1.5 rounded-pill fs-12 d-inline-flex align-items-center gap-1">
                                            <span class="rounded-circle bg-danger" style="width: 6px; height: 6px;"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a href="#" @@click.prevent="viewSetupDetails({ Id: '@accountDetail.Id', AccountName: '@(accountDetail.AccountName?.Replace("'", "\\'"))', AccountNo: '@accountDetail.AccountNo', Status: @accountDetail.Status, AccountControlId: '@accountDetail.AccountControlId', CurrencyId: '@accountDetail.CurrencyId' })" class="btn btn-sm btn-icon btn-outline-light hover-bg-primary text-secondary border-0" title="Edit">
                                            <i class="ti ti-edit fs-16 text-primary"></i>
                                        </a>
                                        <a href="#" @@click.prevent="initDeleteSetup('@accountDetail.Id')" class="btn btn-sm btn-icon btn-outline-light hover-bg-danger text-secondary border-0" title="Delete">
                                            <i class="ti ti-trash fs-16 text-danger"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="d-flex flex-column align-items-center">
                                    <i class="ti ti-file-text fs-40 text-muted mb-2"></i>
                                    <h5 class="text-muted fw-normal">No account details found</h5>
                                    <p class="text-muted-light small mb-0">Try creating a new one or adjusting your search term.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        
        @if (pagedAccountDetails != null)
        {
            <div class="card-footer border-top-0 d-flex justify-content-between align-items-center">
                <div class="text-muted fs-14">
                    Showing {{ @pagedAccountDetails.LowerBound }} to {{ @pagedAccountDetails?.UpperBound }} of {{ @pagedAccountDetails?.TotalCount }} entries
                </div>
                <div class="d-flex gap-2">
                    <!-- Pagination -->
                    <ul class="pagination">

                        @{
                            int counter = 1;
                            int initPage = 1;
                            int currentPage = pagedAccountDetails.PageNo;
                            int pages = pagedAccountDetails.TotalPages;
                            if (currentPage > 9 && pages > 10)
                            {
                                initPage = currentPage - 5;
                            }
                        }

                        @for (int i = initPage; i <= pages; i++)
                        {
                            string active = string.Empty;
                            if (i == currentPage)
                            {
                                active = "active";
                            }

                            string? url = Url.Action("CoaDetails", "GeneralLedger", new { 
                                pageNo = i, 
                                pageSize = pagedAccountDetails.PageSize,
                                query = Model.Query 
                            });

                            <li class="paginate_button page-item @active">
                                <a href="@url" aria-controls="DataTables_Table_0" role="link" aria-current="page" data-dt-idx="0" tabindex="0" class="page-link">@i</a>
                            </li>

                            counter++;

                            if (counter > 10)
                            {
                                break;
                            }
                        }

                    </ul>
                </div>
            </div>
        }
        
    </div>

    <!-- Setup Modal -->
    <div class="modal fade" id="setupModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <div class="page-title">
                        <h4>{{modalTitle}}</h4>
                    </div>
                    <button type="button" class="close bg-danger text-white fs-16" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                
                <div class="modal-body">
                    <!-- Account Name -->
                    <div class="mb-3">
                        <label class="form-label">Account Name</label>
                        <input type="text" class="form-control" :class="{'is-invalid': v$.accountName.$error}" v-model="accountName" placeholder="Enter account name">
                        <div class="invalid-feedback" v-if="v$.accountName.$error">Account Name is required.</div>
                    </div>
    
                <!-- Account Control -->
                <div class="mb-3">
                    <label class="form-label">Account Control</label>
                    <select class="form-select" :class="{'is-invalid': v$.accountControlId.$error}" v-model="accountControlId">
                        <option value="">Select Account Control</option>
                        <option v-for="ctrl in accountControlList" :value="ctrl.id">{{ ctrl.formattedName || ctrl.name || ctrl.subGroupName || ctrl.parentSubGroupName || ctrl.Name }}</option>
                    </select>
                    <div class="invalid-feedback" v-if="v$.accountControlId.$error">Account Control is required.</div>
                </div>
    
                <!-- Account Number -->
                <div class="mb-3">
                    <label class="form-label">Account Number</label>
                    <input type="number" class="form-control" :class="{'is-invalid': v$.accountNo.$error || (accountNo && !isValidAccountNumber) || accountExists}" v-model="accountNo" @@input="debouncedCheckAccountDetails" placeholder="Enter account number">
                    <div class="form-text text-info" v-if="accountNumberRangeMessage && (!accountNo || isValidAccountNumber) && !v$.accountNo.$error && !accountExists">
                        <i class="ti ti-info-circle me-1"></i>{{ accountNumberRangeMessage }}
                    </div>
                    
                    <div class="invalid-feedback" v-if="v$.accountNo.$error">Account Number is required.</div>
                    <div class="invalid-feedback" v-else-if="accountNo && !isValidAccountNumber">{{ accountNumberRangeMessage }}</div>
                    <div class="invalid-feedback" v-else-if="accountExists">An account with this account number already exists.</div>
                </div>
    
                <!-- Currency -->
                <div class="mb-3">
                    <label class="form-label">Currency</label>
                    <select class="form-select" :class="{'is-invalid': v$.currencyId.$error}" v-model="currencyId">
                        <option value="">Select Currency</option>
                        <option v-for="curr in currencyList" :value="curr.id">{{ curr.name }} ({{ curr.code }})</option>
                    </select>
                    <div class="invalid-feedback" v-if="v$.currencyId.$error">Currency is required.</div>
                </div>

                    <!-- Status -->
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" :class="{'is-invalid': v$.status.$error}" v-model="status">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        <div class="invalid-feedback" v-if="v$.status.$error">Status is required.</div>
                    </div>
                </div>
                
                
                
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" @@click="addSetup" :disabled="isLoading || (accountNo && !isValidAccountNumber)">
                        <span v-if="isLoading" class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow">
                <div class="modal-body text-center p-4">
                    <div class="text-danger mb-3">
                        <i class="ti ti-alert-triangle fs-40"></i>
                    </div>
                    <h5 class="mb-2">Are you sure?</h5>
                    <p class="text-muted mb-4">You won't be able to revert this action!</p>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" @@click="deleteSetup" :disabled="isLoading">
                            <span v-if="isLoading" class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            Yes, delete it
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/module-js/gl/setups/account-details.js" asp-append-version="true"></script>