@{
    ViewData["Title"] = "General Ledger | Vouchers";
    Layout = "~/Views/Shared/_generalLedgerLayout.cshtml";
}

<div class="content" id="app">
    <div class="page-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
        <div class="page-title">
            <h4 class="fw-bold mb-1">Vouchers</h4>
            <h6 class="text-muted fs-13 mb-0">Manage and track all Supplier Payments, Employee Payments, and Customer Receipts.</h6>
        </div>
        <div class="page-btn">
            <button type="button" class="btn btn-primary d-inline-flex align-items-center shadow-sm" @@click="openCreateModal">
                <i class="ti ti-circle-plus me-2 fs-16"></i>Create Voucher
            </button>
        </div>
    </div>

    <!-- Tabbed Navigation -->
    <div class="card mb-4">
        <div class="card-body p-0">
            <ul class="nav nav-tabs nav-tabs-solid nav-tabs-rounded border-0 p-3 bg-light m-0">
                <li class="nav-item">
                    <a class="nav-link cursor-pointer fw-semibold px-4 py-2" :class="{ active: activeTab === 'supplier' }" @@click="activeTab = 'supplier'">
                        <i class="ti ti-truck me-2"></i>Supplier Payment Vouchers
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link cursor-pointer fw-semibold px-4 py-2" :class="{ active: activeTab === 'employee' }" @@click="activeTab = 'employee'">
                        <i class="ti ti-user me-2"></i>Employee Payment Vouchers
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link cursor-pointer fw-semibold px-4 py-2" :class="{ active: activeTab === 'customer' }" @@click="activeTab = 'customer'">
                        <i class="ti ti-receipt me-2"></i>Customer Receipt Vouchers
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Voucher Lists Card -->
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3 py-3 border-bottom-0">
            <div class="search-set">
                <div class="search-input position-relative">
                    <span class="btn-searchset position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"><i class="ti ti-search fs-14"></i></span>
                    <input type="search" v-model="searchQuery" class="form-control form-control-sm ps-5" placeholder="Search vouchers..." style="width: 250px;">
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-secondary-transparent text-secondary fs-12 px-3 py-2 rounded">
                    Total Records: {{ filteredVouchers.length }}
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 datatable">
                    <thead class="thead-light">
                        <tr v-if="activeTab === 'supplier'">
                            <th>Voucher No</th>
                            <th>Supplier / Payee</th>
                            <th>Entry Date</th>
                            <th>Bank G/L</th>
                            <th class="text-center">Mode</th>
                            <th class="text-end">Total Amount</th>
                            <th class="text-end">Net Paid</th>
                            <th class="text-center no-sort">Actions</th>
                        </tr>
                        <tr v-else-if="activeTab === 'employee'">
                            <th>Voucher No</th>
                            <th>Employee / Payee</th>
                            <th>Entry Date</th>
                            <th>Bank G/L</th>
                            <th class="text-center">Mode</th>
                            <th class="text-end">Total Amount</th>
                            <th class="text-end">Net Paid</th>
                            <th class="text-center no-sort">Actions</th>
                        </tr>
                        <tr v-else-if="activeTab === 'customer'">
                            <th>Voucher No</th>
                            <th>Customer Name</th>
                            <th>Entry Date</th>
                            <th>Bank/Cash G/L</th>
                            <th class="text-center">Mode</th>
                            <th class="text-end">Invoice Total</th>
                            <th class="text-end">Net Received</th>
                            <th class="text-center no-sort">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="item in filteredVouchers" :key="item.id" class="transition-all">
                            <td>
                                <span class="fw-bold text-primary">{{ item.voucherNo }}</span>
                            </td>
                            <td>{{ item.payeeName || item.customerName }}</td>
                            <td>{{ formatDate(item.entryDate) }}</td>
                            <td>{{ item.bankGl }}</td>
                            <td class="text-center">
                                <span class="badge px-3 py-1.5 rounded-pill fs-12" :class="getModeBadgeClass(item.modeOfPayment || item.modeOfReceipt)">
                                    {{ item.modeOfPayment || item.modeOfReceipt }}
                                </span>
                            </td>
                            <td class="text-end fw-semibold text-dark">
                                {{ formatCurrency(item.totalAmount, item.currencyCode) }}
                            </td>
                            <td class="text-end fw-bold text-success">
                                {{ formatCurrency(item.netAmount, item.currencyCode) }}
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex gap-2">
                                    <button class="btn btn-sm btn-icon btn-outline-light hover-bg-primary text-secondary border-0" @@click="viewDetails(item)" title="View Details">
                                        <i class="ti ti-eye fs-16 text-info"></i>
                                    </button>
                                    <button class="btn btn-sm btn-icon btn-outline-light hover-bg-danger text-secondary border-0" @@click="confirmDelete(item)" title="Delete">
                                        <i class="ti ti-trash fs-16 text-danger"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <tr v-if="filteredVouchers.length === 0">
                            <td colspan="8" class="text-center py-5">
                                <div class="d-flex flex-column align-items-center">
                                    <i class="ti ti-file-text fs-40 text-muted mb-2"></i>
                                    <h5 class="text-muted fw-normal">No vouchers found</h5>
                                    <p class="text-muted-light small mb-0">Try creating a new one or adjusting your search term.</p>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Create Choice Modal -->
    <div class="modal fade" id="selectVoucherTypeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold fs-18">Create New Voucher</h5>
                    <button type="button" class="close bg-danger text-white fs-16" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body py-4">
                    <p class="text-muted mb-4 small">Select the type of transaction voucher you would like to generate:</p>
                    <div class="d-flex flex-column gap-3">
                        <a href="/GeneralLedger/CreateSupplierVoucher" class="d-flex align-items-center p-3 rounded border border-light-subtle hover-bg-light transition-all text-decoration-none text-dark card-hover-effect">
                            <div class="icon-box bg-primary-transparent text-primary rounded p-3 me-3">
                                <i class="ti ti-truck fs-24"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 fs-15">Supplier Payment Voucher</h6>
                                <p class="text-muted small mb-0">Record cash/bank payments made to business suppliers.</p>
                            </div>
                        </a>
                        <a href="/GeneralLedger/CreateEmployeeVoucher" class="d-flex align-items-center p-3 rounded border border-light-subtle hover-bg-light transition-all text-decoration-none text-dark card-hover-effect">
                            <div class="icon-box bg-success-transparent text-success rounded p-3 me-3">
                                <i class="ti ti-user fs-24"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 fs-15">Employee Payment Voucher</h6>
                                <p class="text-muted small mb-0">Record salary advances, reimbursements, or other payments to staff.</p>
                            </div>
                        </a>
                        <a href="/GeneralLedger/CreateCustomerVoucher" class="d-flex align-items-center p-3 rounded border border-light-subtle hover-bg-light transition-all text-decoration-none text-dark card-hover-effect">
                            <div class="icon-box bg-info-transparent text-info rounded p-3 me-3">
                                <i class="ti ti-receipt fs-24"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 fs-15">Customer Receipt Voucher</h6>
                                <p class="text-muted small mb-0">Record cash/bank receipts received from customers.</p>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- View Voucher Details Modal -->
    <div class="modal fade" id="viewDetailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" v-if="selectedVoucher">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold fs-18">Voucher Details: {{ selectedVoucher.voucherNo }}</h5>
                    <button type="button" class="close bg-danger text-white fs-16" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="text-muted small d-block mb-1">Payee / Customer</label>
                            <span class="fw-bold text-dark fs-15">{{ selectedVoucher.payeeName || selectedVoucher.customerName }}</span>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small d-block mb-1">Entry Date</label>
                            <span class="fw-semibold text-dark">{{ formatDate(selectedVoucher.entryDate) }}</span>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small d-block mb-1">Bank G/L</label>
                            <span class="fw-semibold text-dark">{{ selectedVoucher.bankGl }}</span>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small d-block mb-1">Mode of Payment</label>
                            <span class="badge bg-secondary-transparent text-secondary px-3 py-1">{{ selectedVoucher.modeOfPayment || selectedVoucher.modeOfReceipt }}</span>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small d-block mb-1">Payment Date</label>
                            <span class="fw-semibold text-dark">{{ formatDate(selectedVoucher.paymentDate || selectedVoucher.receiptDate) }}</span>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small d-block mb-1">Batch No#</label>
                            <span class="fw-semibold text-dark">{{ selectedVoucher.batchNo || 'N/A' }}</span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Voucher Line Items</h6>
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered table-sm align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th>Ref / Invoice</th>
                                    <th>Debit/Credit GL</th>
                                    <th>Description</th>
                                    <th>Org Unit</th>
                                    <th class="text-end" style="width: 120px;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="(line, idx) in selectedVoucher.lines" :key="idx">
                                    <td>
                                        <span class="text-muted small">Inv:</span> {{ line.invoiceNo }}<br>
                                        <span class="text-muted small">Ref:</span> {{ line.referenceNo }}
                                    </td>
                                    <td>{{ line.glAccount }}</td>
                                    <td>{{ line.description }}</td>
                                    <td>{{ line.orgUnit }}</td>
                                    <td class="text-end fw-semibold">{{ formatCurrency(line.localAmount, selectedVoucher.currencyCode) }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Retentions Details (if any) -->
                    <div v-if="selectedVoucher.retentions && selectedVoucher.retentions.length > 0">
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Retentions Detail</h6>
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered table-sm align-middle">
                                <thead class="bg-light">
                                    <tr>
                                        <th>Description</th>
                                        <th>Credit G/L</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr v-for="(ret, idx) in selectedVoucher.retentions" :key="idx">
                                        <td>{{ ret.description }}</td>
                                        <td>{{ ret.creditGl }}</td>
                                        <td class="text-end fw-semibold">{{ formatCurrency(ret.amount, selectedVoucher.currencyCode) }}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Withholding Details (if any) -->
                    <div class="row g-3" v-if="selectedVoucher.withholdingRate">
                        <div class="col-md-6">
                            <div class="bg-light p-3 rounded">
                                <h6 class="fw-bold mb-2">Withholding Info</h6>
                                <p class="mb-1 small text-muted">Withholding Rate: <strong class="text-dark">{{ selectedVoucher.withholdingRate }}%</strong></p>
                                <p class="mb-1 small text-muted">Credit Account: <strong class="text-dark">{{ selectedVoucher.withholdingCreditGl || 'N/A' }}</strong></p>
                                <p class="mb-1 small text-muted">Tax Type: <strong class="text-dark">{{ selectedVoucher.withholdingTaxType || 'N/A' }}</strong></p>
                                <p class="mb-0 small text-muted">VAT Account: <strong class="text-dark">{{ selectedVoucher.withholdingVatAccount || 'N/A' }}</strong></p>
                            </div>
                        </div>
                        <div class="col-md-6 d-flex flex-column justify-content-end align-items-end text-end">
                            <div class="w-75">
                                <div class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-muted small">Gross Total:</span>
                                    <span class="fw-bold">{{ formatCurrency(selectedVoucher.totalAmount, selectedVoucher.currencyCode) }}</span>
                                </div>
                                <div class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-muted small">Withheld Tax:</span>
                                    <span class="fw-semibold text-danger">- {{ formatCurrency(selectedVoucher.withheldAmount, selectedVoucher.currencyCode) }}</span>
                                </div>
                                <div class="d-flex justify-content-between py-1 border-bottom" v-if="selectedVoucher.retainedAmount">
                                    <span class="text-muted small">Retained Amount:</span>
                                    <span class="fw-semibold text-danger">- {{ formatCurrency(selectedVoucher.retainedAmount, selectedVoucher.currencyCode) }}</span>
                                </div>
                                <div class="d-flex justify-content-between py-2 text-success fs-15 fw-bold">
                                    <span>Net Amount:</span>
                                    <span>{{ formatCurrency(selectedVoucher.netAmount, selectedVoucher.currencyCode) }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 justify-content-end align-items-end text-end" v-else>
                        <div class="col-md-6">
                            <div class="w-75 ms-auto">
                                <div class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-muted small">Gross Total:</span>
                                    <span class="fw-bold">{{ formatCurrency(selectedVoucher.totalAmount, selectedVoucher.currencyCode) }}</span>
                                </div>
                                <div class="d-flex justify-content-between py-2 text-success fs-15 fw-bold">
                                    <span>Net Amount:</span>
                                    <span>{{ formatCurrency(selectedVoucher.netAmount, selectedVoucher.currencyCode) }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered text-center" role="document">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-start py-4">
                    <h4 class="fs-20 fw-bold mb-2 text-danger">Delete Voucher</h4>
                    <p class="mb-0 fs-15 text-muted" v-if="deletingVoucher">
                        Are you sure you want to delete voucher <strong class="text-dark">{{ deletingVoucher.voucherNo }}</strong>? This action cannot be undone.
                    </p>
                </div>
                <div class="modal-footer border-top-0 pt-0 justify-content-end">
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" @@click="deleteVoucher">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-hover-effect {
        transition: all 0.25s ease;
    }
    .card-hover-effect:hover {
        transform: translateY(-2px);
        border-color: #3b82f6 !important;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.08);
        background-color: #f8fafc;
    }
    .transition-all {
        transition: all 0.2s ease-in-out;
    }
    .cursor-pointer {
        cursor: pointer;
    }
</style>

<script src="~/module-js/gl/vouchers-list.js" asp-append-version="true"></script>