@{
    ViewData["Title"] = "General Ledger | Create Supplier Payment Voucher";
    Layout = "~/Views/Shared/_generalLedgerLayout.cshtml";
}

<div class="content" id="app">
    <!-- Header -->
    <div class="page-header d-flex align-items-center justify-content-between flex-wrap row-gap-3 mb-4">
        <div class="page-title">
            <h4 class="fw-bold mb-1">Supplier Payment Voucher</h4>
            <h6 class="text-muted fs-13 mb-0">Record a new payment voucher for business suppliers.</h6>
        </div>
        <div>
            <a href="/GeneralLedger/Vouchers?tab=supplier" class="btn btn-outline-secondary d-inline-flex align-items-center">
                <i class="ti ti-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>

    <!-- Main Tabs -->
    <div class="card mb-3">
        <div class="card-body p-0">
            <ul class="nav nav-tabs nav-tabs-solid nav-tabs-rounded border-0 p-3 bg-light m-0">
                <li class="nav-item">
                    <a class="nav-link cursor-pointer fw-semibold px-4 py-2" :class="{ active: currentTab === 'voucher' }" @@click="currentTab = 'voucher'">
                        Payment Voucher
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link cursor-pointer fw-semibold px-4 py-2" :class="{ active: currentTab === 'retentions' }" @@click="currentTab = 'retentions'">
                        Retentions
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <form @@submit.prevent="saveVoucher">
        <!-- VOUCHER TAB CONTENT -->
        <div v-show="currentTab === 'voucher'">
            <div class="card mb-4">
                <div class="card-body">
                    <!-- Form Row 1 -->
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="form-group mb-0">
                                <label class="form-label fw-bold text-dark mb-1">Supplier/Payee: <span class="text-danger">*</span></label>
                                <select class="form-select" v-model="form.payeeId" required @@change="updatePayeeName">
                                    <option value="" disabled>Select Supplier</option>
                                    <option v-for="s in suppliers" :key="s.id" :value="s.id">{{ s.name }}</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="form-group mb-0">
                                <label class="form-label fw-bold text-dark mb-1">Entry Date: <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" v-model="form.entryDate" required>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group mb-0">
                                <label class="form-label fw-bold text-dark mb-1">Bank G/L: <span class="text-danger">*</span></label>
                                <select class="form-select" v-model="form.bankGl" required>
                                    <option value="" disabled>Select Account</option>
                                    <option v-for="b in bankAccounts" :key="b" :value="b">{{ b }}</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group mb-0">
                                <label class="form-label fw-bold text-dark mb-1">Currency: <span class="text-danger">*</span></label>
                                <select class="form-select" v-model="form.currencyCode" required>
                                    <option v-for="c in currencies" :key="c.code" :value="c.code">{{ c.name }} ({{ c.code }})</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Form Row 2 -->
                    <div class="row g-3 mt-1">
                        <div class="col-md-2">
                            <div class="form-group mb-0">
                                <label class="form-label fw-bold text-dark mb-1">Mode Of Payment: <span class="text-danger">*</span></label>
                                <select class="form-select" v-model="form.modeOfPayment" required>
                                    <option value="Cash">Cash</option>
                                    <option value="Cheque">Cheque</option>
                                    <option value="Bank Transfer">Bank Transfer</option>
                                    <option value="Mobile Money">Mobile Money</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="form-group mb-0">
                                <label class="form-label fw-bold text-dark mb-1">Payment Date: <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" v-model="form.paymentDate" required>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="form-group mb-0">
                                <label class="form-label fw-bold text-dark mb-1">Batch No#:</label>
                                <input type="text" class="form-control" placeholder="Batch No#" v-model="form.batchNo">
                            </div>
                        </div>
                        
                        <div class="col-md-2" v-if="form.modeOfPayment == 'Cheque'">
                            <div class="form-group mb-0">
                                <label class="form-label fw-bold text-dark mb-1">Cheque No#:</label>
                                <input type="text" class="form-control" placeholder="Cheque No#" v-model="form.chequeNo">
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="row align-items-end g-2">
                                <div class="col-8">
                                    <label class="form-label fw-bold text-dark mb-1">Currency Rate:</label>
                                    <input type="number" step="0.0001" class="form-control" v-model.number="form.currencyRate" :disabled="!form.isMultiCurrency">
                                </div>
                                <div class="col-4 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="multiCurrencyCheck" v-model="form.isMultiCurrency" @@change="toggleMultiCurrency">
                                        <label class="form-check-label text-dark fs-12 cursor-pointer" for="multiCurrencyCheck">
                                            Multi-Currency
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Lines Grid Table -->
            <div class="card mb-4">
                <div class="card-header bg-light py-2 border-bottom d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-primary d-inline-flex align-items-center shadow-sm" @@click="addLine">
                            <i class="ti ti-plus me-1"></i>Add Row
                        </button>
                    </div>
                    <span class="fs-12 text-muted fw-semibold">Voucher Lines ({{ form.lines.length }})</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0 text-nowrap">
                            <thead class="bg-light-100 fs-13 text-dark">
                                <tr>
                                    <th class="text-center" style="width: 70px;">WithHold?</th>
                                    <th style="width: 130px;">Invoice No.</th>
                                    <th style="width: 130px;">Reference No</th>
                                    <th style="width: 250px;">Debit G/L <span class="text-danger">*</span></th>
                                    <th>Description</th>
                                    <th style="width: 140px;" class="text-end">Local Amount <span class="text-danger">*</span></th>
                                    <th style="width: 140px;" class="text-end">Foreign Amount</th>
                                    <th style="width: 200px;">Organizational Unit</th>
                                    <th class="text-center" style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="(line, index) in form.lines" :key="index">
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input" v-model="line.isWithhold" @@change="calculateTotals">
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm border-light-subtle" v-model="line.invoiceNo">
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm border-light-subtle" v-model="line.referenceNo">
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm border-light-subtle" v-model="line.glAccount" required>
                                            <option value="" disabled>Select Account</option>
                                            <option v-for="a in debitGlAccounts" :key="a" :value="a">{{ a }}</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm border-light-subtle" v-model="line.description">
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end border-light-subtle fw-semibold" v-model.number="line.localAmount" required @@input="calculateLineForeign(line)">
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end border-light-subtle bg-light text-muted" v-model.number="line.foreignAmount" disabled>
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm border-light-subtle" v-model="line.orgUnit">
                                            <option v-for="org in orgUnits" :key="org" :value="org">{{ org }}</option>
                                        </select>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-icon btn-outline-danger border-0" @@click="removeLine(index)">
                                            <i class="ti ti-trash fs-14"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr v-if="form.lines.length === 0">
                                    <td colspan="9" class="text-center py-4 text-muted small">
                                        No rows added. Click "+ Add Row" to add voucher details.
                                    </td>
                                </tr>
                                <!-- Totals Row -->
                                <tr v-else class="bg-light fw-bold fs-13">
                                    <td colspan="5" class="text-end text-dark">Total:</td>
                                    <td class="text-end text-primary">{{ formatCurrency(totalLocalLines) }}</td>
                                    <td class="text-end text-muted">{{ formatCurrency(totalForeignLines) }}</td>
                                    <td colspan="2"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Bottom Calculator and Withholding Sections -->
            <div class="row g-4 mb-4">
                <!-- Withholding Panel -->
                <div class="col-lg-7">
                    <div class="card h-100 shadow-sm border border-light-subtle">
                        <div class="card-header bg-light py-3">
                            <h6 class="fw-bold text-dark mb-0"><i class="ti ti-calculator me-2"></i>WithHolding</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <!-- Row 1 -->
                                <div class="col-md-6">
                                    <div class="form-group mb-0">
                                        <label class="form-label text-muted small fw-bold mb-1">Rate(%):</label>
                                        <input type="number" class="form-control" v-model.number="form.withholdingRate" @@input="calculateTotals">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="row g-2 py-2">
                                        <div class="col-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="getflCheck" v-model="form.getfl" @@change="calculateTotals">
                                                <label class="form-check-label text-dark fs-13 cursor-pointer" for="getflCheck">GETFL ?</label>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="nhilCheck" v-model="form.nhil" @@change="calculateTotals">
                                                <label class="form-check-label text-dark fs-13 cursor-pointer" for="nhilCheck">NHIL ?</label>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="cstCheck" v-model="form.cst" @@change="calculateTotals">
                                                <label class="form-check-label text-dark fs-13 cursor-pointer" for="cstCheck">CST ?</label>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="covidCheck" v-model="form.covid" @@change="calculateTotals">
                                                <label class="form-check-label text-dark fs-13 cursor-pointer" for="covidCheck">COVID ?</label>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="vatCheck" v-model="form.vat" @@change="calculateTotals">
                                                <label class="form-check-label text-dark fs-13 cursor-pointer" for="vatCheck">VAT ?</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Row 2 -->
                                <div class="col-md-6">
                                    <div class="form-group mb-0">
                                        <label class="form-label text-muted small fw-bold mb-1">Credit G/L:</label>
                                        <select class="form-select" v-model="form.withholdingCreditGl">
                                            <option value="">Select Account</option>
                                            <option v-for="c in withholdingGlAccounts" :key="c" :value="c">{{ c }}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-0">
                                        <label class="form-label text-muted small fw-bold mb-1">VAT/Withhold Account:</label>
                                        <select class="form-select" v-model="form.withholdingVatAccount">
                                            <option value="">Select Account</option>
                                            <option v-for="v in vatGlAccounts" :key="v" :value="v">{{ v }}</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Row 3 -->
                                <div class="col-md-6">
                                    <div class="form-group mb-0">
                                        <label class="form-label text-muted small fw-bold mb-1">Tax Type:</label>
                                        <input type="text" class="form-control" placeholder="Tax Type" v-model="form.withholdingTaxType">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-0">
                                        <label class="form-label text-muted small fw-bold mb-1">VAT Amount:</label>
                                        <input type="text" class="form-control bg-light text-muted fw-semibold" :value="formatCurrency(calculatedVatAmount)" disabled>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Summary Panel -->
                <div class="col-lg-5">
                    <div class="card h-100 shadow-sm border border-light-subtle bg-light-50">
                        <div class="card-header bg-light py-3">
                            <h6 class="fw-bold text-dark mb-0"><i class="ti ti-report-money me-2"></i>Summary totals</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <div class="mb-2">
                                        <label class="form-label text-muted small fw-semibold mb-1">Total:</label>
                                        <input type="text" class="form-control bg-light text-muted fw-bold text-end fs-15" :value="formatCurrency(totalLocalLines)" disabled>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-2">
                                        <label class="form-label text-muted small fw-semibold mb-1">With Held:</label>
                                        <input type="text" class="form-control bg-light text-muted fw-semibold text-end text-danger fs-14" :value="formatCurrency(form.withheldAmount)" disabled>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-2">
                                        <label class="form-label text-muted small fw-semibold mb-1">Retained:</label>
                                        <input type="text" class="form-control bg-light text-muted fw-semibold text-end text-danger fs-14" :value="formatCurrency(form.retainedAmount)" disabled>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-2">
                                        <label class="form-label text-muted small fw-semibold mb-1">VAT Withheld Amount:</label>
                                        <input type="text" class="form-control bg-light text-muted fw-semibold text-end fs-14" :value="formatCurrency(form.vatWithheldAmount)" disabled>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-0">
                                        <label class="form-label text-muted small fw-semibold mb-1">Net Amount:</label>
                                        <input type="text" class="form-control bg-light text-dark fw-bold text-end fs-16 border-success-subtle text-success" :value="formatCurrency(form.netAmount)" disabled>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="mb-0">
                                        <label class="form-label text-muted small fw-semibold mb-1">Base Amount:</label>
                                        <input type="text" class="form-control bg-light text-dark fw-bold text-end fs-16 border-success-subtle text-success" :value="formatCurrency(form.netAmount)" disabled>
                                    </div>
                                </div>
                                
                            </div>
                            
                            <div class="d-flex gap-2 justify-content-end mt-2 border-top pt-3">
                                <a href="/GeneralLedger/Vouchers?tab=supplier" class="btn btn-secondary px-4">Cancel</a>
                                <button type="submit" class="btn btn-primary px-4 fw-bold shadow">Save Voucher</button>
                                <button type="submit" class="btn btn-primary px-4 fw-bold shadow">Save &amp; Preview Voucher</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RETENTIONS TAB CONTENT -->
        <div v-show="currentTab === 'retentions'">
            <div class="card mb-4">
                <div class="card-header bg-light py-2 border-bottom d-flex align-items-center justify-content-between">
                    <div>
                        <button type="button" class="btn btn-sm btn-primary d-inline-flex align-items-center shadow-sm" @@click="addRetention">
                            <i class="ti ti-plus me-1"></i>Add Retention Row
                        </button>
                    </div>
                    <span class="fs-12 text-muted fw-semibold">Retentions List ({{ form.retentions.length }})</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0 text-nowrap">
                            <thead class="bg-light-100 fs-13 text-dark">
                                <tr>
                                    <th>Description <span class="text-danger">*</span></th>
                                    <th style="width: 300px;">Credit G/L <span class="text-danger">*</span></th>
                                    <th style="width: 150px;" class="text-end">Value/Rate <span class="text-danger">*</span></th>
                                    <th style="width: 200px;" class="text-center">Type <span class="text-danger">*</span></th>
                                    <th style="width: 150px;" class="text-end">Total Amount</th>
                                    <th class="text-center" style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="(ret, index) in form.retentions" :key="index">
                                    <td>
                                        <input type="text" class="form-control form-control-sm border-light-subtle" v-model="ret.description" required placeholder="e.g. Performance Guarantee Retention">
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm border-light-subtle" v-model="ret.creditGl" required>
                                            <option value="" disabled>Select Account</option>
                                            <option v-for="c in withholdingGlAccounts" :key="c" :value="c">{{ c }}</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end border-light-subtle fw-semibold" v-model.number="ret.amount" required @@input="calculateRetentionTotal(ret)">
                                    </td>
                                    <td class="text-center">
                                        <select class="form-select form-select-sm border-light-subtle" v-model="ret.isPercentage" @@change="calculateRetentionTotal(ret)">
                                            <option :value="false">Fixed Amount</option>
                                            <option :value="true">Percentage (%)</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end border-light-subtle bg-light text-muted fw-bold" :value="ret.calculatedTotal" disabled>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-icon btn-outline-danger border-0" @@click="removeRetention(index)">
                                            <i class="ti ti-trash fs-14"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr v-if="form.retentions.length === 0">
                                    <td colspan="6" class="text-center py-5 text-muted small">
                                        No retention items specified. Switch back to "Payment Voucher" tab to edit details, or click "+ Add Retention Row".
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-primary px-4 fw-semibold" @@click="currentTab = 'voucher'">Go back to Payment Voucher</button>
                <button type="submit" class="btn btn-primary px-4 fw-bold shadow">Save Voucher</button>
            </div>
        </div>
    </form>
</div>

<style>
    .cursor-pointer {
        cursor: pointer;
    }
</style>

<script src="~/module-js/gl/create-supplier-voucher.js" asp-append-version="true"></script>
