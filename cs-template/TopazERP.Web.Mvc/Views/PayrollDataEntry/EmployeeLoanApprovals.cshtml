@{
    ViewBag.Title = "Employee Loan Approvals";
    Layout = "~/Views/Shared/Layout/_adminPayrollLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Employee Loan Approvals </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#"> Data Entry </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Employee Loan Approvals
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Employee Loan Approvals </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">
                                    <div class="col-sm-2 mx-3">

                                        <div class="form-group text-center" style="width: 180px; border: 1px solid #cacfe7; border-radius: 10px; padding: 0.75rem 1rem; justify-content: center">
                                            <div class="radio" style="width: 150px; display: inline-block;">
                                                <label><input type="radio" v-model="approvalType" name="ApprovalType" value="approve"> &nbsp;&nbsp; <b> Approve </b></label>
                                            </div>
                                            <div class="radio" style="width: 150px; display: inline-block;">
                                                <label><input type="radio" v-model="approvalType" name="ApprovalType" value="reject"> &nbsp;&nbsp; <b>  Reject </b></label>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="col-sm-2 mx-3 mt-1">

                                        <div class="form-group">
                                            <button type="button" :disabled="isLoading" class="alignright btn btn-primary mt-1" v-on:click="manageApproval()">

                                                Submit

                                                <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                                            </button>

                                        </div>

                                    </div>

                                    
                                    
                                </div>
                                
                                <div class="row">
                                    
                                    
                                    <div class="col-sm-5 mx-3">
                                        <p style="font-size: 18px;"> <strong class="text-info">Note:</strong> Double-click on a record to edit.</p>
                                    </div>
                                    
                                </div>

                               
                                <hr />

                                <div id="dataTable"></div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="~/js/payroll/data-entry/employee-loan-approvals.js" asp-append-version="true"></script>