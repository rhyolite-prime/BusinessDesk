@{
    ViewBag.Title = "Loan Amortization";
    Layout = "~/Views/Shared/Layout/_adminPayrollLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Loan Amortization </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#">Payroll Data Entry</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Loan Amortization
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Loan Amortization </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">

                                    <div class="col-sm-3">

                                        <img src="https://res.cloudinary.com/rhyoliteprime/image/upload/v1533814738/images_6.png" class="height-150" style="width:150px" alt="employee_info" id="empImage" name="empImage">

                                    </div>
                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label> <strong>Employee Loan: </strong>  </label>
                                            <input id="employeeId" v-model="employeeId" type="text" class="form-control" />
                                            <span class="text-danger" v-if="!$v.currentLoanId.required && $v.currentLoanId.$dirty && currentLoanId == ''"> Select an employee loan </span>
                                        </div>

                                        <div class="form-group">
                                            <label> <strong> Loan Date: </strong>  </label>
                                            <input v-model="selectedLoanRecord.creationTime" readonly ref="loanDate" class="form-control" type="text" />

                                        </div>

                                        <div class="form-group">
                                            <label> <strong> Principal Balance: </strong>  </label>
                                            <input type="number" class="form-control" readonly v-model="loanRepaymentSummary.totalPrincipalBalance" ref="principalBalance">

                                        </div>

                                       <div class="form-group">
                                            <label> <strong> Amount: </strong> </label>
                                            <input type="number" class="form-control" ref="amountPaid" v-model="amountPaid">
                                            <span class="text-danger" v-if="!$v.amountPaid.required && $v.amountPaid.$dirty"> Amount Paid field is required </span>
                                            <span class="text-danger" v-if="!$v.amountPaid.minValue && $v.amountPaid.$dirty"> Amount Paid field is required </span>
                                        
                                        </div>

                                    </div>

                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label> <strong> Loan Type: </strong>  </label>
                                            <input v-model="selectedLoanRecord.loanTypeName" readonly class="form-control" type="text" />
                                             
                                        </div>

                                        <div class="form-group">
                                            <label> <strong> Last Deduction Date: </strong>  </label>
                                            <input v-model="loanRepaymentSummary.lastDeductionDate" readonly class="form-control" type="text" />

                                        </div>

                                        <div class="form-group">
                                            <label> <strong> Interest Balance: </strong>  </label>
                                            <input type="number" class="form-control" readonly v-model="loanRepaymentSummary.totalInterestBalance">

                                        </div>

                                        <div class="form-group">
                                            <label> <strong> Bank GL: </strong>  </label>
                                            <input id="bankGlAccountId" v-model="bankGlAccountId" type="text" class="form-control" />

                                        </div>

                                    </div>

                                </div>

                                <hr />

                                <div class="row">
                                     
                                    <div class="col-sm-7">
                                    </div>

                                    <div class="col-sm-4">

                                        <button type="button" :disabled="isLoading" v-on:click="amortizeLoan()" class="btn btn-primary" style="float: right;">

                                            Submit

                                            <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>





<script src="~/libs/vuelidate/vuelidate.min.js"></script>
<script src="~/libs/vuelidate/validators.min.js"></script>

<script src="~/js/payroll/data-entry/loan-amortization.js" asp-append-version="true"></script>
