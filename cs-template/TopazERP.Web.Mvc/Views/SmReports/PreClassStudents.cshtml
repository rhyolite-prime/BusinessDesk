 @{
    ViewBag.Title = "Pre Class Student List";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}
 
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Pre Class Student List</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#">Reports</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Pre Class Student List
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Pre Class Student List</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div class="row">
                                    <div class="col-md-3 e-bootstrap mb-1">
                                        <label><strong>Class:</strong> </label>
                                        <input id="classId"/>
                                    </div>
                                    <div class="col-md-3 mb-1">
                                        <label><strong>Gender:</strong></label><br>
                                        <input type="checkbox" id="male" value="Male" v-model="genderFilter" @@change="searchReport"> Male
                                        <input type="checkbox" id="female" value="Female" v-model="genderFilter" @@change="searchReport" class="ml-2"> Female
                                    </div>
                                    <div class="col-md-3 mb-1">
                                        <label><strong>Status:</strong></label><br>

                                        <input type="checkbox"
                                               value="Active"
                                               v-model="statusFilter"
                                               @@change="searchReport">
                                        Active

                                        <input type="checkbox"
                                               value="Inactive"
                                               v-model="statusFilter"
                                               @@change="searchReport"
                                               class="ml-2">
                                        Inactive
                                    </div>

                                    <div class="my-1 float-right col-md-2">
                                        <button class="btn btn-primary mt-2"
                                                :disabled="isLoading"
                                                @@click="searchReport">
                                            Search
                                            <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                                        </button>
                                    </div>
                                  
                                </div>

                                @*table*@
                                   
                                <div style="height:auto;width:auto;min-height:500px;" id="reportView">  </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>



<script src="~/js/school-manager/reports/pre-class-students.js" asp-append-version="true"></script>