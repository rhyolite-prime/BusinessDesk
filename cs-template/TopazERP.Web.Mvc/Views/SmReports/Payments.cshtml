@{
ViewBag.Title = "Payments";
Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Payments</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#">Reports</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Payments
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Payments</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div  class="card-body" id="app">
                                <div>
                                    <div class="row my-1">
                                       
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label> Select Report Type  </label>
                                                <select class="form-control" v-model="reportType" ref="reportType">
                                                    <option value="1"> Summary </option>
                                                    <option value="2"> Details </option>
                                                    <option value="3"> By Bank </option>
                                                    <option value="4"> By GL Account </option>
                                                </select>

                                            </div>
                                        </div>
                                        <div class="col-sm-3" v-if="reportType === '3'">
                                            <div class="form-group">
                                                <label>Bank:</label>
                                                <searchable-dropdown :options="banks" v-model="bankId" text-field="name" value-field="id" placeholder="Select Bank..."> </searchable-dropdown>
                                            </div>
                                        </div>
                                        <div class="col-sm-3" v-if="reportType === '4'">
                                            <div class="form-group">
                                                <label>Bank GL Account:</label>
                                                <searchable-dropdown :options="accounts" v-model="bankGlId" text-field="accountIdentifier" value-field="id" placeholder="Select Bank GL Account..."> </searchable-dropdown>
                                            </div>
                                        </div>

                                        <div class="col-sm-3">

                                            <div class="form-group">
                                                <label>Start Date:</label>
                                                <input id="startDate" v-model="startDate" type="date" class="form-control"/>

                                            </div>

                                        </div>
                                        <div class="col-sm-3">

                                            <div class="form-group">
                                                <label>End Date:</label>
                                                <input id="endDate" v-model="endDate" type="date" class="form-control"/>

                                            </div>

                                        </div>
                                        <div class="my-2 float-right col-md-2">
                                            <button class="btn btn-primary"
                                                    :disabled="isLoading"
                                                    @@click="getReportData">
                                                <i class="la la-search"></i> Search
                                                <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                                            </button>
                                        </div>
                                    </div>
                                <div style="height:auto;width:auto;min-height:500px;" id="reportView"> </div>
                                </div>
                              
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>



<script src="~/js/school-manager/reports/bills-n-payments/payments.js" asp-append-version="true"></script>