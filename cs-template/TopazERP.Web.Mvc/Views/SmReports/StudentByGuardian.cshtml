@{
ViewBag.Title = "Student By Guardian";
Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Student By Guardian</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#">Reports</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Student By Guardian
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Student By Guardian</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div class="row">
                                    <div class="col-md-5 mb-1">
                                        <label><strong>Filter:</strong></label><br>
                                        <input type="checkbox"
                                               v-model="byStudent"
                                               @@change="toggleByStudent"
                                               class="ml-2">
                                        By Student
                                        <input type="checkbox"
                                               v-model="byGuardian"
                                               @@change="toggleByGuardian"
                                               class="ml-2">
                                       By Legal Guardian
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-3 e-bootstrap mb-1" v-show="byStudent">
                                        <label><strong>By Student:</strong> </label>
                                        <input id="studentId"/>
                                    </div>
                                    <div class="col-md-3 e-bootstrap mb-1" v-show="byGuardian">
                                        <label><strong>By Legal Guardian</strong> </label>
                                        <input id="legalGuardianId"/>
                                    </div>
                                    <div class="my-2 float-right col-md-2">
                                        <button class="btn btn-primary"
                                                :disabled="isLoading"
                                                @@click="searchReport">
                                            Search All
                                            <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                                        </button>
                                    </div>
                                </div>

                                @*table*@

                                <div style="height:auto;width:auto;min-height:500px;" id="reportView"> </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>



<script src="~/js/school-manager/reports/student-by-guardian.js" asp-append-version="true"></script>