 @{
    ViewBag.Title = "Student Bill";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
 }
 <style>
     .email-loader-overlay {
         position: fixed;
         top: 0;
         left: 0;
         width: 100%;
         height: 100%;
         background: rgba(0, 0, 0, 0.65);
         display: flex;
         justify-content: center;
         align-items: center;
         z-index: 10000;
     }

     .loader-text {
         margin-top: 10px;
         color: #fff4f4;
     }
     .modal-backdrop {
         position: fixed;
         top: 0;
         left: 0;
         width: 100%;
         height: 100%;
         background: rgba(0,0,0,0.5);
         display: flex;
         justify-content: center;
         align-items: center;
         z-index: 10000;
     }

     .modal-content {
         background: #fff;
         padding: 20px 30px;
         border-radius: 8px;
         max-width: 400px;
         width: 90%;
         text-align: center;
     }
     .loader-overlay {
         position: absolute;
         top: 0;
         left: 0;
         right: 0;
         bottom: 0;
         background: rgba(0, 0, 0, 0.65);
         display: flex;
         flex-direction: column;
         justify-content: center;
         align-items: center;
         z-index: 10;
         border-radius: 10px;
     }

     .loader {
         border: 5px solid #eee;
         border-top: 5px solid #3498db;
         border-radius: 50%;
         width: 50px;
         height: 50px;
         animation: spin 1s linear infinite;
     }

     @@keyframes spin {
         100% { transform: rotate(360deg); }
     }

 </style>
 <div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Student Bill</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#">Report</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Student Bill
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Student Bill</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div v-if="isSendingEmails" class="email-loader-overlay">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="sr-only">Sending emails...</span>
                                    </div>
                                    <div class="loader-text">
                                        <i class="la la-circle-o-notch spinner" v-if="isSendingEmails"></i>
                                        Processing...
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-2 mt-1">
                                        <div class="form-group mt-1">
                                            <label>
                                                <input type="checkbox" v-model="isSummary" /> Bill Summary
                                            </label>
                                        </div>
                                    </div>
                                </div>
                               
                                <div class="row">
                                    <div class="col-md-3 mb-1">
                                        <label>Academic Year:</label>
                                        <searchable-dropdown :options="academicYears" v-model="academicYearId" text-field="name" value-field="id" placeholder="Select Academic Year..."> </searchable-dropdown>
                                    </div>
                                    <div class="col-md-3 e-bootstrap mb-1">
                                        <label>Term:</label>
                                        <searchable-dropdown :options="terms" v-model="termId" text-field="name" value-field="id" placeholder="Select Term..."> </searchable-dropdown>
                                    </div>
                                    <div class="col-md-3 mb-1">
                                            <label>Class:</label>
                                            <searchable-dropdown :options="levelClassDropdown" v-model="classId" text-field="name" value-field="id" placeholder="Select Class..."> </searchable-dropdown>
                                    </div>
                                    <div class="col-md-3 mb-1">
                                            <label> Student:</label>
                                            <searchable-dropdown :options="classStudents" v-model="studentId" text-field="displayText" value-field="id" placeholder="Select Class..."> </searchable-dropdown>
                                    </div>
                                    <div class="col-md-3 e-bootstrap mb-1">
                                        <button class="btn btn-sm btn-primary" @@click="printReport()">
                                            <i class="ft-search"></i>
                                            Search
                                        </button>
                                       
                                    </div>
                                </div>
                                <hr/>
                                <ul class="nav nav-tabs mb-2">
                                    <li class="nav-item">
                                        <a class="nav-link text-primary"
                                           :class="{active: activeTab === 'view'}"
                                           href="#"
                                           @@click.prevent="activeTab = 'view'">
                                            View Report
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-primary"
                                           :class="{active: activeTab === 'email'}"
                                           href="#"
                                           @@click.prevent="activeTab = 'email'">
                                            Email
                                        </a>
                                    </li>
                                </ul>
                                <div v-if="activeTab === 'view'">
                                    <div v-if="isLoadingReports" class="loader-overlay">
                                        <div class="loader"></div>
                                        <p>Generating reports...</p>
                                    </div>
                                    <div class="row">
                                        <!-- RIGHT PDF VIEWER -->
                                        <div class="col">
                                            <div id="reportContainer" style="width:100%; height:800px; border:1px solid #ccc; border-radius: 10px;">

                                                <!-- REPORTS -->
                                                <div v-for="(url, index) in paginatedReports" :key="index" style="margin-bottom:10px; ">
                                                    <iframe
                                                        :src="url"
                                                        width="100%"
                                                        height="400px"
                                                        style="border:1px solid #ccc; border-radius:10px; height:750px;">
                                                    </iframe>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div v-if="activeTab === 'email'">

                                    <div class="mb-2 text-right">
                                        <button class="btn btn-sm btn-primary" @@click="bulkPrintReports()">
                                            <i class="las la-print"></i>
                                            Print Selected
                                        </button>
                                        <button class="btn btn-sm btn-success"
                                                @@click="emailSelectedStudents">
                                            <i class="las la-envelope"></i>
                                            Send Email To Selected
                                        </button>
                                    </div>
                                    <div v-if="isSkipped" style="margin-top:10px;">
                                        <p class="text-primary">{{ emailResultMessage }}</p>
                                    </div>
                                    <div class="table-responsive" >
                                        <table v-if="isSkipped" class="table table-bordered table-sm">
                                            <thead class="bg-danger">
                                            <tr>
                                                <th class="text-white">Skipped Emails</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            <tr v-for="(s, i) in skippedStudents" :key="i">
                                                <td>{{ s}}</td>
                                            </tr>
                                            </tbody>
                                        </table>
                                        <table class="table table-bordered table-sm">
                                            <thead class="bg-light">
                                            <tr>
                                                <th style="width:50px;">
                                                    <input type="checkbox"
                                                           v-model="selectAll"
                                                           @@change="toggleSelectAll">
                                                </th>
                                                <th>Student ID</th>
                                                <th>Student Name</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            <tr v-for="student in paginatedRows" :key="student.id">
                                                <td>
                                                    <input type="checkbox"
                                                           :value="student.id"
                                                           v-model="selectedStudents"
                                                    />
                                                </td>

                                                <td>
                                                    {{ student.studentIdentifier }}
                                                </td>

                                                <td>
                                                    {{ student.name }}
                                                </td>
                                            </tr>
                                            </tbody>
                                        </table>
                                        <div class="d-flex justify-content-end align-items-center gap-2 my-1">
                                            <button
                                                class="btn btn-primary btn-sm"
                                                :disabled="page === 1"
                                                @@click="page--">
                                                Prev
                                            </button>

                                            <span>
                                                Page {{ page }} of {{ totalTablePages }}
                                            </span>

                                            <button
                                                class="btn btn-primary btn-sm"
                                                :disabled="page === totalTablePages"
                                                @@click="page++">
                                                Next
                                            </button>

                                        </div>

                                        <!-- Result Modal -->
                                        <div v-if="emailResultModalVisible" class="modal-backdrop">
                                            <div class="modal-content">
                                                <h5>Email Dispatch Result</h5>
                                                <p>{{ emailResultMessage }}</p>
                                                <button class="btn btn-primary" @@click="emailResultModalVisible = false">Close</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

 
<script src="~/js/school-manager/reports/bills-n-payments/student-bill.js" asp-append-version="true"></script>