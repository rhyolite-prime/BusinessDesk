 @{
    ViewBag.Title = "Promote Entire Level";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

 <style>
     .table td:first-child,
     .table th:first-child {
         position: sticky;
         left: 0;
         background: #fff;
         z-index: 2;
         color: #0a0af0;
     }
 .table th {
     color: #353535;
 }

 .table td select{
     color: #0a0af0;
 }
 
     /* Sticky table header */
     .assessment-table-wrapper thead th {
         position: sticky;
         top: 0;
         z-index: 3;
     }

     /* Optional: keep student column visible when scrolling horizontally */
     .assessment-table-wrapper th:first-child,
     .assessment-table-wrapper td:first-child {
         position: sticky;
         left: 0;
         z-index: 2;
         background: #fff;
     }

     /* Ensure header column stays above body cells */
     .assessment-table-wrapper thead th:first-child {
         z-index: 4;
     }
     .select{
         border: none;
         width: 100%;
         background: transparent;
     }
     .select:focus{
         outline: none;
         box-shadow: none;
     }
     .assignment-item:hover{
         cursor: pointer;
         color: #0a0af0;
     }
     .assignment-list {
         display: flex;
         flex-wrap: wrap;
         gap: 0.1rem; 
         padding: 0;
         margin: 0;
         list-style: none; 
     }


 </style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Promote Entire Level</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#">Promotion/Results</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Promote Entire Level
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Promote To Alumni</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div class="row">
                                    <div class="col-md-3 e-bootstrap mb-1">
                                        <label>Academic Year: </label>
                                        <input id="academicYearId"  />
                                    </div>
                                  
                                    <div class="col-md-3 e-bootstrap mb-1">
                                        <label>Promote From: </label>
                                        <input id="fromClassId"  />
                                    </div>
                                </div>
                                <hr>
                                <div class="row mt-3" v-if="tableData.length">
                                    <div class="col-md-12">
                                        <div >
                                            <p class="primary">
                                                Students to be Promoted ({{ tableData.length }})
                                            </p>

                                            <div >
                                                <table class="table-responsive table table-bordered table-hover mb-0">
                                                    <thead >
                                                    <tr>
                                                        <th>#</th>
                                                        <th style="width: 120px">Student ID</th>
                                                        <th style="width: 350px">Student Name</th>
                                                        <th style="width: 250px">Current Class</th>
                                                        <th style="width:120px">
                                                            Promote ? <input type="checkbox"
                                                                             v-model="selectAll"
                                                                             @@change="toggleSelectAll">
                                                        </th>
                                                        <th style="width: 250px">To Class</th>

                                                    </tr>
                                                    </thead>

                                                    <tbody>
                                                    <tr v-for="(s, index) in paginatedRows" :key="s.studentId">
                                                        <td>
                                                            {{ ((page - 1) * perPage) + index + 1 }}
                                                        </td>
                                                        <td>{{ s.studentIdentifier }}</td>
                                                        <td>{{ s.name }}</td>
                                                        <td class="text-warning">{{ s.fromLevelClassName }}</td>
                                                        <td>
                                                            <input type="checkbox"
                                                                   v-model="s.selected"
                                                                   @@change="toggleSingleSelection(s)">
                                                        </td>
                                                        <td>
                                                            <select class="select form-select form-select-sm"
                                                                    v-model="s.toClassId"
                                                                    :disabled="!s.selected">
                                                                <option value="">Select class</option>
                                                                <option v-for="c in allLevelClasses"
                                                                        :key="c.id"
                                                                        :value="c.id">
                                                                    {{ c.name }}
                                                                </option>
                                                            </select>
                                                        </td>


                                                    </tr>
                                                    </tbody>
                                                </table>
                                                <div class="d-flex justify-content-end align-items-center gap-2 my-1">

                                                    <button
                                                        class="btn btn-primary btn-sm"
                                                        :disabled="page === 1"
                                                        @@click="page--">
                                                        Prev
                                                    </button>

                                                    <span>
                                                        Page {{ page }} of {{ totalPages }}
                                                    </span>

                                                    <button
                                                        class="btn btn-primary btn-sm"
                                                        :disabled="page === totalPages"
                                                        @@click="page++">
                                                        Next
                                                    </button>

                                                </div>

                                                <!-- save promotion modal -->
                                                <div class="modal fade" id="confirmSaveModal" tabindex="-1" aria-hidden="true">
                                                    <div class="modal-dialog modal-dialog-centered">
                                                        <div class="modal-content">

                                                            <div class="modal-header bg-primary">
                                                                <h5 class="modal-title text-white font-weight-bold">
                                                                    Topaz School Manager - Confirm Promotion
                                                                </h5>
                                                                <button type="button" class="btn-close btn" data-bs-dismiss="modal"></button>
                                                            </div>

                                                            <div class="modal-body">
                                                                <p>
                                                                    You are about to effect a promotion, Please make sure that the class being promoted from and the class being promoted to are correct?
                                                                </p>
                                                            </div>

                                                            <div class="modal-footer">
                                                                <button class="btn btn-secondary" @@click="onSavePromotionsNo">
                                                                    No
                                                                </button>
                                                                <button class="btn btn-success" @@click="onSavePromotionsYes">
                                                                    Yes Promote
                                                                </button>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                        </div>
                                            <div v-if="tableData.length" class="float-right">
                                                <button class="btn btn-primary" @@click="confirmSavePromotions">
                                                  <i class="la la-save"></i>  Save
                                                </button>
                                            </div>
                                    </div>
                                </div>

                            </div>
                            </div>
                                  
           
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>



<script src="~/js/school-manager/results-promotions/student-promotion-level.js" asp-append-version="true"></script>