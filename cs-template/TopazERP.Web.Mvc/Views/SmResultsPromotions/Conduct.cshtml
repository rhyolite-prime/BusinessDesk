 @{
    ViewBag.Title = "Conduct";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}
 <style>
 .table th {
     color: #353535;
 }
 .table td select{
     color: #0a0af0;
 }
 
     /* Sticky table header */
     .assessment-table-wrapper thead th {
         position: sticky;
         top: 0;
         z-index: 3;
     }

     /* Optional: keep student column visible when scrolling horizontally */
     .assessment-table-wrapper th:first-child,
     .assessment-table-wrapper td:first-child {
         position: sticky;
         left: 0;
         z-index: 2;
         background: #fff;
     }

     /* Ensure header column stays above body cells */
     .assessment-table-wrapper thead th:first-child {
         z-index: 4;
     }
     .select{
         border: none;
         width: 100%;
         background: transparent;
     }
     .select:focus{
         outline: none;
         box-shadow: none;
     }

 </style>

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Conducts</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#">Promotions/Results</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Conduct
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Conduct</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                             <div class="card-body" id="app">
                                <div class="row">
                                    <div class="col-md-3 e-bootstrap mb-1">
                                        <label>Academic Year: </label>
                                        <input id="academicYearId" />
                                    </div>
                                    <div class="col-md-3 e-bootstrap mb-1">
                                        <label>Term: </label>
                                        <input id="termId"/>
                                    </div>
                                    <div class="col-md-3 e-bootstrap mb-1">
                                        <label>Class: </label>
                                        <input id="classId"/>
                                    </div>
                                </div>
                                <hr />
                                <div v-if="assessmentExists" class="alert alert-info mt-2">
                                   <p>{{existingAssessmentMessage}}</p>
                                </div>
                                <div class="table-responsive mt-2" v-if="tableData.length">
                                    <table class="table table-striped table-bordered table-responsive">
                                        <thead>
                                        <tr>
                                            <th style="width: 60px">#</th>
                                            <th style="width: 960px">Name</th>
                                            <th style="width: 900px">Conduct</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr v-for="(row, index) in paginatedRows" :key="row.studentId">
                                            <td>
                                                {{ ((page - 1) * perPage) + index + 1 }}
                                            </td>
                                            <td>{{ row.studentName }}</td>
                                            <td>
                                                <input type="text"
                                                       class="select input"
                                                       v-model="row.description"/>
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                    <div class="d-flex justify-content-end align-items-center gap-2 my-1">

                                        <button
                                            class="btn btn-primary btn-sm"
                                            :disabled="page === 1"
                                            @@click="page--">
                                            Prev
                                        </button>

                                        <span>
                                            Page {{ page }} of {{ totalPages }}
                                        </span>

                                        <button
                                            class="btn btn-primary btn-sm"
                                            :disabled="page === totalPages"
                                            @@click="page++">
                                            Next
                                        </button>

                                    </div>

                                    <div class="my-1 float-right">
                                        <button class="btn btn-primary mt-2"
                                                @@click="saveAssessment">
                                           <i class="la la-save"></i> {{ assessmentId ? 'Update' : 'Save' }}
                                            <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>



<script src="~/js/school-manager/results-promotions/conducts.js" asp-append-version="true"></script>