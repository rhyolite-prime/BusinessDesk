@{
    ViewBag.Title = "Student Performance Skills";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Student Performance Skills</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#">Promotion/Results</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Student Performance Skills
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body" id="app">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Student Performance Skills</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body">
                                <!-- Filters -->
                                <div class="row">
                                    <div class="col-md-3 mb-1">
                                        <label>Academic Year</label>
                                        <input type="text" id="academicYearId" />
                                    </div>

                                    <div class="col-md-3 mb-1">
                                        <label>Term</label>
                                        <input type="text" id="termId" />
                                    </div>

                                    <div class="col-md-3 mb-1">
                                        <label>Class</label>
                                        <input type="text" id="classId" />
                                    </div>
                                    <div class="col-md-3 mb-1">
                                        <label>Student</label>
                                        <input type="text" id="studentId" />
                                    </div>
                                    <div class="col-md-3 mb-1">
                                        <label>Date</label>
                                        <input type="date" class="form-control" v-model="date" />
                                    </div>
                                </div>
                                

                                <hr />
                                <div class="row">
                                    <div class="col-4">
                                        <div class="card p-1">
                                            <h6>Performance Areas</h6>
                                            <div v-for="a in performanceAreas" :key="a.id" class="form-check">
                                                <input class="form-check-input" type="checkbox"
                                                       :id="'area_' + a.id"
                                                       :checked="selectedAreaIds.includes(String(a.id))"
                                                       @@change="toggleArea(a.id)">
                                                <label class="form-check-label" :for="'area_' + a.id">
                                                    {{ a.name }}
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-8">
                                        <div class="card p-1 " v-for="areaId in selectedAreaIds" :key="'skills_' + areaId">
                                            <h6>
                                                Skills - {{ performanceAreas.find(x => String(x.id) === String(areaId))?.name }}
                                            </h6>
                                            <ul class="p-1 list-group">
                                                <li class=" d-flex align-items-center form-check"
                                                    v-for="s in getSkillsByArea(areaId)"
                                                    :key="s.id">

                                                    <input class="form-check-input me-1"
                                                           type="checkbox"
                                                           :id="'skill_' + areaId + '_' + s.id"
                                                           :checked="(selectedSkillIdsByArea[String(areaId)] || []).includes(String(s.id))"
                                                           @@change="toggleSkill(areaId, s.id)">

                                                    <label class="mb-0 w-100"
                                                           :for="'skill_' + areaId + '_' + s.id">
                                                        {{ s.name }}
                                                    </label>
                                                </li>

                                                <li v-if="!getSkillsByArea(areaId).length"
                                                    class="list-group-item text-muted">
                                                    No skills available.
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                               
                             
                                <div class="card p-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0">Selected Areas & Skills</h6>
                                        <button class="btn btn-primary btn-sm" @@click="saveStudentPerformanceSkills" :disabled="isLoading">
                                            {{ isLoading ? 'Saving...' : 'Save' }}
                                        </button>
                                    </div>

                                    <div class="table-responsive mt-2">
                                        <table class="table table-bordered table-striped table-responsive">
                                            <thead>
                                            <tr>
                                                <th style="width:45%">Performance Area</th>
                                                <th style="width:45%">Skill</th>
                                                <th style="width:10%">Action</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            <tr v-for="(r, i) in liveRows" :key="i">
                                                <td>{{ r.performanceAreaName }}</td>
                                                <td>{{ r.performanceSkillName }}</td>
                                                <td>
                                                    <button v-if="r.performanceSkillId"
                                                            class="btn btn-danger btn-sm"
                                                            @@click="toggleSkill(r.performanceAreaId, r.performanceSkillId)">
                                                        Remove
                                                    </button>
                                                    <button v-else
                                                            class="btn btn-danger btn-sm"
                                                            @@click="toggleArea(r.performanceAreaId)">
                                                        Remove Area
                                                    </button>
                                                </td>
                                            </tr>
                                            <tr v-if="!liveRows.length">
                                                <td colspan="3" class="text-center">No selections yet.</td>
                                            </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="~/js/school-manager/results-promotions/perfomance-skills.js" asp-append-version="true"></script>