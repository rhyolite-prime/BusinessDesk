@{
ViewBag.Title = "School Profile";
Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
    <div class="content-header row">
        <div class="content-header-left col-md-6 col-12 mb-2">
            <h3 class="content-header-title">School Profile </h3>
            <div class="row breadcrumbs-top">
                <div class="breadcrumb-wrapper col-12">
                    <ol class="breadcrumb">
                        <li class=" breadcrumb-item">
                            <a href="../Dashboard/SchoolManager/" class="text-primary"><i class="la la-home"></i> Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="#" class="text-info"> Profiles </a>
                        </li>
                        <li class="breadcrumb-item active">
                           School Profile
                        </li>
                    </ol>
                </div>
            </div>
        </div>

    </div>
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                        <h4 class="card-title"> School Profile </h4>
                        <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                        <div class="heading-elements">
                            <ul class="list-inline mb-0">
                                <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                <li><a data-action="close"><i class="ft-x"></i></a></li>
                            </ul>
                        </div>
                    </div>
                   
            <div class="card-content collapse show">

<div class="card-body" id="app">

<div class="content-i" id="app">
<div class="content-box">
<div class="element-wrapper">
<h6 class="element-header"> School Profile </h6>
<div class="element-box">
<div class="table-responsive" style="height:auto;width:auto;min-height:412px;">        
<ul class="nav nav-tabs" id="myTab-three" role="tablist">
</ul>
<!-- Basic Tables start -->
<div class="tab-content" id="myTabContent-4">
    
        <form>
            <div class="d-flex justify-content-end my-1">
                <button
                    type="button"
                    class="btn btn-outline-success mr-2"
                    @@click="showEmailModal = true">

                    <i class="la la-envelope me-1"></i>
                    Email Settings
                </button>
                <button
                    type="button"
                    class="btn btn-outline-primary"
                    @@click="showSmsModal = true">

                    <i class="la la-commenting-o me-1"></i>
                    SMS Settings
                </button>
            </div>
            <fieldset class="form-group mt-1">
                <legend ><span> Basic Info </span></legend>
                <hr/>
                <div class="row">
                    <div class="col-md-3 text-center mb-2">
                        <div class="position-relative d-inline-block">
                          
                            <img v-if="companyLogoBase64"
                                 :src="companyLogoBase64"
                                 alt="SchoolLogo"
                                 class="shadow-sm border border-primary"
                                 style="width: 200px; height: 200px; object-fit: contain;">
                            
                            <img v-else
                                 src="https://res.cloudinary.com/dusydqiob/image/upload/v1755769638/erp-reports/ap/profile_biwocv.jpg"
                                 alt="Default Profile"
                                 class="shadow-sm border border-primary"
                                 style="width: 200px; height: 200px; object-fit: cover;">
                            @*<div class="form-group">
                                <label><b>Logo Url: </b></label>
                                <input id="schoolLogo" type="text" class="form-control" v-model="schoolLogo" placeholder="Url...">
                            </div>*@
                         
                            <button v-if="companyLogoBase64"
                                    @@click="removeLogo"
                                    type="button"
                                    class="btn btn-sm  p-1 position-absolute bottom-0 end-0 rounded-circle"
                                    style="background-color:#f87272; transform: translate(25%, 25%); bottom: 10px; right: 25px; border: 6px solid white">
                                <i class="la la-times text-white"></i>
                            </button>
                            <button v-else
                                    @@click="showUpload"
                                    type="button"
                                    class="btn btn-sm  p-1 position-absolute bottom-0 end-0 rounded-circle"
                                    style="background-color:#7436f3; transform: translate(25%, 25%); bottom: 10px; right: 25px; border: 6px solid white">
                                <i class="la la-plus text-white"></i>
                            </button>

                        </div>

                        <!-- File input -->
                        <div class="mt-3">
                            <label class="form-label fw-bold">Upload School Crest</label>
                            <input type="file"
                                   ref="fileInput"
                                   class="form-control form-control-sm d-none"
                                   @@change="onFileChange"
                                   accept="image/*">
                        </div>
                    </div>

                    <div class="col-sm-3">
                       
                      
                        <div class="form-group">
                            <label><b> School Name:</b></label> <span class="text-danger">*</span>
                            <input type="text" class="form-control" v-model="schoolName" ref="schoolName" placeholder="School Name">
                            <small v-if="errors.schoolName" style="color:red">
                                {{ errors.schoolName }}
                            </small>
                        </div>

                        <div class="form-group">
                            <label><b> Address: </b></label><span class="text-danger">*</span>
                            <input type="text" class="form-control" v-model="address" ref="address" placeholder="Address">
                            <small v-if="errors.address" style="color:red">
                                {{ errors.address }}
                            </small>
                        </div>

                        <div class="form-group">
                            <label><b> Phone No: </b></label><span class="text-danger">*</span>
                            <input type="text" class="form-control" id="phoneNo" v-model="phoneNo" ref="phoneNo" placeholder="Phone No">
                            <small v-if="errors.phoneNo" style="color:red">
                                {{ errors.phoneNo }}
                            </small>
                        </div>

                        <div class="form-group">
                            <label><b> Email: </b></label><span class="text-danger">*</span>
                            <input type="text" class="form-control" v-model="email" ref="email" placeholder="Email">
                            <small v-if="errors.email" style="color:red">
                                {{ errors.email }}
                            </small>
                        </div>

                        <div class="form-group">
                            <label><b> Region: </b></label><span class="text-danger">*</span>
                            <input id="countryStateId" type="text" class="form-control" v-model="countryStateId" placeholder="Region">
                            <small v-if="errors.countryStateId" style="color:red">
                                {{ errors.countryStateId }}
                            </small>
                        </div>
                       
                    </div>

                    <div class="col-sm-3">
            
                        <div class="form-group">
                            <label><b> Current Academic Year: </b></label><span class="text-danger">*</span>
                            <input type="text" id="currentAcademicYearId" class="form-control" v-model="currentAcademicYearId" placeholder="Current Academic Year">
                            <small v-if="errors.currentAcademicYearId" style="color:red">
                                {{ errors.currentAcademicYearId }}
                            </small>
                        </div>
            
                        <div class="form-group">
                            <label><b>Reg No: </b></label>
                            <input id="registrationNo" type="text" class="form-control" v-model="registrationNo" placeholder="Registration No">
                        </div>
            
                        <div class="form-group">
                            <label><b>Sub Metro: </b></label>
                            <input id="subMetro" type="text" class="form-control" v-model="subMetro" placeholder="Sub Metro">
                        </div>
            
                        <div class="form-group">
                            <label><b>Circuit: </b></label>
                            <input id="circuit" type="text" class="form-control" v-model="circuit" placeholder="Circuit">
                        </div>
            
                        <div class="form-group">
                            <label><b> City: </b></label><span class="text-danger">*</span>
                            <input id="cityId" type="text" class="form-control" v-model="cityId" placeholder="City or Location">
                            <small v-if="errors.cityId" style="color:red">
                                {{ errors.cityId }}
                            </small>
                        </div>
                    </div>
            
                    <div class="col-sm-3">
            
                        <div class="form-group">
                            <label><b> Term: </b></label><span class="text-danger">*</span>
                            <input type="text" id="currentTermId" class="form-control" v-model="currentTermId" placeholder="Term">
                            <small v-if="errors.currentTermId" style="color:red">
                                {{ errors.currentTermId }}
                            </small>
                        </div>
            
                        <div class="form-group">
                            <label><b> Web Link: </b></label>
                            <input type="text" id="webLink" class="form-control" v-model="webLink" placeholder="Web Link">
                        </div>
            
                        <div class="form-group">
                            <label><b> School Days: </b></label><span class="text-danger">*</span>
                            <input id="schoolDays" type="number" class="form-control" v-model="schoolDays" placeholder="School Days">
                            <small v-if="errors.schoolDays" style="color:red">
                                {{ errors.schoolDays }}
                            </small>
                        </div>
                        <div class="form-group">
                            <label><b> Country: </b></label><span class="text-danger">*</span>
                            <input id="countryId" type="text" class="form-control" v-model="countryId" ref="country" placeholder="Country">
                            <small v-if="errors.countryId" style="color:red">
                                {{ errors.countryId }}
                            </small>
                        </div>
                        <div class="form-group">
                            <label><b> Local Currency: </b></label><span class="text-danger">*</span>
                            <input id="currencyId" type="text" class="form-control" v-model="currencyId" ref="currency" placeholder="Currency">
                            <small v-if="errors.currencyId" style="color:red">
                                {{ errors.currencyId }}
                            </small>
                        </div>
                    </div>
                </div>
            </fieldset>

