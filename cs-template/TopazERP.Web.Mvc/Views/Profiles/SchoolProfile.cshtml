            <fieldset class="form-group mt-1">
                <legend><span>Signature</span></legend>
                <hr />
                <div class="row">
                     <div class="col-md-3 text-center mb-2">
                        <div class="position-relative d-inline-block">
                          
                            <img v-if="signatureBase64" :src="signatureBase64"
                                 alt="Signature"
                                 class=" shadow-sm border border-primary"
                                 style="width: 200px; height: 200px; object-fit: contain;">
                            
                            <img v-else
                                 src="https://res.cloudinary.com/dusydqiob/image/upload/v1755769638/erp-reports/ap/profile_biwocv.jpg"
                                 alt="Signature"
                                 class=" shadow-sm border border-primary"
                                 style="width: 200px; height: 200px; object-fit: cover;">
                            @*<div class="form-group">
                                <label><b>Signature Url: </b></label>
                                <input id="signatureUrl" type="text" class="form-control" v-model="signatureUrl" placeholder="Url...">
                            </div>*@
                            <button v-if="signatureBase64"
                                    @@click="removeSignature"
                                    type="button"
                                    class="btn btn-sm  p-1 position-absolute bottom-0 end-0 rounded-circle"
                                    style="background-color:#f87272; transform: translate(25%, 25%); bottom: 10px; right: 25px; border: 6px solid white">
                                <i class="la la-times text-white"></i>
                            </button>
                            <button v-else
                                    @@click="showSignatureUpload"
                                    type="button"
                                    class="btn btn-sm  p-1 position-absolute bottom-0 end-0 rounded-circle"
                                    style="background-color:#7436f3; transform: translate(25%, 25%); bottom: 10px; right: 25px; border: 6px solid white">
                                <i class="la la-plus text-white"></i>
                            </button>

                        </div>

                        <!-- File input -->
                        <div class="mt-3">
                            <label class="form-label fw-bold">Upload Signature</label>
                            <input type="file"
                                   ref="signatureFileInput"
                                   class="form-control form-control-sm d-none"
                                   @@change="onSignatureFileChange"
                                   accept="image/*">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <input type="checkbox" id="showSignature" v-model="showSignature"/>
                                <label class="mb-0 mx-2" for="showSignature"><b>Show Signature</b></label>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <input type="checkbox" id="showSignatureOnResults" v-model="showSignatureOnResults"/>
                                <label class="mb-0 mx-2" for="showSignatureOnResults"><b>Show On Results By Students</b></label>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <input type="checkbox" id="showSignatureOnBills" v-model="showSignatureOnBills"/>
                                <label class="mb-0 mx-2" for="showSignatureOnBills"><b>Show On Student Bills</b></label>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <input type="checkbox" id="showSignatureOnStatement" v-model="showSignatureOnStatement"/>
                                <label class="mb-0 mx-2" for="showSignatureOnStatement"><b>Show On Student Statement</b></label>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <input type="checkbox" id="showSignatureOnReceipt" v-model="showSignatureOnReceipt"/>
                                <label class="mb-0 mx-2" for="showSignatureOnReceipt"><b>Show On Receipt</b></label>
                            </div>
                        </div>
                    </div>
                </div>

            </fieldset>
            
            <fieldset class="form-group mt-1">
                <legend><span>Terminal Report</span></legend>
                <hr />
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <input type="checkbox" id="isClassPosition" v-model="isClassPosition"/>
                                <label class="mb-0 mx-2" for="isClassPosition"><b>Class Position (Splitting)</b></label>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <input type="checkbox" id="isSubjectPosition" v-model="isSubjectPosition"/>
                                <label class="mb-0 mx-2" for="isSubjectPosition"><b>Subject Position (Splitting)</b></label>
                            </div>
                        </div>
                    </div>
                </div>

            </fieldset>
           
            <fieldset class="form-group mt-1">
                <legend><span>Others</span></legend>
                <hr />
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <input type="checkbox" id="enforceExamSecurity" v-model="enforceExamSecurity"/>
                                <label class="mb-0 mx-2" for="enforceExamSecurity"><b>Enforce Exam Security</b></label>
                            </div>
                        </div>
                    </div>
                </div>

            </fieldset>
            
            <div class="row mb-4">

                <div class="col-sm-3"></div>
                <div class="col-sm-4"></div>
                <div class="col-sm-4">

                    <button type="button" :disabled="isLoading" @@click="saveProfile()" style="float: right" class="btn btn-primary">
                        Save Profile

                        <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                    </button>

                </div>

            </div>
<!-- SMS Settings Modal -->
            <div
                v-if="showSmsModal"
                class="modal fade show d-block"
                tabindex="-1"
                role="dialog"
                style="background-color: rgba(0,0,0,0.5);">

                <div class="modal-dialog modal-dialog-centered" role="document">

                    <div class="modal-content">

                        <!-- Header -->
                        <div class="modal-header">

                            <div>
                                <h5 class="modal-title mb-1">
                                    <i class="la la-commenting-o me-1"></i>
                                    SMS Settings
                                </h5>

                                <small class="text-muted">
                                    Configure your school's SMS provider.
                                </small>
                            </div>

                            <button
                                type="button"
                                class="btn-close btn-danger btn btn-sm" 
                                aria-label="Close"
                                @@click="showSmsModal = false">
                                <i class="la la-times"></i>
                            </button>

                        </div>

                        <!-- Body -->
                        <div class="modal-body">

                            <div class="alert alert-info">
                                <i class="la la-info-circle me-1"></i>
                                These settings are used when sending SMS messages
                                to students and parents.
                            </div>

                            <!-- Client ID -->
                            <div class="form-group">

                                <label>
                                    <b>Client ID</b>
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    v-model="clientId"
                                    placeholder="Enter Client ID">

                            </div>

                            <!-- Client Secret -->
                            <div class="form-group">

                                <label>
                                    <b>Client Secret</b>
                                </label>

                                <div class="input-group">

                                    <input
                                        :type="showClientSecret ? 'text' : 'password'"
                                        class="form-control"
                                        v-model="clientSecret"
                                        placeholder="Enter Client Secret">

                                    <button
                                        type="button"
                                        class="btn btn-outline-secondary"
                                        @@click="showClientSecret = !showClientSecret">

                                        <i
                                            :class="showClientSecret
                                    ? 'la la-eye-slash'
                                    : 'la la-eye'">
                                        </i>

                                    </button>

                                </div>

                            </div>

                            <!-- Sender ID -->
                            <div class="form-group">

                                <label>
                                    <b>Sender ID</b>
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    v-model="senderId"
                                    placeholder="Enter Sender ID">

                            </div>

                        </div>

                        <!-- Footer -->
                        <div class="modal-footer">

                            <button
                                type="button"
                                class="btn btn-light"
                                :disabled="isLoading"
                                @@click="showSmsModal = false">

                                Cancel
                            </button>

                            <button
                                type="button"
                                class="btn btn-primary"
                                :disabled="isLoading"
                                @@click="saveProfile()">

                                <i
                                    class="la la-circle-o-notch spinner"
                                    v-if="isLoading">
                                </i>

                                <i
                                    class="la la-save"
                                    v-else>
                                </i>

                                Save SMS Settings

                            </button>

                        </div>

                    </div>

                </div>

            </div>
            
            
            <!-- Email Settings Modal -->
<div
    v-if="showEmailModal"
    class="modal fade show d-block"
    tabindex="-1"
    role="dialog"
    style="background-color: rgba(0,0,0,0.5);">

    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down" role="document">

        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">

                <div>
                    <h5 class="modal-title mb-1">
                        <i class="la la-envelope me-1"></i>
                        Email Settings
                    </h5>

                    <small class="text-muted">
                        Configure your school's Email provider.
                    </small>
                </div>

                <button
                    type="button"
                    class="btn-close btn-danger btn btn-sm" 
                    aria-label="Close"
                    @@click="showEmailModal = false">
                    <i class="la la-times"></i>
                </button>

            </div>

            <!-- Body -->
            <div class="modal-body">

                <div class="alert alert-info">
                    <i class="la la-info-circle me-1"></i>
                    These settings are used when sending Emails
                    to students and parents.
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label> <b>Mail Host Name: </b> </label>
                            <input type="text" class="form-control" v-model="mailHostName" placeholder="Mail Host Name">
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-group">
                            <label> <b>Primary Email Address: </b> </label>
                            <input type="text" class="form-control" v-model="primaryEmailAddress" placeholder="Primary Email Address">
                        </div>
                    </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="form-group">
                                <label> <b> Port Number: </b> </label>
                                <input type="number" class="form-control" v-model="portNumber" placeholder="1234">

                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label> <b> Is SSL Enabled: </b> </label>
                                <select class="form-control mb-3" v-model="isSSLEnabled">
                                    <option value="false">No</option>
                                    <option value="true">Yes</option>
                                </select>
                            </div>
                        </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="form-group">
                            <label> <b>Mail Password: </b> </label>
                            <div class="input-group">

                                <input
                                    :type="showEmailPassword ? 'text' : 'password'"
                                    class="form-control"
                                    v-model="emailPassword"
                                    placeholder="Enter Email Password">

                                <button
                                    type="button"
                                    class="btn btn-outline-secondary"
                                    @@click="showEmailPassword = !showEmailPassword">

                                    <i
                                        :class="showEmailPassword
                                    ? 'la la-eye-slash'
                                    : 'la la-eye'">
                                    </i>

                                </button>

                            </div>
                        </div>
                    </div>
                    </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-light"
                    :disabled="isLoading"
                    @@click="showEmailModal = false">

                    Cancel
                </button>

                <button
                    type="button"
                    class="btn btn-primary"
                    :disabled="isLoading"
                    @@click="saveProfile()">

                    <i
                        class="la la-circle-o-notch spinner"
                        v-if="isLoading">
                    </i>

                    <i
                        class="la la-save"
                        v-else>
                    </i>

                    Save Email Settings

                </button>

            </div>

        </div>

    </div>

</div>
