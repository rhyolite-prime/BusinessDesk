 @{
    ViewBag.Title = "Cancel Results";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

 <style>
     .assignment-item:hover{
         cursor: pointer;
         color: #0a0af0;
     }
     .assignment-list {
         display: flex;
         flex-wrap: wrap;
         gap: 0.1rem; 
         padding: 0;
         margin: 0;
         list-style: none; 
     }
     .assignment-item {
         cursor: pointer;
         border: 1px solid #ddd;
         border-radius: 6px;
         padding: 10px;
         background: #f9f9f9;
         transition: all 0.2s ease;
     }

     .assignment-item.selected {
         background: #ffecec;
         border-color: #dc3545;
         box-shadow: 0 0 0 2px rgba(220,53,69,.25);
     }

     .modal-backdrop-custom {
         position: fixed;
         inset: 0;
         background: rgba(0,0,0,.5);
         display: flex;
         align-items: center;
         justify-content: center;
         z-index: 9999;
     }

     .modal-box {
         background: white;
         padding: 20px;
         width: 400px;
         border-radius: 8px;
     }

 </style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Cancel Results</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#">Promotion/Results</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Cancel Results
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Cancel Results</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div class="row">
                                    <div class="col-md-3 e-bootstrap mb-1">
                                        <label>Academic Year: </label>
                                        <input id="academicYearId"  :disabled="lockInputs"/>
                                    </div>
                                    <div class="col-md-3 e-bootstrap mb-1">
                                        <label>Term: </label>
                                        <input id="termId"  :disabled="lockInputs"/>
                                    </div>
                                    <div class="col-md-3 e-bootstrap mb-1">
                                        <label>Class: </label>
                                        <input id="classId"  :disabled="lockInputs"/>
                                    </div>
                                   
                                    <div class="col-md-3 e-bootstrap mb-1">
                                        <label>Subject: </label>
                                        <input id="subjectId"  :disabled="lockInputs"/>
                                    </div>
                                    <div class="col-md-3 e-bootstrap mb-1">
                                        <label>Result Type: </label>
                                        <input id="type"  :disabled="lockInputs"/>
                                    </div>
                                   
                                </div>
                                <div v-if="existingAssignmentList.length" class="mb-3">
                                    <label class="font-weight-bold mb-2 d-block">Existing Results:</label>
                                    <ul class="assignment-list d-flex flex-row flex-wrap p-0 m-0 list-unstyled">
                                        <li v-for="a in existingAssignmentList"
                                            :key="a.id"
                                            class="assignment-item"
                                            :class="{ selected: selectedAssignmentIds.includes(a.id) }"
                                            @@click="toggleAssignmentSelection(a)">
                                            <p>Assign. {{ a.assignmentNumber }} Date: <span>{{ formatDate(a.assignedDate) }}</span></p>
                                        </li>

                                    </ul>
                                </div>
                                <div v-else class="alert alert-warning">
                                    No existing results found for the selected criteria.
                                </div>
                                <div class="my-1 float-right">
                                    <button class="btn btn-danger"
                                            :disabled="!selectedAssignmentIds.length"
                                            @@click="confirmCancel">
                                        Cancel  Results
                                    </button>
                                </div>
                                
                                <div v-if="showCancelModal" class="modal-backdrop-custom">
                                    <div class="modal-box">
                                        <h5 class="text-danger">Confirm Cancellation</h5>

                                        <p>
                                            You are about to cancel
                                            <strong>{{ selectedAssignmentIds.length }}</strong>
                                            results(s).
                                        </p>

                                        <p class="text-muted">
                                            This action cannot be undone.
                                        </p>

                                        <div class="text-right">
                                            <button class="btn btn-secondary mr-2"
                                                    @@click="showCancelModal = false">
                                                No, Go Back
                                            </button>

                                            <button class="btn btn-danger"
                                                    @@click="cancelSelectedAssignments">
                                                Yes, Cancel
                                            </button>
                                        </div>
                                    </div>
                                </div>

                            </div>
                           

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>



<script src="~/js/school-manager/results-promotions/cancel-results.js" asp-append-version="true"></script>