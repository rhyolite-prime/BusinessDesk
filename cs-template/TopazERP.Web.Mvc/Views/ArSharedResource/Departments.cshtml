@{
    ViewBag.Title = "Departments";
    Layout = "~/Views/Shared/Layout/_adminArLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
</style>

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Departments </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/Ar" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#"> Shared Resources </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Departments
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card b">
                        <div class="card-header">
                            <h4 class="card-title"> Departments </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">

                                    <div class="col-sm-2">
                                    </div>
                                    <div class="col-sm-3">

                                        <div class="form-group">
                                            <label> <strong> Department: </strong> </label>
                                            <input type="text" class="form-control" v-model="name" id="name" placeholder="Department Name">

                                        </div>

                                    </div>

                                    <div class="col-sm-3">

                                        <div class="form-group">
                                            <label> <strong> Parent Hierachy: </strong>  </label>
                                            <select class="form-control" v-model="parentId" type="text">
                                                <option value=""> Select Parent Hierachy </option>
                                                <option :value="department.id" v-for="department in departmentHierachyList"> {{department.name}} </option>
                                            </select>
                                        </div>

                                    </div>

                                    <div class="col-sm-2 mt-1">
                                        <div class="form-group mt-1">
                                            <button type="button" v-on:click="saveDepartment()" :disabled="isLoading" class="btn btn-warning">
                                                Save

                                                <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                                            </button>

                                        </div>

                                    </div>

                                </div>
                                <hr />

                                <div id="dataTable"></div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
            

        </div>
    </div>
</div>


<script src="~/js/shared/vue3/departments.js" asp-append-version="true"></script>