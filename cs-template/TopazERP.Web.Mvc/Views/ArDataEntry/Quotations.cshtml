@{
ViewBag.Title = "Quotations";
Layout = "~/Views/Shared/Layout/_adminArLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
</style>
<div class="app-content content">
<div class="content-wrapper">
<div class="content-header row">
    <div class="content-header-left col-md-6 col-12 mb-2">
        <h3 class="content-header-title"> Quotations </h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Ar","Dashboard")" class="text-info"><i class="la la-home"></i> Home</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a class="text-info" href="#"> Data Entry </a>
                    </li>
                    <li class="breadcrumb-item active">
                       Quotations
                    </li>
                </ol>
            </div>
        </div>
    </div>

</div>
<div class="content-body">
<!-- Basic Tables start -->
<div class="row">
<div class="col-12">
<div class="card b">
<div class="card-header">
    <h4 class="card-title"> Quotations</h4>
    <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
    <div class="heading-elements">
        <ul class="list-inline mb-0">
            <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
            <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
            <li><a data-action="close"><i class="ft-x"></i></a></li>
        </ul>
    </div>
</div>

<div class="card-content collapse show">
<div class="card-body" id="app">
<div>
    <!--search area -->
    <div class="row my-1">
        <div class="col-sm-4">
            <div >
                <button type="button" v-on:click="clearForm" class=" btn btn-info mr-2 btn-sm">
                    <i class="la la-refresh"></i> Reset Form
                    <i class="fa fa-spinner fa-spin" v-if="isLoading"></i>
                </button>
                <button type="button" v-on:click="deleteQuotation" class="btn btn-danger mr-2 btn-sm">
                    <i class="la la-trash"></i> Delete
                    <i class="fa fa-spinner fa-spin" v-if="isLoading"></i>
                </button>
               
            </div>
            
        </div>
        <div class="col-sm-4">

            <div class="form-group">
                <label> <strong> Search Quotation: </strong>  </label>
                <input id="quotationId" v-model="quotationId" type="text" class="form-control" />

            </div>

        </div>
        <div class="col-sm-4  text-right" v-if="quotationId">
            <a @@click="printReport" class="btn btn-info text-white btn-sm"> <i class="la la-print"></i> Print </a>
        </div>

    </div>
    <hr/>
    <!-- add and update form -->
    <div>
        <div class="row mb-2">
            <div class="col-12">
                <div class="form-group">
                    <label class="h4 mt-2"><strong>Add Tax Levies if Applicable: </strong></label>
                </div>
                <!-- Checkboxes as buttons -->
                <div class="form-group d-flex flex-wrap">
                    <div class="d-flex gap-2 mt-1">
                        <!-- Tax Levy Buttons -->
                        <button
                            v-for="tax in taxLevyList"
                            :key="tax.id"
                            :class="['btn', tax.isApplied ? 'btn-amber' : 'btn-outline-amber']"
                            style="min-width: 120px;"
                            @@click.prevent="toggleTaxLevy(tax.id)">
                            {{ tax.name }} ({{ tax.rate }}%)
                        </button>
                    </div>
                   
                </div>
                
            </div>
        </div>
      
        <div class="row">
            <div class="col-sm-3">
              
                <div class="form-group">
                    <label> <strong> Customer: </strong> </label><span class="text-danger">*</span>
                    <input id="customerId" v-model="customerId" type="text" class="form-control" required/>
                </div>

                <div class="form-group">
                    <label> <strong>Account No.: </strong> </label>
                    <input v-model="accountNumber" class="form-control" type="text" disabled="disabled"/>

                </div>
                <div class="form-group">
                    <label> <strong>Address: </strong> </label>
                    <input v-model="address" class="form-control" type="text" disabled="disabled"/>

                </div>

                
            </div>
            <div class="col-sm-3">

                <div class="form-group">
                    <label> <strong> <strong> Quotation Number: </strong> </strong> </label><span class="text-success">*</span>
                    <input type="text" class="form-control" v-model="quotationNumber" placeholder="Generated On Save" />

                </div>
                <div class="form-group">
                    <label> <strong>Quotation Date: </strong> </label><span class="text-danger">*</span>
                    <input v-model="quotationDate" id="quotationDate" class="form-control" type="date" required/>
                </div>
               
            </div>
            <div class="col-sm-3">

                <div class="form-group">
                    <label> <strong>Currency: </strong> </label><span class="text-danger">*</span>
                    <input id="currencyId" v-model="currencyId" type="text" class="form-control" required/>
                </div>
                <div class="form-group">
                    <label> <strong> Currency Rate: </strong>  </label>
                    <input id="buyRate" v-model="buyRate" step="0.0001" min="0" type="number" class="form-control" />

                </div>

            </div>
            <div class="col-sm-3">

                <div class="form-group">
                    <label> <strong>Notes: </strong> </label>
                    <textarea v-model="notes" class="form-control" type="text"></textarea>
                </div>
                
            </div>

        </div>
        <hr />
        <p>Add Quotation Items</p>

        <div class="mt-3" id="dataTable2"></div>
        <div class="row mt-2">
            <div class="col"></div>
            <div class="col-sm-5 d-flex justify-content-end">
                <div class="form-check mb-3 mx-2">
                    <input 
                        type="checkbox" 
                        class="form-check-input" 
                        id="convertToInvoiceCheckbox" 
                        v-model="isConvertedToInvoice"
                        :disabled="isInvoiceQuotation"
                    >

                    <label class="form-check-label" for="convertToInvoiceCheckbox">
                        {{ isConvertedToInvoice ? 'Converted To Invoice' : 'Convert To Invoice' }}
                        <i class="fa fa-spinner fa-spin" v-if="isLoading"></i>
                    </label>
                </div>
                
                <button class="btn btn-amber mb-3" style="float: right" type="button" data-target="#addEdit" data-toggle="modal"> Save Quotation </button>
            </div>
            <div aria-hidden="true" aria-labelledby="exampleModalLabel" class="modal fade" id="addEdit" role="dialog" tabindex="-1">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel"> Confirm Action </h5>
                            <button aria-label="Close" class="close" data-dismiss="modal" type="button"><span aria-hidden="true"> &times;</span></button>
                        </div>
                        <div class="modal-body">

                            <p>Are You Sure You Want To Save/Update Quotation?</p>

                        </div>

                        <div class="modal-footer">

                            <button class="btn btn-danger" data-dismiss="modal" type="button"> Cancel </button>

                            <button class="btn btn-info" type="button" :disabled="isLoading" v-on:click="saveQuotation()">

                                Yes

                                <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>

                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div aria-hidden="true" aria-labelledby="exampleModalLabel1" class="modal fade" id="createInvoice" role="dialog" tabindex="-1">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel1"> Confirm Action </h5>
                            <button aria-label="Close" class="close" data-dismiss="modal" type="button"><span aria-hidden="true"> &times;</span></button>
                        </div>
                        <div class="modal-body">

                            <p>Are You Sure You Want To create invoice out of this quotation?</p>

                        </div>

                        <div class="modal-footer">

                            <button class="btn btn-danger" data-dismiss="modal" type="button"> Cancel </button>

                            <button class="btn btn-info" type="button" :disabled="isLoading" v-on:click="createInvoice()">

                                Yes

                                <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>

                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div> 
    </div>
    
    




</div>


</div>
</div>

</div>

</div>
</div>


</div>
</div>

</div>

<script src="~/js/ar/data-entry/quotations.js" asp-append-version="true"></script>

