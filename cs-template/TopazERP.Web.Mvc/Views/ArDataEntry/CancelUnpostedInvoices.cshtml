@{
ViewBag.Title = "Cancel Unposted Invoices";
Layout = "~/Views/Shared/Layout/_adminArLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Change Invoice Status</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/Ar" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#"> Ap Data Entry </a>
                            </li>
                            <li class="breadcrumb-item active">
                              Change Invoice Status - Cancel Invoice
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Cancel Invoices</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div class="content-i" id="app">
                                    <div class="content-box">
                                        <div class="element-wrapper">
                                            <h6 class="element-header"> Change Invoice Status - Cancel Invoice </h6>
                                            <div class="element-box">
                                                <div class="table-responsive" style="height:auto;width:auto;min-height:412px;">

                                                    <ul class="nav nav-tabs" id="myTab-three" role="tablist">
                                                        <li class="nav-item">
                                                            <a class="nav-link text-info active" id="home-tab-three" data-toggle="tab" href="#home-three" role="tab" aria-controls="home" aria-selected="true">Cancel Invoice</a>
                                                        </li>
                                                    </ul>
                                                    <div class="tab-content" id="myTabContent-4">
                                                        <div class="tab-pane fade show active" id="home-three" role="tabpanel" aria-labelledby="home-tab-three">
                                                            <div class="row mt-3">
                                                                <div class="col-md-2">
                                                                    <button type="button" v-on:click="clearForm" class="mt-2 btn btn-info">
                                                                        <i class="la la-refresh"></i> Reset Form
                                                                        <i class="fa fa-spinner fa-spin" v-if="isLoading"></i>
                                                                    </button>
                                                                </div>
                                                                <div class="col-md-2">
                                                                    <div class="form-group">
                                                                        <button type="button" style="float: left" class="mt-2 btn btn-danger" data-target="#addEdit" data-toggle="modal">
                                                                            Cancel Invoice
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                                <div class="col-sm-4">
                                                                    <label for="customerId" class="form-label"><strong>Search Customer:</strong></label><span class="text-danger">*</span>
                                                                    <div class="form-group">
                                                                        <input id="customerId" v-model="customerId" type="text" class="form-control"/>
                                                                    </div>

                                                                </div>
                                                            </div>

                                                            <hr />


                                                            <div id="dataTable"></div>
                                                            <div aria-hidden="true" aria-labelledby="exampleModalLabel" class="modal fade" id="addEdit" role="dialog" tabindex="-1">
                                                                <div class="modal-dialog" role="document">
                                                                    <div class="modal-content">
                                                                        <div class="modal-header">
                                                                            <h5 class="modal-title" id="exampleModalLabel"> Confirm Action </h5>
                                                                            <button aria-label="Close" class="close" data-dismiss="modal" type="button"><span aria-hidden="true"> &times;</span></button>
                                                                        </div>
                                                                        <div class="modal-body">

                                                                            <p>Are You Sure You Want To Cancel Invoice(s)</p>

                                                                        </div>

                                                                        <div class="modal-footer">

                                                                            <button class="btn btn-danger" data-dismiss="modal" type="button"> Cancel </button>

                                                                            <button class="btn btn-info" type="button" :disabled="isLoading" v-on:click="cancelInvoice()">

                                                                                Yes

                                                                                <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>

                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>


<script src="~/js/ar/data-entry/cancelUnPostedInvoices.js" asp-append-version="true"></script>