@{
ViewBag.Title = "Opening Balances";
Layout = "~/Views/Shared/Layout/_adminArLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
    .nav {
        font-size: 0.8rem;
    }
    .perPage {
        border: none;
        padding: 0.25rem 0.5rem;
        background-color: #f8f9fa;
    }
    .pign{
        border-bottom: 1px solid #e3e3e3;
        background-color: #f8f9fa;
    }
</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Opening Balances </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/Ar" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#"> Data Entry </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Opening Balances
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card b">
                        <div class="card-header">
                            <h4 class="card-title"> Opening Balance</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div id="openingBalanceApp">
  

            <!-- Controls -->
            <div class="d-flex justify-content-between align-items-center flex-wrap">

                <!-- Search -->
                 <div class="position-relative my-1" style="width:350px;">
                                                                            <input type="text"
                                                                                   class="form-control"
                                                                                   v-model="searchQuery"
                                                                                   placeholder="Search or select supplier..."
                                                                                   @@focus="showDropdown = true"
                                                                                   @@input="showDropdown = true"
                                                                                   @@blur="hideDropdown"
                                                                            >
                                                                            <!-- Dropdown -->
                                                                            <div v-show="showDropdown"
                                                                                 class="list-group position-absolute w-100"
                                                                                 style="z-index:1000; max-height:200px; overflow-y:auto;">
        
                                                                                <button class="list-group-item list-group-item-action"
                                                                                        v-for="b in balances"
                                                                                        :key="b.id"
                                                                                        @@click="selectFromDropdown(b.customerName)">
                                                                                    {{ b.customerName }} - {{ formatNumber(b.amount) }} {{ b.currencyCode }}
                                                                                </button>

                                                                                <div v-if="balances.length === 0" class="list-group-item text-muted">
                                                                                    No balances found
                                                                                </div>
                                                                            </div>
                                                                        </div>

                <!-- Buttons -->
                <div class="btn-group d-flex flex-wrap gap-2 my-1">
                    <a href="@Url.Action("CreateBalance","ArDataEntry")" class="btn btn-outline-success btn-sm">
                        <i class="la la-plus-circle"></i> Add Opening Balance
                    </a>
                    <a href="@Url.Action("PostBalance","ArDataEntry")" class="btn btn-outline-primary btn-sm">
                        <i class="la la-upload"></i> Post Balances
                    </a>
                </div>
            </div>

            <!-- Suppliers Table -->
            <div class="table-responsive">
                <table class="b table table-hover table-striped">
                    <thead class="bg-white text-black">
                        <tr>
                            <th></th>
                            <th>Customer</th>
                            <th># Balances</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                     
                        <template v-for="(items, customerId, index) in paginatedCustomers" :key="customerId">

                            <tr 
                                style="cursor:pointer;" 
                                @@click="toggleCustomer(customerId)"   
                                :class="[
                                        index % 2 === 0 ? 'bg-light-blue' : 'bg-white',
                                        expanded.includes(customerId) ? 'font-weight-bold text-info' : ''
                                        ]"
                            >
                                <td>
                                    <i :class="expanded.includes(customerId) ? 'la la-angle-down' : 'la la-angle-right'"></i>
                                </td>

                                <td><strong>{{ items[0].customerName }}</strong></td>
                                

                                <td>{{ items.length }}</td>

                                <td>
                                    <i class="la la-file-text text-info"
                                       style="cursor:pointer;font-size:1.2rem;"
                                       @@click.stop="printReport(customerId, status)"></i>
                                </td>
                            </tr>

                            <!-- Child Rows: Balances for this Supplier -->
                            <tr v-show="expanded.includes(customerId)">
                                <td colspan="5" class="p-0">
                                    <table class="table table-sm table-striped mb-0">
                                        <thead class="table-info">
                                            <tr>
                                                <th>Amount</th>
                                                <th>Currency</th>
                                                <th>Rate</th>
                                                <th>Date</th>
                                                <th>Posted</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            <tr v-for="b in items" :key="b.id">
                                                <td>{{ formatNumber(b.amount) }}</td>
                                                <td>{{ b.currencyCode }}</td>
                                                <td>{{ b.buyRate.toFixed(4) }}</td>
                                                <td>{{ new Date(b.transactionDate).toLocaleDateString() }}</td>

                                                <td>
                                                    <span v-if="b.isPosted" class="text-success">Yes</span>
                                                    <span v-else class="text-secondary">No</span>
                                                </td>

                                                <td>
                                                    <i  v-if="!b.isPosted"
                                                        class="la la-edit text-primary"
                                                        style="cursor:pointer;font-size:1.2rem;"
                                                        @@click.stop="editBalance(b.id)">
                                                    </i>
                                                    <i v-if="!b.isPosted"
                                                       class="la la-trash text-danger"
                                                       style="cursor:pointer;font-size:1.2rem;"
                                                       @@click.stop="deleteBalance(b.id)">
                                                    </i>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>

                        </template>

                        <tr v-if="Object.keys(groupedBalances).length === 0">
                            <td colspan="5" class="text-center text-muted">No records found</td>
                        </tr>

                    </tbody>
                </table>
            </div>

          <div class="d-flex justify-content-end align-items-center flex-wrap pign p-1">
              <div class="d-flex align-items-center mb-2 mb-md-0 nav mr-1">
                  <i class="la la-list text-info mr-2"></i>
                  <select v-model="perPage" class="perPage">
                      <option value="5">5 per page</option>
                      <option value="10">10 per page</option>
                      <option value="20">20 per page</option>
                      <option value="50">50 per page</option>
                      </select>
                  </div>
              <!-- Pagination -->
              <nav class="float-right nav">
                  <ul class="pagination justify-content-center">

                      <!-- Prev -->
                      <li class="page-item" :class="{ disabled: currentPage === 1 }">
                          <a class="page-link text-sm" href="#" @@click.prevent="currentPage--">Prev</a>
                          </li>

                      <!-- Pages -->
                      <li class="page-item"
                          v-for="(page, index) in paginationPages"
                          :key="index"
                          :class="{ active: currentPage === page, disabled: page === '...' }">

                          <a class="page-link text-sm"
                             href="#"
                             @@click.prevent="page !== '...' && (currentPage = page)">
                              {{ page }}
                              </a>
                          </li>

                      <!-- Next -->
                      <li class="page-item" :class="{ disabled: currentPage === totalPages }">
                          <a class="page-link text-sm" href="#" @@click.prevent="currentPage++">Next</a>
                          </li>

                      </ul>
                  </nav>
              </div>
            <!-- Delete Confirmation Modal -->
            <div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog">
                <div class="modal-dialog modal-sm" role="document">
                    <div class="modal-content">

                        <div class="modal-header bg-info text-white">
                            <h5 class="modal-title">{{ modalTitle }}</h5>
                            <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                        </div>

                        <div class="modal-body text-center">
                            <p>{{ modalMessage }}</p>
                        </div>

                        <div class="modal-footer">
                            <button class="btn btn-secondary" data-dismiss="modal">No</button>
                            <button class="btn btn-danger" @@click="confirmDelete">Yes</button>
                        </div>

                    </div>
                </div>
            </div>
        </div>
                        </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

 



<script src="~/js/ar/data-entry/opening-balances.js" asp-append-version="true"></script>