@{
    ViewBag.Title = "Reports | PaySlip";
    Layout = "~/Views/Shared/Layout/_adminPayrollLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> PaySlip </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#"> Historial Reports </a>
                            </li>
                            <li class="breadcrumb-item active">
                                PaySlip
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> PaySlip   </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">


                                    <div class="col-sm-3">

                                        <div class="form-group">
                                            <label> <strong> Select Report Type : </strong>  </label>
                                            <select class="form-control" v-model="payslipType" ref="payslipType">
                                                <option value="basic"> Basic </option>
                                                <option value="type-i"> Type I </option>
                                                <option value="type-ii"> Type II </option>
                                                <option value="type-iii"> Type III </option>

                                            </select>

                                        </div>

                                    </div>

                                    <div class="col-sm-2">

                                        <div class="form-group">
                                            <label> <strong> Month: </strong>  </label>

                                            <select class="form-control mb-3" v-model="month" v-on:change="getReportData()">
                                                <option value="1"> January </option>
                                                <option value="2"> February </option>
                                                <option value="3"> March </option>
                                                <option value="4"> April </option>
                                                <option value="5"> May </option>
                                                <option value="6"> June </option>
                                                <option value="7"> July </option>
                                                <option value="8"> August </option>
                                                <option value="9"> September </option>
                                                <option value="10"> October </option>
                                                <option value="11"> November </option>
                                                <option value="12"> December </option>
                                            </select>

                                        </div>

                                    </div>

                                    <div class="col-sm-2">

                                        <div class="form-group">
                                            <label> <strong> Year: </strong>  </label>
                                            <input type="number" class="form-control" v-model="year" placeholder="@DateTime.Now.Year">
                                        </div>

                                    </div>
                                    <div class="col-sm-3">

                                        <div class="form-group">

                                            <label> <strong> Select Employee: </strong>  </label>

                                            <input id="employeeId" v-model="employeeId" type="text" class="form-control" />

                                        </div>

                                    </div>

                                    <div class="col-sm-2 mt-1">

                                        <div class="form-group mt-1">

                                            <button type="button" class="alignright btn btn-primary" v-on:click="getReportData()"> Search </button>

                                        </div>

                                    </div>

                                </div>

                                <hr />

                                <div style="height:auto;width:auto;min-height:500px;" id="reportView">  </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>


<script src="~/js/payroll/historical-reports/payslip.js" asp-append-version="true"></script>