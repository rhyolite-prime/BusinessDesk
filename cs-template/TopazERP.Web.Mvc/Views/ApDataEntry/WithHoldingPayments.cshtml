@{
ViewBag.Title = "WithHolding Payments";
Layout = "~/Views/Shared/Layout/_adminApLayout.cshtml";
}

<div class="app-content content">
<div class="content-wrapper">
<div class="content-header row">
    <div class="content-header-left col-md-6 col-12 mb-2">
        <h3 class="content-header-title"> WithHolding Payments </h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="../Dashboard/Ap" class="text-info"><i class="la la-home"></i> Home</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a class="text-info" href="#"> Data Entry </a>
                    </li>
                    <li class="breadcrumb-item active">
                        WithHolding Payments
                    </li>
                </ol>
            </div>
        </div>
    </div>

</div>
<div class="content-body">
<!-- Basic Tables start -->
<div class="row">
<div class="col-12">
<div class="card">
<div class="card-header">
    <h4 class="card-title">WithHolding Payments</h4>
    <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
    <div class="heading-elements">
        <ul class="list-inline mb-0">
            <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
            <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
            <li><a data-action="close"><i class="ft-x"></i></a></li>
        </ul>
    </div>
</div>

<div class="card-content collapse show">

<div class="card-body" id="app">

<div class="content-i" id="app">
<div class="content-box">
<div class="element-wrapper">
<h6 class="element-header"> Payments Transactions</h6>
<div class="element-box">
<div class="table-responsive" style="height:auto;width:auto;min-height:412px;">

<ul class="nav nav-tabs" id="myTab-three" role="tablist">
    <li class="nav-item">
        <a class="nav-link text-info active" id="home-tab-three" data-toggle="tab" href="#home-three" role="tab" aria-controls="home" aria-selected="true">WithHolding Payments</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-info" id="profile-tab-four" data-toggle="tab" href="#profile-four" role="tab" aria-controls="profile" aria-selected="false">Post Transaction</a>
    </li>

</ul>

<div class="tab-content" id="myTabContent-4">
    <div class="tab-pane fade show active" id="home-three" role="tabpanel" aria-labelledby="home-tab-three">
   

   
        <!--search area -->
        <div class="row mt-3">

            <div class="col-sm-4">
                <button type="button" v-on:click="clearForm" class="mb-3 mt-3 btn btn-info">
                    <i class="la la-refresh"></i> Reset Form
                    <i class="fa fa-spinner fa-spin" v-if="isLoading"></i>
                </button>
            </div>
            <div class="col-sm-4 mb-3 mt-3">

                <div class="form-group">
                    <input id="withholdingId" v-model="withholdingId" type="text" class="form-control" />

                </div>

            </div>
            <div class="col-sm-4"></div>

        </div>
    
        <form ref="paymentForm" class="mb-5" >
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="supplierId" class="form-label"><strong>Supplier:</strong></label><span class="text-danger">*</span>
                        <div class="form-group">
                            <input id="supplierId" v-model="supplierId" type="text" class="form-control" />
                        </div>
                    </div>
                
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="accountNumber" class="form-label"><strong>Account No.:</strong></label>
                        <input type="text" class="form-control" id="accountNumber" v-model="accountNumber" disabled="disabled"  required>
                    </div>

                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label> <strong>Currency: </strong> </label><span class="text-danger">*</span>
                        <input id="currencyId" v-model="currencyId" type="text" class="form-control" required/>
                    </div>
                
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="amountToApply" class="form-label"><strong>Amount to Apply:</strong></label><span class="text-danger">*</span>
                        <input type="number" step="0.01" min="0" class="form-control" id="amountToApply" v-model="amountToApply" required>
                    </div>

                </div>
            </div>

            <div class="row">
           
           
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label" for="buyRate"><strong>Currency Rate:</strong></label>
                        <input type="number" class="form-control" id="buyRate" v-model="buyRate" required>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="paymentDate" class="form-label"><strong>Date of Payment:</strong> </label><span class="text-danger">*</span>
                        <input type="date" class="form-control" id="paymentDate" v-model="paymentDate" required>
                    </div>

                </div>
       
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label"><strong>Mode of Payment:</strong></label><br>
                        <div class="form-control">
                            <div class="form-check form-check-inline">
                                <input
                                    class="form-check-input"
                                    type="radio"
                                    id="cash"
                                    value="Cash"
                                    v-model="modeOfPayment"
                                    @@change="toggleCash"/>
                                <label class="form-check-label" for="cash">Cash</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input
                                    class="form-check-input"
                                    type="radio"
                                    id="cheque"
                                    value="Cheque"
                                    v-model="modeOfPayment"
                                    @@change="toggleCheque"/>
                                <label class="form-check-label" for="cheque">Cheque</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" v-if="cheque">
                        <label class="form-label" for="chequeNumber"><strong>chequeNumber:</strong></label>
                        <input type="text" class="form-control" id="chequeNumber" v-model="chequeNumber" required>
                    </div>

                </div>
                <div class="col-md-3">
                    <label class="form-label"><strong>Bank GL:</strong></label>
                    <input id="bankAccountId" v-model="bankAccountId" type="text" class="form-control" />

                </div>
          


            </div>
        

            <div class="row">
           
                <div class="col-md-3">
                    <label for="outstandingCreditMemo" class="form-label"><strong>Outstanding Credit Memo:</strong></label>
                    <input type="number" class="form-control" id="outstandingCreditMemo" v-model="outstandingCreditMemo" required>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="batchNumber" class="form-label"><strong>Batch Number</strong></label>
                        <input type="text" class="form-control" id="batchNumber" v-model="batchNumber" placeholder="2321" disabled>
                    </div>

                </div>
            </div>


       
        </form>
        <hr/>
        <div class="mt-5" id="dataTable"></div>
        <div class="row mt-3">
            <div class="col"></div>
            <div class="col">

                <button type="button" style="float: right" @@click="savePayment()" class="mb-3 btn btn-success">
                    Save Payment
                    <i class="fa fa-spinner fa-spin" v-if="isLoading"></i>

                </button>

            </div>

        </div>
    </div>
<div class="tab-pane fade mt-3" id="profile-four" role="tabpanel" aria-labelledby="profile-tab-four">
    <div class="row mt-3">
        <div class="col">

            <button type="button" style="float: left" data-target="#addEdit" data-toggle="modal" class="mb-3 btn btn-info">
                Post Payment
            </button>

        </div>

    </div>                                                   
    <div class="row justify-content-center">
        <div class="col-sm-8">
            <h5 class="card-title mb-2 text-center">Post WithHolding Payments</h5>
        </div>
    </div>
    <div id="dataTable2"></div>
    <div aria-hidden="true" aria-labelledby="exampleModalLabel" class="modal fade" id="addEdit" role="dialog" tabindex="-1">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel"> Confirm Action </h5>
                    <button aria-label="Close" class="close" data-dismiss="modal" type="button"><span aria-hidden="true"> &times;</span></button>
                </div>
                <div class="modal-body">

                    <p>Are You Sure You Want To Post Transaction(s)?</p>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-danger" data-dismiss="modal" type="button"> Cancel </button>

                    <button class="btn btn-info" type="button" :disabled="isLoading" v-on:click="postWithHolding()">

                        Yes

                        <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>

                    </button>
                </div>
            </div>
        </div>
    </div>


    <hr/>
    
   
        <hr/>
        
        


</div>

</div>
</div>

</div>

</div>
</div>


</div>
</div>

</div>
</div>

</div>
</div>
</div>
</div>
</div>

<script src="~/js/ap/DataEntry/withholdingPayments.js" asp-append-version="true"></script>

