@{
ViewBag.Title = "Edit Vouchers";
Layout = "~/Views/Shared/Layout/_adminApLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
</style>
<div class="app-content content">
<div class="content-wrapper">
<div class="content-header row">
    <div class="content-header-left col-md-6 col-12 mb-2">
        <h3 class="content-header-title">Edit Vouchers</h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="../Dashboard/Ap" class="text-info"><i class="la la-home"></i> Home</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a class="text-info" href="#"> Data Entry </a>
                    </li>
                    <li class="breadcrumb-item active">
                        Vouchers
                    </li>
                </ol>
            </div>
        </div>
    </div>

</div>
<div class="content-body">
    
    <!-- Basic Tables start -->
    <div class="row">
        <div class="col-12">
            <div class="card b">
                <div class="card-header">
                    <h4 class="card-title">Edit Vouchers</h4>
                    <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                    <div class="heading-elements">
                        <ul class="list-inline mb-0">
                            <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
                            <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                            <li><a data-action="close"><i class="ft-x"></i></a></li>
                        </ul>
                    </div>
                </div>

                <div class="card-content collapse show">

                    <div class="card-body" id="app">
                                            <div class="row">
                                                <div class="col-sm-10 ">
                                                    
                                                </div>
                                                <div class="col-sm-2  float-right" v-if="voucherId">
                                                    <a @@click="printReport" class="btn btn-info text-white"> <i class="la la-print"></i> Print PV </a>
                                                </div>
                                            </div>
                                            <div>

                                                <!-- form area -->
                                                <form ref="voucherForm" v-on:submit.prevent="validateAndSaveVoucher()">
                                                    <div class=" row">
                                                        <div class="col mb-1">
                                                            <div class="form-group">
                                                                <p class="form-control-plaintext"><strong>File Ref:</strong> {{ referenceNumber }}</p>
                                                            </div>
                                                            <div id="invoiceDataTable"></div>

                                                        </div>

                                                    </div>
                                                    <div class=" row">
                                                        <div class="col-12">
                                                            <div class="form-group">
                                                                <label class="h4 mt-2"><strong>Tax Levies: </strong></label>
                                                            </div>
                                                            <!-- Checkboxes as buttons -->
                                                            <div class="form-group">
                                                                <div class="row g-2">
                                                                    <!-- Tax Levy Buttons -->
                                                                    <div v-for="tax in taxLevyList" :key="tax.id" class="col-12 col-sm-3 col-md-6 col-lg-3 mb-2">
                                                                        <label class="form-label"> <strong> {{ tax.name }} </strong></label>
                                                                        <button
                                                                            :class="['btn w-100', tax.isApplied ? 'btn-success' : 'form-control']"
                                                                            :disabled="tax.isDisabled"
                                                                            @@click.prevent="toggleTaxLevy(tax.id)">
                                                                            ({{ tax.rate }}%) <span v-if="tax.amount">- {{ tax.amount }}</span>
                                                                        </button>


                                                                    </div>

                                                                    <!-- VAT Input -->
                                                                    <div class="col-12 col-sm-3 col-md-6 col-lg-3 mb-2">
                                                                        <label class="form-label"><strong>Vat Rate:</strong></label>
                                                                        <input type="number" v-model="VatRate" @@input="userIsEditingRate = true" class="form-control" placeholder="VAT Rate" :disabled="!vatInInvoice"/>
                                                                    </div>
                                                                    <div class="col-sm-3">
                                                                        <div class="form-group">
                                                                            <label for="vatAmount" class="form-label"><strong>Vat Amount:</strong></label>
                                                                            <input type="number" step="0.01" min="0" class="form-control" id="vatAmount" v-model="vatAmount" disabled="disabled">
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-sm-3">
                                                                        <div class="form-group">
                                                                            <label for="totalTaxAmount" class="form-label"><strong>Total Tax Amount:</strong></label>
                                                                            <input type="number" step="0.01" min="0" class="form-control" id="totalTaxAmount" v-model="totalTaxAmount" disabled="disabled">
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </div>
                                                    <div>
                                                        <fieldset class=" mt-4">
                                                            <legend class="w-auto text-info">Payment Details</legend>
                                                            <div class="row">
                                                                <div class="col-sm-3">
                                                                    <div class="form-group">
                                                                        <label for="voucherEntryDate" class="form-label"><strong>Voucher Entry Date:</strong></label>
                                                                        <input type="date" class="form-control" id="voucherEntryDate" v-model="voucherEntryDate">
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label class="form-label" for="voucherDescription"><strong>Description:</strong></label><span class="text-danger">*</span>
                                                                        <input type="text" class="form-control" id="voucherDescription" v-model="voucherDescription" required>
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label for="voucherNumber" class="form-label"><strong>Voucher No.:</strong></label><span class="text-danger">*</span>
                                                                        <input type="text" class="form-control" id="voucherNumber" v-model="voucherNumber" placeholder="Generated On Save">
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label> <strong>Bank G/L: </strong> </label>
                                                                        <input type="text" name="bankGlAccountId" id="bankAccountId" v-model="bankAccountId" class="form-control" placeholder="Bank G/L Account">

                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label> <strong>Bank: </strong> </label>
                                                                        <input id="bankId" v-model="bankId" type="text" class="form-control"/>
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label> <strong> Bank Branch: </strong> </label>
                                                                        <input id="branchId" v-model="bankBranchId" type="text" class="form-control"/>
                                                                    </div>

                                                                </div>
                                                                <div class="col-sm-3">
                                                                    <div class="form-group">
                                                                        <label class="form-label"><strong>Mode of Payment:</strong></label><br>
                                                                        <div class="form-control">
                                                                            <div class="form-check form-check-inline">
                                                                                <input
                                                                                    class="form-check-input"
                                                                                    type="radio"
                                                                                    id="cash"
                                                                                    value="Cash"
                                                                                    v-model="modeOfPayment"
                                                                                    @@change="toggleCash"/>
                                                                                <label class="form-check-label" for="cash">Cash</label>
                                                                            </div>
                                                                            <div class="form-check form-check-inline">
                                                                                <input
                                                                                    class="form-check-input"
                                                                                    type="radio"
                                                                                    id="cheque"
                                                                                    value="Cheque"
                                                                                    v-model="modeOfPayment"
                                                                                    @@change="toggleCheque"/>
                                                                                <label class="form-check-label" for="cheque">Cheque</label>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label class="form-label" for="chequeNumber"><strong>chequeNumber:</strong></label>
                                                                        <input type="text" class="form-control" id="chequeNumber" v-model="chequeNumber" :disabled="!cheque" :required="cheque">
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label> <strong>Currency: </strong> </label><span class="text-danger">*</span>
                                                                        <input id="payCurrencyId" v-model="payCurrencyId" type="text" class="form-control" required/>
                                                                    </div>
                                                                    <div class="form-group" v-if="payCurrencyId">
                                                                        <label for="payCurrencyBuyRate" class="form-label"><strong>Currency Rate:</strong></label>
                                                                        <input type="number" class="form-control" id="payCurrencyBuyRate" v-model="payCurrencyBuyRate">
                                                                    </div>
                                                                    <div class="form-group mx-2 my-3">
                                                                        <input class="form-check-input" type="checkbox" id="isMulticurrency" v-model="isMultiCurrency" disabled/>
                                                                        <label class="form-label" for="isMulticurrency">Is MultiCurrency</label>
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label for="paymentDate" class="form-label"><strong>Payment Date:</strong></label><span class="text-danger">*</span>
                                                                        <input type="date" class="form-control" id="paymentDate" v-model="paymentDate" required>
                                                                    </div>



                                                                </div>
                                                                <div class="col-sm-3">
                                                                    <div class="form-group mx-2">
                                                                        <input type="checkbox" v-model="isWithHolding" class="form-check-input ">
                                                                        <label class="form-check-label mx-2">
                                                                            <strong>WithHolding</strong>
                                                                        </label>
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label for="withHoldingRate" class="form-label"><strong>Rate (%)</strong></label>
                                                                        <input type="number" step="0.01" min="0" class="form-control" id="withHoldingRate" v-model="withHoldingRate">
                                                                    </div>
                                                                    <div class="form-group mx-2">
                                                                        <input type="checkbox" v-model="isVatWithHolding" class="form-check-input ">
                                                                        <label class="form-check-label mx-2">
                                                                            <strong>Vat WithHolding (%)</strong>
                                                                        </label>
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <input type="number" step="0.01" min="0" class="form-control" id="VatWithHeldRate" v-model="VatWithHeldRate">
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label><strong>Credit/WithHolding G/L:</strong></label>
                                                                        <input type="text" name="creditAccountId" id="creditAccountId" class="form-control" placeholder="Credit G/L Account">
                                                                    </div>

                                                                    <div class="form-group" v-if="vatInInvoice || isVatInclusive">
                                                                        <label> <strong>Vat/WithHold G/L: </strong> </label>
                                                                        <input type="text" name="vatWithHoldAccountId" id="vatWithHoldAccountId" v-model="vatWithHoldAccountId" class="form-control" placeholder="Vat/WithHold G/L Account">
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label for="paymentAmount" class="form-label"><strong>Payment Amount:</strong></label><span class="text-danger">*</span>
                                                                        <input type="number" step="0.01" min="0" class="form-control" id="paymentAmount" v-model="paymentAmount" required>
                                                                    </div>

                                                                </div>
                                                                <div class="col-sm-3">
                                                                    <div class="form-group">
                                                                        <label for="total" class="form-label"><strong>Total:</strong></label>
                                                                        <input type="number" step="0.01" min="0" class="form-control" id="total" v-model="total" disabled="disabled">
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label for="withHeld" class="form-label"><strong>WithHeld:</strong></label>
                                                                        <input type="number" step="0.01" min="0" class="form-control" id="withHeld" v-model="withHeld" disabled="disabled">
                                                                    </div>

                                                                    <div class="form-group">
                                                                        <label for="vatWithheld" class="form-label"><strong>Vat WithHeld:</strong></label>
                                                                        <input type="number" step="0.01" min="0" class="form-control" id="vatWithheld" v-model="vatWithheld" disabled="disabled">
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label for="netAmount" class="form-label"><strong>Net Amount:</strong></label>
                                                                        <input type="number" step="0.01" min="0" class="form-control" id="netAmount" v-model="netAmount" disabled="disabled">
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label> <strong> Batch No#: </strong> </label>
                                                                        <input type="text" class="form-control" v-model="batchNumber" ref="batchNumber" placeholder="Batch No#" disabled="">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </fieldset>
                                                    </div>

                                                    <hr/>
                                                    <div class="row justify-content-end">
                                                        <div class="col-sm-2">
                                                            <!-- Submit Button -->
                                                            <div>
                                                                <button type="submit" class="btn btn-success btn-block">Update Voucher
                                                                    <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                                                                </button>
                                                            </div>

                                                        </div>

                                                    </div>
                                                </form>

                                            </div>
                                            <hr/>

                                        </div>




                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>


                </div>
            </div>

@if (TempData["Message"] != null)
{
    <script>
        $(function () {
            swal("Warning!", "@TempData["Message"]", "warning").then(function () {
                window.location.href = '@Url.Action("VoucherAction", "ApDataEntry")'; 
            });
        });
    </script>
}

<script>
    window.voucherId = @Html.Raw(Json.Serialize(ViewBag.VoucherId ?? ""));
</script>
<script src="~/js/ap/DataEntry/editVouchers.js" asp-append-version="true"></script>