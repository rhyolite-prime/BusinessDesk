@{
ViewBag.Title = "Invoices";
Layout = "~/Views/Shared/Layout/_adminApLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
    .bg-light-blue {
        background-color: #d2e5fa; 
    }
    .nav {
        font-size: 0.8rem;
    }
    .perPage {
        border: none;
        padding: 0.25rem 0.5rem;
        background-color: #f8f9fa;
    }
    .pign{
        border-bottom: 1px solid #e3e3e3;
        background-color: #f8f9fa;
    }
    .loader-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.65);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10000;
    }
    .loader-text {
        margin-top: 10px;
        color: #fff4f4;
    }
</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-1">
                <h3 class="font-weight-bold">Invoices</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Invoices","ApDataEntry")" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#"> Data Entry </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Invoices
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card b">
                        <div class="card-header">
                            <h4 class="card-title"> Invoices</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="card-content collapse show">

                            <div class="card-body" id="app">
                                
                                <div id="invoiceApp" class="">
                                    <div v-if="isLoading" class="loader-overlay">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="sr-only">Processing...</span>
                                        </div>
                                        <div class="loader-text">
                                            <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                                            Processing...
                                        </div>
                                    </div>
                                    <div class="card">
                                        <div class="">

                                            <!-- Controls -->
                                            <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap">

                                                <div class="position-relative mb-1" style="width:350px;">

                                                </div>


                                                <!-- Responsive Button Group -->
                                                <div class="btn-group d-flex flex-wrap gap-2 mb-1" role="group">
                                                    <a href="@Url.Action("AddInvoice", "ApDataEntry")" class="btn btn-outline-success flex-fill btn-sm">
                                                        <i class="la la-plus-circle"></i> Add Invoice
                                                    </a>

                                                    <a href="@Url.Action("PostInvoice", "ApDataEntry")" class="btn btn-outline-primary flex-fill btn-sm">
                                                        <i class="la la-upload"></i> Post Invoices
                                                    </a>
                                                </div>

                                            </div>

                                            <!-- TABLE -->
                                            <div class="table-responsive ">
                                                <span class="my-1">{{ selectedInvoices.length }} selected</span>
                                                <div class="bg-light p-1 flex-wrap d-flex justify-content-between align-items-center ">
                                                    <div v-if="selectedInvoices.length > 0" class="bulk-actions">
                                                        <button class="btn btn-light btn-sm mr-1" @@click="approveSelected"> <i class="la la-check-circle " title="Approve Invoices"></i></button>
                                                        <button class="btn btn-light btn-sm mr-1" @@click="printSelected"> <i class="la la-print " title="Print Invoices"></i></button>
                                                        <button class="btn btn-light btn-sm mr-1" @@click="cancelSelected"> <i class="la la-ban " title="Cancel Invoices"></i></button>
                                                    </div>
                                                    <div class="position-relative" style="width:350px;">
                                                        <input type="text"
                                                               class="form-control"
                                                               v-model="searchQuery"
                                                               placeholder="Search or select invoice..."
                                                               @@focus="showDropdown = true"
                                                               @@input="showDropdown = true"
                                                               @@blur="hideDropdown">
                                                        <!-- Dropdown -->
                                                        <div v-show="showDropdown"
                                                             class="list-group position-absolute w-100"
                                                             style="z-index:1000; max-height:200px; overflow-y:auto;">

                                                            <button class="list-group-item list-group-item-action"
                                                                    v-for="inv in invoices"
                                                                    :key="inv.id"
                                                                    @@click="selectFromDropdown(inv.invoiceNumber)">
                                                                {{ inv.invoiceNumber }} — {{ inv.supplierName }}
                                                            </button>

                                                            <div v-if="invoices.length === 0" class="list-group-item text-muted">
                                                                No invoices
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <table class="table table-hover table-striped b">
                                                    <thead class="bg-white text-black">
                                                    <tr>
                                                        <th><input type="checkbox" v-model="selectAll" @@change="toggleSelectAll"></th>
                                                        <th class="cursor-pointer" @@click="sort('invoiceNumber')">Invoice #</th>
                                                        <th class="cursor-pointer" @@click="sort('supplierName')">Supplier</th>
                                                        <th class="cursor-pointer" @@click="sort('invoiceDate')">Invoice Date</th>
                                                        <th class="cursor-pointer" @@click="sort('currencyCode')">Currency</th>
                                                        <th class="cursor-pointer" @@click="sort('balance')">Balance</th>
                                                        <th class="cursor-pointer" @@click="sort('isPosted')">Posted ?</th>

                                                        <th>Actions</th>
                                                    </tr>
                                                    </thead>

                                                      <tbody>

                                                <template v-for="(yearInvoices, year) in groupedInvoices" :key="year">

                                             <!-- YEAR HEADER -->
                                            <tr class="table-light"
                                                    style="cursor:pointer"
                                                        @@click="toggleYear(year)">

                                            <td colspan="8">

                                        <strong>
                                        <i :class="expandedYears.includes(year)
                                                    ? 'la la-angle-down'
                                                    : 'la la-angle-right'"></i>

                                        {{ year }}
                                        </strong>

                                        <span class="badge badge-dark ml-2">{{ yearInvoices.length }}</span>
                                    </td>
                                 </tr>

   
                                <template v-if="expandedYears.includes(year)">
                        
                                    <template
                                        v-for="(inv, index) in yearInvoices"
                                        :key="inv.id">
                        
                                        <!-- Parent Row -->
                                        <tr
                                            :class="[
                                                inv.isCanceled ? 'table-danger' : '',
                                                index % 2 === 0 ? 'bg-light-blue' : 'bg-white',
                                                expanded.includes(inv.id)
                                                    ? 'font-weight-bold text-info'
                                                    : ''
                                            ]"
                                            style="cursor:pointer;"
                                            @@click="toggleInvoice(inv.id)">
                        
                                            <td>
                                                <input type="checkbox"
                                                       :value="inv.id"
                                                       v-model="selectedInvoices"
                                                       @@click.stop>
                                            </td>
                        
                                            <td>
                                                <strong>
                                                    <i :class="expanded.includes(inv.id)
                                                        ? 'la la-angle-down'
                                                        : 'la la-angle-right'"></i>
                                                </strong>
                        
                                                {{ inv.invoiceNumber }}
                                            </td>
                        
                                            <td>{{ inv.supplierName }}</td>
                                            <td>{{ new Date(inv.invoiceDate).toLocaleDateString() }}</td>
                                            <td>{{ inv.currencyCode }}</td>
                                            <td>{{ formatNumber(inv.balance) }}</td>
                        
                                            <td>
                                                <span v-if="inv.isPosted"
                                                      class="text-success text-sm">
                                                    Yes
                                                </span>
                        
                                                <span v-else
                                                      class="text-secondary text-sm">
                                                    No
                                                </span>
                                            </td>
                        
                                            <td class="text-left">
                                                <i class="la la-edit text-primary"
                                                   title="Edit Invoice"
                                                   style="cursor:pointer;font-size:1.2rem;"
                                                   @@click.stop="editInvoice(inv.id)">
                                                </i>
                                                <i v-if="!inv.isApproved"
                                                   class="la la-check-circle text-success"
                                                   title="Approve Invoice"
                                                   style="cursor:pointer;font-size:1.2rem;"
                                                   @@click.stop="approveSingle(inv.id)">
                                                </i>
                        
                                                <i class="la la-file-text text-info"
                                                   title="View Report"
                                                   style="cursor:pointer;font-size:1.2rem;"
                                                   @@click.stop="printReport(inv.id)">
                                                </i>
                        
                                            </td>
                                        </tr>
                        
                                        <!-- CHILD DETAILS -->
                                        <tr v-show="expanded.includes(inv.id)">
                                            <td colspan="8" class="p-0">
                        
                                                <table class="table table-sm table-striped mb-0">
                        
                                                    <thead class="table-info">
                                                        <tr>
                                                            <th>Ref #</th>
                                                            <th>Description</th>
                                                            <th>Qty</th>
                                                            <th>Unit Price</th>
                                                            <th>Disc. Amount</th>
                                                            <th>Sub Total</th>
                                                            <th>Debit Account</th>
                                                        </tr>
                                                    </thead>
                        
                                                    <tbody>
                        
                                                        <tr v-for="d in inv.invoiceDetails" :key="d.id">
                        
                                                            <td>{{ d.referenceNumber }}</td>
                                                            <td>{{ d.description }}</td>
                                                            <td>{{ d.quantity }}</td>
                                                            <td>{{ formatNumber(d.unitPrice) }}</td>
                                                            <td>{{ formatNumber(d.amount) }}</td>
                                                            <td>{{ formatNumber(d.subTotal) }}</td>
                                                            <td>{{ d.debitAccountName }}</td>
                        
                                                        </tr>
                        
                                                    </tbody>
                        
                                                </table>
                        
                                            </td>
                                        </tr>
                        
                                    </template>
                        
                                </template>

                                    </template>

                                    <tr v-if="Object.keys(groupedInvoices).length === 0">
                                        <td colspan="8" class="text-center text-muted">
                                            No records found
                                        </td>
                                    </tr>

                                    </tbody>
                                                </table>
                                            </div>
                                            <div class="d-flex justify-content-end align-items-center flex-wrap pign p-1">
                                                <div class="d-flex align-items-center mb-2 mb-md-0 nav mr-1">
                                                    <i class="la la-list text-info mr-2"></i>
                                                    <select v-model="perPage" class="perPage">
                                                        <option value="5">5 per page</option>
                                                        <option value="10">10 per page</option>
                                                        <option value="20">20 per page</option>
                                                        <option value="50">50 per page</option>
                                                    </select>
                                                </div>
                                                <!-- Pagination -->
                                                <nav class="float-right nav">
                                                    <ul class="pagination justify-content-center">

                                                        <!-- Prev -->
                                                        <li class="page-item" :class="{ disabled: currentPage === 1 }">
                                                            <a class="page-link text-sm" href="#" @@click.prevent="currentPage--">Prev</a>
                                                        </li>

                                                        <!-- Pages -->
                                                        <li class="page-item"
                                                            v-for="(page, index) in paginationPages"
                                                            :key="index"
                                                            :class="{ active: currentPage === page, disabled: page === '...' }">

                                                            <a class="page-link text-sm"
                                                               href="#"
                                                               @@click.prevent="page !== '...' && (currentPage = page)">
                                                                {{ page }}
                                                            </a>
                                                        </li>

                                                        <!-- Next -->
                                                        <li class="page-item" :class="{ disabled: currentPage === totalPages }">
                                                            <a class="page-link text-sm" href="#" @@click.prevent="currentPage++">Next</a>
                                                        </li>

                                                    </ul>
                                                </nav>
                                            </div>
                                         


                                        </div>
                                    </div>
                                    <!-- Global Invoice Confirmation Modal -->
                                    <div class="modal fade" id="confirmModal" tabindex="-1" role="dialog">
                                        <div class="modal-dialog modal-sm" role="document">
                                            <div class="modal-content">

                                                <div class="modal-header bg-info text-white">
                                                    <h5 class="modal-title">{{ modalTitle }}</h5>
                                                    <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                                                </div>

                                                <div class="modal-body text-center">
                                                    <p>{{ modalMessage }}</p>
                                                </div>

                                                <div class="modal-footer">
                                                    <button class="btn btn-secondary" data-dismiss="modal">No</button>
                                                    <button class="btn btn-danger" @@click="confirmAction">Yes</button>
                                                </div>

                                            </div>
                                        </div>
                                    </div>

                                </div>

    
    




                                                    </div>


                                                </div>
                                            </div>

                                        </div>

                                    </div>
                                </div>


                            </div>
                        </div>
<script src="~/js/ap/DataEntry/invoices.js" asp-append-version="true"></script>
@*<script src="~/js/components/Searchbar.js"></script>*@

