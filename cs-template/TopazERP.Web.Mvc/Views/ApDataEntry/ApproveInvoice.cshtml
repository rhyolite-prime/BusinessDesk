@{
ViewBag.Title = "Approve Invoices";
Layout = "~/Views/Shared/Layout/_adminApLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Approve Invoices</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/Ap" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#"> Ap Data Entry </a>
                            </li>
                            <li class="breadcrumb-item active">
                               Approve Invoices
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card b">
                        <div class="card-header">
                            <h4 class="card-title">Approve Invoices</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <button type="button" style="float: right" class=" mx-1 btn btn-info btn-sm" data-target="#addEdit" data-toggle="modal">
                                                Approve Invoice(s)
                                            </button>
                                        </div>
                                        </div>

                                </div>
                               
                                <hr />
                             

                                <div id="dataTable"></div>
                                <div aria-hidden="true" aria-labelledby="exampleModalLabel" class="modal fade" id="addEdit" role="dialog" tabindex="-1">
                                    <div class="modal-dialog" role="document">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="exampleModalLabel"> Confirm Action </h5>
                                                <button aria-label="Close" class="close" data-dismiss="modal" type="button"><span aria-hidden="true"> &times;</span></button>
                                            </div>
                                            <div class="modal-body">

                                                <p>Are You Sure You Want To Approve Invoice(s)</p>

                                            </div>

                                            <div class="modal-footer">

                                                <button class="btn btn-danger" data-dismiss="modal" type="button"> Cancel </button>

                                                <button class="btn btn-info" type="button" :disabled="isLoading" v-on:click=" ApproveInvoice()">

                                                    Yes

                                                    <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>

                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>


<script src="~/js/ap/DataEntry/approveInvoices.js" asp-append-version="true"></script>