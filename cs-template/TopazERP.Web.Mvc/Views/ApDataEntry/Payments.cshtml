@{
ViewBag.Title = "Payments";
Layout = "~/Views/Shared/Layout/_adminApLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
</style>
<div class="app-content content">
<div class="content-wrapper">
<div class="content-header row">
    <div class="content-header-left col-md-6 col-12 mb-2">
        <h3 class="content-header-title"> Payments </h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="../Dashboard/Ap" class="text-info"><i class="la la-home"></i> Home</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a class="text-info" href="#"> Data Entry </a>
                    </li>
                    <li class="breadcrumb-item active">
                        Payments
                    </li>
                </ol>
            </div>
        </div>
    </div>

</div>
<div class="content-body">
<!-- Basic Tables start -->
<div class="row">
<div class="col-12">
<div class="card b">
<div class="card-header">
    <h4 class="card-title">Payments</h4>
    <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
    <div class="heading-elements">
        <ul class="list-inline mb-0">
            <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
            <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
            <li><a data-action="close"><i class="ft-x"></i></a></li>
        </ul>
    </div>
</div>

<div class="card-content collapse show">

<div class="card-body" id="app">
    
        <!--search area -->
        <div class="row ">
            <div class="col-sm-4 d-flex">
                <button type="button" v-on:click="clearForm" class="mr-2 mb-1 btn btn-info btn-sm">
                    <i class="la la-refresh"></i> Reset Form
                    <i class="fa fa-spinner fa-spin" v-if="isLoading"></i>
                </button>
            </div>

            <div class="col-sm-4">

                @*<div class="form-group">
                    <input id="paymentId" v-model="paymentId" type="text" class="form-control" />

                </div>*@

            </div>
            <div class="col-sm-4  text-right" v-if="paymentId">
                <a @@click="printReport" class="btn btn-info text-white btn-sm"> <i class="la la-print"></i> Print </a>
            </div>

        </div>
    
        <form ref="paymentForm" class="" >
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="supplierId" class="form-label"><strong>Supplier:</strong></label><span class="text-danger">*</span>
                        <div class="form-group">
                            <input id="supplierId" v-model="supplierId" type="text" class="form-control" />
                        </div>
                    </div>
                
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="accountNumber" class="form-label"><strong>Account No.:</strong></label>
                        <input type="text" class="form-control" id="accountNumber" v-model="accountNumber" disabled="disabled"  required>
                    </div>

                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="paymentDate" class="form-label"><strong>Date of Payment:</strong> </label><span class="text-danger">*</span>
                        <input type="date" class="form-control" id="paymentDate" v-model="paymentDate" required>
                    </div>

                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="batchNumber" class="form-label"><strong>Batch Number</strong></label>
                        <input type="text" class="form-control" id="batchNumber" v-model="batchNumber" placeholder="2321" disabled>
                    </div>

                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="invoiceTypeId" class="form-label"><strong>Invoice Type</strong></label><span class="text-danger">*</span>
                        <input id="invoiceTypeId" v-model="invoiceTypeId" type="text" class="form-control" placeholder="select invoice type" required/>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="invoiceRate" class="form-label"><strong>Rate</strong></label>
                        <input id="invoiceRate" v-model="invoiceRate" type="number" class="form-control" readonly/>
                    </div>
                </div>
           
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="amountToPay" class="form-label"><strong>Amount to Pay:</strong></label><span class="text-danger">*</span>
                        <input type="number" class="form-control" id="amountToPay" v-model="amountToPay" required>
                    </div>

                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label> <strong>Pay Currency: </strong> </label><span class="text-danger">*</span>
                        <input id="currencyId" v-model="currencyId" type="text" class="form-control" required/>

                    </div>

                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label" for="buyRate"><strong>Pay Currency Rate:</strong></label>
                        <input type="number" class="form-control" id="buyRate" v-model="buyRate" required>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label"><strong>Apply Payment:</strong></label><br>
                    <div class="form-control">
                        <div class="form-check form-check-inline">
                            <input
                                class="form-check-input"
                                type="radio"
                                id="automatic"
                                value="true"
                                v-model="isAutomatic"
                                @@change="toggleIsAutomatic"/>
                            <label class="form-check-label" for="automatic">
                                Automatic
                            </label>
                       
                        </div>
                        <div class="form-check form-check-inline">
                            <input
                                class="form-check-input"
                                type="radio"
                                id="manual"
                                value="false"
                                v-model="isAutomatic"
                                @@change="toggleManual"/>
                            <label class="form-check-label" for="manual">
                                Manual
                            </label>
                        </div>
                    </div>


                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label"><strong>Mode of Payment:</strong></label><br>
                        <div class="form-control">
                            <div class="form-check form-check-inline">
                                <input
                                    class="form-check-input"
                                    type="radio"
                                    id="cash"
                                    value="Cash"
                                    v-model="modeOfPayment"
                                    @@change="toggleCash"/>
                                <label class="form-check-label" for="cash">Cash</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input
                                    class="form-check-input"
                                    type="radio"
                                    id="cheque"
                                    value="Cheque"
                                    v-model="modeOfPayment"
                                    @@change="toggleCheque"/>
                                <label class="form-check-label" for="cheque">Cheque</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3" v-if="cheque">
                    <div class="form-group" >
                        <label class="form-label" for="chequeNumber"><strong>chequeNumber:</strong></label>
                        <input type="text" class="form-control" id="chequeNumber" v-model="chequeNumber" required>
                    </div>
                </div>
                <div class="col-md-3" v-if="isOu">
                    <label for="ouId" class="form-label"><strong>Organizational Unit:</strong></label><span class="text-danger">*</span>
                    <input id="ouId" v-model="ouId" type="text" class="form-control" required/>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <label> <strong>Bank: </strong> </label>
                        <input id="bankId" v-model="bankId" type="text" class="form-control"/>
                    </div>

                </div>

                <div class="col-sm-3">
                    <div class="form-group">
                        <label> <strong> Bank Branch: </strong> </label>
                        <input id="branchId" v-model="bankBranchId" type="text" class="form-control" placeholder="bank branch"/>

                    </div>
                </div>
                <div class="col-md-3">
                    <label for="refNumber" class="form-label"><strong>Ref Number:</strong></label>
                    <input type="text" class="form-control" id="refNumber" v-model="referenceNumber" required>
                </div>
                <div class="col-md-3">
                    <label for="outstandingCreditMemo" class="form-label"><strong>Outstanding Credit Memo:</strong></label>
                    <input type="text" class="form-control" id="outstandingCreditMemo" v-model="outstandingCreditMemo" required disabled="disabled">
                </div>
                <div class="col-md-3">
                    <label class="form-label"><strong>Bank GL:</strong></label>
                    <input id="bankAccountId" v-model="bankAccountId" type="text" class="form-control" required/>
                </div>
            
        
                <div class="form-group m-3">
                    <input class="form-check-input" type="checkbox" id="isMulticurrency" v-model="isMultiCurrency" disabled/>
                    <label class="form-label" for="isMulticurrency">Is MultiCurrency</label>
                </div>
            </div>
        
        </form>
        <hr/>
        <button v-if="isAutomatic" type="button" @@click="ApplyPayment" class="mt-2 btn btn-secondary btn-sm">
            Apply Payment
        </button>
        <div class="mt-5" id="dataTable"></div>
        <div class="row mt-2">
            <div class="col"></div>
            <div class="col">

                <button type="button" style="float: right" @@click="savePayment()" class="mb-2 btn btn-success btn-sm">
                    Save Payment
                    <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>

                </button>

            </div>

        </div>
    </div>
    

</div>

</div>
</div>


</div>
</div>

</div>
</div>

<script src="~/js/ap/DataEntry/payments.js" asp-append-version="true"></script>


