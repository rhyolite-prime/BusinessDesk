@{
ViewBag.Title = "Cancel Invoice";
Layout = "~/Views/Shared/Layout/_adminApLayout.cshtml";
}

<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Change Invoice Status</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/Ap" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#"> Ap Data Entry </a>
                            </li>
                            <li class="breadcrumb-item active">
                              Change Invoice Status - Cancel Invoice
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card b">
                        <div class="card-header">
                            <h4 class="card-title">Cancel Invoices</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                                            <div class="row">
                                                                <div class="col-md-2">
                                                                    <button type="button" v-on:click="clearForm" class="mt-2 btn btn-info btn-sm">
                                                                        <i class="la la-refresh"></i> Reset Form
                                                                        <i class="fa fa-spinner fa-spin" v-if="isLoading"></i>
                                                                    </button>
                                                                </div>
                                                                <div class="col-md-2">
                                                                    <div class="form-group">
                                                                        <button type="button" style="float: left" class="mt-2 btn btn-danger btn-sm" data-target="#addEdit" data-toggle="modal">
                                                                            Cancel Invoice
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                                <div class="col-sm-4">
                                                                    <label for="supplierId" class="form-label"><strong>Search Supplier:</strong></label><span class="text-danger">*</span>
                                                                    <div class="form-group">
                                                                        <input id="supplierId" v-model="supplierId" type="text" class="form-control"/>
                                                                    </div>

                                                                </div>
                                                            </div>

                                                            <hr />


                                                            <div id="dataTable"></div>
                                                            <div aria-hidden="true" aria-labelledby="exampleModalLabel" class="modal fade" id="addEdit" role="dialog" tabindex="-1">
                                                                <div class="modal-dialog" role="document">
                                                                    <div class="modal-content">
                                                                        <div class="modal-header">
                                                                            <h5 class="modal-title" id="exampleModalLabel"> Confirm Action </h5>
                                                                            <button aria-label="Close" class="close" data-dismiss="modal" type="button"><span aria-hidden="true"> &times;</span></button>
                                                                        </div>
                                                                        <div class="modal-body">

                                                                            <p>Are You Sure You Want To Cancel Invoice(s)</p>

                                                                        </div>

                                                                        <div class="modal-footer">

                                                                            <button class="btn btn-danger" data-dismiss="modal" type="button"> Cancel </button>

                                                                            <button class="btn btn-info" type="button" :disabled="isLoading" v-on:click="cancelInvoice()">

                                                                                Yes

                                                                                <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>

                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                       
                                                   
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        </div>
                                </div>
                              
                            </div>


<script src="~/js/ap/DataEntry/CancelUnpostedInvoices.js" asp-append-version="true"></script>