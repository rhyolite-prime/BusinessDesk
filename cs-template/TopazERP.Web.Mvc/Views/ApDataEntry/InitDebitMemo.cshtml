@{
    ViewBag.Title = "Debit Memos";
    Layout = "~/Views/Shared/Layout/_adminApLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
    .nav {
        font-size: 0.8rem;
    }
    .perPage {
        border: none;
        padding: 0.25rem 0.5rem;
        background-color: #f8f9fa;
    }
    .pign{
        border-bottom: 1px solid #e3e3e3;
        background-color: #f8f9fa;
    }
</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Debit Memos</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/Ap" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#"> Ap Data Entry </a>
                            </li>
                            <li class="breadcrumb-item active">Debit Memos</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-body">
            <div id="debitMemoApp" >
                <div class="card b">
                    <div class="card-header">
                        <h4 class="card-title">Debit Memos</h4>
                        <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                        <div class="heading-elements">
                            <ul class="list-inline mb-0">
                                <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
                                <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                <li><a data-action="close"><i class="ft-x"></i></a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Controls -->
                        <div class="d-flex justify-content-between align-items-center  flex-wrap">
                            <div class="position-relative my-1" style="width:350px;">
                                <input type="text"
                                       class="form-control"
                                       v-model="searchQuery"
                                       placeholder="Search or select memo..."
                                       @@focus="showDropdown = true"
                                       @@input="showDropdown = true"
                                       @@blur="hideDropdown">
                                <!-- Dropdown -->
                                <div v-show="showDropdown"
                                     class="list-group position-absolute w-100"
                                     style="z-index:1000; max-height:200px; overflow-y:auto;">

                                    <button class="list-group-item list-group-item-action"
                                            v-for="d in debitMemos"
                                            :key="d.id"
                                            @@click="selectFromDropdown(d.batchNumber)">
                                        {{ d.batchNumber }} — {{ d.supplierName }}
                                    </button>

                                    <div v-if="debitMemos.length === 0" class="list-group-item text-muted">
                                        No debit memos found.
                                    </div>
                                </div>
                            </div>

                            <!-- Debit Memo Buttons -->
                            <div class="d-flex gap-2 my-1">
                                <a href="@Url.Action("CreateMemo", "ApDataEntry")" class="btn btn-outline-success btn-sm">
                                    <i class="la la-plus-circle"></i> Add Debit Memo
                                </a>
                            </div>
                        </div>

                        <!-- Debit Memo Table -->
                        <div class="table-responsive">
                            <table class="table table-hover table-striped b">
                                <thead class="bg-white text-black table-info">
                                <tr>
                                    <th class="cursor-pointer" @@click="sort('batchNumber')">Batch #</th>
                                    <th class="cursor-pointer" @@click="sort('supplierName')">Supplier</th>
                                    <th class="cursor-pointer" @@click="sort('amount')">Amount</th>
                                    <th class="cursor-pointer" @@click="sort('transactionDate')">Transaction Date</th>
                                    <th class="cursor-pointer" @@click="sort('isInvoiceDebit')">Applied ?</th>
                                    <th>Actions</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr v-for="d in paginatedDebitMemos" :key="d.id">
                                    <td>{{ d.batchNumber }}</td>
                                    <td>{{ d.supplierName }}</td>
                                    <td>{{ formatNumber(d.amount) }}</td>
                                    <td>{{ new Date(d.transactionDate).toLocaleDateString() }}</td>
                                    <td>{{ d.isInvoiceDebit ? 'Yes' : 'No' }}</td>
                                    <td class="text-left">
                                        <i v-if="!d.isInvoiceDebit" class="m-1 text-sm text-primary font-weight-bold" title="Apply" style="cursor:pointer;font-size:1rem;" @@click="applyDebitMemo(d.id)">Apply</i>
                                        <i v-if="!d.isInvoiceDebit" class="la la-edit text-primary" title="Edit" style="cursor:pointer;font-size:1.2rem;" @@click="editDebitMemo(d.id)"></i>
                                        <i v-if="!d.isInvoiceDebit" class="la la-trash text-danger" title="Delete" style="cursor:pointer;font-size:1.2rem;" @@click="deleteDebitMemo(d.id)"></i>

                                    </td>
                                </tr>

                                <tr v-if="paginatedDebitMemos.length === 0">
                                    <td colspan="5" class="text-center text-muted">No records found</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-end align-items-center flex-wrap pign p-1">
                            <div class="d-flex align-items-center mb-2 mb-md-0 nav mr-1">
                                <i class="la la-list text-info mr-2"></i>
                                <select v-model="perPage" class="perPage">
                                    <option value="5">5 per page</option>
                                    <option value="10">10 per page</option>
                                    <option value="20">20 per page</option>
                                    <option value="50">50 per page</option>
                                </select>
                            </div>
                            <!-- Pagination -->
                            <nav class="float-right nav">
                                <ul class="pagination justify-content-center">

                                    <!-- Prev -->
                                    <li class="page-item" :class="{ disabled: currentPage === 1 }">
                                        <a class="page-link text-sm" href="#" @@click.prevent="currentPage--">Prev</a>
                                    </li>

                                    <!-- Pages -->
                                    <li class="page-item"
                                        v-for="(page, index) in paginationPages"
                                        :key="index"
                                        :class="{ active: currentPage === page, disabled: page === '...' }">

                                        <a class="page-link text-sm"
                                           href="#"
                                           @@click.prevent="page !== '...' && (currentPage = page)">
                                            {{ page }}
                                        </a>
                                    </li>

                                    <!-- Next -->
                                    <li class="page-item" :class="{ disabled: currentPage === totalPages }">
                                        <a class="page-link text-sm" href="#" @@click.prevent="currentPage++">Next</a>
                                    </li>

                                </ul>
                            </nav>
                        </div>

                    </div>
                </div>
                <!-- Debit Memo Delete Modal -->
                <div class="modal fade" id="debitMemoDeleteModal" tabindex="-1" role="dialog">
                    <div class="modal-dialog modal-sm" role="document">
                        <div class="modal-content">

                            <div class="modal-header bg-info text-white">
                                <h5 class="modal-title">{{ modalTitle }}</h5>
                                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                            </div>

                            <div class="modal-body text-center">
                                <p>{{ modalMessage }}</p>
                            </div>

                            <div class="modal-footer">
                                <button class="btn btn-secondary" data-dismiss="modal">No</button>
                                <button class="btn btn-danger" @@click="confirmDelete">Yes</button>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="~/js/ap/DataEntry/debitMemo.js" asp-append-version="true"></script>
