@{
    ViewBag.Title = "Payments";
    Layout = "~/Views/Shared/Layout/_adminApLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
        .nav {
            font-size: 0.8rem;
        }
        .perPage {
            border: none;
            padding: 0.25rem 0.5rem;
            background-color: #f8f9fa;
        }
        .pign{
            border-bottom: 1px solid #e3e3e3;
            background-color: #f8f9fa;
        }
    .report-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 9999;
    }

    .overlay-backdrop {
        position: absolute;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
    }

    .overlay-content {
        position: relative;
        width: 90%;
        height: 90%;
        margin: 2% auto;
        background: #fff;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .overlay-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 15px;
        border-bottom: 1px solid #ddd;
    }

    .overlay-body {
        flex: 1;
        height: 100%;
    }

    .close-btn {
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
    }
</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="font-weight-bold">Payments</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/Ap" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#"> Ap Data Entry </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Payments
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
           
        <div class="card b">
            <div class="card-header">
                <h4 class="card-title">Payments</h4>
                <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                <div class="heading-elements">
                    <ul class="list-inline mb-0">
                        <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
                        <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                        <li><a data-action="close"><i class="ft-x"></i></a></li>
                    </ul>
                </div>
            </div>
            <div class="card-body">

                <div id="paymentApp">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div class="position-relative " style="width:350px;"></div>

                        <!-- Payments Button Group -->
                        <div class="btn-group d-flex flex-wrap gap-2 my-1" role="group">
                            <a href="@Url.Action("Payments", "ApDataEntry")" class="btn btn-outline-success flex-fill btn-sm">
                                <i class="la la-plus-circle"></i> Add Payment
                            </a>
                            <a href="@Url.Action("PostPayment", "ApDataEntry")" class="btn btn-outline-primary flex-fill btn-sm">
                                <i class="la la-upload"></i> Post Payments
                            </a>
                        </div>


                    </div>

                    <!-- Payments Table -->
                    <div class="table-responsive">
                        <span class="my-1">{{ selectedPayments.length }} selected</span>
                        <div class="bg-light p-1 flex-wrap d-flex justify-content-between align-items-center ">
                            <div v-if="selectedPayments.length > 0" class="bulk-actions">
                                <button class="btn btn-light btn-sm mr-1" @@click="printSelected"> <i class="la la-print " title="Print"></i></button>
                                <button class="btn btn-light btn-sm mr-1" @@click="cancelSelected"> <i class="la la-ban " title="Cancel Payments"></i></button>
                                </div>
                            <div class="position-relative " style="width:350px;">
                                <input type="text"
                                       class="form-control"
                                       v-model="searchQuery"
                                       placeholder="Search or select payment..."
                                       @@focus="showDropdown = true"
                                       @@input="showDropdown = true"
                                       @@blur="hideDropdown">
                                <!-- Dropdown -->
                                <div v-show="showDropdown"
                                     class="list-group position-absolute w-100"
                                     style="z-index:1000; max-height:200px; overflow-y:auto;">

                                    <button class="list-group-item list-group-item-action"
                                            v-for="p in payments"
                                            :key="p.id"
                                            @@click="selectFromDropdown(p.batchNumber)">
                                        {{ p.batchNumber }} — {{ p.supplierName }}
                                    </button>

                                    <div v-if="payments.length === 0" class="list-group-item text-muted">
                                        No payments found
                                    </div>
                                </div>
                            </div>

                            </div>

                        <table class="table table-hover table-striped b">
                            <thead class="bg-white text-black">
                            <tr>
                                <th><input type="checkbox" v-model="selectAll" @@change="toggleSelectAll"></th>
                                <th class="cursor-pointer" @@click="sort('batchNumber')">Batch #</th>
                                <th class="cursor-pointer" @@click="sort('supplierName')">Supplier</th>
                                <th class="cursor-pointer" @@click="sort('amountToPay')">Amount</th>
                                <th class="cursor-pointer" @@click="sort('paymentDate')">Payment Date</th>
                                <th class="cursor-pointer" @@click="sort('isPosted')">Posted</th>
                                <th>Actions</th>
                            </tr>
                            </thead>
                           <tbody>

                                    <template v-for="(yearPayments, year) in groupedPayments" :key="year">
                            
                                        <!-- YEAR HEADER -->
                                        <tr class="table-light"
                                            style="cursor:pointer"
                                            @@click="togglePaymentYear(year)">
                            
                                            <td colspan="7">
                            
                                                <strong>
                                                    <i :class="expandedPaymentYears.includes(year)
                                                        ? 'la la-angle-down'
                                                        : 'la la-angle-right'"></i>
                            
                                                    {{ year }}
                                                </strong>
                            
                                                <span class="badge badge-dark ml-2">
                                                    {{ yearPayments.length }}
                                                </span>
                            
                                            </td>
                                        </tr>
                            
                                        <!-- PAYMENTS -->
                                        <template v-if="expandedPaymentYears.includes(year)">
                            
                                            <template v-for="p in yearPayments" :key="p.id">
                            
                                                <!-- Parent Row -->
                                                <tr
                                                    :class="{
                                                        'table-danger': p.isCanceled,
                                                        'font-weight-bold text-info': expandedPayments.includes(p.id)
                                                    }"
                                                    style="cursor: pointer;"
                                                    @@click="togglePayment(p.id)"
                                                    class="bg-white">
                            
                                                    <td>
                                                        <input type="checkbox"
                                                               v-model="selectedPayments"
                                                               :value="p.id"
                                                               @@click.stop>
                                                    </td>
                            
                                                    <td>
                                                        <strong>
                                                            <i :class="expandedPayments.includes(p.id)
                                                                ? 'la la-angle-down'
                                                                : 'la la-angle-right'"></i>
                                                        </strong>
                            
                                                        {{ p.batchNumber }}
                                                    </td>
                            
                                                    <td>{{ p.supplierName }}</td>
                            
                                                    <td>{{ formatNumber(p.amountToPay) }}</td>
                            
                                                    <td>
                                                        {{ new Date(p.paymentDate).toLocaleDateString() }}
                                                    </td>
                            
                                                    <td>
                            
                                                        <span v-if="p.isPosted"
                                                              class="text-success">
                                                            Yes
                                                        </span>
                            
                                                        <span v-else
                                                              class="text-secondary">
                                                            No
                                                        </span>
                            
                                                    </td>
                                                    <td class="text-left">
                                                        @*
                                                        <i class="la la-file-text text-info"
                                                           title="View Report"
                                                           style="cursor:pointer;font-size:1.2rem;"
                                                           @@click.stop="printReport(p.id)">
                                                        </i>
                                                        *@
                                                        <i v-if="!p.isPosted && !p.isCanceled"
                                                           class="la la-edit text-primary"
                                                           title="Edit Payment"
                                                           style="cursor:pointer;font-size:1.2rem;"
                                                           @@click.stop="editPayment(p.id)">
                                                        </i>
                            
                                                        <i v-if="!p.isCanceled"
                                                           :class="p.isPosted
                                                                ? 'la la-ban text-warning'
                                                                : 'la la-trash text-danger'"
                            
                                                           :title="p.isPosted
                                                                ? 'Cancel'
                                                                : 'Delete'"
                            
                                                           style="cursor:pointer;font-size:1.2rem;"
                                                           @@click.stop="cancelSingle(p.id)">
                                                        </i>
                            
                                                        <span v-if="p.isCanceled"
                                                              class="badge badge-danger">
                                                            Canceled
                                                        </span>
                            
                                                    </td>
                                                </tr>
                            
                                                <!-- CHILD ROW -->
                                                <tr v-show="expandedPayments.includes(p.id)">
                            
                                                    <td colspan="7" class="p-0">
                            
                                                        <table class="table table-sm table-striped mb-0">
                            
                                                            <thead class="table-info">
                            
                                                            <tr>
                                                                <th>Invoice #</th>
                                                                <th>Invoice Date</th>
                                                                <th>Balance Due</th>
                                                                <th>Projected Pay Date</th>
                                                                <th>Amount To Apply</th>
                                                                <th>New Balance</th>
                                                            </tr>
                            
                                                            </thead>
                            
                                                            <tbody>
                            
                                                            <tr v-for="inv in p.invoiceList"
                                                                :key="inv.id">
                            
                                                                <td>{{ inv.invoiceNumber }}</td>
                            
                                                                <td>
                                                                    {{ new Date(inv.invoiceDate).toLocaleDateString() }}
                                                                </td>
                            
                                                                <td>
                                                                    {{ formatNumber(inv.balance ?? (inv.totalInvoiceAmount - inv.paidAmount)) }}
                                                                </td>
                            
                                                                <td>
                                                                    {{ new Date(inv.projectedPayDate).toLocaleDateString() }}
                                                                </td>
                            
                                                                <td>
                                                                    {{ formatNumber(amountToApplyFor(p.id, inv.id)) }}
                                                                </td>
                            
                                                                <td>
                                                                    {{ formatNumber(newBalanceFor(p.id, inv)) }}
                                                                </td>
                            
                                                            </tr>
                            
                                                            </tbody>
                            
                                                        </table>
                            
                                                    </td>
                            
                                                </tr>
                            
                                            </template>
                            
                                        </template>
                            
                                    </template>
                            
                                    <tr v-if="Object.keys(groupedPayments).length === 0">
                            
                                        <td colspan="7"
                                            class="text-center text-muted">
                            
                                            No records found
                            
                                        </td>
                            
                                    </tr>
                            
                                    </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-end align-items-center flex-wrap pign p-1">
                                                                        <div class="d-flex align-items-center mb-2 mb-md-0 nav mr-1">
                                                                            <i class="la la-list text-info mr-2"></i>
                                                                            <select v-model="perPage" class="perPage">
                                                                                <option value="5">5 per page</option>
                                                                                <option value="10">10 per page</option>
                                                                                <option value="20">20 per page</option>
                                                                                <option value="50">50 per page</option>
                                                                            </select>
                                                                        </div>
                                                                        <!-- Pagination -->
                                                                        <nav class="float-right nav">
                                                                            <ul class="pagination justify-content-center">

                                                                                <!-- Prev -->
                                                                                <li class="page-item" :class="{ disabled: currentPage === 1 }">
                                                                                    <a class="page-link text-sm" href="#" @@click.prevent="currentPage--">Prev</a>
                                                                                </li>

                                                                                <!-- Pages -->
                                                                                <li class="page-item"
                                                                                    v-for="(page, index) in paginationPages"
                                                                                    :key="index"
                                                                                    :class="{ active: currentPage === page, disabled: page === '...' }">

                                                                                    <a class="page-link text-sm"
                                                                                       href="#"
                                                                                       @@click.prevent="page !== '...' && (currentPage = page)">
                                                                                        {{ page }}
                                                                                    </a>
                                                                                </li>

                                                                                <!-- Next -->
                                                                                <li class="page-item" :class="{ disabled: currentPage === totalPages }">
                                                                                    <a class="page-link text-sm" href="#" @@click.prevent="currentPage++">Next</a>
                                                                                </li>

                                                                            </ul>
                                                                        </nav>
                                                                    </div>
                                                                    <!-- Per Page -->
          
                    <div v-if="showReportOverlay" class="report-overlay">
    
                        <!-- Backdrop -->
                        <div class="overlay-backdrop" @@click="closeReport"></div>

                        <!-- Modal Content -->
                        <div class="overlay-content">
        
                            <!-- Header -->
                            <div class="overlay-header">
                                <h5>Print Preview</h5>
                                <button class="close-btn" @@click="closeReport">&times;</button>
                            </div>

                            <!-- Report Viewer -->
                            <div id="reportView" class="overlay-body"></div>

                        </div>
                    </div>  
                    <!-- Cancel Confirmation Modal -->
                    <div class="modal fade" id="cancelModal" tabindex="-1" role="dialog">
                        <div class="modal-dialog modal-sm" role="document">
                            <div class="modal-content">

                                <div class="modal-header bg-info text-white">
                                    <h5 class="modal-title">Confirm Cancel</h5>
                                    <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                                </div>

                                <div class="modal-body text-center">
                                    <p>{{ modalMessage }}</p>
                                </div>

                                <div class="modal-footer">
                                    <button class="btn btn-secondary" data-dismiss="modal">No</button>
                                    <button class="btn btn-danger" @@click="confirmCancel">Yes, Proceed</button>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        </div>
    </div>

<script>
    $(document).ready(function () {
        $('#paymentModal').modal('show');

        $('#proceedBtn').click(function () {
            const selectedAction = $('input[name="paymentAction"]:checked').val();

            if (selectedAction === 'invoice') {
                window.location.href = '/ApDataEntry/Payments';
            } else if (selectedAction === 'withholding') {
                window.location.href = '/ApDataEntry/WithHoldingPayments';
            }
        });

    });
</script>
<script src="~/js/ap/DataEntry/paymentPage.js" asp-append-version="true"></script>

