@{
ViewBag.Title = "Vouchers";
Layout = "~/Views/Shared/Layout/_adminApLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
    .nav {
        font-size: 0.8rem;
    }
    .perPage {
        border: none;
        padding: 0.25rem 0.5rem;
        background-color: #f8f9fa;
    }
    .pign{
        border-bottom: 1px solid #e3e3e3;
        background-color: #f8f9fa;
    }
    .loader-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.65);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10000;
    }
    .loader-text {
        margin-top: 10px;
        color: #fff4f4;
    }
    .report-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 9999;
    }

    .overlay-backdrop {
        position: absolute;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
    }

    .overlay-content {
        position: relative;
        width: 90%;
        height: 90%;
        margin: 2% auto;
        background: #fff;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .overlay-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 15px;
        border-bottom: 1px solid #ddd;
    }

    .overlay-body {
        flex: 1;
        height: 100%;
    }

    .close-btn {
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
    }
</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Vouchers</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/Ap" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#"> Ap Data Entry </a>
                            </li>
                            <li class="breadcrumb-item active">
                              Vouchers
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
           <div id="voucherApp" class="mt-3">
               <div class="card b">
                   <div class="card-body">
                       <div class="d-flex justify-content-between align-items-center flex-wrap">
                           <div v-if="isLoading" class="loader-overlay">
                               <div class="spinner-border text-primary" role="status">
                                   <span class="sr-only">Processing...</span>
                               </div>
                               <div class="loader-text">
                                   <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                                   Processing...
                               </div>
                           </div>
                           <div class="position-relative " style="width:350px;"></div>
                           <div class="btn-group d-flex flex-wrap gap-2 my-1" role="group">
                               <a href="@Url.Action("Vouchers", "ApDataEntry")" class="btn btn-outline-success flex-fill btn-sm">
                                   <i class="la la-plus-circle"></i> Raise Voucher
                               </a>
                               <a href="@Url.Action("PostVouchers", "ApDataEntry")" class="btn btn-outline-primary flex-fill btn-sm">
                                   <i class="la la-upload"></i> Post Vouchers
                               </a>
                           </div>
                       </div>

                       <div class="table-responsive">
                            <span class="my-1">{{ selectedVouchers.length }} selected</span>
                                                <div class="bg-light p-1 flex-wrap d-flex justify-content-between align-items-center ">
                                                    <div v-if="selectedVouchers.length > 0" class="bulk-actions">
                                                        <button class="btn btn-light btn-sm mr-1" @@click="printSelected"> <i class="la la-print " title="Print"></i></button>
                                                        <button class="btn btn-light btn-sm mr-1" @@click="cancelSelected"> <i class="la la-ban " title="Cancel"></i></button>
                                                    </div>
                                                    <div class="position-relative " style="width:350px;">
                                                        <input type="text"
                                                               class="form-control"
                                                               v-model="searchQuery"
                                                               placeholder="Search or select voucher..."
                                                               @@focus="showDropdown = true"
                                                               @@input="showDropdown = true"
                                                               @@blur="hideDropdown">
                                                        <!-- Dropdown -->
                                                        <div v-show="showDropdown"
                                                             class="list-group position-absolute w-100"
                                                             style="z-index:1000; max-height:200px; overflow-y:auto;">
        
                                                            <button class="list-group-item list-group-item-action"
                                                                    v-for="v in vouchers"
                                                                    :key="v.id"
                                                                    @@click="selectFromDropdown(v.batchNumber)">
                                                                {{ v.batchNumber }} — {{ v.supplierName }}
                                                            </button>

                                                            <div v-if="vouchers.length === 0" class="list-group-item text-muted">
                                                                No vouchers found.
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                           <table class="table table-hover my-table-striped b">
                               <thead class="bg-white text-black">
                               <tr>
                                   <th><input type="checkbox" v-model="selectAll" @@change="toggleSelectAll"></th>
                                   <th class="cursor-pointer" @@click="sort('batchNumber')">Batch #</th>
                                   <th class="cursor-pointer" @@click="sort('invoiceNumber')">Invoice #</th>
                                   <th class="cursor-pointer" @@click="sort('currencyCode')">Currency</th>
                                   <th class="cursor-pointer" @@click="sort('netAmount')">Net Amount</th>
                                   <th class="cursor-pointer" @@click="sort('voucherEntryDate')">Date</th>
                                   <th class="cursor-pointer" @@click="sort('isPosted')">Posted</th>
                                   <th>Actions</th>

                               </tr>
                               </thead>
                               <tbody>

                                <template v-for="(yearVouchers, year) in groupedPayments" :key="year">
                        
                                    <!-- YEAR HEADER -->
                                    <tr class="table-light"
                                        style="cursor:pointer"
                                        @@click="togglePaymentYear(year)">
                        
                                        <td colspan="8">
                        
                                            <strong>
                        
                                                <i :class="expandedPaymentYears.includes(year)
                                                    ? 'la la-angle-down'
                                                    : 'la la-angle-right'"></i>
                        
                                                {{ year }}
                        
                                            </strong>
                        
                                            <span class="badge badge-dark ml-2">
                                                {{ yearVouchers.length }}
                                            </span>
                        
                                        </td>
                        
                                    </tr>
                        
                                    <!-- VOUCHERS UNDER YEAR -->
                                    <template v-if="expandedPaymentYears.includes(year)">
                        
                                        <template v-for="v in yearVouchers" :key="v.id">
                        
                                            <!-- Parent Row -->
                                            <tr
                                                style="cursor: pointer;"
                                                @@click="toggleVoucher(v.id)"
                                                class="parent-row"
                                                :class="{
                                                    'font-weight-bold text-info':
                                                    expandedVouchers.includes(v.id)
                                                }">
                        
                                                <td>
                        
                                                    <input type="checkbox"
                                                           :value="v.id"
                                                           v-model="selectedVouchers"
                                                           @@click.stop>
                        
                                                </td>
                        
                                                <td>
                        
                                                    <strong>
                        
                                                        <i class="la text-sm"
                                                           :class="expandedVouchers.includes(v.id)
                                                           ? 'la-angle-down'
                                                           : 'la-angle-right'"></i>
                        
                                                    </strong>
                        
                                                    {{ v.batchNumber }}
                        
                                                </td>
                        
                                                <td>{{ v.invoiceNumber }}</td>
                        
                                                <td>{{ v.currencyCode }}</td>
                        
                                                <td>
                        
                                                    {{ v.netAmount !== undefined &&
                                                       v.netAmount !== null
                        
                                                        ? v.netAmount.toLocaleString(undefined, {
                                                            minimumFractionDigits: 2,
                                                            maximumFractionDigits: 2
                                                        })
                        
                                                        : '-'
                                                    }}
                        
                                                </td>
                        
                                                <td>
                                                    {{ new Date(v.voucherEntryDate).toLocaleDateString() }}
                                                </td>
                        
                                                <td>
                        
                                                    <span v-if="v.isPosted"
                                                          class="text-success">
                                                        Yes
                                                    </span>
                        
                                                    <span v-else
                                                          class="text-secondary">
                                                        No
                                                    </span>
                        
                                                </td>
                        
                                                <td class="text-left">
                        
                                                    <a class="la la-edit text-primary"
                                                       title="Edit Voucher"
                                                       style="cursor:pointer;font-size:1.2rem;"
                                                       @@click.stop="editVoucher(v.id)">
                                                    </a>
                        
                                                </td>
                        
                                            </tr>
                        
                                            <!-- CHILD DETAILS -->
                                            <tr v-show="expandedVouchers.includes(v.id)">
                        
                                                <td colspan="8" class="p-0">
                        
                                                    <table class="table table-hover table-sm table-striped mb-0">
                        
                                                        <thead class="table-info">
                        
                                                        <tr>
                                                            <th>Account</th>
                                                            <th>Description</th>
                                                            <th>Debit Amount</th>
                                                            <th>Credit Amount</th>
                                                            <th>Buy Rate</th>
                                                        </tr>
                        
                                                        </thead>
                        
                                                        <tbody>
                        
                                                        <tr v-for="d in v.details"
                                                            :key="d.account + d.debitAmount">
                        
                                                            <td>{{ d.account }}</td>
                        
                                                            <td>{{ d.description }}</td>
                        
                                                            <td>
                        
                                                                {{ d.debitAmount !== undefined &&
                                                                   d.debitAmount !== null
                        
                                                                    ? d.debitAmount.toLocaleString(undefined, {
                                                                        minimumFractionDigits: 2,
                                                                        maximumFractionDigits: 2
                                                                    })
                        
                                                                    : '-'
                                                                }}
                        
                                                            </td>
                        
                                                            <td>
                        
                                                                {{ d.creditAmount !== undefined &&
                                                                   d.creditAmount !== null
                        
                                                                    ? d.creditAmount.toLocaleString(undefined, {
                                                                        minimumFractionDigits: 2,
                                                                        maximumFractionDigits: 2
                                                                    })
                        
                                                                    : '-'
                                                                }}
                        
                                                            </td>
                        
                                                            <td>{{ d.buyRate.toFixed(4) }}</td>
                        
                                                        </tr>
                        
                                                        </tbody>
                        
                                                    </table>
                        
                                                </td>
                        
                                            </tr>
                        
                                        </template>
                        
                                    </template>
                        
                                </template>
                        
                                <tr v-if="Object.keys(groupedPayments).length === 0">
                        
                                    <td colspan="8"
                                        class="text-center text-muted">
                        
                                        No records found
                        
                                    </td>
                        
                                </tr>
                        
                               </tbody>



                           </table>
                       </div>
                       <div class="d-flex justify-content-end align-items-center flex-wrap pign p-1">
                                                <div class="d-flex align-items-center mb-2 mb-md-0 nav mr-1">
                                                    <i class="la la-list text-info mr-2"></i>
                                                    <select v-model="perPage" class="perPage">
                                                        <option value="5">5 per page</option>
                                                        <option value="10">10 per page</option>
                                                        <option value="20">20 per page</option>
                                                        <option value="50">50 per page</option>
                                                    </select>
                                                </div>
                                                <!-- Pagination -->
                                                <nav class="float-right nav">
                                                    <ul class="pagination justify-content-center">

                                                        <!-- Prev -->
                                                        <li class="page-item" :class="{ disabled: currentPage === 1 }">
                                                            <a class="page-link text-sm" href="#" @@click.prevent="currentPage--">Prev</a>
                                                        </li>

                                                        <!-- Pages -->
                                                        <li class="page-item"
                                                            v-for="(page, index) in paginationPages"
                                                            :key="index"
                                                            :class="{ active: currentPage === page, disabled: page === '...' }">

                                                            <a class="page-link text-sm"
                                                               href="#"
                                                               @@click.prevent="page !== '...' && (currentPage = page)">
                                                                {{ page }}
                                                            </a>
                                                        </li>

                                                        <!-- Next -->
                                                        <li class="page-item" :class="{ disabled: currentPage === totalPages }">
                                                            <a class="page-link text-sm" href="#" @@click.prevent="currentPage++">Next</a>
                                                        </li>

                                                    </ul>
                                                </nav>
                                            </div>
                       <div v-if="showReportOverlay" class="report-overlay">
    
                           <!-- Backdrop -->
                           <div class="overlay-backdrop" @@click="closeReport"></div>

                           <!-- Modal Content -->
                           <div class="overlay-content">
        
                               <!-- Header -->
                               <div class="overlay-header">
                                   <h5>Print Preview</h5>
                                   <button class="close-btn" @@click="closeReport">&times;</button>
                               </div>

                               <!-- Report Viewer -->
                               <div id="reportView" class="overlay-body"></div>

                           </div>
                       </div>            
                   </div>
               </div>
               <!-- Voucher Delete Confirmation Modal -->
               <div class="modal fade" id="voucherDeleteModal" tabindex="-1" role="dialog">
                   <div class="modal-dialog modal-sm" role="document">
                       <div class="modal-content">

                           <div class="modal-header bg-info text-white">
                               <h5 class="modal-title">{{ modalTitle }}</h5>
                               <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                           </div>

                           <div class="modal-body text-center">
                               <p>{{ modalMessage }}</p>
                           </div>

                           <div class="modal-footer">
                               <button class="btn btn-secondary" data-dismiss="modal">No</button>
                               <button class="btn btn-danger" @@click="confirmDelete">Yes</button>
                           </div>

                       </div>
                   </div>
               </div>

</div>

        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('#voucherModal').modal('show');

        $('#proceedBtn').click(function () {
            const selectedAction = $('input[name="voucherAction"]:checked').val();

            if (selectedAction === 'create') {
                window.location.href = '/ApDataEntry/Vouchers';
            } else if (selectedAction === 'UnPaidWithholding') {
                window.location.href = '/ApDataEntry/UnPaidWithHolding';
            }
            else if (selectedAction === 'post') {
                window.location.href = '/ApDataEntry/PostVouchers';
            }
            else if (selectedAction === 'UnPaidVatWithholding') {
                window.location.href = '/ApDataEntry/UnPaidVatWithHolding';
            }
        });
    });

</script>

<script src="~/js/ap/DataEntry/VoucherActions.js" asp-append-version="true"></script>

<script>
    // THIS comes from your POST form
    const reportData = JSON.parse(@Html.Raw(Json.Serialize(Model)));

    $("#reportView").boldReportViewer({
        reportServiceUrl: "@ViewBag.ReportApiBaseUrl",
        processingMode: ej.ReportViewer.ProcessingMode.Local,
        reportPath: "@ViewBag.ReportPath",
        dataSources: [{
            value: reportData,
            name: "DataSet1"
        }]
    });
</script>


