@using Microsoft.AspNetCore.Mvc.TagHelpers
@using TopazERP.Web.Helpers
@{
ViewBag.Title = "Edit Posted Invoices";
Layout = "~/Views/Shared/Layout/_adminApLayout.cshtml";
}

<div class="app-content content">
<div class="content-wrapper">
<div class="content-header row">
    <div class="content-header-left col-md-6 col-12 mb-2">
        <h3 class="content-header-title">Change Invoice Status</h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Ap","Dashboard")" class="text-info"><i class="la la-home"></i> Home</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a class="text-info" href="#"> Data Entry </a>
                    </li>
                    <li class="breadcrumb-item active">
                        Edit Posted Invoices
                    </li>
                </ol>
            </div>
        </div>
    </div>

</div>
<div class="content-body">
<!-- Basic Tables start -->
<div class="row">
<div class="col-12">
<div class="card">
<div class="card-header">
    <h4 class="card-title">Edit Posted Invoices</h4>
    <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
    <div class="heading-elements">
        <ul class="list-inline mb-0">
            <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
            <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
            <li><a data-action="close"><i class="ft-x"></i></a></li>
        </ul>
    </div>
</div>

<div class="card-content collapse show">

<div class="card-body" id="app">

<div class="content-i" id="app">
<div class="content-box">
<div class="element-wrapper">
<div class="element-box">
<div class="table-responsive" style="height:auto;width:auto;min-height:412px;">
   

<div>
    

    <!--search area -->
    <div class="row mt-2">

        <div class="col-sm-4">
            <div class="mt-2">
                <button type="button" v-on:click="clearForm" class="mb-3 btn btn-info mr-2">
                    <i class="la la-refresh"></i> Reset Form
                    <i class="fa fa-spinner fa-spin" v-if="isLoading"></i>
                </button>
                
            </div>
            
        </div>
        <div class="col-sm-4">

            <div class="form-group">
                <label> <strong> Search Supplier Invoice: </strong>  </label>
                <input id="invoiceId" v-model="invoiceId" type="text" class="form-control" />

            </div>

        </div>
        <div class="col-sm-4 mt-2 text-right" v-if="invoiceId">
            <a @@click="printReport" class="btn btn-info text-white"> <i class="la la-print"></i> Print </a>
        </div>

    </div>
    <hr/>
    <!-- add and update form -->
    <div>
     
        <div class="row">
            <div class="col-sm-3">

                <div class="form-group">
                    <label> <strong> Supplier: </strong> </label><span class="text-danger">*</span>
                    <input id="supplierId" v-model="supplierId" type="text" class="form-control" required/>
                </div>

                <div class="form-group">
                    <label> <strong>Account No.: </strong> </label>
                    <input v-model="accountNumber" class="form-control" type="text" disabled="disabled"/>

                </div>

                <div class="form-group">
                    <label> <strong>Currency: </strong> </label><span class="text-danger">*</span>
                    <input id="currencyId" v-model="currencyId" type="text" class="form-control" required/>
                </div>
                <div class="form-group">
                    <label> <strong> Currency Rate: </strong>  </label>
                    <input id="buyRate" v-model="buyRate" step="0.01" min="0" type="number" class="form-control" />

                </div>

                <div class="form-group mx-2">
                    <input class="form-check-input" type="checkbox" id="isMulticurrency" v-model="isMultiCurrency" disabled/>
                    <label class="form-label" for="isMulticurrency">Is MultiCurrency</label>
                </div>

            </div>
            <div class="col-sm-3">

                <div class="form-group">
                    <label> <strong> <strong> Invoice Number: </strong> </strong> </label><span class="text-success">*</span>
                    <input type="text" class="form-control" v-model="invoiceNumber" placeholder="Generated On Save" />

                </div>
                <div class="form-group">
                    <label> <strong>Received Date: </strong> </label><span class="text-danger">*</span>
                    <input id="invoiceDate" v-model="invoiceDate" class="form-control" type="date" required/>
                </div>

                <div class="form-group">
                    <label> <strong>Projected Pay Date: </strong> </label><span class="text-danger">*</span>
                    <input id="projectedPayDate" v-model="projectedPayDate" class="form-control" type="date" required/>
                </div>



            </div>
            <div class="col-sm-3">
                <div class="form-group">
                    <label> <strong>Voucher No.: </strong> </label>
                    <input v-model="voucherNumber" class="form-control" type="text"/>
                </div>

                <div class="form-group">
                    <label> <strong>PO No.: </strong> </label>
                    <input v-model="purchaseOrderNumber" class="form-control" type="text"/>
                </div>

                <div class="form-group">
                    <label> <strong>Balance: </strong> </label>
                    <input v-model="invoiceBalance" class="form-control" type="number" disabled="disabled"/>

                </div>



            </div>
            <div class="col-sm-3">
                <div class="form-group" v-if="isOu">
                    <label> <strong>OU (Cost Center): </strong> </label><span class="text-danger">*</span>
                    <input id="ouId" v-model="ouId" type="text" class="form-control" required/>
                </div>

                <div class="form-group">
                    <label> <strong>Liability G/L No: </strong> </label><span class="text-danger">*</span>
                    <input id="liabilityAccountId" v-model="liabilityAccountId" type="text" class="form-control" required/>
                </div>
                <div class="form-group">
                    <label> <strong>Batch No.: </strong> </label>
                    <input v-model="batchNumber" class="form-control" type="text" placeholder="2321" disabled/>
                </div>
                <div class="form-group">
                    <label> <strong>Total Amount: </strong> </label>
                    <input v-model="totalInvoiceAmount"  class="form-control" type="number" disabled="disabled"/>
                </div>
            </div>

        </div>
        <hr />
        <p>Details</p>
        <div class="row mb-2">
            <div class="col-12">
                <div class="form-group">
                    <p class="mt-2"><strong>Add Tax Levies if Applicable: </strong></p>
                </div>
                <div class="form-group d-flex flex-wrap">
                    <div class="d-flex gap-2 mt-1">
                        <button
                            v-for="tax in taxLevyList"
                            :key="tax.id"
                            :class="['btn', tax.isApplied ? 'btn-success' : 'btn-outline-success']"
                            style="min-width: 120px;"
                            @@click.prevent="toggleTaxLevy(tax.id)"
                            :disabled="isVatInclusive">
                            {{ tax.name }} ({{ tax.rate }}%)
                        </button>

                        <input
                            type="number"
                            v-model="vatRate"
                            class="form-control border-success"
                            :disabled="isVatInclusive"
                        />
                    </div>
                </div>


            </div>
        </div>
        <div class="mt-3" id="dataTable2"></div>
        <div class="row mt-2">
            <div class="col"></div>
            <div class="col">
                <button class="btn btn-success mb-3" style="float: right" type="button" data-target="#addEdit" data-toggle="modal"> Save Invoice </button>
            </div>
            <div aria-hidden="true" aria-labelledby="exampleModalLabel" class="modal fade" id="addEdit" role="dialog" tabindex="-1">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel"> Confirm Action </h5>
                            <button aria-label="Close" class="close" data-dismiss="modal" type="button"><span aria-hidden="true"> &times;</span></button>
                        </div>
                        <div class="modal-body">

                           <p>Are You Sure You Want To Edit This Posted Invoice?</p>

                        </div>

                        <div class="modal-footer">

                            <button class="btn btn-danger" data-dismiss="modal" type="button"> Cancel </button>

                            <button class="btn btn-info" type="button" :disabled="isLoading" v-on:click="editPostedInvoice()">

                                Yes

                                <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>

                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div> 
    </div>
    
    




</div>


</div>
</div>

</div>

</div>
</div>


</div>
</div>

</div>
</div>

</div>
</div>
</div>
</div>
<script src="~/js/ap/DataEntry/editPostedInvoice.js" asp-append-version="true"></script>

