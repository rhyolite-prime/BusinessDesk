 @{
    ViewBag.Title = "Head Teacher Remarks";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

 <style>
     /* ✅ full-screen overlay inside app */
     .preview-loader-overlay {
         position: absolute;
         inset: 0;
         background: rgba(255, 255, 255, 0.75);
         z-index: 9999;
         display: flex;
         align-items: center;
         justify-content: center;
         backdrop-filter: blur(1px);
     }

     /* make sure #app can host an absolute overlay */
     #app {
         position: relative;
     }

     .preview-loader-card {
         background: #fff;
         border-radius: 12px;
         padding: 18px 22px;
         box-shadow: 0 8px 24px rgba(0,0,0,0.15);
         display: flex;
         align-items: center;
         gap: 12px;
     }

     .preview-loader-text {
         font-weight: 600;
         color: #0b1f5b; /* deep blue */
         font-size: 14px;
     }

     /* ✅ deep blue animated spinner */
     .deepblue-spinner {
         width: 34px;
         height: 34px;
         border-radius: 50%;
         border: 4px solid rgba(11, 31, 91, 0.18);
         border-top-color: #0b1f5b; /* deep blue */
         animation: deepblue-spin 0.85s linear infinite;
     }

     @@keyframes deepblue-spin {
         to { transform: rotate(360deg); }
     }
     
 </style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Head Teacher Remarks</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#">Import Data</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Head Teacher Remarks
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Head Teacher Remarks</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <!-- ✅ Preview Loader Overlay -->
                                <div v-if="isPreviewLoading" class="preview-loader-overlay">
                                    <div class="preview-loader-card">
                                        <div class="deepblue-spinner"></div>
                                        <div class="preview-loader-text">Processing preview...</div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-3 e-bootstrap">
                                        <label>Academic Year:</label>
                                        <input id="academicYearId"/>
                                    </div>
                                    <div class="col-md-3 e-bootstrap">
                                        <label>Term:</label>
                                        <input id="termId"/>
                                    </div>
                                    <div class="col-md-3 e-bootstrap">
                                        <label>Class:</label>
                                        <input id="classId"/>
                                    </div>

                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label class="text-amber"> <strong> Choose File: </strong>
                                                <a class="text-primary font-weight-bold"
                                                   :disabled="!academicYearId || !termId || !classId"
                                                   @@click="downloadTemplate">
                                                    Download Template
                                                </a>
                                            </label>
                                            <input type="file" name="customFile" v-on:change="onFileUpload($event)" class="form-control" required>
                                        </div>

                                    </div>
                                    <div class="col-sm-2">
                                        <button class="btn btn-primary mt-2"
                                                :disabled="hasErrors || previewRows.length === 0"
                                                @@click="importData">
                                            <i class="la la-file-import"></i> Import
                                        </button>

                                    </div>


                                </div>

                                <hr/>
                                <div class="e-bootstrap">
                                    <div class="my-1 badge badge-dark">No. of Records: {{ previewRows.length }}</div>
                                    <table class="table table-striped table-bordered table-responsive">
                                        <thead>
                                        <tr>
                                            <th style="width: 380px">Reg No</th>
                                            <th style="width: 480px">Name</th>
                                            <th style="width: 580px">Remarks</th>
                                            <th style="width: 480px">Status</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr v-for="row in previewRows" :key="row.studentIdentifier">
                                            <td>{{ row.studentIdentifier }}</td>
                                            <td>{{ row.studentName }}</td>
                                            <td>{{ row.remark }}</td>
                                            <td>
                                                <span v-if="row.error" class="text-danger">
                                                    {{ row.error }}
                                                </span>
                                                <span v-else class="text-success">
                                                    OK
                                                </span>
                                            </td>
                                        </tr>

                                        </tbody>
                                    </table>


                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>



<script src="~/js/school-manager/import-data/mainTeacher-remarks.js" asp-append-version="true"></script>