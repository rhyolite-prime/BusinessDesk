@{
    ViewBag.Title = "Cost Centers";
    Layout = "~/Views/Shared/Layout/_adminLedgerLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Cost Centers </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#"> Shared Resources </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Cost Centers
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Cost Centers  </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">

                                    <div class="col-sm-2">
                                    </div>
                                    <div class="col-sm-3">

                                        <div class="form-group">
                                            <label> <strong> Cost Center: </strong> </label>
                                            <input type="text" class="form-control" v-model="name" id="name" placeholder="Cost Center">

                                        </div>

                                    </div>

                                    <div class="col-sm-3">

                                        <div class="form-group">
                                            <label> <strong> Parent Hierachy: </strong>  </label>
                                            <select class="form-control" v-model="parentId" type="text">
                                                <option value=""> Select Parent Hierachy </option>
                                                <option :value="costCenter.id" v-for="costCenter in costCenterHierachyList"> {{costCenter.name}} </option>
                                            </select>
                                        </div>

                                    </div>

                                    <div class="col-sm-2 mt-1">
                                        <div class="form-group mt-1">
                                            <button type="button" v-on:click="saveCostCenter()" :disabled="isLoading" class="btn btn-primary">
                                                Save
                                                <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                                            </button>

                                        </div>

                                    </div>

                                </div>
                                <hr />
                                
                                <div id="dataTable"></div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>



<script src="~/js/shared/cost-centers.js" asp-append-version="true"></script>