@{
    ViewBag.Title = "Company Profile";
    Layout = "~/Views/Shared/Layout/_adminLedgerLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Company Profile </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#"> Shared Resources </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Company Profile
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Company Profile </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                             <form>

                        <fieldset class="form-group">
                            <legend><span> Basic Info </span></legend>
                            <hr />
                            <div class="row">

                                <div class="col-md-3 text-center mb-2">
                        <div class="position-relative d-inline-block">
                          
                            <img v-if="companyLogoBase64"
                                 :src="companyLogoBase64"
                                 alt="Company Logo"
                                 class="rounded-circle shadow-sm border border-info"
                                 style="width: 200px; height: 200px; object-fit: contain;">
                            
                            <img v-else
                                 src="https://res.cloudinary.com/dusydqiob/image/upload/v1755769638/erp-reports/ap/profile_biwocv.jpg"
                                 alt="Default Profile"
                                 class="rounded-circle shadow-sm border border-info"
                                 style="width: 200px; height: 200px; object-fit: cover;">

                         
                            <button v-if="companyLogoBase64"
                                    @@click="removeLogo"
                                    type="button"
                                    class="btn btn-sm  p-1 position-absolute bottom-0 end-0 rounded-circle"
                                    style="background-color:#f87272; transform: translate(25%, 25%); bottom: 10px; right: 25px; border: 6px solid white">
                                <i class="la la-times text-white"></i>
                            </button>
                            <button v-else
                                    @@click="showUpload"
                                    type="button"
                                    class="btn btn-sm  p-1 position-absolute bottom-0 end-0 rounded-circle"
                                    style="background-color:#138fdc; transform: translate(25%, 25%); bottom: 10px; right: 25px; border: 6px solid white">
                                <i class="la la-plus text-white"></i>
                            </button>

                        </div>

                        <!-- File input -->
                        <div class="mt-3">
                            <label class="form-label fw-bold">Upload Company Logo</label>
                            <input type="file"
                                   ref="fileInput"
                                   class="form-control form-control-sm d-none"
                                   @@change="onFileChange"
                                   accept="image/*">
                        </div>
                    </div>

                                <div class="col-sm-4">

                                    <div class="form-group">
                                        <label> <b> Company Name:</b> </label>
                                                    <input type="text" class="form-control" v-model="companyName" ref="companyName" placeholder="Company Name">
                                        <span class="text-danger" v-if="!$v.companyName.required && $v.companyName.$dirty && companyName == ''"> Company Name field is required </span>

                                    </div>


                                      <div class="form-group">
                                        <label> <b> Country: </b>  </label>
                                            <select class="form-control" v-model="countryId" ref="countryId">
                                            <option value=""> Select Country </option>
                                            <option :value="country.id" v-for="country in nationalityList">{{country.name}}</option>
                                        </select>
                                    </div>

                                    <div class="form-group">
                                        <label> <b> City: </b> </label>
                                        <input type="text" class="form-control" v-model="cityName" placeholder="City or Location">

                                    </div>

                                    <div class="form-group">
                                        <label> <b> Phone No: </b>  </label>
                                        <input type="text" class="form-control" id="phoneNo" v-model="phoneNo" ref="phoneNo" placeholder="Phone No">
                                        <span class="text-danger" v-if="!$v.phoneNo.required && $v.phoneNo.$dirty && phoneNo == ''"> Phone No. field is required </span>

                                    </div>

                                    <div class="form-group">

                                        <label> <b> Default Currency: </b> </label>

                                        <select class="form-control mb-3" v-model="defaultCurrenyId" id="defaultCurrenyId">
                                            <option :value="currency.id" v-for="currency in currencyList"> {{currency.currencyName}} </option>
                                        </select>
                                       
                                    </div>

                                </div>

                                <div class="col-sm-4">

                                     <div class="form-group">
                                        <label> <b> Company TIN: </b> </label>
                                        <input type="text" class="form-control" v-model="companyTin" placeholder="Company Tin">

                                    </div>

                                    <div class="form-group">
                                        <label> <b> Email: </b> </label>
                                                    <input type="text" class="form-control" v-model="email" ref="email" placeholder="Email">
                                        <span class="text-danger" v-if="!$v.email.required && $v.email.$dirty && email == ''"> Email field is required </span>

                                    </div>
                                     
                                    <div class="form-group">
                                        <label> <b> Address: </b> </label>
                                         <input type="text" class="form-control" v-model="address" ref="address" placeholder="Address">
                                         <span class="text-danger" v-if="!$v.address.required && $v.address.$dirty && email == ''"> Address field is required </span>

                                    </div>

                                    <div class="form-group">

                                        <label> <b> First Month Of FiscalYear: </b> </label>

                                        <select class="form-control mb-3" id="firstMonthOfFiscalYear" v-model="firstMonthOfFiscalYear">
                                            <option value="1"> January </option>
                                            <option value="2"> February </option>
                                            <option value="3"> March </option>
                                            <option value="4"> April </option>
                                            <option value="5"> May </option>
                                            <option value="6"> June </option>
                                            <option value="7"> July </option>
                                            <option value="8"> August </option>
                                            <option value="9"> September </option>
                                            <option value="10"> October </option>
                                            <option value="11"> November </option>
                                            <option value="12"> December </option>
                                        </select>
                                    </div>
                                    
                                </div>
                                 
                            </div>

                        </fieldset>

                        <fieldset class="form-group">
                            <legend><span> SSNIT </span></legend>
                            <hr />
                            <div class="row">

                                <div class="col-sm-1">
                                </div>

                                <div class="col-sm-4">

                                    <div class="form-group">
                                        <label> <b> Employer Social Security No: </b> </label>
                                        <input type="text" class="form-control" v-model="employerSocialSecurityNo" placeholder="Employer Social Security No">

                                    </div>

                                    <div class="form-group">
                                        <label> <b> Social Security Fund Employer Rate: </b> </label>
                                        <input type="number" class="form-control" v-model="socialSecurityFundEmployerRate" placeholder="Social Security Fund Employer Rate">

                                    </div>

                                </div>

                                <div class="col-sm-4">

                                    <div class="form-group">

                                        <label> <b> Social Security Fund Employee Rate: </b> </label>
                                        <input type="number" class="form-control" v-model="socialSecurityFundEmployeeRate" placeholder="Social Security Fund Employee Rate">

                                    </div>

                                    <div class="form-group">

                                        <label class="checkbox checkbox-primary mt-3">
                                            <input type="checkbox" v-model="paySocialSecurityFund"> <span> <strong> Pay Social Security Fund ? </strong>   </span> <span class="checkmark"></span>
                                        </label>

                                    </div>

                                </div>


                            </div>

                        </fieldset>

                        <fieldset class="form-group">
                            <legend><span>  Provident Fund </span></legend>
                            <hr />
                            <div class="row">

                                <div class="col-sm-1">
                                </div>

                                <div class="col-sm-4">

                                    <div class="form-group">
                                        <label> <b> Provident Fund Employee Rate: </b> </label>
                                        <input type="number" class="form-control" v-model="providentFundEmployeeRate" placeholder="Provident Fund Employee Rate">

                                    </div>

                                    <div class="form-group">

                                        <label> <b> Provident Fund Employer Rate: </b> </label>
                                         <input type="number" class="form-control" v-model="providentFundEmployerRate" placeholder="Provident Fund Employer Rate">

                                    </div>

                                </div>

                                <div class="col-sm-4">

                                    <div class="form-group">

                                        <label class="checkbox checkbox-primary mt-2">
                                            <input type="checkbox" v-model="providentFundTreatAsSocialSecurityFund"> <span> <strong> Treat Provident Fund As Social Security Fund ? </strong>   </span> <span class="checkmark"></span>
                                        </label>

                                        <label class="checkbox checkbox-primary mt-2">
                                            <input type="checkbox" v-model="payProvidentFund"> <span> <strong> Pay Provident Fund ? </strong> </span> <span class="checkmark"></span>
                                        </label>

                                        <br/>

                                        <label class="checkbox checkbox-primary mt-2">
                                            <input type="checkbox" v-model="providentFundTaxEmployerPortion"> <span> <strong> Provident Fund Tax Employer Portion ? </strong> </span> <span class="checkmark"></span>
                                        </label>

                                    </div>


                                </div>

                            </div>

                        </fieldset>

                        <fieldset class="form-group">
                            <legend><span> 2nd Provident Fund </span></legend>
                                        <hr />
                            <div class="row">

                                <div class="col-sm-1">
                                </div>

                                <div class="col-sm-4">

                                    <div class="form-group">
                                        <label> <b> Second Provident Employee Rate: </b> </label>
                                        <input type="number" class="form-control" v-model="secondProvidentEmployeeRate" placeholder="Provident Fund Employee Rate">

                                    </div>

                                    <div class="form-group">

                                        <label> <b> Second Provident Employer Rate: </b> </label>
                                                    <input type="number" class="form-control" v-model="secondProvidentEmployerRate" placeholder="Provident Fund Employer Rate">

                                    </div>

                                </div>

                                <div class="col-sm-4">

                                    <div class="form-group">

                                        <label class="checkbox checkbox-primary mt-2">
                                            <input type="checkbox" v-model="paySecondProvidentOrOthers"> <span> <strong> Pay Second Provident Or Others ? </strong>   </span> <span class="checkmark"></span>
                                        </label>

                                        <label class="checkbox checkbox-primary mt-2">
                                            <input type="checkbox" v-model="treatSecondProvidentAsSsf"> <span> <strong> Treat Second Provident As SSF ? </strong> </span> <span class="checkmark"></span>
                                        </label>

                                        <br />

                                        <label class="checkbox checkbox-primary mt-2">
                                            <input type="checkbox" v-model="secondProvidentTaxEmployerPortion"> <span> <strong> Second Provident Tax Employer Portion ? </strong> </span> <span class="checkmark"></span>
                                        </label>

                                    </div>



                                </div>


                            </div>

                        </fieldset>

                        <fieldset class="form-group">
                            <legend><span> Overtime </span></legend>
                             <hr />
                            <div class="row">

                                <div class="col-sm-1">
                                </div>

                                <div class="col-sm-4">

                                    <div class="form-group">

                                        <label class="checkbox checkbox-primary mt-2">
                                            <input type="checkbox" v-model="overtimePercentageOnBasicSalary"> <span> <strong> Overtime Percentage On Basic Salary ? </strong>   </span> <span class="checkmark"></span>
                                        </label>

                                        <label class="checkbox checkbox-primary mt-2">
                                            <input type="checkbox" v-model="overtimePercentageOnDailyWage"> <span> <strong> Overtime Percentage On Daily Wage ? </strong> </span> <span class="checkmark"></span>
                                        </label>
                                    </div>


                                </div>
                                 
                            </div>

                        </fieldset>
                       
                        <fieldset class="form-group">
                            <legend><span>  Email Settings </span></legend>
                             <hr />
                            <div class="row">

                                <div class="col-sm-1">
                                </div>

                                <div class="col-sm-4">

                                    <div class="form-group">
                                        <label> <b>Mail Host Name: </b> </label>
                                        <input type="text" class="form-control" v-model="mailHostName" placeholder="Mail Host Name">

                                    </div>

                                    <div class="form-group">
                                        <label> <b>Primary Email Address: </b> </label>
                                        <input type="text" class="form-control" v-model="primaryEmailAddress" placeholder="Primary Email Address">

                                    </div>

                                    <div class="form-group">
                                        <label> <b>Mail Password: </b> </label>
                                        <input type="password" class="form-control" v-model="emailPassword" placeholder="********">

                                    </div>


                                </div>

                                <div class="col-sm-4">

                                    <div class="form-group">
                                        <label> <b> Port Number: </b> </label>
                                        <input type="number" class="form-control" v-model="portNumber" placeholder="1234">

                                    </div>

                                    <div class="form-group">
                                        <label> <b> Is SSL Enabled: </b> </label>
                                        <select class="form-control mb-3" v-model="isSSLEnabled">
                                            <option value="false">No</option>
                                            <option value="true">Yes</option>
                                        </select>
                                    </div>

                                </div>

                            </div>

                        </fieldset>

                        <!-- G/L Section -->
                        <fieldset class="form-group">
                            <legend><span> G/L </span></legend>
                            <hr />
                            <div class="row">

                                <div class="col-sm-1">
                                </div>

                                <div class="col-sm-4">

                                    <div class="form-group">
                                        <label>
                                            <b>Enforce OU usage:</b>
                                            <input type="checkbox" v-model="enforceOu" class="ml-2">
                                        </label>
                                    </div>

                                </div>

                            </div>

                        </fieldset>

                        <hr />
                        <div class="row">

                            <div class="col-sm-3"></div>
                            <div class="col-sm-4"></div>
                            <div class="col-sm-4">

                                <button type="button" :disabled="isLoading" v-on:click="saveProfile()" style="float: right" class="btn btn-primary">
                                    Save
                                
                                    <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                                </button>

                            </div>

                        </div>

                    </form>

                    </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>


<script src="~/libs/vuelidate/vuelidate.min.js"></script>
<script src="~/libs/vuelidate/validators.min.js"></script>

<script src="~/js/shared/company-profile.js" asp-append-version="true"></script>