@{
    ViewBag.Title = "Balance Sheet";
    Layout = "~/Views/Shared/Layout/_adminLedgerLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> GL Reports </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#"> Balance Sheet </a>
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Balance Sheet </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">

                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label><strong>Start Date:</strong></label>
                                            <input type="date" class="form-control" v-model="startDate" v-on:change="getReportData()">
                                        </div>
                                    </div>
                                    
                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label><strong>End Date:</strong></label>
                                            <input type="date" class="form-control" v-model="endDate" v-on:change="getReportData()">
                                        </div>
                                    </div>
                                    
                                    <div class="col-sm-3">

                                        <div class="form-group">

                                            <label> <strong> Expense Account : </strong>  </label>
                                            <select class="form-control mb-3" v-model="accountId" ref="accountId">
                                                <option value=""> Select Expense Account </option>
                                                <option :value="account.id" v-for="account in expenseAccountList"> {{account.accountNo}}-{{account.accountName}} </option>
                                            </select>
                                        </div>

                                    </div>
                                    
                                    <div class="col-sm-2">

                                        <div class="form-group">

                                            <label> <strong> Select Report Type: </strong>  </label>
                                            <select class="form-control" v-model="reportType" ref="reportType">
                                                <option value="detail"> Detail </option>
                                                <option value="summary"> Summary </option>
                                                <option value="prior-period">Prior Period</option>
                                                <option value="prior-period-summary">Prior Period Summary</option>
                                                <option value="comparative-balance-sheet">Comparative Balance Sheet</option>
                                            </select>

                                        </div>

                                    </div>
                                    

                                    <div class="col-sm-2 mt-1">

                                        <div class="form-group mt-1">
                                            <button type="button" class="alignright btn btn-primary" v-on:click="getReportData()"> Search </button>
                                        </div>

                                    </div>

                                </div>

                                <hr />

                                <div style="height:auto;width:auto;min-height:500px;" id="reportView">  </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>


<script src="~/js/gl/reports/balance-sheet.js" asp-append-version="true"></script>