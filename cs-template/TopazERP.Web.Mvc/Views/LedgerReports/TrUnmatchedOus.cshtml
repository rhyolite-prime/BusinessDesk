@{
    ViewBag.Title = "GL Transactions Reports | Unmatched OUs";
    Layout = "~/Views/Shared/Layout/_adminLedgerLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> GL Reports </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#"> GL Transaction Reports </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Unmatched OUs
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">  GL Transaction Report - Unmatched OUs </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">

                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label><strong>End Date:</strong></label>
                                            <input type="date" class="form-control" v-model="endDate" v-on:change="getReportData()">
                                        </div>
                                    </div>
                                    
                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label><strong>Batch No.:</strong></label>
                                            <input type="text" class="form-control" v-model="batchNo" v-on:change="getReportData()">
                                        </div>
                                    </div>
                                    
                                    <div class="col-sm-4">

                                        <div class="form-group">

                                            <label> <strong> OU: </strong>  </label>
                                            <select class="form-control mb-3" v-model="ouId" ref="ouId">
                                                <option value=""> Select OU </option>
                                                <option :value="ou.id" v-for="ou in costCenterHierachyList"> {{ou.name}} </option>
                                            </select>
                                        </div>

                                    </div>
                                    
                                    <div class="col-sm-3">

                                        <div class="form-group">

                                            <label> <strong> Account Number: </strong>  </label>
                                            <select class="form-control mb-3" v-model="accountId" ref="accountId">
                                                <option value=""> Select Account </option>
                                                <option :value="account.id" v-for="account in accountList"> {{account.accountNo}}-{{account.accountName}} </option>
                                            </select>
                                        </div>

                                    </div>
                                    
                                    
                                    <div class="col-sm-2">

                                        <div class="form-group">

                                            <label> <strong> Journal Entry Type: </strong>  </label>
                                            <select class="form-control mb-3" v-model="journalEntryType" ref="journalEntryType">
                                                <option value="local"> Local Currency Transaction</option>
                                                <option value="foreign"> Foreign Currency Transaction</option>
                                                
                                            </select>
                                        </div>

                                    </div>

                                    <div class="col-sm-2 mt-1">

                                        <div class="form-group mt-1">
                                            <button type="button" class="alignright btn btn-primary" v-on:click="getReportData()"> Search </button>
                                        </div>

                                    </div>

                                </div>

                                <hr />

                                <div style="height:auto;width:auto;min-height:500px;" id="reportView">  </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>


<script src="~/js/gl/reports/tr-unmatched-ous.js" asp-append-version="true"></script>