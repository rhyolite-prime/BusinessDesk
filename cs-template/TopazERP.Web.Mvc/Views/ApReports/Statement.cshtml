@{
    ViewBag.Title = "Statement";
    Layout = "~/Views/Shared/Layout/_adminApLayout.cshtml";
}

<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Statement</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb ">
                            <li class="breadcrumb-item">
                                <a href="#" class="text-info">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#" class="text-info"> Reports </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Statement
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card b">
                        <div class="card-header">
                            <h4 class="card-title"> Statement </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label><strong>Select Report Type:</strong></label>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" id="type1" value="type1" v-model="reportType">
                                                <label class="form-check-label" for="type1">Type 1</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" id="type2" value="type2" v-model="reportType">
                                                <label class="form-check-label" for="type2">Type 2</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" id="type3" value="type3" v-model="reportType">
                                                <label class="form-check-label" for="type3">Type 3</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label> <strong>Supplier:</strong> </label>
                                            <input id="supplierId" v-model="supplierId" type="text" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="col-sm-3"  v-if="reportType == 'type2' || reportType == 'type3'">

                                        <div class="form-group">
                                            <label> <strong>Start Date:</strong> </label>
                                            <input id="startDate" v-model="startDate"  type="date" class="form-control" />

                                        </div>

                                    </div>
                                    <div class="col-sm-3" v-if="reportType == 'type2' || reportType == 'type3'">

                                        <div class="form-group">
                                            <label> <strong> End Date: </strong> </label>
                                            <input id="endDate" v-model="endDate"  type="date" class="form-control" />

                                        </div>

                                    </div>

                                    <div class="col-sm-2 mt-1">

                                        <div class="form-group mt-1">

                                            <button type="button" class="alignright btn btn-success" @@click="getReportData()"> Search </button>

                                        </div>

                                    </div>

                                </div>

                                <hr />

                                <div style="height:auto;width:auto;min-height:500px;" id="reportView">  </div>

                            </div>

                        </div>
                    </div>
                </div>
                
            </div>


        </div>
    </div>
</div>


<script src="~/js/ap/GeneralReports/statements.js" asp-append-version="true"></script>