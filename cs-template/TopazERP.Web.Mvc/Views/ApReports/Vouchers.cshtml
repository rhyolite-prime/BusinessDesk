@{
    ViewBag.Title = "Vouchers";
    Layout = "~/Views/Shared/Layout/_adminApLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
</style>

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Vouchers Reports</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb ">
                            <li class="breadcrumb-item">
                                <a href="#" class="text-info">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#" class="text-info"> Reports </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Vouchers
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card b">
                        <div class="card-header">
                            <h4 class="card-title"> Vouchers </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label> <strong> Select Report Type: </strong>  </label>
                                            <select class="form-control" v-model="reportType" ref="reportType">
                                                <option value="summary-report"> Summary </option>
                                                <option value="details"> By Voucher Number </option>
                                                <option value="bySupplier"> By Supplier </option>
                                                <option value="byInvoice"> By Invoice </option>
                                                <option value="byDate"> By Date </option>
                                                
                                            </select>

                                        </div>
                                    </div>

                                    <div class="col-sm-3" v-show="reportType == 'bySupplier'">
                                        <div class="form-group">
                                            <label> <strong>Supplier:</strong> </label>
                                            <input id="supplierId" v-model="supplierId" type="text" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="col" v-show="reportType == 'byDate'">
                                        <div class="row" >
                                            <div class="col">

                                                <div class="form-group">
                                                    <label> <strong>Start Date:</strong> </label>
                                                    <input v-model="startDate" ref="startDate" type="date" class="form-control" />

                                                </div>

                                            </div>
                                            <div class="col">

                                                <div class="form-group">
                                                    <label> <strong> End Date: </strong> </label>
                                                    <input v-model="endDate" ref="endDate" type="date" class="form-control" />

                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-3" v-show="reportType == 'byInvoice'">
                                        <div class="form-group">
                                            <label> <strong>Invoice Number:</strong> </label>
                                            <input id="invoiceId" v-model="invoiceId" type="text" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="col-sm-3" v-show="reportType == 'details'">
                                        <div class="form-group">
                                            <label> <strong>Voucher Number:</strong> </label>
                                            <input id="voucherId" v-model="voucherId" type="text" class="form-control" />
                                        </div>
                                    </div>
                                   

                                    <div class="col-sm-2 mt-1">

                                        <div class="form-group mt-1">

                                            <button type="button" class="alignright btn btn-success" v-on:click="getReportData()"> Search </button>

                                        </div>

                                    </div>

                                </div>

                                <hr />

                                <div style="height:auto;width:auto;min-height:500px;" id="reportView">  </div>

                            </div>

                        </div>
                    </div>
                </div>
                
            </div>


        </div>
    </div>
</div>


<script src="~/js/ap/GeneralReports/voucher.js" asp-append-version="true"></script>