@{
    ViewBag.Title = "Supplier Lists";
    Layout = "~/Views/Shared/Layout/_adminApLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
</style>

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Supplier List Type 1 </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb ">
                            <li class="breadcrumb-item">
                                <a href="#" class="text-info">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#" class="text-info"> General Reports </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Supplier List
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card b">
                        <div class="card-header">
                            <h4 class="card-title"> Supplier List   </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row justify-content-center">

                                    <div class="col-sm-2">  </div>

                                    <div class="col-sm-3 ">


                                        <div class="form-group">
                                            <label> <strong> Select Report Type: </strong>  </label>
                                            <select class="form-control" v-model="reportType" ref="reportType">
                                                <option value="summary-report"> Type 1 </option>
                                                <option value="supplier-group"> Type 2 </option>
                                            </select>

                                        </div>

                                    </div>
                                    
                                    <div class="col-sm-3 " v-show="reportType == 'supplier-group'">

                                        <div class="form-group">
                                            <label> <strong> Supplier Group: </strong>  </label>
                                            <select class="form-control" v-model="supplierGroupId" ref="supplierGroup">
                                                <option> Select Supplier Group</option>
                                                <option v-for="group in supplierGroupList" :value="group.id"> {{ group.name }} </option>
                                            </select>
                                            
                                        </div>
                                        </div>

                                            <div class="col-sm-2 mt-1">

                                        <div class="form-group mt-1">

                                            <button type="button" class="alignright btn btn-success" v-on:click="getReportData()"> Search </button>

                                        </div>

                                    </div>

                                </div>

                                <hr />

                                <div style="height:auto;width:auto;min-height:500px;" id="reportView">  </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>



<script src="~/js/ap/GeneralReports/supplierLists.js" asp-append-version="true"></script>