@{
    ViewBag.Title = "Add Relations";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
    var staffId = ViewBag.StaffId;
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-body" id="app">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Staff Relations - {{staffName}}</h4>
                        </div>
                        
                        <div class="card-content collapse show">
                            <div class="card-body" >
                                <div class="table-responsive">
                                    <div class="mb-2 ">
                                        <a :href="'/SmStaffSetups/UpdateStaff?id=' + form.staffId" class="text-primary text-xl">
                                            <i class="las la-arrow-alt-circle-left"></i> Go Back
                                        </a>
                                        <a :href="'/SmStaffSetups/Qualification?staffId=' + form.staffId" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Qualification
                                        </a>
                                        <a :href="'/SmStaffSetups/PastEmployments?staffId=' + form.staffId" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Past Employment
                                        </a>
                                        <a :href="'/SmStaffSetups/PastPositions?staffId=' + form.staffId" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Past Position
                                        </a>
                                    </div>
                                    <table class="table-responsive table table-striped table-bordered table-hover">
                                        <thead class="table-light">
                                        <tr>
                                            <th>Relationship</th>
                                            <th style="width: 450px;">Name</th>
                                            <th style="width: 450px;">Address</th>
                                            <th style="width: 250px;">Phone No.</th>
                                            <th>Actions</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr v-for="relation in relations" :key="relation.id" >
                                            <td>{{ relation.relationShipName }}</td>
                                            <td>{{ relation.name }}</td>
                                            <td>{{ relation.address }}</td>
                                            <td>{{ relation.phoneNumber }}</td>
                                            <td>
                                                <a class="text-primary me-1" @@click="editRelation(relation)">
                                                    <i class="la la-edit"></i>
                                                </a>
                                                <a class="text-danger" @@click="deleteRelation(relation.id)">
                                                    <i class="la la-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <form class="mb-5">
                                    <input type="hidden" v-model="form.staffId"/>
                                    <div class="row g-3">
                                        <div class="col-md-3 my-1">
                                            <label class="form-label">Relationship</label>
                                            <select  v-model="form.relationshipId" class="form-control" @@change="setRelationshipName">
                                                <option v-for="rel in relationships" :value="rel.id">{{ rel.name }}</option>
                                            </select>
                                            </div>
                                        <div class="col-md-3 my-1">
                                            <label for="name" class="form-label">Name</label>
                                            <input type="text" v-model="form.name" id="name" class="form-control" />
                                        </div>
                                    
                                        <div class="col-md-3 my-1">
                                            <label for="address" class="form-label">Address</label>
                                            <input type="text" v-model="form.address" id="address" class="form-control" />
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label for="phoneNumber" class="form-label">Phone No.</label>
                                            <input type="text" v-model="form.phoneNumber" id="phoneNumber" class="form-control" />
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label for="faxNumber" class="form-label">Fax No.</label>
                                            <input type="text" v-model="form.faxNumber" id="faxNumber" class="form-control" />
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label for="email" class="form-label">Email</label>
                                            <input type="email" v-model="form.email" id="email" class="form-control" />
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label for="mobileNumber" class="form-label">Mobile</label>
                                            <input type="text" v-model="form.mobileNumber" id="mobileNumber" class="form-control" />
                                        </div>
                                  
                                    </div>
                                    <div class="mt-3">
                                        <button type="button" @@click="saveRelation" class="btn btn-success">Save</button>
                                        <a href="/SmStaffSetUps/StaffBio" class="btn btn-secondary">Cancel</a>
                                    </div>
                                </form>



                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
                        </div>
                    </div>
                </div>
<script>
    window.staffId = @Html.Raw(Json.Serialize(ViewBag.StaffId ?? ""));
</script>

<script src="~/js/school-manager/staff/relationships.js" asp-append-version="true"></script>

