@{
    ViewBag.Title = "Update Staff";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#"> Staff SetUps </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Update Staff Info
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Update Staff</h4>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <form>
                                    <div class="">
                                        <a href="@Url.Action("StaffBio", "SmStaffSetups")" class="text-primary text-xl">
                                            <i class="las la-arrow-alt-circle-left"></i> Go Back
                                        </a>
                                        <a :href="'/SmStaffSetups/Qualification?staffId=' + form.id" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Qualification
                                        </a>
                                        <a :href="'/SmStaffSetups/Relations?staffId=' + form.id" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Relations
                                        </a>
                                        <a :href="'/SmStaffSetups/PastEmployments?staffId=' + form.id" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Past Employment
                                        </a>
                                        <a :href="'/SmStaffSetups/PastPositions?staffId=' + form.id" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Past Position
                                        </a>
                                    </div>
                                    <div class="row g-3">
                                        <!-- Staff Basic Info -->
                                        <div class="col-md-3 my-1">
                                            <label>Staff Identifier</label>
                                            <input type="text" v-model="form.staffIdentifier" class="form-control" readonly>
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>First Name</label><span class="text-danger">*</span>
                                            <input type="text" v-model="form.firstName" class="form-control"  :class="{'is-invalid': errors.firstName}" required>
                                            <small v-if="errors.firstName" class="text-danger">
                                                {{ errors.firstName }}
                                            </small>
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Other Name</label>
                                            <input type="text" v-model="form.otherName" class="form-control">
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Last Name</label><span class="text-danger">*</span>
                                            <input type="text" v-model="form.lastName" class="form-control" :class="{'is-invalid': errors.lastName}" required>
                                            <small v-if="errors.lastName" class="text-danger">
                                                {{ errors.lastName }}
                                            </small>
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Date of Birth</label><span class="text-danger">*</span>
                                            <input type="date" v-model="form.dateOfBirth" class="form-control" :class="{'is-invalid': dobError}">
                                            <small v-if="dobError" class="text-danger">
                                                {{ dobError }}
                                            </small>
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Gender</label><span class="text-danger">*</span>
                                            <select v-model="form.gender" class="form-control">
                                                <option value="Male">Male</option>
                                                <option value="Female">Female</option>
                                            </select>
                                        </div>

                                        <!-- Contact Info -->
                                        <div class="col-md-3 my-1">
                                            <label>Email</label><span class="text-danger">*</span>
                                            <input type="email" v-model="form.email" class="form-control" :class="{'is-invalid': errors.email}">
                                            <small v-if="errors.email" class="text-danger">
                                                {{ errors.email }}
                                            </small>
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Contact Number</label><span class="text-danger">*</span>
                                            <input type="text" v-model="form.contactNumber" class="form-control" :class="{'is-invalid': errors.contactNumber}">
                                            <small v-if="errors.contactNumber" class="text-danger">
                                                {{ errors.contactNumber }}
                                            </small>
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Address</label><span class="text-danger">*</span>
                                            <input type="text" v-model="form.address" class="form-control" :class="{'is-invalid': errors.address}">
                                            <small v-if="errors.address" class="text-danger">
                                                {{ errors.address }}
                                            </small>
                                        </div>

                                        <!-- Title, Designation, Grade -->
                                        <div class="col-md-3 my-1">
                                            <label>Title</label><span class="text-danger">*</span>
                                            <select v-model="form.titleId" class="form-control" :class="{'is-invalid': errors.titleId}">
                                                <option v-for="title in titles" :value="title.id">{{ title.name }}</option>
                                            </select>
                                            <small v-if="errors.titleId" class="text-danger">
                                                {{ errors.titleId }}
                                            </small>
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Designation</label>
                                            <select v-model="form.designationId" class="form-control">
                                                <option v-for="des in designations" :value="des.id">{{ des.name }}</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Grade</label>
                                            <select v-model="form.gradeId" class="form-control">
                                                <option v-for="grade in grades" :value="grade.id">{{ grade.name }}</option>
                                            </select>
                                        </div>

                                        <!-- Employment Dates -->
                                        <div class="col-md-3 my-1">
                                            <label>Date of Employment</label><span class="text-danger">*</span>
                                            <input type="date" v-model="form.dateOfEmployment" class="form-control" :class="{'is-invalid': errors.dateOfEmployment}">
                                            <small v-if="errors.dateOfEmployment" class="text-danger">
                                                {{ errors.dateOfEmployment }}
                                            </small>
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Date Appointed</label><span class="text-danger">*</span>
                                            <input type="date" v-model="form.dateAppointed" class="form-control" :class="{'is-invalid': errors.dateAppointed}">
                                            <small v-if="errors.dateAppointed" class="text-danger">
                                                {{ errors.dateAppointed }}
                                            </small>
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Date Promoted To Grade</label>
                                            <input type="date" v-model="form.datePromotedToGrade" class="form-control">
                                        </div>

                                        <!-- Teacher Checkbox & Academic Year -->
                                        <div class="col-md-3 my-1">
                                            <label>Is Teacher</label><br>
                                            <input type="checkbox" v-model="form.isTeacher" class="form-control">
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Academic Year</label><span class="text-danger">*</span>
                                            <select v-model="form.academicYearId"
                                                    class="form-control"
                                                    :class="{'is-invalid': errors.academicYearId}">
                                                <option v-for="year in academicYears" :value="year.id">
                                                    {{ year.name }}
                                                </option>
                                            </select>

                                            <small v-if="errors.academicYearId" class="text-danger">
                                                {{ errors.academicYearId }}
                                            </small>
                                        </div>
                                        

                                        <!-- Social Security & Notes -->
                                        <div class="col-md-3 my-1">
                                            <label>Social Security Number</label>
                                            <input type="text" v-model="form.socialSecurityNumber" class="form-control">
                                        </div>

                                        <!-- Next of Kin -->
                                        <div class="col-md-3 my-1">
                                            <label>Next of Kin Name</label><span class="text-danger">*</span>
                                            <input type="text" v-model="form.nextOfKinName" class="form-control" :class="{'is-invalid': errors.nextOfKinName}">
                                            <small v-if="errors.nextOfKinName" class="text-danger">
                                                {{ errors.nextOfKinName }}
                                            </small>
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Next of Kin Contact</label><span class="text-danger">*</span>
                                            <input type="text" v-model="form.nextOfKinContactNumber" class="form-control" :class="{'is-invalid': errors.nextOfKinContactNumber}">
                                            <small v-if="errors.nextOfKinContactNumber" class="text-danger">
                                                {{ errors.nextOfKinContactNumber }}
                                            </small>
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Next of Kin Email</label>
                                            <input type="email" v-model="form.nextOfKinEmail" class="form-control">
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Next of Kin Address</label>
                                            <input type="text" v-model="form.nextOfKinAddress" class="form-control">
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Next of Kin Relationship</label><span class="text-danger">*</span>
                                            <select v-model="form.nextOfKinRelationshipId" class="form-control"  :class="{'is-invalid': errors.nextOfKinRelationshipId}">
                                                <option v-for="rel in relationships" :value="rel.id">{{ rel.name }}</option>
                                            </select>
                                            <small v-if="errors.nextOfKinRelationshipId" class="text-danger">
                                                {{ errors.nextOfKinRelationshipId }}
                                            </small>
                                        </div>

                                        <div class="col-md-6 my-1">
                                            <label>Notes</label>
                                            <textarea v-model="form.notes" class="form-control"></textarea>
                                        </div>

                                    </div>
                                    <div class="my-2 float-right">
                                        <a href="@Url.Action("StaffBio", "SmStaffSetUps")" class="btn btn-secondary"><i class="la la-times"></i>Cancel</a>
                                        <button type="button" @@click="updateStaff" class="btn btn-primary ml-1"><i class="la la-save"></i>Save</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/school-manager/staff/updateStaff.js" asp-append-version="true"></script>
