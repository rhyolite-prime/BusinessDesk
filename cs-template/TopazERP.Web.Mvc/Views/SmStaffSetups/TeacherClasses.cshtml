@{
    ViewBag.Title = "Assign Classes";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Assign Classes</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#"> Staff SetUps </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Assign Classes
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Assign Classes To Teachers</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <!-- Selection Controls -->
                                <div class="row g-3 mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Teacher:</label>
                                        <input id="teacherId"/>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Class:</label>
                                        <input id="classId"/>

                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Academic Year:</label>
                                        <input id="academicYearId"/>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-primary btn-sm mb-3" @@click="assignClass"
                                        :disabled="!teacherId || !classId || !academicYearId">
                                  <i class="la la-save"></i> Save
                                </button>

                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <input type="text" v-model="searchQuery" class="form-control" placeholder="Search by teacher or class">
                                    </div>
                                </div>
                                <!-- Table -->
                                <div class="table-responsive">
                                    <table class="table-responsive table table-striped  table-hover">
                                        <thead class="bg-primary text-white">
                                        <tr>
                                            <th style="width: 450px;">Teacher</th>
                                            <th style="width: 450px;">Class</th>
                                            <th style="width: 250px;">Academic Year</th>
                                            <th>Actions</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <template v-for="teacher in paginatedTeacherClasses" :key="teacher.staffId">
                                            <tr >
                                                <td colspan="4"><b>{{ getTeacherName(teacher.staffId) }}</b>
                                                </td>
                                            </tr>
                                            <tr  v-for="cls in teacher.classes" :key="cls.id">
                                                <td></td>
                                                <td>{{ getLevelClassNameFromId(cls.classId) }}</td>
                                                <td>{{ getAcademicYearName(cls.academicYearId) }}</td>
                                                <td>
                                                    <a class="text-danger" @@click="deleteTeacherClass(cls.id)">
                                                        <i class="la la-trash"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        </template>
                                        </tbody>
                                    </table>
                                </div>

                                <nav class="float-right">
                                    <ul class="pagination">
                                        <button @@click.prevent="currentPage--" class="btn btn-sm btn-primary mr-1" :class="{ disabled: currentPage === 1 }">
                                          Prev
                                        </button>
                                        <p>Page {{currentPage}} of {{totalPages}}</p>
                                        <button class="btn btn-sm btn-primary ml-1" :class="{ disabled: currentPage === totalPages }" @@click.prevent="currentPage++">Next
                                        </button>
                                    </ul>
                                </nav>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/vue-select@4.0.0/dist/vue-select.css">

<script src="https://unpkg.com/vue-select@4.0.0/dist/vue-select.umd.min.js"></script>


<script src="~/js/school-manager/staff/assignclasses.js" asp-append-version="true"></script>
