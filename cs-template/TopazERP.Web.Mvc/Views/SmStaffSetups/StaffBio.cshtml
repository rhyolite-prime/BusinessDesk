@{
    ViewBag.Title = "Staff Bio";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Staff List</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#"> Staff SetUps </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Staff List
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Staff List</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div class="container-fluid">
                                    <div class="d-flex justify-content-between align-items-center ">
                                        <h4>Staff Management</h4>
                                        <a href="/SmStaffSetups/CreateStaff" class="btn btn-outline-primary">
                                            <i class="la la-plus"></i> Add New Staff
                                        </a>
                                    </div>

                                    <!-- Search -->
                                    <div class="row mb-1">
                                        <div class="col-md-4">
                                            <input type="text" v-model="searchQuery" class="form-control rounded-lg" placeholder="Search staff...">
                                        </div>
                                    </div>

                                    <!-- Table -->
                                    <div class="table-responsive">
                                        <table class="table-responsive table table-striped table-bordered table-hover">
                                            <thead class="bg-primary text-white font-weight-bold">
                                            <tr>
                                                <th @@click="sortBy('staffIdentifier')">Staff ID</th>
                                                <th style="width: 600px;" @@click="sortBy('fullName')">Name</th>
                                                <th @@click="sortBy('email')">Email</th>
                                                <th>Teacher</th>
                                                <th>Actions</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            <tr v-for="staff in paginatedData" :key="staff.id" >
                                                <td @@click="viewStaff(staff)" class="cursor-pointer">{{ staff.staffIdentifier }}</td>
                                                <td @@click="viewStaff(staff)" class="cursor-pointer">{{ staff.fullName }}</td>
                                                <td @@click="viewStaff(staff)" class="cursor-pointer">{{ staff.email }}</td>
                                                <td @@click="viewStaff(staff)" class="cursor-pointer">
                                                    <span class="badge" :class="staff.isTeacher ? 'text-success' : 'text-secondary'">
                                                        {{ staff.isTeacher ? 'Yes' : 'No' }}
                                                    </span>
                                                </td>
                                                <td>
                                                    <a :href="'/SmStaffSetups/UpdateStaff?id=' + staff.id" class="text-primary me-1">
                                                        <i class="la la-edit"></i>
                                                    </a>
                                                    <a class="text-danger" @@click="deleteStaff(staff.id)">
                                                        <i class="la la-trash"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- Pagination -->
                                    <nav class="float-right">

                                        <ul class="pagination">

                                            <li class="page-item"
                                                :class="{ disabled: currentPage === 1 }">

                                                <a class="page-link"
                                                   href="#"
                                                   @@click.prevent="changePage(currentPage - 1)">

                                                    Prev

                                                </a>
                                            </li>

                                            <li class="page-item"
                                                v-for="(page,index) in visiblePages"
                                                :key="index"
                                                :class="{
                active: page === currentPage,
                disabled: page === '...'
            }">

                                                <a class="page-link bg-primary"
                                                   href="#"
                                                   @@click.prevent="page !== '...' ? changePage(page) : null">

                                                    {{ page }}

                                                </a>
                                            </li>

                                            <li class="page-item"
                                                :class="{ disabled: currentPage === totalPages }">

                                                <a class="page-link text-primary"
                                                   href="#"
                                                   @@click.prevent="changePage(currentPage + 1)">

                                                    Next

                                                </a>
                                            </li>

                                        </ul>

                                    </nav>
                                </div>
                                <div v-if="showStaffModal" class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-lg">
            
            <!-- Header -->
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title text-white">
                    {{ selectedStaff.fullName }}
                </h5>
                <button type="button" class="btn btn-sm btn-danger btn-close" @@click="closeModal"><i class="la la-close"></i></button>
            </div>

            <!-- Body -->
            <div class="modal-body" v-if="selectedStaff">
                <div class="row">
                    
                    <div class="col-md-6 mb-2">
                        <strong>Staff ID:</strong> {{ selectedStaff.staffIdentifier }}
                    </div>

                    <div class="col-md-6 mb-2">
                        <strong>Email:</strong> {{ selectedStaff.email }}
                    </div>

                    <div class="col-md-6 mb-2">
                        <strong>Phone:</strong> {{ selectedStaff.contactNumber }}
                    </div>

                    <div class="col-md-6 mb-2">
                        <strong>Gender:</strong> {{ selectedStaff.gender }}
                    </div>

                    <div class="col-md-6 mb-2">
                        <strong>Designation:</strong> {{ selectedStaff.designationName }}
                    </div>

                    <div class="col-md-6 mb-2">
                        <strong>Grade:</strong> {{ selectedStaff.gradeName }}
                    </div>

                    <div class="col-md-6 mb-2">
                        <strong>Employment Date:</strong> {{ formatDate(selectedStaff.dateOfEmployment) }}
                    </div>

                    <div class="col-md-6 mb-2">
                        <strong>Teacher:</strong> 
                        <span :class="selectedStaff.isTeacher ? 'text-success' : 'text-secondary'">
                            {{ selectedStaff.isTeacher ? 'Yes' : 'No' }}
                        </span>
                    </div>

                    <div class="col-12 mt-2">
                        <strong>Address:</strong> {{ selectedStaff.address }}
                    </div>

                    <hr class="w-100">

                    <div class="col-12">
                        <h6 class="text-primary">Next of Kin</h6>
                    </div>

                    <div class="col-md-6">
                        <strong>Name:</strong> {{ selectedStaff.nextOfKinName }}
                    </div>

                    <div class="col-md-6">
                        <strong>Phone:</strong> {{ selectedStaff.nextOfKinContactNumber }}
                    </div>

                    <div class="col-md-6">
                        <strong>Email:</strong> {{ selectedStaff.nextOfKinEmail }}
                    </div>

                    <div class="col-md-6">
                        <strong>Address:</strong> {{ selectedStaff.nextOfKinAddress }}
                    </div>

                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer">
                <a :href="'/SmStaffSetups/UpdateStaff?id=' + selectedStaff.id" class="btn btn-primary">
                    <i class="la la-edit"></i> Edit
                </a>
                <button class="btn btn-secondary" @@click="closeModal">Close</button>
            </div>

        </div>
    </div>
</div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>


<script src="~/js/school-manager/staff/index.js" asp-append-version="true"></script>