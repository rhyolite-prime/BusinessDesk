@{
    ViewBag.Title = "Aging ";
    Layout = "~/Views/Shared/Layout/_adminApLayout.cshtml";
}

<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Aging</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb ">
                            <li class="breadcrumb-item">
                                <a href="#" class="text-info">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#" class="text-info"> Enquiries </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Aging
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card b">
                        <div class="card-header">
                            <h4 class="card-title"> Aging </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">
                                        <div class="col-sm-3 ">
                                            <div class="form-group">
                                                <label> <strong> Number Of Days: </strong>  </label>
                                                <input v-model="agingInterval" ref="agingInterval" type="number" class="form-control"/>

                                            </div>
                                        </div>
                                   
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label> <strong>Start Date:</strong> </label>
                                            <input v-model="startDate" ref="startDate" type="date" class="form-control"/>

                                        </div>
                                    </div>
                                    

                                    <div class="col-sm-2 mt-1">

                                        <div class="form-group mt-1">

                                            <button type="button" class="alignright btn btn-success" v-on:click="getAgingData()"> Search </button>

                                        </div>
                               

                                    </div>

                                </div>

                                <hr />
                                
                                    <div id="dataTable"></div>
                             



                            </div>

                        </div>
                    </div>
                </div>
                
            </div>


        </div>
    </div>
</div>


<script src="~/js/ap/Enquiries/aging.js" asp-append-version="true"></script>
