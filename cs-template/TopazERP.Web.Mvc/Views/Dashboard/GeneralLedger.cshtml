@{
    ViewBag.Title = "Dashboard | General Ledger";
    Layout = "~/Views/Shared/Layout/_adminLedgerLayout.cshtml";
}

<style>
    /* ── Design Tokens ─────────────────────────────────────────── */
    :root {
        --gl-primary:      #667eea;
        --gl-success:      #48bb78;
        --gl-warning:      #f6ad55;
        --gl-danger:       #fc8181;
        --gl-info:         #63b3ed;
        --gl-dark:         #2d3748;
        --gl-muted:        #718096;
        --gl-bg:           #f7f8fc;
        --gl-card:         #ffffff;
        --gl-border:       #e8ecf4;
        --gl-radius:       14px;
        --gl-shadow:       0 2px 12px rgba(102,126,234,0.08);
        --gl-shadow-hover: 0 8px 28px rgba(102,126,234,0.18);
    }

    /* ── Layout ────────────────────────────────────────────────── */
    .gl-dashboard { font-family: 'Inter','Segoe UI',sans-serif; background: var(--gl-bg); }

    /* ── Page Header ───────────────────────────────────────────── */
    .gl-header {
        display: flex; align-items: center; justify-content: space-between;
        flex-wrap: wrap; gap: 12px; margin-bottom: 24px;
    }
    .gl-header-title { font-size: 1.35rem; font-weight: 700; color: var(--gl-dark); margin: 0; }
    .gl-header-sub   { font-size: 0.82rem; color: var(--gl-muted); margin-top: 2px; }
    .gl-period-selector { display: flex; gap: 6px; flex-wrap: wrap; }
    .gl-period-btn {
        padding: 6px 14px; border-radius: 20px; border: 1.5px solid var(--gl-border);
        background: #fff; font-size: 0.78rem; font-weight: 500; color: var(--gl-muted);
        cursor: pointer; transition: all 0.2s;
    }
    .gl-period-btn.active, .gl-period-btn:hover {
        background: var(--gl-primary); color: #fff; border-color: var(--gl-primary);
    }

    /* ── KPI Cards ─────────────────────────────────────────────── */
    .gl-stats-row {
        display: grid; grid-template-columns: repeat(auto-fit,minmax(190px,1fr));
        gap: 16px; margin-bottom: 22px;
    }
    .gl-stat-card {
        background: var(--gl-card); border-radius: var(--gl-radius);
        padding: 18px 20px; display: flex; align-items: center; gap: 16px;
        box-shadow: var(--gl-shadow); border: 1px solid var(--gl-border);
        transition: transform 0.2s, box-shadow 0.2s;
        position: relative; overflow: hidden;
    }
    .gl-stat-card:hover { transform: translateY(-3px); box-shadow: var(--gl-shadow-hover); }
    .gl-stat-card::before {
        content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
        border-radius: var(--gl-radius) var(--gl-radius) 0 0;
    }
    .gl-stat-card.primary::before { background: linear-gradient(90deg,#667eea,#764ba2); }
    .gl-stat-card.success::before { background: linear-gradient(90deg,#48bb78,#38a169); }
    .gl-stat-card.warning::before { background: linear-gradient(90deg,#f6ad55,#ed8936); }
    .gl-stat-card.danger::before  { background: linear-gradient(90deg,#fc8181,#e53e3e); }
    .gl-stat-card.info::before    { background: linear-gradient(90deg,#63b3ed,#3182ce); }
    .gl-stat-card.dark::before    { background: linear-gradient(90deg,#718096,#4a5568); }
    .gl-stat-icon {
        width: 48px; height: 48px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem; flex-shrink: 0;
    }
    .gl-stat-card.primary .gl-stat-icon { background:rgba(102,126,234,0.12); color:var(--gl-primary); }
    .gl-stat-card.success .gl-stat-icon { background:rgba(72,187,120,0.12);  color:var(--gl-success); }
    .gl-stat-card.warning .gl-stat-icon { background:rgba(246,173,85,0.12);  color:var(--gl-warning); }
    .gl-stat-card.danger  .gl-stat-icon { background:rgba(252,129,129,0.12); color:var(--gl-danger);  }
    .gl-stat-card.info    .gl-stat-icon { background:rgba(99,179,237,0.12);  color:var(--gl-info);    }
    .gl-stat-card.dark    .gl-stat-icon { background:rgba(113,128,150,0.12); color:var(--gl-muted);   }
    .gl-stat-body  { flex: 1; min-width: 0; }
    .gl-stat-value { font-size: 1.35rem; font-weight: 800; color: var(--gl-dark); line-height: 1.1; }
    .gl-stat-label { font-size:0.73rem; font-weight:500; color:var(--gl-muted); margin-top:4px; text-transform:uppercase; letter-spacing:.5px; }
    .gl-stat-sub   { font-size:0.7rem; color:var(--gl-success); margin-top:3px; }
    .gl-stat-sub.neg { color:var(--gl-danger); }

    /* ── Charts Row ────────────────────────────────────────────── */
    .gl-charts-row { display:grid; grid-template-columns:2fr 1fr 1fr; gap:16px; margin-bottom:22px; }
    @@media(max-width:992px){ .gl-charts-row{ grid-template-columns:1fr 1fr; } }
    @@media(max-width:600px) { .gl-charts-row{ grid-template-columns:1fr; } }

    /* ── Tables Row ────────────────────────────────────────────── */
    .gl-tables-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:22px; }
    @@media(max-width:768px){ .gl-tables-row{ grid-template-columns:1fr; } }

    /* ── Card Component ────────────────────────────────────────── */
    .gl-card {
        background:var(--gl-card); border-radius:var(--gl-radius);
        box-shadow:var(--gl-shadow); border:1px solid var(--gl-border); overflow:hidden;
    }
    .gl-card-header {
        display:flex; align-items:center; justify-content:space-between;
        padding:14px 18px; border-bottom:1px solid var(--gl-border);
    }
    .gl-card-title { font-size:0.92rem; font-weight:700; color:var(--gl-dark); margin:0; }
    .gl-card-sub   { font-size:0.73rem; color:var(--gl-muted); margin-top:2px; }
    .gl-card-body  { padding:14px 18px; }
    .gl-card-actions { display:flex; gap:6px; }
    .gl-card-actions a { color:var(--gl-muted); font-size:.85rem; cursor:pointer; transition:color .2s; }
    .gl-card-actions a:hover { color:var(--gl-primary); }

    /* ── Search ────────────────────────────────────────────────── */
    .gl-search {
        display:flex; align-items:center; background:var(--gl-bg);
        border:1.5px solid var(--gl-border); border-radius:8px;
        padding:5px 10px; gap:8px; width:200px; transition:border-color .2s;
    }
    .gl-search:focus-within { border-color:var(--gl-primary); }
    .gl-search input { border:none; background:transparent; outline:none; font-size:.8rem; color:var(--gl-dark); width:100%; }
    .gl-search i { color:var(--gl-muted); font-size:.85rem; }

    /* ── Table ─────────────────────────────────────────────────── */
    .gl-table-wrap { overflow-x:auto; }
    .gl-table { width:100%; border-collapse:collapse; font-size:.8rem; }
    .gl-table thead th {
        background:#f8f9fe; color:var(--gl-muted); font-weight:600; font-size:.72rem;
        text-transform:uppercase; letter-spacing:.4px; padding:10px 12px;
        white-space:nowrap; cursor:pointer; user-select:none;
        border-bottom:1.5px solid var(--gl-border);
    }
    .gl-table thead th:hover { color:var(--gl-primary); }
    .gl-table tbody tr { border-bottom:1px solid #f0f2f8; transition:background .15s; }
    .gl-table tbody tr:hover { background:#f8f9fe; }
    .gl-table tbody td { padding:9px 12px; color:var(--gl-dark); vertical-align:middle; }
    .gl-table tbody td.amount { font-weight:600; font-family:'Courier New',monospace; }
    .gl-table tbody td.debit-val  { color:#e53e3e; }
    .gl-table tbody td.credit-val { color:#38a169; }
    .gl-table tbody td.balance-pos { color:#38a169; font-weight:700; }
    .gl-table tbody td.balance-neg { color:#e53e3e; font-weight:700; }

    /* ── Badges ────────────────────────────────────────────────── */
    .gl-badge {
        display:inline-block; padding:2px 9px; border-radius:10px;
        font-size:.68rem; font-weight:600; letter-spacing:.3px;
    }
    .badge-posted    { background:rgba(72,187,120,.12);  color:#2f855a; }
    .badge-unposted  { background:rgba(246,173,85,.12);  color:#c05621; }
    .badge-asset     { background:rgba(102,126,234,.12); color:#553c9a; }
    .badge-liability { background:rgba(252,129,129,.12); color:#c53030; }
    .badge-equity    { background:rgba(99,179,237,.12);  color:#2b6cb0; }
    .badge-revenue   { background:rgba(72,187,120,.12);  color:#276749; }
    .badge-expense   { background:rgba(246,173,85,.12);  color:#7b341e; }

    /* ── Pagination ────────────────────────────────────────────── */
    .gl-pagination {
        display:flex; align-items:center; justify-content:flex-end;
        gap:8px; padding:10px 18px; border-top:1px solid var(--gl-border);
        font-size:.78rem; color:var(--gl-muted);
    }
    .gl-page-btn {
        padding:4px 12px; border-radius:6px; border:1.5px solid var(--gl-border);
        background:#fff; color:var(--gl-dark); font-size:.75rem; cursor:pointer; transition:all .2s;
    }
    .gl-page-btn:hover:not(:disabled) { background:var(--gl-primary); color:#fff; border-color:var(--gl-primary); }
    .gl-page-btn:disabled { opacity:.4; cursor:not-allowed; }

    /* ── Empty State ───────────────────────────────────────────── */
    .gl-empty { text-align:center; padding:32px 16px; color:var(--gl-muted); font-size:.85rem; }
    .gl-empty i { font-size:2rem; display:block; margin-bottom:8px; opacity:.4; }

    /* ── Account Code chip ─────────────────────────────────────── */
    .gl-acct-code {
        font-family:'Courier New',monospace; font-size:.72rem;
        background:#f0f2f8; border-radius:4px; padding:1px 6px; color:var(--gl-muted);
    }
</style>

<div class="app-content content gl-dashboard">
    <div class="content-wrapper">
        <div class="content-header row"></div>

        <div class="content-body" id="app">

            <!-- Page Header -->
            <div class="gl-header">
                <div>
                    <h1 class="gl-header-title">
                        <i class="la la-book mr-1" style="color:var(--gl-primary);"></i>
                        General Ledger Dashboard
                    </h1>
                    <div class="gl-header-sub">Topaz Accounting Pro &middot; As at September 2024 &middot; Mock Data</div>
                </div>
                <div class="gl-period-selector">
                    <button
                        v-for="p in periods"
                        :key="p"
                        class="gl-period-btn"
                        :class="{ active: selectedPeriod === p }"
                        @@click="selectedPeriod = p">{{ p }}</button>
                </div>
            </div>

            <!-- KPI Summary Cards -->
            <div class="gl-stats-row">

                <div class="gl-stat-card primary">
                    <div class="gl-stat-icon"><i class="la la-arrow-up"></i></div>
                    <div class="gl-stat-body">
                        <div class="gl-stat-value">GHS {{ formatAmount(totalDebits) }}</div>
                        <div class="gl-stat-label">Total Debits</div>
                        <div class="gl-stat-sub">&#8593; 8.4% vs last period</div>
                    </div>
                </div>

                <div class="gl-stat-card success">
                    <div class="gl-stat-icon"><i class="la la-arrow-down"></i></div>
                    <div class="gl-stat-body">
                        <div class="gl-stat-value">GHS {{ formatAmount(totalCredits) }}</div>
                        <div class="gl-stat-label">Total Credits</div>
                        <div class="gl-stat-sub">&#8593; 7.9% vs last period</div>
                    </div>
                </div>

                <div class="gl-stat-card" :class="netBalance >= 0 ? 'warning' : 'danger'">
                    <div class="gl-stat-icon"><i class="la la-balance-scale"></i></div>
                    <div class="gl-stat-body">
                        <div class="gl-stat-value">GHS {{ formatAmount(Math.abs(netBalance)) }}</div>
                        <div class="gl-stat-label">Net Balance</div>
                        <div class="gl-stat-sub" :class="netBalance < 0 ? 'neg' : ''">
                            {{ netBalance >= 0 ? 'Surplus' : 'Deficit' }}
                        </div>
                    </div>
                </div>

                <div class="gl-stat-card info">
                    <div class="gl-stat-icon"><i class="la la-file-text"></i></div>
                    <div class="gl-stat-body">
                        <div class="gl-stat-value">{{ totalJournalEntries.toLocaleString() }}</div>
                        <div class="gl-stat-label">Journal Entries</div>
                        <div class="gl-stat-sub">{{ postedEntries }} posted</div>
                    </div>
                </div>

                <div class="gl-stat-card warning">
                    <div class="gl-stat-icon"><i class="la la-clock-o"></i></div>
                    <div class="gl-stat-body">
                        <div class="gl-stat-value">{{ unpostedEntries }}</div>
                        <div class="gl-stat-label">Unposted Entries</div>
                        <div class="gl-stat-sub neg">Awaiting approval</div>
                    </div>
                </div>

                <div class="gl-stat-card dark">
                    <div class="gl-stat-icon"><i class="la la-sitemap"></i></div>
                    <div class="gl-stat-body">
                        <div class="gl-stat-value">{{ totalAccounts }}</div>
                        <div class="gl-stat-label">Chart of Accounts</div>
                        <div class="gl-stat-sub">5 account types</div>
                    </div>
                </div>

            </div>

            <!-- Charts Row -->
            <div class="gl-charts-row">

                <!-- Monthly Trend -->
                <div class="gl-card">
                    <div class="gl-card-header">
                        <div>
                            <div class="gl-card-title">Monthly Debit vs Credit Trend</div>
                            <div class="gl-card-sub">Jan &ndash; Sep 2024 &bull; Area comparison</div>
                        </div>
                        <div class="gl-card-actions">
                            <a data-action="collapse"><i class="ft-minus"></i></a>
                            <a data-action="reload"><i class="ft-rotate-cw"></i></a>
                            <a data-action="expand"><i class="ft-maximize"></i></a>
                        </div>
                    </div>
                    <div class="card-content collapse show">
                        <div class="gl-card-body" style="padding-top:6px;">
                            <gl-monthly-trend-chart
                                type="area" height="280"
                                :options="glMonthlyTrendChart.chartOptions"
                                :series="glMonthlyTrendChart.series">
                            </gl-monthly-trend-chart>
                        </div>
                    </div>
                </div>

                <!-- Account Type Donut -->
                <div class="gl-card">
                    <div class="gl-card-header">
                        <div>
                            <div class="gl-card-title">Account Distribution</div>
                            <div class="gl-card-sub">By account type</div>
                        </div>
                        <div class="gl-card-actions">
                            <a data-action="collapse"><i class="ft-minus"></i></a>
                            <a data-action="expand"><i class="ft-maximize"></i></a>
                        </div>
                    </div>
                    <div class="card-content collapse show">
                        <div class="gl-card-body" style="padding-top:6px;">
                            <gl-account-type-chart
                                type="donut" height="260"
                                :options="glAccountTypeChart.chartOptions"
                                :series="glAccountTypeChart.series">
                            </gl-account-type-chart>
                        </div>
                    </div>
                </div>

                <!-- Top Expense Bar -->
                <div class="gl-card">
                    <div class="gl-card-header">
                        <div>
                            <div class="gl-card-title">Top Expense Accounts</div>
                            <div class="gl-card-sub">YTD spend by account</div>
                        </div>
                        <div class="gl-card-actions">
                            <a data-action="collapse"><i class="ft-minus"></i></a>
                            <a data-action="expand"><i class="ft-maximize"></i></a>
                        </div>
                    </div>
                    <div class="card-content collapse show">
                        <div class="gl-card-body" style="padding-top:6px;">
                            <gl-debit-credit-chart
                                type="bar" height="260"
                                :options="glDebitCreditChart.chartOptions"
                                :series="glDebitCreditChart.series">
                            </gl-debit-credit-chart>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Tables Row -->
            <div class="gl-tables-row">

                <!-- Recent Journal Entries -->
                <div class="gl-card">
                    <div class="gl-card-header">
                        <div>
                            <div class="gl-card-title">Recent Journal Entries</div>
                            <div class="gl-card-sub">{{ filteredJournalEntries.length }} entries</div>
                        </div>
                        <div class="gl-search">
                            <i class="la la-search"></i>
                            <input v-model="journalSearch" placeholder="Search entries..." @@input="journalCurrentPage = 1" />
                        </div>
                    </div>
                    <div class="card-content collapse show">
                        <div class="gl-table-wrap">
                            <table class="gl-table">
                                <thead>
                                    <tr>
                                        <th @@click="sortJournal('id')">Ref # {{ sortIcon('id', journalSortKey, journalSortOrder) }}</th>
                                        <th @@click="sortJournal('date')">Date {{ sortIcon('date', journalSortKey, journalSortOrder) }}</th>
                                        <th @@click="sortJournal('description')">Description {{ sortIcon('description', journalSortKey, journalSortOrder) }}</th>
                                        <th @@click="sortJournal('debit')" style="text-align:right;">Debit {{ sortIcon('debit', journalSortKey, journalSortOrder) }}</th>
                                        <th @@click="sortJournal('credit')" style="text-align:right;">Credit {{ sortIcon('credit', journalSortKey, journalSortOrder) }}</th>
                                        <th @@click="sortJournal('status')">Status {{ sortIcon('status', journalSortKey, journalSortOrder) }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr v-if="paginatedJournalEntries.length === 0">
                                        <td colspan="6">
                                            <div class="gl-empty">
                                                <i class="la la-search"></i>
                                                No matching entries found.
                                            </div>
                                        </td>
                                    </tr>
                                    <tr v-for="entry in paginatedJournalEntries" :key="entry.id">
                                        <td>
                                            <span style="font-family:'Courier New',monospace;font-size:.75rem;color:var(--gl-primary);font-weight:600;">
                                                {{ entry.id }}
                                            </span>
                                        </td>
                                        <td>{{ entry.date }}</td>
                                        <td>
                                            <div style="font-weight:500;color:var(--gl-dark);">{{ entry.description }}</div>
                                            <div style="font-size:.7rem;color:var(--gl-muted);">{{ entry.account }}</div>
                                        </td>
                                        <td class="amount debit-val" style="text-align:right;">
                                            <span v-if="entry.debit > 0">{{ formatAmount(entry.debit) }}</span>
                                            <span v-else style="color:#cbd5e0;">&#8212;</span>
                                        </td>
                                        <td class="amount credit-val" style="text-align:right;">
                                            <span v-if="entry.credit > 0">{{ formatAmount(entry.credit) }}</span>
                                            <span v-else style="color:#cbd5e0;">&#8212;</span>
                                        </td>
                                        <td>
                                            <span class="gl-badge" :class="statusBadgeClass(entry.status)">{{ entry.status }}</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="gl-pagination">
                            <span>Page {{ journalCurrentPage }} of {{ totalJournalPages }}</span>
                            <button class="gl-page-btn" @@click="prevJournalPage" :disabled="journalCurrentPage === 1">&#8249; Prev</button>
                            <button class="gl-page-btn" @@click="nextJournalPage" :disabled="journalCurrentPage === totalJournalPages">Next &#8250;</button>
                        </div>
                    </div>
                </div>

                <!-- Trial Balance Summary -->
                <div class="gl-card">
                    <div class="gl-card-header">
                        <div>
                            <div class="gl-card-title">Trial Balance Summary</div>
                            <div class="gl-card-sub">{{ filteredAccountBalances.length }} accounts</div>
                        </div>
                        <div class="gl-search">
                            <i class="la la-search"></i>
                            <input v-model="balanceSearch" placeholder="Search accounts..." @@input="balanceCurrentPage = 1" />
                        </div>
                    </div>
                    <div class="card-content collapse show">
                        <div class="gl-table-wrap">
                            <table class="gl-table">
                                <thead>
                                    <tr>
                                        <th @@click="sortBalance('code')">Code {{ sortIcon('code', balanceSortKey, balanceSortOrder) }}</th>
                                        <th @@click="sortBalance('name')">Account {{ sortIcon('name', balanceSortKey, balanceSortOrder) }}</th>
                                        <th @@click="sortBalance('type')">Type {{ sortIcon('type', balanceSortKey, balanceSortOrder) }}</th>
                                        <th @@click="sortBalance('debit')" style="text-align:right;">Debit {{ sortIcon('debit', balanceSortKey, balanceSortOrder) }}</th>
                                        <th @@click="sortBalance('credit')" style="text-align:right;">Credit {{ sortIcon('credit', balanceSortKey, balanceSortOrder) }}</th>
                                        <th @@click="sortBalance('balance')" style="text-align:right;">Balance {{ sortIcon('balance', balanceSortKey, balanceSortOrder) }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr v-if="paginatedAccountBalances.length === 0">
                                        <td colspan="6">
                                            <div class="gl-empty">
                                                <i class="la la-search"></i>
                                                No matching accounts found.
                                            </div>
                                        </td>
                                    </tr>
                                    <tr v-for="acct in paginatedAccountBalances" :key="acct.code">
                                        <td><span class="gl-acct-code">{{ acct.code }}</span></td>
                                        <td style="font-weight:500;">{{ acct.name }}</td>
                                        <td>
                                            <span class="gl-badge" :class="accountTypeBadgeClass(acct.type)">{{ acct.type }}</span>
                                        </td>
                                        <td class="amount debit-val" style="text-align:right;">
                                            <span v-if="acct.debit > 0">{{ formatAmount(acct.debit) }}</span>
                                            <span v-else style="color:#cbd5e0;">&#8212;</span>
                                        </td>
                                        <td class="amount credit-val" style="text-align:right;">
                                            <span v-if="acct.credit > 0">{{ formatAmount(acct.credit) }}</span>
                                            <span v-else style="color:#cbd5e0;">&#8212;</span>
                                        </td>
                                        <td class="amount" style="text-align:right;" :class="acct.balance >= 0 ? 'balance-pos' : 'balance-neg'">
                                            {{ formatAmount(Math.abs(acct.balance)) }}
                                            <span style="font-size:.65rem;font-weight:400;margin-left:2px;">{{ acct.balance >= 0 ? 'Dr' : 'Cr' }}</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="gl-pagination">
                            <span>Page {{ balanceCurrentPage }} of {{ totalBalancePages }}</span>
                            <button class="gl-page-btn" @@click="prevBalancePage" :disabled="balanceCurrentPage === 1">&#8249; Prev</button>
                            <button class="gl-page-btn" @@click="nextBalancePage" :disabled="balanceCurrentPage === totalBalancePages">Next &#8250;</button>
                        </div>
                    </div>
                </div>

            </div>

        </div><!-- /#app -->
    </div>
</div>

<script src="~/js/payroll/dashboard/general-ledger.js" asp-append-version="true"></script>
