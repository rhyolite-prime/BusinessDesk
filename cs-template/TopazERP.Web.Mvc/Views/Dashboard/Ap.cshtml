@{
ViewBag.Title = "Dashboard | Ap";
Layout = "~/Views/Shared/Layout/_adminApLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
    .hover-card:hover {
        transform: scale(1.03); 
        box-shadow: 0 4px 15px rgba(42, 42, 43, 0.15);
        border: 1px solid #7cb7e8;
        border-radius: 15px;
        background: #b4e4f3;
    }
    .invoices{
        border-bottom: 1px solid #7cb7e8;
       /* border-top: 1px solid #7cb7e8;*/
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        margin-bottom: 2px;
      
    }
    .card{
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03) !important;
    }
    .icon-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon-circle i {
        font-size: 20px;
        color: #fff;
    }
</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <h4 style="font-family: 'Times New Roman'" >Topaz Accounting Pro (AP)</h4>
                    </div>
                </div>
            </div>

        </div>
    <div class="content-body" id="app">

        <section id="number-cards">
            <div class="row">
                <!-- Total Active Suppliers With Balance -->
                <div class="col">
                    <div class="card b shadow text-white" style="background: linear-gradient(90deg,#023039 0%,#29ade6 70%,#1DB4FAFF 100%)">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div class="d-flex justify-content-between ">
                                <div class="icon-circle">
                                    <i class="la la-users" ></i>
                                </div>
                                <div class=" ml-1">
                                    <h3 class=" mb-0 text-white font-weight-bold">{{ supplierCount}}</h3>
                                    <h6 class="mb-1 text-white">Total Suppliers</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Total Invoices -->
                <div class="col">
                            <div class="card b shadow text-white" style="background: linear-gradient(90deg,#1db4fa 0%,#29ade6 36%,#023039FF 100%)">
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <div class="d-flex justify-content-between ">
                                        <div class="icon-circle">
                                            <i class="la la-file" ></i>
                                        </div>
                                        <div class=" ml-1">
                                            <h3 class=" mb-0 text-white font-weight-bold">{{ invoiceCount }}</h3>
                                            <h6 class="mb-1 text-white">Total Invoices</h6>
                                        </div>
                                    </div>
                                </div>
                            </div>
                </div>
                <!-- Posted Invoices -->
                <div class="col">
                    <div class="card b shadow text-white" style="background: linear-gradient(90deg,#023039FF 0%,#29ade6 70%,#1DB4FAFF 100%)">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div class="d-flex justify-content-between ">
                                <div class="icon-circle">
                                    <i class="la la-share-square" ></i>
                                </div>
                                <div class=" ml-1">
                                    <h3 class=" mb-0 text-white font-weight-bold">{{ postedInvoiceCount }}</h3>
                                    <h6 class="mb-1 text-white">Posted Invoices</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Total Posted Payments -->
                <div class="col">
                    <div class="card b shadow text-white" style="background: linear-gradient(90deg,#1db4fa 0%,#29ade6 36%,#023039FF 100%)">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div class="d-flex justify-content-between ">
                                <div class="icon-circle">
                                    <i class="la la-money"></i>
                                </div>
                                <div class=" ml-1">
                                    <h3 class=" mb-0 text-white font-weight-bold">{{ paymentCount }}</h3>
                                    <h6 class="mb-1 text-white">Posted Payments</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <section id="c3-pie-bar-charts">

    <div class="row">
        <div class="col-12 col-md-6">
        <div class="card b shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0">Invoice Analysis</h4>
                <div class="heading-elements">
                    <ul class="list-inline mb-0">
                        <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
                        <li><a data-action="reload"><i class="ft-rotate-cw"></i></a></li>
                        <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                    </ul>
                </div>
            </div>
            <div class="card-content collapse show">
                <div class="card-body " style="height: 300px;">
                    @*<invoice-analysis-chart 
                            :options="invoiceAnalysisChartData.chartOptions" 
                            :series="invoiceAnalysisChartData.series">
                        </invoice-analysis-chart>*@
                    <canvas id="invoiceChart"></canvas>
                   
                </div>
            </div>
        </div>
    </div>
        

        <div class="col-12 col-md-6">
            <div class="card b">
                <div class="card-header">
                    <h4 class="card-title">Invoices</h4>
                    <a class="heading-elements-toggle"><i class="la la-ellipsis-h font-medium-3"></i></a>
                    <div class="heading-elements">
                        <ul class="list-inline mb-0">
                            <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
                            <li><a data-action="reload"><i class="ft-rotate-cw"></i></a></li>
                            <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                        </ul>
                    </div>
                </div>
                <div class="card-content collapse show">
                    <div class="card-body justify-content-center align-items-center" style="height: 300px; overflow: auto;">

                        <div class="row">
                            <div 
                                class="col-12 "
                                v-for="invoice in paginatedInvoices" 
                                :key="invoice.id"
                            >
                                <div 
                                    class="invoices hover-card p-1 d-flex justify-content-between align-items-center"
                                    style="cursor:pointer; transition: transform 0.2s;"
                                    @@click="printReport(invoice.id)"
                                >
                                    <div class="d-flex align-items-center">
                                        <div>
                                            <div class="text-info"><strong>{{ invoice.supplierName }}</strong></div>
                                            <div class="text-muted" style="font-size: 12px;">Inv #: {{ invoice.invoiceNumber }}</div>
                                        </div>
                                    </div>
                                        <div class="text-end d-flex ">
                                            <div class="text-success mr-1" style="font-size: 12px; ">{{ invoice.currencyCode }}</div>
                                            <div style="font-size: 12px; font-weight: bold;">{{ parseFloat(invoice.totalInvoiceAmount).toFixed(2) }}</div>
                                        </div>
                                   
                                </div>
                            </div>
                        </div>

                        <!-- Pagination Controls -->
                        <div class="pagination-controls d-flex justify-content-center mt-1" style="font-size: 11px">
                            <button class="btn btn-sm btn-info text-white mx-2" @@click="prevPage" :disabled="currentPage === 1">Previous</button>
                            <span>Page {{ currentPage }} of {{ totalPages }}</span>
                            <button class="btn btn-sm btn-info text-white mx-2" @@click="nextPage" :disabled="currentPage === totalPages">Next</button>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card b">
                <div class="card-header">
                    <h4 class="card-title">Opening Balances</h4>
                    <a class="heading-elements-toggle"><i class="la la-ellipsis-h font-medium-3"></i></a>
                    <div class="heading-elements">
                        <ul class="list-inline mb-0">
                            <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
                            <li><a data-action="reload"><i class="ft-rotate-cw"></i></a></li>
                            <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                        </ul>
                    </div>
                </div>
                <div class="card-content collapse show">
                    <div class="card-body" style="height: 300px; overflow: auto;">
                        <div class="table-responsive" style="max-height: 200px; overflow: auto; font-size: 11px">
                            <table class=" table table-hover table-sm table-striped">
                                <thead class="table-secondary" style="color: gray;">
                                <tr>
                                    <th @@click="sortBTable('supplierName')">
                                        Supplier
                                        <span v-if="bSortKey === 'supplierName'">
                                            {{ sortOrder === 'asc' ? '↑' : '↓' }}
                                        </span>
                                    </th>
                                    <th @@click="sortBTable('amount')">
                                        Amount
                                        <span v-if="bSortKey === 'amount'">
                                            {{ sortOrder === 'asc' ? '↑' : '↓' }}
                                        </span>
                                    </th>
                                    <th @@click="sortBTable('transactionDate')">
                                        Date
                                        <span v-if="bSortKey === 'transactionDate'">
                                            {{ sortOrder === 'asc' ? '↑' : '↓' }}
                                        </span>
                                    </th>
                                    <th @@click="sortBTable('currencyCode')">
                                        Currency
                                        <span v-if="bSortKey === 'currencyCode'">
                                            {{ sortOrder === 'asc' ? '↑' : '↓' }}
                                        </span>
                                    </th>
                                </tr>
                                </thead>
                                <tbody style="color: black;">
                                <tr v-for="balance in paginatedBalances" :key="balance.supplierName">
                                    <td class="w-50">
                                        <i class="la la-user border border-info rounded-full border-2 " style="border-color: #0b93ff;  color: #0d7a64; margin-right: 10px; border-radius: 50%;"></i>
                                        {{ balance.supplierName }}
                                    </td>
                                    <td>{{ parseFloat(balance.amount).toFixed(2) }}</td>
                                    <td class="w-50">{{ balance.transactionDate}}</td>
                                    <td>{{ balance.currencyCode }}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="pagination-controls d-flex justify-content-center m-2">
                            <button  class="btn btn-sm  text-white mx-2 btn-info" @@click="prevBPage" :disabled="currentBPage === 1">Previous</button>
                            <span>Page {{ currentBPage }} of {{ totalBPages }}</span>
                            <button class="btn btn-sm btn-info text-white mx-2" @@click="nextBPage" :disabled="currentBPage === totalBPages">Next</button>
                        </div>


                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card b">
                <div class="card-header">
                    <h4 class="card-title">Invoice Payments</h4>
                    <a class="heading-elements-toggle"><i class="la la-ellipsis-h font-medium-3"></i></a>
                    <div class="heading-elements">
                        <ul class="list-inline mb-0">
                            <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
                            <li><a data-action="reload"><i class="ft-rotate-cw"></i></a></li>
                            <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                        </ul>
                    </div>
                </div>
                <div class="card-content collapse show">
                    <div class="card-body justify-content-center align-items-center" style="height: 300px; overflow: auto;">
                        @*
                        <supplier-payments-chart type="bar" height="230" :options="supplierPaymentsChartData.chartOptions" :series="supplierPaymentsChartData.series"></supplier-payments-chart>
                        *@
                        <canvas id="supplierChart"></canvas>

                    </div>
                </div>
            </div>
        </div>


    </div>

    </section>


    </div>
    </div>
</div>


<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>

<script src="~/js/Ap/Dashboard/ap.js" asp-append-version="true"></script>


