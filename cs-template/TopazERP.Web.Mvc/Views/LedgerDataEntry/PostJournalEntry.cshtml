@{
    ViewBag.Title = "Post Journal Entries";
    Layout = "~/Views/Shared/Layout/_adminLedgerLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Post Journal Entries </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#">General Ledger </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Post Journal Entries
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Post Journal Entries </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">
                        
                                    <div class="col-sm-8"> </div>
                                    
                                    <div class="col-sm-2">
                                        <button type="button" class="btn btn-md btn-danger mr-2 mt-2" :disabled="isDeleteBtnLoading" v-on:click="delJournal()"> <i class="fa fa-trash"></i> Delete <i class="fa fa-spinner fa-spin" v-if="isDeleteBtnLoading"></i> </button>

                                    </div>
                        
                                    <div class="col-sm-2">

                                        <button type="button" class="btn btn-md btn-primary mt-2" :disabled="isPostBtnLoading" v-on:click="postJournal()"> <i class="fa fa-check"></i> Post  <i class="fa fa-spinner fa-spin" v-if="isPostBtnLoading"></i> </button>

                                    </div>

                                </div>
                    
                                <hr />
                                
                                <div id="dataTable"></div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>


<script src="~/js/gl/data-entry/post-journal-entries.js" asp-append-version="true"></script>