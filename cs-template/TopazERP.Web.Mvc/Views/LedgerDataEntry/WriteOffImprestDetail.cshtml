@{
    ViewBag.Title = "Writeoff Imprest Detail";
    Layout = "~/Views/Shared/Layout/_adminLedgerLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> @ViewBag.Title </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="#">Home</a></li>
                            <li class="breadcrumb-item"><a href="#">General Ledger</a></li>
                            <li class="breadcrumb-item"><a href="/LedgerDataEntry/Imprest">Imprest</a></li>
                            <li class="breadcrumb-item active">@ViewBag.Title</li>
                        </ol>
                    </div>
                </div>
            </div>
            <div class="content-header-right col-md-6 col-12 mb-2 text-right">
                <a href="/LedgerDataEntry/Imprest" class="btn btn-secondary"><i class="fa fa-arrow-left"></i> Back to Imprests</a>
            </div>
        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Edit Writeoff </h4>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div v-if="isShimmerLoading" class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="sr-only">Loading...</span>
                                    </div>
                                </div>
                                
                                <form id="writeoffForm" v-show="!isShimmerLoading">
                                    <fieldset class="mb-3" style="border: 1px solid #ced4da; padding: 10px; border-radius: 5px;">
                                        <legend style="width: auto; padding: 0 10px; font-size: 1.1rem; font-weight: 500;">Writeoff Info</legend>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group row">
                                                    <label class="col-md-4 col-form-label"> <strong>Writeoff Date:</strong> </label>
                                                    <div class="col-md-8">
                                                        <input type="date" class="form-control" v-model="form.writeOffDate" />
                                                    </div>
                                                </div>
                                                <div class="form-group row">
                                                    <label class="col-md-4 col-form-label"> <strong>Amount:</strong>  </label>
                                                    <div class="col-md-8">
                                                        <input type="number" class="form-control text-right" v-model="form.amount" min="0" step="0.01" />
                                                    </div>
                                                </div>
                                                <div class="form-group row">
                                                    <label class="col-md-4 col-form-label"> <strong>Written Off By:</strong>  </label>
                                                    <div class="col-md-8">
                                                        <input type="text" class="form-control" v-model="form.writtenOffBy" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group row">
                                                    <label class="col-md-4 col-form-label"> <strong>Authorized By:</strong>  </label>
                                                    <div class="col-md-8">
                                                        <input type="text" class="form-control" v-model="form.authorizedBy" />
                                                    </div>
                                                </div>
                                                <div class="form-group row">
                                                    <label class="col-md-4 col-form-label"> <strong>Notes:</strong>  </label>
                                                    <div class="col-md-8">
                                                        <textarea class="form-control" v-model="form.notes" rows="4"></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </fieldset>
                                    
                                    <div class="form-actions text-right">
                                        <button type="button" class="btn btn-primary" v-on:click="updateWriteoff()">
                                            <i class="la la-check-square-o"></i> Save Changes
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/gl/data-entry/writeoff-imprest-detail.js" asp-append-version="true"></script>
