@{
ViewBag.Title = "Voucher History";
Layout = "~/Views/Shared/Layout/_adminLedgerLayout.cshtml";
}
<div class="app-content content">
   <div class="content-wrapper">
      <div class="content-header row">
         <div class="content-header-left col-md-6 col-12 mb-2">
            <h3 class="content-header-title"> Voucher History </h3>
            <div class="row breadcrumbs-top">
               <div class="breadcrumb-wrapper col-12">
                  <ol class="breadcrumb">
                     <li class="breadcrumb-item">
                        <a href="#">Home</a>
                     </li>
                     <li class="breadcrumb-item">
                        <a href="#">General Ledger</a>
                     </li>
                     <li class="breadcrumb-item active">
                        Voucher History
                     </li>
                  </ol>
               </div>
            </div>
         </div>
      </div>
      <div class="content-body">
         <!-- Basic Tables start -->
         <div class="row">
            <div class="col-12">
               <div class="card">
                  <div class="card-header">
                     <h4 class="card-title">  Voucher History </h4>
                     <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                     <div class="heading-elements">
                        <ul class="list-inline mb-0">
                           <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                           <li><a data-action="close"><i class="ft-x"></i></a></li>
                        </ul>
                     </div>
                  </div>
                  <div class="card-content collapse show">
                     <div class="card-body" id="app">
                        <div class="alert alert-info" role="alert" style="margin-bottom: 20px;">
                           Vouchers are displayed for the past 3 months by default. Use the filter to retrieve data for ranges outside the default.
                        </div>
                        <div class="row">
                           <div class="col-sm-2"> </div>
                           <div class="col-sm-2">
                              <div class="form-group">
                                 <label> <strong> Start Date: </strong> </label>
                                 <input type="text" class="e-textbox" name="StartDate" id="startDate">
                                 <script type="text/javascript">
                                    $( function ()
                                    {
                                        // declaration
                                        $( "#startDate" ).ejDatePicker( {
                                            width: "100%",
                                            dateFormat: "dd-MMM-yyyy",
                                            value: new Date()
                                        } );
                                    } );
                                 </script>
                              </div>
                           </div>
                           <div class="col-sm-2">
                              <div class="form-group">
                                 <label> <strong> End Date: </strong> </label>
                                 <input type="text" class="e-textbox" name="EndDate" id="endDate">
                                 <script type="text/javascript">
                                    $( function ()
                                    {
                                        // declaration
                                        $( "#endDate" ).ejDatePicker( {
                                            width: "100%",
                                            dateFormat: "dd-MMM-yyyy",
                                            value: new Date()
                                        } );
                                    } );
                                 </script>
                              </div>
                           </div>
                        </div>
                        <hr/>
                        <div id="dataTable"></div>
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </div>
</div>
<script src="~/libs/vuelidate/vuelidate.min.js"></script>
<script src="~/libs/vuelidate/validators.min.js"></script>

<script src="~/js/gl/data-entry/voucher-history.js" asp-append-version="true"></script>