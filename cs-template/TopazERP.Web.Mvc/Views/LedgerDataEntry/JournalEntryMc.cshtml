@{
    ViewBag.Title = "Journal Entry MultiCurrency";
    Layout = "~/Views/Shared/Layout/_adminLedgerLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Journal Entry </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#">General Ledger</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Journal Entry - MultiCurrency
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Journal Entry - MultiCurrency </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            
                            <div class="card-body" id="app">

                                
                                 <div class="row">

                                    <div class="col-sm-1"> </div>

                                    <div class="col-sm-2">

                                        <div class="form-group">
                                            <label> <strong> Batch No#: </strong> </label>
                                            <input type="text" class="form-control" placeholder="1234" v-model="batchNumber">

                                        </div>

                                    </div>

                                    <div class="col-sm-2">

                                        <div class="form-group">
                                            <label> <strong> Batch Date: </strong> </label>
                                            <input type="text" class="form-control" name="BatchDate" id="batchDate" ref="batchDate" v-model="batchDate">
                                            <span class="text-danger" v-if="!$v.batchDate.required && $v.batchDate.$dirty"> Batch date field is required </span>

                                        </div>

                                    </div>

                                    <div class="col-sm-4"> 

                                        <div class="form-group">
                                            <label> <strong> OU (Cost Center): </strong> </label>
                                            <input type="text" class="form-control" id="ouId" v-model="ouId">
                                             

                                        </div>

                                    </div>

                                    <div class="col-sm-2 mt-1">

                                        <button type="button" v-on:click="saveJournal()" :disabled="isLoading" class="btn btn-primary mt-1">
                                            Save

                                            <div class="spinner-border" v-if="isLoading" role="status" aria-hidden="true" style="width: 20px; height: 20px"></div>
                                        </button>

                                    </div>
                                </div>

                                <hr/>
                                
                                
                                <div class="p-1 text-left">
                                    <button class="btn btn-sm btn-success" @@click="addLine">
                                        + Add Row
                                    </button>
                                    <button class="btn btn-sm btn-danger ml-1" @@click="removeLastLine" v-if="journalEntryList.length > 1">
                                        − Remove Last Row
                                    </button>
                                </div>
                                
                                <div class="alert alert-info py-1 px-2 mb-1" style="font-size: 12px;">
                                    <i class="la la-arrow-right"></i>
                                    Scroll to the right to view additional journal fields.
                                </div>
                                <!-- Journal Lines Table -->
                                <div class="card">
                                    <div class="card-body p-0" style="overflow-x:auto;">

                                        <table class="table table-bordered table-sm journal-table" style="min-width:1600px; table-layout: fixed;">
                                            
                                            <!-- Column widths -->
                                            <colgroup>
                                                <col style="width:200px">
                                                <col style="width:250px">
                                                <col style="width:350px">
                                                <col style="width:250px">
                                                <col style="width:150px">
                                                <col style="width:220px">
                                                <col style="width:150px">
                                                <col style="width:150px">
                                                <col style="width:140px">
                                                <col style="width:140px">
                                                <col style="width:170px">
                                                <col style="width:160px">
                                                <col style="width:80px">
                                            </colgroup>
                                            
                                            <thead>
                                            <tr>
                                                <th>Ref No.</th>
                                                <th>G/L Account</th>
                                                <th>Dept.</th>
                                                <th>Currency</th>
                                                <th>Rate</th>
                                                <th>Description</th>
                                                <th>Local Debit</th>
                                                <th>Local Credit</th>
                                                <th>Foreign Debit</th>
                                                <th>Foreign Credit</th>
                                                <th>Recipient</th>
                                                <th>Cheque No.</th>
                                                <th>Action</th>
                                            </tr>
                                            </thead>
                                            
                                            <tbody>
                                            
                                            <tr v-for="(line, index) in journalEntryList" :key="index">
                                                
                                                <td>
                                                    <input type="text" class="form-control form-control-md" v-model="line.referenceNumber">
                                                </td>

                                                <td>
                                                    <select class="form-control form-control-md" v-model="line.accountId" @@change="onAccountChange(line.accountId, index)">
                                                        <option value="">Select GL Account</option>
                                                        <option :value="account.id" v-for="account in accountsList"> {{account.accountNo}}-{{account.accountName}} </option>
                                                    </select>
                                                </td>

                                                <td>
                                                    <select class="form-control form-control-md" v-model="line.ouId">
                                                        <option value="">Select OU</option>
                                                        <option :value="costCenter.id" v-for="costCenter in costCenterHierachyList"> {{costCenter.name}} </option>
                                                    </select>
                                                </td>

                                                <td>
                                                    <select class="form-control form-control-md" disabled v-model="line.currencyId" @@change="onCurrencyChange(line.currencyId, index)">
                                                        <option value="">Select Currency</option>
                                                        <option :value="currency.id" v-for="currency in currencyRateList"> {{currency.currencyCode}} - {{currency.currencyName}} </option>
                                                    </select>
                                                </td>

                                                <td>
                                                    <input type="number" disabled class="form-control form-control-md" v-model="line.buyRate">
                                                </td>

                                                <td>
                                                    <input type="text" class="form-control form-control-md" v-model="line.description">
                                                </td>

                                                <td>
                                                    <input type="number" 
                                                           class="form-control form-control-md text-right" 
                                                           v-model="line.localDebit" 
                                                           :disabled="!isLocalFieldEnabled(index)">
                                                </td>

                                                <td>
                                                    <input type="number" 
                                                           class="form-control form-control-md text-right" 
                                                           v-model="line.localCredit" 
                                                           :disabled="!isLocalFieldEnabled(index)">
                                                </td>

                                                <td>
                                                    <input type="number" 
                                                           class="form-control form-control-md text-right" 
                                                           v-model="line.foreignDebit" 
                                                           :disabled="!isForeignFieldEnabled(index)">
                                                </td>

                                                <td>
                                                    <input type="number" 
                                                           class="form-control form-control-md text-right" 
                                                           v-model="line.foreignCredit" 
                                                           :disabled="!isForeignFieldEnabled(index)">
                                                </td>

                                                <td>
                                                    <input type="text" class="form-control form-control-md" v-model="line.recipient">
                                                </td>

                                                <td>
                                                    <input type="text" class="form-control form-control-md" v-model="line.chequeNo">
                                                </td>

                                                <td class="text-center">
                                                    <button class="btn btn-md btn-outline-danger"
                                                            @@click="removeLine(index)"
                                                            title="Delete row">
                                                        <i class="la la-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                            </tbody>

                                            <tfoot>
                                            <tr class="font-weight-bold">
                                                <td colspan="6">TOTAL</td>
                                                <td class="text-right">{{ formatCurrency(totalLocalDebit) }}</td>
                                                <td class="text-right">{{ formatCurrency(totalLocalCredit) }}</td>
                                                @*<td class="text-right">{{ formatCurrency(totalForeignDebit) }}</td>
                                                <td class="text-right">{{ formatCurrency(totalForeignCredit) }}</td>*@
                                                <td colspan="3"></td>
                                            </tr>
                                            </tfoot>
                                        </table>

                                    </div>
                                </div>
                                
                                
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="~/libs/vuelidate/vuelidate.min.js"></script>
<script src="~/libs/vuelidate/validators.min.js"></script>

<script src="~/js/gl/data-entry/journal-mc.js" asp-append-version="true"></script>