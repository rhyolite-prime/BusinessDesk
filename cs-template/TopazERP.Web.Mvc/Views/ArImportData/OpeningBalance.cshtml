@{
ViewBag.Title = "Opening Balances";
Layout = "~/Views/Shared/Layout/_adminArLayout.cshtml";
}

<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
    /* ✅ full-screen overlay inside app */
    .preview-loader-overlay {
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, 0.75);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(1px);
    }

    /* make sure #app can host an absolute overlay */
    #app {
        position: relative;
    }

    .preview-loader-card {
        background: #fff;
        border-radius: 12px;
        padding: 18px 22px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .preview-loader-text {
        font-weight: 600;
        color: #0b1f5b; /* deep blue */
        font-size: 14px;
    }
    
    .deepblue-spinner {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 4px solid rgb(255 204 4 / 0.24);
        border-top-color: #e5e219;
        animation: deepblue-spin 0.85s linear infinite;
    }

    @@keyframes deepblue-spin {
        to { transform: rotate(360deg); }
    }
</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Import Opening Balances </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/Ar" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#"> Import Data </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Opening Balances
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div id="app">
            <div class="content-body">
                <!-- Basic Tables start -->
                <div class="row">
                    <div class="col-12">
                        <div class="card b">
                            <div class="card-header">
                                <h4 class="card-title"></h4>
                                <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                                <div class="heading-elements">
                                    <ul class="list-inline mb-0">
                                        <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                        <li><a data-action="close"><i class="ft-x"></i></a></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="card-content collapse show">
                                <div class="card-body">
                                    <div v-if="isLoading" class="preview-loader-overlay">
                                        <div class="preview-loader-card">
                                            <div class="deepblue-spinner"></div>
                                            <div class="preview-loader-text">Processing preview...</div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <div class="form-group">
                                                <label class="text-amber">
                                                    <strong> Choose File: </strong>
                                                    <a href="@Url.Action("DownloadOpeningBalanceUploadSample","ArImportData")">
                                                        <b> Download Template </b>
                                                    </a>
                                                </label>

                                                <input type="file"
                                                       class="form-control"
                                                       @@change="onFileUpload"
                                                       required />
                                            </div>

                                        </div>

                                        <div class="col-sm-3 mt-2">
                                            <div class="form-group">
                                                <button :disabled="hasErrors || previewData.length === 0" class="btn btn-info" @@click="importData">
                                                    Import
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="table-responsive">
                                        <p class="mb-2">
                                            <strong>Total Import Rows:</strong>
                                            <span class="badge bg-warning">
                                                {{ previewData?.length || 0 }}
                                            </span>
                                        </p>
                                        <table class="table-responsive table table-striped align-middle w-100">
                                            <thead>
                                            <tr>
                                                <th style="width:60px">No.</th>
                                                <th style="min-width:280px">Customer</th>
                                                <th style="min-width:200px">Transaction Date</th>
                                                <th style="min-width:220px">Currency</th>
                                                <th style="min-width:150px">Rate</th>
                                                <th style="min-width:200px">Amount</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            <template v-for="(row, index) in paginatedData" :key="index">
                                                <tr>
                                                    <td>{{ (currentPage - 1) * pageSize + index + 1 }}</td>
                                                    <td>{{ row.customer }}</td>
                                                    <td>{{ formatDate(row.transactionDate) }}</td>
                                                    <td>{{ row.currencyName }}</td>
                                                    <td>{{ row.currencyRate }}</td>
                                                    <td>{{ row.amount.toLocaleString(undefined, {
                                                        minimumFractionDigits: 2,
                                                        maximumFractionDigits: 2
                                                        }) }}</td>
                                                </tr>
                                                <tr v-if="row.errors && row.errors.length" class="table-danger">
                                                    <td></td>
                                                    <td colspan="12">
                                                        <strong>Issues:</strong>
                                                        <ul class="mb-0">
                                                            <li v-for="e in row.errors" class="text-danger">
                                                                {{ e }}
                                                            </li>
                                                        </ul>
                                                    </td>
                                                </tr>

                                            </template>

                                            </tbody>

                                        </table>
                                        <nav class="mt-3">
                                            <ul class="pagination pagination-sm justify-content-end">

                                                <li class="page-item" :class="{ disabled: currentPage === 1 }">
                                                    <a class="page-link" @@click="currentPage--">Prev</a>
                                                </li>

                                                <li class="page-item"
                                                    v-for="p in paginationPages"
                                                    :key="p"
                                                    :class="{ active: currentPage === p }">

                                                    <a class="page-link" @@click="currentPage = p">
                                                        {{ p }}
                                                    </a>
                                                </li>

                                                <li class="page-item" :class="{ disabled: currentPage === totalPages }">
                                                    <a class="page-link" @@click="currentPage++">Next</a>
                                                </li>

                                            </ul>
                                        </nav>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>

    </div>
</div>

<script src="~/js/ar/imports/balance-import.js" asp-append-version="true"></script>



