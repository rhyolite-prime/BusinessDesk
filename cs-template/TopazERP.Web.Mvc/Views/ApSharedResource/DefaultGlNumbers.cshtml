@{
    ViewBag.Title = "Default GL Numbers";
    Layout = "~/Views/Shared/Layout/_adminApLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
</style>

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Default GL Numbers </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#">Ap Setups</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Default GL Numbers
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card b">
                        <div class="card-header">
                            <h4 class="card-title"> Default GL Numbers </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            
                            <div class="card-body d-none" id="app">

                                <div class="row">

                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label> A/P Bank Account: </label>
                                            <input id="accountPayablesBankAccountId" v-model="accountPayablesBankAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Payroll Bank Account: </label>
                                            <input id="payRollBankAccountId" v-model="payRollBankAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> A/R Bank Account: </label>
                                            <input id="accountsReceivableBankAccountId" v-model="accountsReceivableBankAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Sales Bank Account: </label>
                                            <input id="salesBankAccountId" v-model="salesBankAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Accounts Receivable: </label>
                                            <input id="accountsReceivableAccountId" v-model="accountsReceivableAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Accounts Payable: </label>
                                            <input id="accountsPayableAccountId" v-model="accountsPayableAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Withholding: </label>
                                            <input id="withholdingTaxAccountId" v-model="withholdingTaxAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Imprest Category: </label>
                                            <input id="imprestCategoryId" v-model="imprestCategoryId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Credit Purchases : </label>
                                            <input id="creditPurchasesAccountId" v-model="creditPurchasesAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Advance From Customer: </label>
                                            <input id="advanceFromCustomerAccountId" v-model="advanceFromCustomerAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> COVID Tax Recieved: </label>
                                            <input id="covidTaxRecievedAccountId" v-model="covidTaxRecievedAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Communications Service Tax Received: </label>
                                            <input id="communicationsServiceTaxReceivedAccountId" v-model="communicationsServiceTaxReceivedAccountId" type="text" class="form-control"/>

                                        </div>

                                    </div>

                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label> Inventory: </label>
                                            <input id="inventoryAccountId" v-model="inventoryAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Sales(Revenue): </label>
                                            <input id="salesRevenueAccountId" v-model="salesRevenueAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Stock Purchases: </label>
                                            <input id="stockPurchasesAccountId" v-model="stockPurchasesAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Current Earnings: </label>
                                            <input id="currentEarningsAccountId" v-model="currentEarningsAccountId" type="text" class="form-control"/>

                                        </div>


                                        <div class="form-group">
                                            <label> Retained Earnings: </label>
                                            <input id="retainedEarningsAccountId" v-model="retainedEarningsAccountId" type="text" class="form-control"/>

                                        </div>


                                        <div class="form-group">
                                            <label> VAT Received: </label>
                                            <input id="vatReceivedAccountId" v-model="vatReceivedAccountId" type="text" class="form-control"/>

                                        </div>


                                        <div class="form-group">
                                            <label> Imprest GL #: </label>
                                            <input id="imprestGlAccountId" v-model="imprestGlAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Purchases Bank: </label>
                                            <input id="purchasesBankAccountId" v-model="purchasesBankAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Advance to Supplier: </label>
                                            <input id="advanceToSupplierAccountId" v-model="advanceToSupplierAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> COVID Tax Paid: </label>
                                            <input id="covidTaxPaidAccountId" v-model="covidTaxPaidAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Communications Service Tax Paid : </label>
                                            <input id="communicationsServiceTaxPaidAccountId" v-model="communicationsServiceTaxPaidAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">

                                            <label> VAT Rate: </label>
                                            <input id="vatRate" v-model="vatRate" type="text" class="form-control"/>

                                        </div>

                                    </div>

                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label> Goods in Transit: </label>
                                            <input id="goodsInTransitAccountId" v-model="goodsInTransitAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Unrealized FX Loss: </label>
                                            <input id="unrealizedFxLossAccountId" v-model="unrealizedFxLossAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Unrealized FX Gain: </label>
                                            <input id="unrealizedFxGainAccountId" v-model="unrealizedFxGainAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Realized FX Loss: </label>
                                            <input id="realizedFxLossAccountId" v-model="realizedFxLossAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> Realized FX Gain: </label>
                                            <input id="realizedFxGainAccountId" v-model="realizedFxGainAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> VAT Paid: </label>
                                            <input id="vatPaidAccountId" v-model="vatPaidAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> GETFL Received: </label>
                                            <input id="getflReceivedAccountId" v-model="getflReceivedAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> GETFL Paid: </label>
                                            <input id="getflPaidAccountId" v-model="getflPaidAccountId" type="text" class="form-control"/>

                                        </div>

                                        <div class="form-group">
                                            <label> NHIL Received: </label>
                                            <input id="nhilReceivedAccountId" v-model="nhilReceivedAccountId" type="text" class="form-control"/>

                                        </div>


                                        <div class="form-group">
                                            <label> NHIL Paid: </label>
                                            <input id="nhilPaidAccountId" v-model="nhilPaidAccountId" type="text" class="form-control"/>

                                        </div>


                                    </div>

                                </div>

                                <hr/>
                                <fieldset class="form-group">
                                    <legend><span> Social Security Information </span></legend>

                                    <div class="row">

                                        <div class="col-sm-4">

                                            <div class="form-group">
                                                <label> Employer's Portion of Social Security Rate: </label>
                                                <input id="socialSecurityFundEmployerRate" v-model="socialSecurityFundEmployerRate" type="text" class="form-control"/>

                                            </div>

                                            <div class="form-group">
                                                <label> Employee's Portion of Social Security Rate: </label>
                                                <input id="socialSecurityFundEmployeeRate" v-model="socialSecurityFundEmployeeRate" type="text" class="form-control"/>

                                            </div>

                                        </div>

                                        <div class="col-sm-4">

                                            <div class="form-group">
                                                <label> Employer SSF Default Expense GL: </label>
                                                <input id="socialSecurityEmployerPortionDefaultExpenseGl" v-model="socialSecurityEmployerPortionDefaultExpenseGl" type="text" class="form-control"/>

                                            </div>

                                            <div class="form-group">
                                                <label> Employee SSF Default Expense GL: </label>
                                                <input id="socialSecurityEmployeePortionDefaultExpenseGl" v-model="socialSecurityEmployeePortionDefaultExpenseGl" type="text" class="form-control"/>

                                            </div>
                                        </div>

                                        <div class="col-sm-4">

                                            <div class="form-group">
                                                <label> Employer SSF Default Liability GL: </label>
                                                <input id="socialSecurityEmployerPortionDefaultLiabilityGl" v-model="socialSecurityEmployerPortionDefaultLiabilityGl" type="text" class="form-control"/>

                                            </div>

                                            <div class="form-group">
                                                <label> Employee SSF Default Liability GL: </label>
                                                <input id="socialSecurityEmployeePortionDefaultLiabilityGl" v-model="socialSecurityEmployeePortionDefaultLiabilityGl" type="text" class="form-control"/>

                                            </div>

                                        </div>

                                    </div>

                                </fieldset>

                                <hr/>

                                <div class="row">
                                    <div class="col-sm-8"></div>
                                    <div class="col-sm-4">

                                        <button type="button" :disabled="isLoading" v-on:click="saveDefaultGlNumbers()" class="btn btn-primary" style="float: right;">

                                            Save
                                            <div class="spinner-border" v-if="isLoading" role="status" aria-hidden="true" style="width: 20px; height: 20px"></div>

                                        </button>
                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>


<script src="~/js/shared/vue3/default-gl-numbers.js" asp-append-version="true"></script>