@using TopazERP
@using Abp.Web.Security.AntiForgery
@inject IAbpAntiForgeryManager AbpAntiForgeryManager
@{
    ViewBag.Title = "Audit Logs";
    AbpAntiForgeryManager.SetCookie(Context);
    Layout = "~/Views/Shared/Layout/_adminArLayout.cshtml";
}

<style>
    .table{
        font-size: 11px;
        color: black;
       
    }
    .badge-purple {
        background-color: #6f42c1;
        color: #fff;
    }
    .badge-deepBlue {
        background-color: #0b20a6;
        color: #fff;
    }
    .pass {
        background-color: rgb(88 253 75 / 0.33);
        color: #148504;
    }
    .fail{
        background-color: rgb(255 76 76 / 0.33);
        color: #b01818;
    }
    .badge-pill {
        padding: 6px 12px;
        font-size: 12px;
    }
    .table-footer{
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
    }
    .table-footer .page-link {
        width: 30px;
        height: 30px;

        padding: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 5px !important;

        color: #64748b;
        border-color: #e2e8f0;

        font-size: 11px;
    }

    .table-footer .page-item.active .page-link {
        background: #2f65a5;
        border-color:#2f65a5;
        color: #fff;
    }
    
</style>
<div class="app-content content" id="app">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Audit Logs </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-info"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-info" href="#">Reports</a>
                            </li>

                            <li class="breadcrumb-item active">
                                Audit Logs
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Audit Logs  </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-3">

                                        <div class="form-group">
                                            <label>Start Date:</label>
                                            <input id="startDate" v-model="startDate" type="date" class="form-control form-control-sm"/>

                                        </div>

                                    </div>
                                    <div class="col-sm-3">

                                        <div class="form-group">
                                            <label>End Date:</label>
                                            <input id="endDate" v-model="endDate" type="date" class="form-control form-control-sm"/>

                                        </div>
                                    </div>
                                    <div class="my-2 float-right col-md-6">
                                        <button class="btn btn-warning btn-sm"
                                                :disabled="isLoading"
                                                @@click="getAuditLogs">
                                            <i class="la la-search"></i> Search
                                            <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                                        </button>
                                        <button type="button"
                                                class="btn btn-secondary btn-sm ml-1"
                                                @@click="generateAuditLogReport()">
                                            <i class="la la-file-text"></i>
                                            Generate Report
                                        </button>
                                    </div>
                                </div>
                            <div class="table-responsive">   
                                <table class="table table-bordered table-hover table-striped text-left">
                                    <thead class="thead">
                                    <tr>
                                        <th>#</th>
                                        <th >Module</th>
                                        <th >User</th>
                                        <th >Menu</th>
                                        <th >Action</th>
                                        <th >Status</th>
                                        <th >Execution Time</th>
                                        <th>Duration</th>
                                            
                                    </tr>
                                    </thead>

                                    <tbody>
                                    <tr v-if="isLoading">
                                        <td colspan="9" class="text-center py-4">
                                            <div class="spinner-border spinner-border-sm text-primary"></div>
                                            <span class="ms-2">Loading audit logs...</span>
                                        </td>
                                    </tr>

                                    <tr v-else-if="auditLogsList.length === 0">
                                        <td colspan="9" class="text-center py-4 text-muted">
                                            No audit logs found for the selected date range.
                                        </td>
                                    </tr>

                                    <tr v-else
                                        v-for="(log, index) in paginatedAuditLogs"
                                        :key="log.id">

                                        <td>
                                            {{ (currentPage - 1) * pageSize + index + 1 }}
                                        </td>
                                        <td>
                                            <span :class="applicationClass(log.application)">
                                                {{ log.application }}
                                            </span>
                                        </td>
                                        <td>
                                            <span v-if="log.userFullName">
                                                {{ log.userFullName }}
                                            </span>
                                            <span v-else class="text-muted">
                                                __
                                            </span>
                                        </td>
                                           
                                        <td>
                                            {{ log.urlPath }}
                                        </td>
                                        <td>
                                            {{ log.methodName }}
                                        </td>
                                        <td>
                                            <span v-if="log.status === 'Success'"
                                                  class="badge badge-pill pass">
                                                Success
                                            </span>

                                            <span v-else
                                                  class="badge badge-pill fail">
                                                Failed
                                            </span>
                                        </td>
                                        <td>
                                            {{ formatDateTime(log.executionTime) }}
                                        </td>
                                        <td>
                                            {{ log.executionDuration }} ms
                                        </td>
                                    </tr>
                                    </tbody>
                                </table>
                              
                                
                            </div> 
                                <div  v-if="auditLogsList.length" class="table-footer mb-1">
                                    <div class="text-muted small">
                    
                                        Showing
                                        <strong>{{ paginationStart }}</strong>
                                        -
                                        <strong>{{ paginationEnd }}</strong>
                                        of
                                        <strong>{{ auditLogsList.length }}</strong>
                                        Logs
                    
                                    </div>

                                    <!-- Pagination -->
                                    <nav aria-label="pagination">

                                        <ul class="pagination pagination-sm mb-0">

                                            <!-- Previous -->
                                            <li
                                                class="page-item"
                                                :class="{ disabled: currentPage === 1 }">
                                                <button
                                                    class="page-link"
                                                    @@click="changePage(currentPage - 1)"
                                                    :disabled="currentPage === 1">
                                                    <i class="la la-angle-left"></i>
                                                </button>

                                            </li>


                                            <!-- Page numbers -->
                                            <div v-for="(page, index) in paginationPages" :key="index">
                                                <!-- Ellipsis -->
                                                <li v-if="page === '...'" class="page-item disabled">
                                                    <span class="page-link pagination-dots">
                                                        ...
                                                    </span>
                                                </li>


                                                <!-- Page -->
                                                <li v-else class="page-item" :class="{ active: currentPage === page }">
                                                    <button
                                                        type="button"
                                                        class="page-link"
                                                        @@click="changePage(page)">
                                                        {{ page }}
                                                    </button>
                                                </li>
                                            </div>


                                            <!-- Next -->
                                            <li class="page-item" :class="{ disabled: currentPage === totalPages }">
                                                <button
                                                    class="page-link"
                                                    @@click="changePage(currentPage + 1)"
                                                    :disabled="currentPage === totalPages">
                                                    <i class="la la-angle-right"></i>
                                                </button>
                                            </li>

                                        </ul>

                                    </nav>
                                </div>
                                
                                @*report modal*@
                                <div class="modal fade" id="auditReportModal" tabindex="-1" role="dialog" aria-labelledby="auditReportModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-xl" role="document" style="max-width: 95%;">

                                        <div class="modal-content">

                                            <div class="modal-header">
                                                <h5 class="modal-title" id="auditReportModalLabel">
                                                    Audit Log Report
                                                </h5>

                                                <button type="button"
                                                        class="close"
                                                        data-dismiss="modal"
                                                        aria-label="Close">
                                                    <span aria-hidden="true">&times;</span>
                                                </button>
                                            </div>

                                            <div class="modal-body p-0">

                                                <div id="reportView" style="width: 100%; min-height: 75vh;">
                                                </div>

                                            </div>

                                            <div class="modal-footer">
                                                <button type="button"
                                                        class="btn btn-secondary"
                                                        data-dismiss="modal">
                                                    Close
                                                </button>
                                            </div>

                                        </div>

                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>

   

</div>


 

<script src="~/js/ar/general-reports/audit-logs.js" asp-append-version="true"></script>