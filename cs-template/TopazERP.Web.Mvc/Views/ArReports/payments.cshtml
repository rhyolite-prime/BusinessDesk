@{
    ViewBag.Title = "Payments";
    Layout = "~/Views/Shared/Layout/_adminArLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
</style>

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Payment Reports</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb ">
                            <li class="breadcrumb-item">
                                <a href="#" class="text-info">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#" class="text-info"> Reports </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Payments
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card b">
                        <div class="card-header">
                            <h4 class="card-title"> Payments </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div class="row">
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            <label for="paymentOptions" class="form-label font-weight-bold">Choose Payment Type:</label>
                                            <div id="paymentOptions" class="form-group p-1 border  rounded row">
                                                <div class="col">
                                                    <input class="form-check-input" type="radio" id="invoicePayments" v-model="reportType" name="ReportType" value="Invoice">
                                                    <label class="form-check-label" for="invoicePayments">
                                                        Invoice Payments
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                   
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label> <strong> Select Report Type: </strong>  </label>
                                            <select class="form-control" v-model="subReportType" ref="subReportType">
                                                <option value="summary-report"> Summary </option>
                                                <option value="customer-report"> By Customer </option>
                                                <option value="date-report"> By Date</option>
                                            </select>

                                        </div>
                                    </div>
                                </div>
                                <div class="row" v-show="subReportType == 'customer-report'">

                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label> <strong>Customer:</strong> </label>
                                            <input id="customerId" v-model="customerId" type="text" class="form-control" />
                                        </div>
                                    </div>

                                   

                                    

                                </div>
                                <div class="row" v-show="subReportType == 'date-report'">
                                    <div class="col-sm-3">

                                        <div class="form-group">
                                            <label> <strong>Start Date:</strong> </label>
                                            <input v-model="startDate" ref="startDate" type="date" class="form-control" />

                                        </div>

                                    </div>
                                    <div class="col-sm-3">

                                        <div class="form-group">
                                            <label> <strong> End Date: </strong> </label>
                                            <input v-model="endDate" ref="endDate" type="date" class="form-control" />

                                        </div>

                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-2 mt-1">

                                        <div class="form-group mt-1">

                                            <button type="button" class="alignright btn btn-amber" v-on:click="getReportData()"> Search </button>

                                        </div>

                                    </div>
                                </div>

                                <hr />

                                <div style="height:auto;width:auto;min-height:500px;" id="reportView">  </div>

                            </div>

                        </div>
                    </div>
                </div>
                
            </div>


        </div>
    </div>
</div>


<script src="~/js/ar/general-reports/payments.js" asp-append-version="true"></script>