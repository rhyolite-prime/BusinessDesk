@using Microsoft.AspNetCore.Mvc.TagHelpers
@using TopazERP.Web.Helpers
@{
    ViewBag.Title = "Invoice Details";
    Layout = "~/Views/Shared/Layout/_adminArLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
    .bg-light-blue {
        background-color: #d2e5fa; 
    }
    .nav {
        font-size: 0.8rem;
    }
    .perPage {
        border: none;
        padding: 0.25rem 0.5rem;
        background-color: #f8f9fa;
    }
    .pign{
        border-bottom: 1px solid #e3e3e3;
        background-color: #f8f9fa;
    }
    .loader-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.65);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10000;
    }
    .loader-text {
        margin-top: 10px;
        color: #fff4f4;
    }
</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Payment Receipts</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb ">
                            <li class="breadcrumb-item">
                                <a href="#" class="text-info">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#" class="text-info"> Reports </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Payment Receipts
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Invoice </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div v-if="isLoading" class="loader-overlay">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="sr-only">Processing...</span>
                                    </div>
                                    <div class="loader-text">
                                        <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                                        Processing...
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            <label><strong> Search Payment: </strong></label>
                                            <input id="paymentId" v-model="paymentId" type="text" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="col-sm-2 mt-1">
                                        <div class="form-group mt-1 d-flex">
                                            <button class="btn btn-amber" @@click="print()">Print</button>
                                        </div>
                                    </div>
                                </div>

                                <hr />

                                @*<!-- Loader -->
                                <div v-if="isLoading" class="d-flex justify-content-center align-items-center" style="height:300px;">
                                    <div class="loader"></div>
                                </div>

                                <!-- PDF Viewer -->
                                <div v-show="pdfUrl && !isLoading" class="pdf-container">
                                    <iframe :src="pdfUrl" width="100%" height="600px" style="border:none;"></iframe>
                                </div>*@
                             
                                <table class="table table-bordered table-striped">
                                    <thead>
                                    <tr>
                                        <th>
                                            <input type="checkbox"
                                                   v-model="selectAll"
                                                   @@change="toggleSelectAll">
                                        </th>
                                        <th>Batch Number</th>
                                        <th>Customer Name</th>
                                        <th>Payment Date</th>
                                        <th>Amount</th>
                                        <th>Reference</th>
                                        <th>Bank</th>
                                    </tr>
                                    </thead>

                                    <tbody>
                                    <tr v-for="pay in paginatedPayments" :key="pay.id">

                                        <td>
                                            <input type="checkbox"
                                                   :value="pay.id"
                                                   :checked="selectedPayments.includes(pay.id)"
                                                   @@change="togglePayment(pay.id)">
                                        </td>

                                        <td>{{ pay.batchNumber }}</td>
                                        <td>{{ pay.customerName }}</td>
                                        <td>{{new Date(pay.paymentDate).toLocaleDateString() }}</td>
                                        <td>{{ formatNumber(pay.amountToPay) }}</td>
                                        <td>{{ pay.referenceNo }}</td>
                                        <td>{{ pay.bankName }}</td>

                                    </tr>
                                    </tbody>
                                </table>
                                    <div class="d-flex justify-content-end align-items-center flex-wrap pign p-1">
                                                <div class="d-flex align-items-center mb-2 mb-md-0 nav mr-1">
                                                    <i class="la la-list text-info mr-2"></i>
                                                    <select v-model="perPage" class="perPage">
                                                        <option value="5">5 per page</option>
                                                        <option value="10">10 per page</option>
                                                        <option value="20">20 per page</option>
                                                        <option value="50">50 per page</option>
                                                    </select>
                                                </div>
                                                <!-- Pagination -->
                                                <nav class="float-right nav">
                                                    <ul class="pagination justify-content-center">

                                                        <!-- Prev -->
                                                        <li class="page-item" :class="{ disabled: currentPage === 1 }">
                                                            <a class="page-link text-sm" href="#" @@click.prevent="currentPage--">Prev</a>
                                                        </li>

                                                        <!-- Pages -->
                                                        <li class="page-item"
                                                            v-for="(page, index) in paginationPages"
                                                            :key="index"
                                                            :class="{ active: currentPage === page, disabled: page === '...' }">

                                                            <a class="page-link text-sm"
                                                               href="#"
                                                               @@click.prevent="page !== '...' && (currentPage = page)">
                                                                {{ page }}
                                                            </a>
                                                        </li>

                                                        <!-- Next -->
                                                        <li class="page-item" :class="{ disabled: currentPage === totalPages }">
                                                            <a class="page-link text-sm" href="#" @@click.prevent="currentPage++">Next</a>
                                                        </li>

                                                    </ul>
                                                </nav>
                                            </div>
                                         
                            </div>

                        </div>
                    </div>
                </div>
                
            </div>


        </div>
    </div>
</div>


<script src="~/js/ar/general-reports/paymentReceipt.js" asp-append-version="true"></script>

