@{
ViewBag.Title = "Opening Balances";
Layout = "~/Views/Shared/Layout/_adminArLayout.cshtml";
}
<style>
    .b {
        border-radius: 15px;
        border: 0.5px solid #e3e3e3;
    }
</style>

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Opening Balances</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb ">
                            <li class="breadcrumb-item">
                                <a href="#" class="text-info">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#" class="text-info"> Reports </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Opening Balances
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card b">
                        <div class="card-header">
                            <h4 class="card-title">Opening Balances</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">
                                    <div class="col-sm-3 ">


                                        <div class="form-group">
                                            <label> <strong> Select Report Type: </strong>  </label>
                                            <select class="form-control" v-model="reportType" ref="reportType">
                                                <option value="summary"> Summary </option>
                                                <option value="byCustomer"> By Customer </option>
                                                <option value="type2"> Type 2</option>
                                            </select>

                                        </div>

                                    </div>

                                    <div class="col-sm-3"  v-show="reportType == 'byCustomer'">
                                        <div class="form-group">
                                            <label> <strong>Customer:</strong> </label>
                                            <input id="customerId" v-model="customerId" type="text" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label><strong>Status:</strong></label>
                                            <div>
                                                <label class="mr-2">
                                                    <input type="radio" value="all" v-model="reportStatus"> All
                                                </label>
                                                <label class="mr-2">
                                                    <input type="radio" value="posted" v-model="reportStatus"> Posted
                                                </label>
                                                <label>
                                                    <input type="radio" value="unposted" v-model="reportStatus"> Unposted
                                                </label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-sm-2 mt-1">

                                        <div class="form-group mt-1">

                                            <button type="button" class="alignright btn btn-amber" v-on:click="getReportData()"> Search </button>

                                        </div>

                                    </div>

                                </div>

                                <hr />

                                <div style="height:auto;width:auto;min-height:500px;" id="reportView">  </div>

                            </div>

                        </div>
                    </div>
                </div>

            </div>


        </div>
    </div>
</div>


<script src="~/js/ar/general-reports/openingbalances.js" asp-append-version="true"></script>