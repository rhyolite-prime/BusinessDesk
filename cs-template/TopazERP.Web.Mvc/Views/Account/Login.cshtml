@model TopazERP.Web.Models.Account.LoginFormViewModel
@{
    ViewBag.Title = L("LogIn");
    Layout = "~/Views/Account/_authLayout.cshtml";
}

@section scripts {
    <script src="~/view-resources/Views/Account/Login.js" asp-append-version="true"></script>
}

<div class="card-body">
    <form class="form-horizontal" asp-action="Login" method="post" id="LoginForm" novalidate>
        <input type="hidden" id="ReturnUrl" name="returnUrl" value="@Model.ReturnUrl" />
        <input type="hidden" id="ReturnUrlHash" name="returnUrlHash" value="" />

        <fieldset class="form-group position-relative has-icon-left">
            <input type="text"
                   id="AccountId"
                   name="accountId"
                   class="form-control input-lg"
                   placeholder="Account ID"
                   autocomplete="organization"
                   required />
            <div class="form-control-position">
                <i class="ft-tag"></i>
            </div>
            <div class="help-block font-small-3" id="AccountId-error"></div>
        </fieldset>

        <fieldset class="form-group position-relative has-icon-left">
            <input type="text"
                   id="UsernameOrEmailAddress"
                   name="usernameOrEmailAddress"
                   class="form-control input-lg"
                   placeholder="Username"
                   autocomplete="username"
                   required />
            <div class="form-control-position">
                <i class="ft-user"></i>
            </div>
            <div class="help-block font-small-3" id="UsernameOrEmailAddress-error"></div>
        </fieldset>

        <fieldset class="form-group position-relative has-icon-left">
            <input type="password"
                   id="Password"
                   name="Password"
                   class="form-control input-lg"
                   placeholder="Password"
                   autocomplete="current-password"
                   required />
            <div class="form-control-position">
                <i class="la la-key"></i>
            </div>
            <button type="button"
                    id="TogglePassword"
                    class="btn btn-link password-toggle-btn"
                    aria-label="Toggle password visibility"
                    tabindex="-1">
                <i class="la la-eye" id="TogglePasswordIcon"></i>
            </button>
            <div class="help-block font-small-3" id="Password-error"></div>
        </fieldset>

        <div class="form-group row">
            <div class="col-md-6 col-12 text-center text-md-left">
                <fieldset>
                    <input type="checkbox" id="RememberMe" name="RememberMe" class="chk-remember">
                    <label for="RememberMe"> Remember Me</label>
                </fieldset>
            </div>
            <div class="col-md-6 col-12 text-center text-md-right">
                <a href="#" class="card-link">Forgot Password?</a>
            </div>
        </div>

        <div id="LoginError" class="alert alert-danger" style="display:none;" role="alert"></div>

        <button type="submit" id="LoginBtn" class="btn btn-danger btn-block btn-lg">
            <span id="LoginBtnText"><i class="ft-unlock"></i> Login</span>
            <span id="LoginBtnSpinner" style="display:none;">
                <i class="la la-spinner la-spin"></i> Signing in...
            </span>
        </button>
    </form>
</div>


<style>
    .password-toggle-btn {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        padding: 0;
        color: #aaa;
        background: none;
        border: none;
        z-index: 10;
        line-height: 1;
    }
    .password-toggle-btn:hover {
        color: #555;
    }
    #LoginError {
        font-size: 0.9rem;
        margin-top: 0.5rem;
    }
</style>
