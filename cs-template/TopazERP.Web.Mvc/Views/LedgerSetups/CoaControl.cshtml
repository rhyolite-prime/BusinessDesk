@{
    ViewBag.Title = "Chart of Account Control";
    Layout = "~/Views/Shared/Layout/_adminLedgerLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Chart of Account Control </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#">General Ledger Setups</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Chart of Account Control
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Chart of Account Control </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                               <div class="row">

                                <div class="col-sm-3">
                                </div>

                                <div class="col-sm-3">

                                    <div class="form-group">
                                        <label> Chart of Account: </label>
                                        <select class="form-control" v-model="selectedAccountGroupId" v-on:change="getChartOfAccountControlByAccountGroup()">
                                            <option value=""> Select Chart of Account </option>
                                            <option :value="coa.id" v-for="coa in coaHierachyList"> {{coa.name}} </option>
                                        </select>
                                        
                                    </div>

                                </div>


                                </div>
                                <hr />
                                <div class="row">

                                    <div class="col-sm-3">

                                        <div class="form-group">
                                            <label> Account Header Name: </label>
                                            <input type="text" class="form-control" name="AccountHeaderName" v-model="accountHeaderName" placeholder="Account Header Name">

                                        </div>

                                    </div>

                                    <div class="col-sm-2">

                                        <div class="form-group">
                                            <label> Min. Account No: </label>
                                            <input type="number" class="form-control" name="MinAccount" v-model="minAccount" placeholder="Min. Account No">
                                             
                                        </div>

                                    </div>

                                    <div class="col-sm-2">

                                        <div class="form-group">
                                            <label> Max. Account No: </label>

                                            <input type="number" class="form-control" name="MaxAccount" v-model="maxAccount" placeholder="Max. Account No">
                                            
                                        </div>

                                    </div>

                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label> Parent Account: </label>
                                            <select class="form-control" v-model="parentAccountHeaderId">
                                                <option value=""> Parent Account </option>
                                                <option :value="coaControl.id" v-for="coaControl in coaControlHierachyList"> {{coaControl.accountControlHierachyName}} </option>
                                            </select>
                                        </div>

                                    </div>


                                    <div class="col-sm-1 mt-1">
                                        <div class="form-group mt-1">
                                             
                                            <button type="button" v-on:click="saveCoaControl()" class="btn btn-primary"> Save </button>

                                        </div>

                                    </div>

                                </div>

                                <hr />

                                <div id="dataTable"></div>

                      </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>

<script src="~/libs/vuelidate/vuelidate.min.js"></script>
<script src="~/libs/vuelidate/validators.min.js"></script>

<script src="~/js/gl/setups/coa-control.js" asp-append-version="true"></script>