 @{
    ViewBag.Title = "Time Table";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

 <style>
 .table th {
     color: #353535;
 }
 .crud-header{
     background-color: #2f65a5;
 }
 a:hover {
     cursor: pointer;
     color: #2f65a5;
 }
 
 
     .select{
         border: none;
         background-color: transparent;
         padding: 4px;
         
     }
     .table thead th {
         vertical-align: middle;
         white-space: nowrap;
     }

     .table thead th.sortable {
         cursor: pointer;
     }

     .table thead th.sortable:hover {
         background-color: #28568c;
     }
 .table-active {
     background-color: #e9f1fb !important;
 }
 .crud-buttons a:hover{
     color: #ffffff;
     background-color: #28568c;
     border-radius: 4px;
     padding: 4px;
 }


</style>

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Time Table</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Data Entry</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Time Table
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Class Time Table</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show" id="app">
                            <div class="card-body">
                                <button class="btn btn-sm btn-outline-light my-1" @@click="printPreview">
                                    <i class="la la-print"></i> Print
                                </button>
                                <div class="row">
                                    <div class="col-md-3 e-bootstrap">
                                        <label>Academic Year:</label>
                                        <input id="academicYearId"/>
                                    </div>
                                    <div class="col-md-3 e-bootstrap">
                                        <label>Term:</label>
                                        <input id="termId"/>
                                    </div>
                                    <div class="col-md-3 e-bootstrap">
                                        <label>Class:</label>
                                        <input id="classId"/>
                                    </div>
                                    <div class="col-md-3 e-bootstrap">
                                        <label>Day:</label>
                                        <input id="dayId"/>
                                    </div>
                                </div>

                                <hr/>

                                <div class="mb-2 ">
                                    <button class="my-1 btn btn-sm btn-outline-primary" @@click="addDetail"><i class="la la-plus"></i> New</button>
                                    <table class="table-responsive table table-striped">
                                        <thead>
                                        <tr>
                                            <th style="width: 350px">Subject</th>
                                            <th style="width: 350px">Teacher</th>
                                            <th style="width: 200px">From</th>
                                            <th style="width: 200px">To</th>
                                            <th style="width: 100px">Action</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr v-for="(detail, index) in detailsList" :key="detail.id">
                                            <td>
                                                <select v-model="detail.subjectId" class="select form-control" @@change="setSubjectName">
                                                    <option v-for="s in subjectsForSelectedClass" :value="s.subjectId">{{ getSubjectName(s.subjectId) }}</option>
                                                </select>
                                            </td>

                                            <td>
                                                <select v-model="detail.teacherId" class="select form-control" @@change="setTeacherName">
                                                    <option v-for="t in teachers" :value="t.id">{{ t.firstName }} {{ t.lastName }}</option>
                                                </select>
                                            </td>
                                            <td>
                                                <input type="time" v-model="detail.startTime" class="select form-control">
                                            </td>
                                            <td>
                                                <input type="time" v-model="detail.endTime" class="select form-control">
                                            </td>
                                            <td>
                                                <a class="text-danger" @@click="removeDetail(index)"><i class="la la-trash"></i></a>
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>



                                </div>
                                <!-- Assigned Subjects Table -->


                                <div class="text-right">
                                    <button class="btn btn-primary mr-1"
                                            :disabled="saving"
                                            @@click="saveTimeTable">
                                        <span v-if="saving">
                                            <i class="la la-spinner la-spin mr-1"></i>
                                            Processing...
                                        </span>

                                        <span>
                                          <i class="la la-save"></i>  {{ form.id ? 'Update' : 'Save' }}
                                        </span>

                                    </button>
                                    @*cancel*@
                                    <div class="btn btn-secondary"
                                         @@click="resetForm">
                                       <i class="la la-times"></i> Cancel
                                    </div>
                                </div>


                            </div>

</div>


                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>



<script src="~/js/school-manager/data-entry/timeTable.js" asp-append-version="true"></script>