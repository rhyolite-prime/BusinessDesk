 @{
    ViewBag.Title = "Class Attendance";
 Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Class Attendance</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Data Entry</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Class Attendance
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Class Attendance</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show" id="app">
                            <div class="card-body">
                                <button class="btn btn-sm btn-outline-light my-1" @@click="printPreview()" >
                                    <i class="la la-print"></i> Print
                                </button>
                                <div class="row">
                                    <div class="col-md-3 e-bootstrap">
                                        <label><strong>Class:</strong></label>
                                        <input id="classId"/>
                                    </div>
                                    <div class="col-md-3">
                                        <label>Date</label>
                                        <input type="date" class="form-control" v-model="form.date"/>
                                    </div>
                                    <div class="col-md-3 d-flex align-items-end">
                                        <button class="btn btn-success" @@click="saveAttendance"> <i class="la la-save"></i>  {{ isEditMode ? 'Update' : 'Save' }}<i class="la la-circle-o-notch spinner" v-if="isLoading"></i></button>
                                    </div>
                                    
                                </div>

                                <div class="row mt-3">
                                    <div class="col-12 e-bootstrap">
                                        <div id="studentsDataTable"></div>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
            </div>
          </div>
                </div>
            </div>
        </div>
    </div>
 



<script src="~/js/school-manager/data-entry/attendance.js" asp-append-version="true"></script>