 @{
    ViewBag.Title = "Mid Term Assessment";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}
 <style>
     .table td:first-child,
     .table th:first-child {
         position: sticky;
         left: 0;
         background: #fff;
         z-index: 2;
         color: #0a0af0;
     }
 
     /* Sticky table header */
     .assessment-table-wrapper thead th {
         position: sticky;
         top: 0;
         z-index: 3;
     }

     /* Optional: keep student column visible when scrolling horizontally */
     .assessment-table-wrapper th:first-child,
     .assessment-table-wrapper td:first-child {
         position: sticky;
         left: 0;
         z-index: 2;
     }

     /* Ensure header column stays above body cells */
     .assessment-table-wrapper thead th:first-child {
         z-index: 4;
     }
     .select{
         border: none;
         outline: none;
         background: transparent;
         width: 100%;
         height: 100%;
         padding: 0;
     }
     .crud-header{
         background-color: #2f65a5;
     }
 </style>

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Mid Term Assessment</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Data Entry</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Mid Term Assessment
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Mid Term Assessment</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show" id="app">
                            <div class="card-body">
                                <ul class="nav nav-tabs mb-2">
                                    <li class="nav-item primary">
                                        <a class="nav-link"
                                           :class="{ active: activeTab === 'main' }"
                                           @@click="activeTab = 'main'">
                                            Remark Headers Entry
                                        </a>
                                    </li>

                                    <li class="nav-item primary">
                                        <a class="nav-link"
                                           :class="{ active: activeTab === 'participants' }"
                                           @@click="activeTab = 'participants'">
                                            Mid Term Work Habits
                                        </a>
                                    </li>
                                </ul>

                                <div class="e-bootstrap my-1" v-show="activeTab === 'main'">
                                    <div id="dataTable"></div>
                                </div>
                                <div v-show="activeTab === 'participants'">
                                    <div class="row mb-2">
                                        <div class="col-md-3 e-bootstrap">
                                            <label>Academic Year:</label>
                                            <input id="academicYearId"/>
                                        </div>

                                        <div class="col-md-3 e-bootstrap">
                                            <label>Term:</label>
                                            <input id="termId"/>
                                        </div>

                                        <div class="col-md-3 e-bootstrap">
                                            <label>Class:</label>
                                            <input id="classId"/>
                                        </div>
                                    </div>
                                    <div class="e-bootstrap my-1">
                                        <div v-if="!form.classId || !form.termId || !form.academicYearId"
                                             class="alert alert-info">
                                            Select Class, Term and Academic Year to load students.
                                        </div>
                                      
                                        <div v-if="assessmentTable.length">
                                            <div class="crud-header rounded rounded-lg d-flex justify-content-between align-items-center p-1 flex-wrap">
                                                
                                                <div>
                                                    <input type="text"
                                                           class="form-control form-control-sm"
                                                           placeholder="Search..."
                                                           v-model="searchText"
                                                           style="width: 220px;">
                                                </div>

                                            </div>

                                            <table class="table-responsive table table-bordered table-hover align-middle mb-0">
                                                <thead>
                                                <tr>
                                                    <th style="width:20%">Students</th>
                                                    <th style="width: 20%" v-for="h in assessmentHeaders" :key="h.id">
                                                        {{ h.name }}
                                                    </th>
                                                </tr>
                                                </thead>

                                                <tbody>
                                                <tr v-for="row in paginatedAssessmentTable" :key="row.studentId">
                                                    <td class="fw-semibold">
                                                        {{ row.studentName }}
                                                    </td>

                                                    <td v-for="header in row.headers"
                                                        :key="header.headerId"
                                                        class="text-primary">

                                                        <select
                                                            class="select"
                                                            v-model="header.selectedOptionId">
                                                            <option value="">Select</option>
                                                            <option
                                                                v-for="opt in header.options"
                                                                :key="opt.id"
                                                                :value="opt.id">
                                                                {{ opt.option }}
                                                            </option>
                                                        </select>
                                                    </td>
                                                </tr>
                                                </tbody>
                                            </table>
                                            <div class="d-flex justify-content-end align-items-center gap-2 mt-2">

                                                <button class="btn btn-primary btn-sm"
                                                        :disabled="currentPage === 1"
                                                        @@click="currentPage--">
                                                    Prev
                                                </button>

                                                <span class="px-2">
                                                    Page {{ currentPage }} of {{ totalPages }}
                                                </span>

                                                <button class="btn btn-primary btn-sm"
                                                        :disabled="currentPage === totalPages"
                                                        @@click="currentPage++">
                                                    Next
                                                </button>

                                            </div>
                                        </div>


                                    </div>
                                    <div class="float-right mb-2">
                                        <button class="btn btn-primary" @@click="saveData">
                                            <i class="la la-save"></i>
                                            Save
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
            </div>
          </div>
                </div>
            </div>
        </div>
    </div>
 



<script src="~/js/school-manager/data-entry/midTermAssessment.js" asp-append-version="true"></script>