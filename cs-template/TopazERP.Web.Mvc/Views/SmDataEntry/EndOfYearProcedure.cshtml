 @{
    ViewBag.Title = "End Of Term Procedures";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">End Of Term Procedures</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Data Entry</a>
                            </li>
                            <li class="breadcrumb-item active">
                                End Of Term Procedures
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">End Of Term Procedures</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show" id="app">
                            <div class="card-body">
                                <ul class="nav nav-tabs mb-2">
                                    <li class="nav-item">
                                        <a class="nav-link"
                                           :class="{ active: activeTab === 'main' }"
                                           @@click="activeTab = 'main'">
                                            Next Term Begins
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                           :class="{ active: activeTab === 'participants' }"
                                           @@click="activeTab = 'participants'">
                                            Promote Classes
                                        </a>
                                    </li>
                                </ul>


                                <div v-show="activeTab === 'main'">
                                    <div class="row mb-2">
                                        <div class="col-md-3">
                                            <label><strong>Next Term Begins</strong></label>
                                            <input type="date" v-model="form.startDate" class="form-control">
                                        </div>
                                    </div>
 
                                </div>

                                <div class="e-bootstrap my-1" v-show="activeTab === 'participants'">
                                    <div id="dataTable"></div>
                                </div>
                              
                                
                                <div class="float-right mb-2">
                                    <button class="btn btn-success" @@click="saveData">
                                        <i class="la la-save"></i>
                                      Save
                                    </button>
                                </div>
                               
                            </div>
                            

                           
                           

                        </div>
            </div>
          </div>
                </div>
            </div>
        </div>
    </div>
 



<script src="~/js/school-manager/data-entry/classPromotions.js" asp-append-version="true"></script>