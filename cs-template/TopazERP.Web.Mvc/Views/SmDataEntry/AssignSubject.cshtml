 @{
    ViewBag.Title = "Assign Subject";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

 <style>
     .subject-item input {
         margin-right: 6px;
     }
 </style>

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Assign Subject</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Data Entry</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Assign Subject
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Assign Subject</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show" id="app">
                            <div class="card-body">
                                <button class="btn btn-sm btn-outline-light my-1" @@click="printPreview">
                                    <i class="la la-print"></i> Print
                                </button>
                                <div class="row">
                                    <div class="col-md-3">
                                        <label>Academic Year:</label>
                                        <input id="academicYearId"/>
                                    </div>
                                    <div class="col-md-3">
                                        <label>Term:</label>
                                        <input id="termId"/>
                                    </div>
                                    <div class="col-md-3">
                                        <label>Class:</label>
                                        <input id="classId"/>
                                    </div>
                                </div>

                                <hr/>

                                <div class="row mb-2 ">

                                    <div class="col-md-6  my-1">
                                        <label class="d-flex align-items-center ">
                                            <input type="checkbox"
                                                   class="mr-1"
                                                   :checked="allSubjectsSelected"
                                                   @@change="toggleSelectAll">
                                            Select All Subjects
                                        </label>

                                        <hr class="my-1"/>

                                        <ul class="list-unstyled mb-0">
                                            <li class="mb-1"
                                                v-for="s in subjects"
                                                :key="s.id">

                                                <label class="d-flex align-items-center subject-item">
                                                    <input type="checkbox"
                                                           class="mr-1 "
                                                           :checked="isSelected(s.id)"
                                                           @@change="toggleSubjectCheckbox(s)">
                                                    {{ s.name }}
                                                </label>

                                            </li>
                                        </ul>
                                    </div>
                                    <div class="col-md-6">
                                        <table class="table-responsive table table-bordered table-sm my-1 table-striped">
                                            <thead>
                                            <tr>
                                                <th style="width: 90%">Subject</th>
                                                <th style="width:10%">Remove</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            <tr v-if="form.details.length === 0">
                                                <td colspan="2" class="text-center text-muted">
                                                    No subjects assigned
                                                </td>
                                            </tr>

                                            <tr v-for="(d, index) in form.details" :key="d.subjectId">
                                                <td>{{getSubjectName(d.subjectId)}}</td>
                                                <td>
                                                    <a class="text-danger"
                                                       @@click="removeDetail(index)">
                                                        <i class="la la-trash"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                            </tbody>
                                        </table></div>

                                </div>
                                <!-- Assigned Subjects Table -->


                                <div class="text-right">
                                    <button class="btn btn-primary mr-1"
                                            :disabled="saving"
                                            @@click="save">

                                        <span v-if="saving">
                                            <i class="la la-spinner la-spin mr-1"></i>
                                            Saving...
                                        </span>

                                        <span v-else>
                                            <i class="la la-save"></i> {{ form.id ? 'Update' : 'Save' }}
                                        </span>

                                    </button>
                                    @*cancel*@
                                    <div class="btn btn-secondary"
                                         @@click="resetForm">
                                      <i class="la la-times"></i>  Cancel
                                    </div>
                                </div>


                            </div>
</div>


                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>



<script src="~/js/school-manager/data-entry/assignSubject.js" asp-append-version="true"></script>