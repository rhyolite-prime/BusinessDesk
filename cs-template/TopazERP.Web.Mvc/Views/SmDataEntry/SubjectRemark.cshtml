@{
    ViewBag.Title = "Subject Remarks";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}
<style>
 .table th {
     color: #353535;
 }
 .crud-header{
     background-color: #2f65a5;
 }
 .crud-buttons a:hover{
     color: #ffffff;
     background-color: #28568c;
     border-radius: 4px;
     padding: 4px;
 }

 .thead tr th{
     color: #000000;
 }
     .select{
         border: none;
         background-color: transparent;
         padding: 4px;
         
     }
     .table thead th {
         vertical-align: middle;
         white-space: nowrap;
     }


</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Subject Remarks</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Data Entry</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Subject Remarks
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>

        <div class="content-body" id="app">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Subject Remarks For Primary & JHS</h4>
                    <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                    <div class="heading-elements">
                        <ul class="list-inline mb-0">
                            <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                            <li><a data-action="close"><i class="ft-x"></i></a></li>
                        </ul>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Stage -->
                    <div class="form-group mb-1">
                        <label><strong>Stage</strong></label><br />
                        <label class="mr-2">
                            <input type="radio" value="Primary" v-model="stage" @@change="loadStageRemarks" /> Primary
                        </label>
                        <label>
                            <input type="radio" value="JHS" v-model="stage" @@change="loadStageRemarks" /> JHS
                        </label>
                    </div>
                    
                    <!-- Editable Table -->
                    <div class="mb-1">
        
                        <!-- CRUD HEADER -->
                        <div class="crud-header rounded rounded-xl d-flex justify-content-between align-items-center p-1">
        
                            <!-- Left: CRUD buttons -->
                            <div class="crud-buttons">
        
                                <!-- Add Row -->
                                <a class="text-white" @@click="addRow">
                                    <i class="la la-plus"></i>
                                </a>
        
                                <!-- Save Selected -->
                                <a class="text-white" @@click="saveSelected">
                                    <i class="la la-save"></i>
                                </a>
        
                                <!-- Delete Selected -->
                                <a class="text-white" @@click="deleteSelected">
                                    <i class="la la-trash"></i>
                                </a>
        
                            </div>
        
                        </div>
        
                        <table class="table-responsive table table-bordered table-sm">
        
                            <thead class="thead text-white">
                            <tr>
        
                                <!-- Select All Checkbox -->
                                <th style="width: 40px" class="text-center">
                                    <input type="checkbox"
                                           v-model="selectAll"
                                           @@change="toggleSelectAll" />
                                </th>
        
                                <th style="width: 120px">Grade Number</th>
                                <th style="width: 250px">Min Mark</th>
                                <th style="width: 250px">Max Mark</th>
                                <th style="width: 450px">Grade</th>
        
                            </tr>
                            </thead>
        
                            <tbody>
        
                            <tr v-for="(row, index) in tableRows" :key="row.id || index" @@keydown.enter.prevent="saveRow(row)">
        
                                <!-- Row Checkbox -->
                                <td class="text-center">
                                    <input type="checkbox" v-model="row.selected" />
                                </td>
        
                                <td>
                                    <input class="select form-control"
                                           v-model="row.gradeNumber" />
                                </td>
        
                                <td>
                                    <input type="number"
                                           class="select form-control"
                                           v-model.number="row.minMark" />
                                </td>
        
                                <td>
                                    <input type="number"
                                           class="select form-control"
                                           v-model.number="row.maxMark" />
                                </td>
        
                                <td>
                                    <input style="width: 450px"
                                           class="select form-control"
                                           v-model="row.remark" />
                                </td>
        
                            </tr>
        
                            <tr v-if="tableRows.length === 0">
                                <td colspan="5" class="text-center">
                                    No data. Add a row.
                                </td>
                            </tr>
        
                            </tbody>
        
                        </table>
        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/school-manager/data-entry/subjectRemarks.js" asp-append-version="true"></script>
