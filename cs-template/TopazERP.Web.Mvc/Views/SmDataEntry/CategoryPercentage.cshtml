 @{
    ViewBag.Title = "Category Percentage";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}
 <style>
     .subject-item input {
         margin-right: 6px;
     }

 </style>

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Category Percentage</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Data Entry</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Category Percentage
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Category Percentage</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show" id="app">
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-md-2 mb-1">
                                        <label>Exams %:</label>
                                        <input type="number" class="form-control" v-model.number="form.examPercentage">
                                    </div>
                                    <div class="col-md-2 mb-1">
                                        <label>Cat 1 %:</label>
                                        <input type="number" class="form-control" v-model.number="form.cat1Percentage">
                                    </div>
                                    <div class="col-md-2 mb-1">
                                        <label>Cat 2 %:</label>
                                        <input type="number" class="form-control" v-model.number="form.cat2Percentage">
                                    </div>
                                    <div class="col-md-2 mb-1">
                                        <label>Cat 3 %:</label>
                                        <input type="number" class="form-control" v-model.number="form.cat3Percentage">
                                    </div>
                                    <div class="col-md-2 mb-1">
                                        <label>Cat 4 %:</label>
                                        <input type="number" class="form-control" v-model.number="form.cat4Percentage">
                                    </div>
                                </div>

                                <div class="text-right mt-2">
                                    <button class="btn btn-primary" :disabled="saving" @@click="save">
                                        <span v-if="saving"><i class="la la-spinner la-spin mr-1"></i> Processing...</span>
                                        <span v-else><i class="la la-save"></i>{{ form.id ? 'Update' : 'Save' }}</span>
                                    </button>
                                </div>
                                
                            </div>
                           

                        </div>
                        </div>
            </div>
          </div>
                </div>
            </div>
        </div>
 
 



<script src="~/js/school-manager/data-entry/categoryPercentage.js" asp-append-version="true"></script>