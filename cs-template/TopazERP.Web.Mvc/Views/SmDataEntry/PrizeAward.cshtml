@{
ViewBag.Title = "Prize Awarded";
Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Prize Awarded </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#"> Data Entry </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Prize Awarded
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Prize Awarded</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <button class="btn btn-sm btn-outline-light my-1" @@click="printPreview">
                                    <i class="la la-print"></i> Print
                                </button>
                                <div class="row mb-2">
                                    <div class="col-md-3">
                                        <label>Academic Year</label>
                                        <input id="academicYearId"/>
                                    </div>

                                    <div class="col-md-3">
                                        <label>Term</label>
                                        <input id="termId"/>
                                    </div>

                                    <div class="col-md-3">
                                        <label>Level</label>
                                        <input id="levelId"/>
                                    </div>
                                </div>

                                <hr/>

                                <div class="e-bootstrap">
                                    <table id="dataTable"></table>

                                    <div class="my-1 float-right">
                                        <button class="btn btn-success mr-2" @@click="saveData">
                                            <i class="la la-save"></i>
                                            {{ form.id === null ? 'Save' : 'Update' }}

                                        </button>
                                        <button v-if="form.id !== null" class="btn btn-danger" @@click="deleteData">
                                            <i class="la la-trash"></i> Delete
                                        </button>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>


<script src="~/js/school-manager/data-entry/prizeAwards.js" asp-append-version="true"></script>