 @{
    ViewBag.Title = "Register Class";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Register Class</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Data Entry</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Register Class
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Register Class</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show" id="app">
                            <div class="card-body" >
                                <div v-show="showListPanel">

                                    <div class="d-flex justify-content-between align-items-center ">
                                        <h6>Registered Classes</h6>
                                        

                                        <button class="btn btn-outline-primary"
                                                @@click="showListPanel = false">
                                            <i class="la la-plus"></i>
                                            Register Class
                                        </button>
                                    </div>
                                    <div class="row my-1">
                                        <div class="col-md-1">
                                            <button class="btn btn-sm btn-outline-light" @@click="printPreview">
                                                <i class="la la-print"></i> Print
                                            </button>
                                        </div>
                                       
                                        <div class="col-md-3">
                                            <input type="text"
                                                   class="form-control"
                                                   placeholder="Search class, teacher, room, academic year..."
                                                   v-model="searchText"
                                                   @@input="currentPage = 1"/>
                                        </div>


                                    </div>

                                    <table class="table-responsive table table-bordered table-striped">
                                        <thead >
                                        <tr>

                                            <th @@click="setSort('className')" style="cursor:pointer; width: 250px">
                                                Class
                                                <i :class="sortIcon('className')"></i>
                                            </th>

                                            <th @@click="setSort('roomName')" style="cursor:pointer; width: 250px">Room
                                                <i :class="sortIcon('roomName')"></i>
                                            </th>

                                            <th @@click="setSort('mainTeacherName')" style="cursor:pointer; width: 350px">
                                                Main Teacher
                                                <i :class="sortIcon('mainTeacherName')"></i>
                                            </th>

                                            <th @@click="setSort('capacity')" style="cursor:pointer; width: 250px">
                                                Class Size
                                                <i :class="sortIcon('capacity')"></i>
                                            </th>

                                            <th style="width:150px">Actions</th>

                                        </tr>
                                        </thead>
                                        <tbody>

                                        <!-- NO DATA -->
                                        <tr v-if="groupedByAcademicYear.length === 0">
                                            <td colspan="6" class="text-center">No records found</td>
                                        </tr>

                                        <!-- ACADEMIC YEAR GROUP -->
                                        <template v-for="year in groupedByAcademicYear" :key="year.academicYearId">

                                            <!-- PARENT ROW -->
                                            <tr class="table-active"
                                                style="cursor:pointer"
                                                @@click="toggleYear(year.academicYearId)">
                                                <td colspan="6">
                                                    <i class="la"
                                                       :class="expandedYears[year.academicYearId] ? 'la-chevron-down' : 'la-chevron-right'">
                                                    </i>
                                                    <strong class="ml-1">
                                                       Academic Year - {{ getAcademicYearName(year.academicYearId)}}
                                                    </strong>
                                                    <span class="text-xm text-primary ml-2">
                                                        {{ year.classes.length }} item(s)
                                                    </span>
                                                </td>
                                            </tr>

                                            <!-- CHILD ROWS -->
                                            <tr v-show="expandedYears[year.academicYearId]"
                                                v-for="item in year.classes"
                                                :key="item.id">
                                                
                                                <td>{{ getLevelClassNameFromId(item.classId)}}</td>
                                                <td>{{ getRoomName(item.roomId) }}</td>
                                                <td>{{ getTeacherName(item.mainTeacherId)}}</td>
                                                <td>{{ item.capacity }}</td>
                                                <td>
                                                    <a class="text-primary mr-2"
                                                       @@click.stop="editRegisteredClass(item)">
                                                        <i class="la la-edit"></i>
                                                    </a>

                                                    <a class="text-danger"
                                                       @@click.stop="deleteRegisteredClass(item.id)">
                                                        <i class="la la-trash"></i>
                                                    </a>
                                                </td>
                                            </tr>

                                        </template>

                                        </tbody>
                                    </table>
                                    <div class="d-flex justify-content-end align-items-center gap-2">

                                        <!-- Prev -->
                                        <button class="btn btn-primary btn-sm"
                                                :disabled="currentPage === 1"
                                                @@click="currentPage--">
                                            Prev
                                        </button>

                                        <!-- Page Info -->
                                        <span class="px-2">
                                            Page {{ currentPage }} of {{ totalPages }}
                                        </span>

                                        <!-- Next -->
                                        <button class="btn btn-primary btn-sm"
                                                :disabled="currentPage === totalPages"
                                                @@click="currentPage++">
                                            Next
                                        </button>

                                    </div>


                                    </div>
                                <div v-show="!showListPanel">

    <div class="d-flex justify-content-between align-items-center my-1">
        <h6 v-if="isEditMode">Edit Register Class</h6>
        <button class="btn btn-secondary"
                @@click="showListPanel = true">
            <i class="la la-chevron-circle-left"></i>
            Back to List
        </button>
    </div>
            <div class="row">

                <div class="col-md-3 mb-1 e-bootstrap">
                    <label>Class</label>
                    <input id="classId" />
                </div>

                <div class="col-md-3 mb-1 e-bootstrap">
                    <label>Academic Year</label>
                    <input id="academicYearId" />
                </div>

                <div class="col-md-3 mb-1 e-bootstrap">
                    <label>Room</label>
                    <input id="roomId" />
                </div>

                <div class="col-md-3 mb-1 e-bootstrap">
                    <label>Main Teacher</label>
                    <input id="mainTeacherId" />
                </div>

                <div class="col-md-3 mb-1 e-bootstrap">
                    <label>Sub Teacher</label>
                    <input id="subTeacherId" />
                </div>
                <div class="col-md-3 mb-1 e-bootstrap">
                    <label>Class Prefect</label>
                    <input id="classPrefectId" />
                </div>
                <div class="col-md-3 mb-1 e-bootstrap">
                    <label>Assistant Class Prefect</label>
                    <input id="assistantPrefectId" />
                </div>
                <div class="col-md-3 mb-1 e-bootstrap">
                    <label>Class Size</label>
                    <input type="number"
                           class="form-control"
                           v-model="form.capacity" />
                </div>

                <div class="col-md-6 mb-1 e-bootstrap">
                    <label>Description</label>
                    <textarea class="form-control"
                              v-model="form.description"></textarea>
                </div>

                <div class="col-md-6 mb-1">
                    <label>Comments</label>
                    <textarea class="form-control"
                              v-model="form.comments"></textarea>
                </div>

            </div>

            <div class="text-right">
                <button class="btn btn-primary"
                        @@click="saveInput">
                  <i class="la la-save"></i>  {{ isEditMode ? 'Update' : 'Save' }}
                </button>
            </div>

        </div>
    </div>

</div>


                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>



<script src="~/js/school-manager/data-entry/registerClass.js" asp-append-version="true"></script>