@{
    ViewBag.Title = "Disciplinary Actions";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}
<style>
 .table th {
     color: #353535;
 }
 .crud-header{
     background-color: #2f65a5;
 }
 a:hover {
     cursor: pointer;
     color: #2f65a5;
 }
 
 
     .select{
         border: none;
         background-color: transparent;
         padding: 4px;
         
     }
     .table thead th {
         vertical-align: middle;
         white-space: nowrap;
     }

     .table thead th.sortable {
         cursor: pointer;
     }

     .table thead th.sortable:hover {
         background-color: #28568c;
     }
 .table-active {
     background-color: #e9f1fb !important;
 }
 .crud-buttons a:hover{
     color: #ffffff;
     background-color: #28568c;
     border-radius: 4px;
     padding: 4px;
 }


</style>


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Disciplinary Actions </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#"> Data Entry </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Disciplinary Actions
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Disciplinary Actions</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div class="e-bootstrap">
                                    <div class="crud-header rounded rounded-lg d-flex justify-content-between align-items-center p-1 flex-wrap">

                                        <!-- Left: CRUD buttons -->
                                        <div class="crud-buttons">
                                            <a class="text-white" @@click="addRow">
                                                <i class="la la-plus"></i>
                                            </a>

                                            <a class="text-white" @@click="saveSelected">
                                                <i class="la la-save"></i>
                                            </a>

                                            <a class="text-white" @@click="deleteSelected">
                                                <i class="la la-trash"></i>
                                            </a>

                                            <a class="text-white" @@click="printPreview">
                                                <i class="la la-print"></i>
                                            </a>
                                        </div>
                                        
                                        <div>
                                            <input type="text"
                                                   class="form-control form-control-sm"
                                                   placeholder="Search..."
                                                   v-model="searchText"
                                                   style="width: 220px;">
                                        </div>

                                    </div>

                                    <div class="table-responsive mb-2">
                                        <table class=" table table-bordered table-striped table-responsive">
                                            <thead>
                                            <tr>
                                                <th style="width: 150px" class="sortable" @@click="sortBy('academicYearId')">Academic Year</th>
                                                <th style="width: 150px" class="sortable" @@click="sortBy('classId')">Class</th>
                                                <th style="width: 150px" class="sortable" @@click="sortBy('actionDate')">Date</th>
                                                <th style="width: 250px">Student</th>
                                                <th style="width: 150px">Offense</th>
                                                
                                                <th style="width: 360px">Action Taken</th>
                                            </tr>
                                            </thead>

                                            <tbody>
                                            <tr v-for="row in pagedRows"
                                                :key="row.id"
                                                @@click="selectRow(row)"
                                                :class="{ 'table-active': selectedRow === row }"
                                                @@keydown.enter.prevent="saveRow(row)">

                                                <td>
                                                    <select class="select" v-model="row.academicYearId">
                                                        <option value="">Select</option>
                                                        <option v-for="ay in academicYears" :value="ay.id">
                                                            {{ ay.name }}
                                                        </option>
                                                    </select>
                                                </td>

                                                <td>
                                                    <select class="select" v-model="row.classId" @@change="row.studentId = null">
                                                        <option value="">Select</option>
                                                        <option v-for="c in classes" :value="c.id">
                                                            {{ getLevelClassNameFromId(c.id) }}
                                                        </option>
                                                    </select>
                                                </td>
                                                <td>
                                                    <input class="select" type="date" v-model="row.actionDate">
                                                </td>
                                                <td>
                                                    <select class="select" v-model="row.studentId" :disabled="!row.classId">
                                                        <option value="">Select</option>
                                                        <option v-for="s in studentsByClass(row.classId)" :value="s.id">
                                                            {{ s.name }}
                                                        </option>
                                                    </select>
                                                </td>

                                                <td>
                                                    <select class="select" v-model="row.offenseId">
                                                        <option value="">Select</option>
                                                        <option v-for="o in offenses" :value="o.id">
                                                            {{ o.name }}
                                                        </option>
                                                    </select>
                                                </td>

                                                

                                                <td>
                                                    <input class="select" type="text" v-model="row.description">
                                                </td>

                                            </tr>
                                            </tbody>

                                        </table>
                                        <div class="pagination float-right">
                                            <button class="btn btn-sm btn-primary mr-1" @@click="currentPage--" :disabled="currentPage === 1">Prev</button>
                                            <span>Page {{ currentPage }} of {{ totalPages }}</span>
                                            <button class="btn btn-sm btn-primary ml-1" @@click="currentPage++" :disabled="currentPage === totalPages">Next</button>
                                        </div>

                                    </div>


                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>

<script src="~/js/school-manager/data-entry/disciplinaryActions.js" asp-append-version="true"></script>