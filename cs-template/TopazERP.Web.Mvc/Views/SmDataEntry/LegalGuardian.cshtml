@{
    ViewBag.Title = "Parents & Legal Guardians";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

<style>
 .table th {
     color: #353535;
 }
 a:hover {
     cursor: pointer;
     color: #2f65a5;
 }
 
     .select{
         border: none;
         background-color: transparent;
         padding: 4px;
         
     }
     .table thead th {
         vertical-align: middle;
         white-space: nowrap;
     }

     .table thead th.sortable {
         cursor: pointer;
     }

     .table thead th.sortable:hover {
         background-color: #28568c;
     }
 

</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Parents & Legal Guardians </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#"> Data Entry </a>
                            </li>
                            <li class="breadcrumb-item active">
                               Parents & Legal Guardians
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body" id="app">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                            <ul class="nav nav-tabs card-header-tabs" id="guardianTabs" role="tablist">

                                <!-- TAB 1 -->
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       id="guardian-tab"
                                       data-toggle="tab"
                                       href="#guardian"
                                       role="tab">
                                        Create / Edit Legal Guardian
                                    </a>
                                </li>

                                <!-- TAB 2 -->
                                <li class="nav-item">
                                    <a class="nav-link"
                                       id="assign-tab"
                                       data-toggle="tab"
                                       href="#assign"
                                       role="tab">
                                        Assign Student To Guardian
                                    </a>
                                </li>

                            </ul>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" >
                                <div class="tab-content">
                                    <div class="tab-pane fade show active"
                                         id="guardian"
                                         role="tabpanel">
                                        <div>
                                            <h4>{{ editing ? 'Edit Legal Guardian' : 'Add New Legal Guardian' }}</h4>
                                            <form >
                                                <div class="row mt-2">
                                                    <div class="col-md-3 mb-2">
                                                        <label>Student</label>
                                                        <input id="studentId">
                                                    </div>
                                                    <div class="col-md-3 mb-2">
                                                        <label>Relationship</label>
                                                        <input id="relationshipId">
                                                    </div>
                                                    <div class="col-md-3 mb-2">
                                                        <label>Title</label>
                                                        <input id="titleId">
                                                    </div>

                                                    <div class="col-md-3 mb-2">
                                                        <label>First Name</label>
                                                        <input v-model="form.firstName" type="text" class="form-control">
                                                    </div>
                                                    <div class="col-md-3 mb-2">
                                                        <label>Last Name</label>
                                                        <input v-model="form.lastName" type="text" class="form-control">
                                                    </div>
                                                    <div class="col-md-3 mb-2">
                                                        <label>Other Names</label>
                                                        <input v-model="form.otherNames" type="text" class="form-control">
                                                    </div>

                                                    <div class="col-md-3 mb-2">
                                                        <label>Phone Number</label>
                                                        <input v-model="form.phoneNumber" type="text" class="form-control">
                                                    </div>
                                                    <div class="col-md-3 mb-2">
                                                        <label>Email</label>
                                                        <input v-model="form.email" type="email" class="form-control">
                                                    </div>

                                                    <div class="col-md-3 mb-2">
                                                        <label>Place of Work</label>
                                                        <input v-model="form.placeOfWork" type="text" class="form-control">
                                                    </div>
                                                    <div class="col-md-3 mb-2">
                                                        <label>Work Phone</label>
                                                        <input v-model="form.workPhone" type="text" class="form-control">
                                                    </div>
                                                    <div class="col-md-3 mb-2">
                                                        <label>Is Legal Guardian</label>
                                                        <input v-model="form.isLegalGuardian" type="checkbox" class="form-control">
                                                    </div>
                                           
                                                </div>
                                            </form>
                                            <div class="my-2 float-right">
                                                <button class="btn btn-primary" type="button" @@click="saveGuardian" :disabled="isLoading">
                                                   <i class="la la-save"></i> {{ editing ? 'Update' : 'Save' }}
                                                </button>
                                                <button class="btn btn-secondary ml-2" type="button" @@click="resetForm"><i class="la la-times"></i>Cancel</button>
                                            </div>
                                        </div>
                                        <div class="mt-4">
                                            <table class="table-responsive table  table-striped">
                                                <thead>
                                                <tr>
                                                    <th style="width: 20%">Student</th>
                                                    <th style="width: 20%">Name</th>
                                                    <th style="width: 10%">Relationship</th>
                                                    <th style="width: 20%">Phone</th>
                                                    <th style="width: 20%">Email</th>
                                                    <th style="width: 10%">Actions</th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                <tr v-for="g in studentGuardians" :key="g.id">
                                                    <td class="select">{{ formatStudentName(allStudents.find(s => s.id === g.studentId)) }}</td>
                                                    <td class="select">{{ formatLegalGuardianName(g) }}</td>
                                                    <td>{{ getRelationshipName(g.relationshipId) }}</td>
                                                    <td>{{ g.phoneNumber }}</td>
                                                    <td>{{ g.email }}</td>
                                                    <td>
                                                        <a class="text-primary" @@click="editGuardian(g)"><i class="la la-edit"></i></a>
                                                        <a class="text-danger" @@click="deleteGuardian(g.id)"><i class="la la-trash"></i></a>
                                                    </td>
                                                </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="tab-pane fade"
                                         id="assign"
                                         role="tabpanel">
                                        <div>
                                            <h4>Assign Student To Parent / Legal Guardian</h4>
                                            <form >
                                                <div class="row mt-2">
                                                    <div class="col-md-3 mb-2">
                                                        <label>Legal Guardian</label>
                                                        <input id="legalGuardianId">
                                                    </div>
                                                    <div class="col-md-3 mb-2">
                                                        <label>Student</label>
                                                        <input id="studentId1">
                                                    </div>
                                                    <div class="col-md-3 mb-2">
                                                        <label>Relationship</label>
                                                        <input id="relationshipId1">
                                                    </div>
                                                    <div class="col-md-3 mb-2">
                                                        <label>Title</label>
                                                        <input id="titleId1">
                                                    </div>

                                                    <div class="col-md-3 mb-2">
                                                        <label>First Name</label>
                                                        <input v-model="assignForm.firstName" type="text" class="form-control" disabled>
                                                    </div>
                                                    <div class="col-md-3 mb-2">
                                                        <label>Last Name</label>
                                                        <input v-model="assignForm.lastName" type="text" class="form-control"  disabled>
                                                    </div>
                                                    <div class="col-md-3 mb-2">
                                                        <label>Other Names</label>
                                                        <input v-model="assignForm.otherNames" type="text" class="form-control"  disabled>
                                                    </div>

                                                    <div class="col-md-3 mb-2">
                                                        <label>Phone Number</label>
                                                        <input v-model="assignForm.phoneNumber" type="text" class="form-control" disabled>
                                                    </div>
                                                    <div class="col-md-3 mb-2">
                                                        <label>Email</label>
                                                        <input v-model="assignForm.email" type="email" class="form-control" disabled>
                                                    </div>

                                                    <div class="col-md-3 mb-2">
                                                        <label>Place of Work</label>
                                                        <input v-model="assignForm.placeOfWork" type="text" class="form-control" disabled>
                                                    </div>
                                                    <div class="col-md-3 mb-2">
                                                        <label>Work Phone</label>
                                                        <input v-model="assignForm.workPhone" type="text" class="form-control" disabled>
                                                    </div>
                                                    <div class="col-md-3 mb-2">
                                                        <label>Is Legal Guardian</label>
                                                        <input v-model="assignForm.isLegalGuardian" type="checkbox" class="form-control" disabled>
                                                    </div>
                                           
                                                </div>
                                            </form>
                                            <div class="my-2 float-right">
                                                <button class="btn btn-primary" type="button" @@click="assignStudent" :disabled="isLoading">
                                                   <i class="la la-save"></i> Save
                                                </button>
                                                <button class="btn btn-secondary ml-2" type="button" @@click="resetForm"><i class="la la-times"></i>Cancel</button>
                                            </div>
                                            <div class="mt-4" v-if="guardianStudents.length > 0">
                                                <h5>Students Under This Guardian</h5>

                                                <table class="table table-striped table-sm table-responsive">
                                                    <thead>
                                                    <tr>
                                                        <th>#</th>
                                                        <th style="width: 50%">Student Name</th>
                                                        <th style="width: 50%">Relationship</th>
                                                    </tr>
                                                    </thead>
                                                    <tbody>
                                                    <tr v-for="(item, index) in guardianStudents" :key="index">
                                                        <td>{{ index + 1 }}</td>
                                                        <td>{{ formatStudentName(allStudents.find(s => s.id === item.studentId)) }}</td>
                                                        <td>{{ getRelationshipName(item.relationshipId) }}</td>
                                                    </tr>
                                                    </tbody>
                                                </table>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>

<script src="~/js/school-manager/data-entry/legalGuardians.js" asp-append-version="true"></script>