@{
    ViewBag.Title = "PTA Executives";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}
<style>
    .table-responsive {
        color: #0a0a0a;
    }
</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> PTA Executives </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#"> Data Entry </a>
                            </li>
                            <li class="breadcrumb-item active">
                                PTA Executives
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">PTA Executives</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <button class="btn btn-sm btn-outline-light my-1" @@click="printPreview">
                                    <i class="la la-print"></i> Print
                                </button>
                                <div class="row">

                                    <div class="col-md-3">
                                        <label><strong> Academic Year:</strong></label>
                                        <input id="academicYearId"/>
                                    </div>

                                    <div class="col-md-3">
                                        <label><strong>Position:</strong></label>
                                        <input id="ptaPositionId"/>
                                    </div>

                                    <div class="col-md-3">
                                        <label><strong>Name:</strong> </label>
                                        <input type="text" class="form-control" v-model="form.name">
                                    </div>

                                    <div class="col-md-3">
                                        <label><strong>Phone No:</strong></label>
                                        <input type="text" class="form-control" v-model="form.phoneNumber">
                                    </div>

                                    <div class="col-md-3">
                                        <label><strong>Email:</strong></label>
                                        <input type="email" class="form-control" v-model="form.email">
                                    </div>

                                    <div class="col-md-3">
                                        <label><strong>Address:</strong></label>
                                        <input type="text" class="form-control" v-model="form.address">
                                    </div>

                                    <div class="col-md-3">
                                        <label><strong>Term Start Date:</strong></label>
                                        <input type="date" class="form-control" v-model="form.startDate">
                                    </div>

                                    <div class="col-md-3">
                                        <label><strong>Term End Date:</strong></label>
                                        <input type="date" class="form-control" v-model="form.endDate">
                                    </div>



                                </div>
                                <div class="my-3 float-right">
                                    <button class="btn btn-primary " @@click="save">
                                        <i class="la la-save"></i>
                                        {{ form.id === null ? 'Save' : 'Update' }}

                                    </button>
                                    <button class="btn btn-secondary ml-2" @@click="resetForm">
                                       <i class="la la-times"></i> Cancel
                                    </button>
                                </div>

                                <hr>
                                <div class="table-responsive mt-4">
                                    <table class="table-responsive table  table-striped">
                                        <thead>
                                        <tr>
                                            <th style="width: 5%">#</th>
                                            <th style="width: 18%">Academic Year</th>
                                            <th style="width: 20%">Position</th>
                                            <th style="width: 25%">Name</th>
                                            <th style="width: 20%">Phone</th>
                                            <th style="width: 12%">Action</th>
                                        </tr>
                                        </thead>

                                        <tbody>

                                        <tr v-if="filteredExecutives.length === 0">
                                            <td colspan="10" class="text-center">
                                                No PTA Executives Found
                                            </td>
                                        </tr>

                                        <tr v-for="(item,index) in filteredExecutives" :key="item.id">

                                            <td>{{ index + 1 }}</td>
                                            <td>{{ item.academicYearName }}</td>
                                            <td>{{ item.ptaPositionName }}</td>
                                            <td>{{ item.name }}</td>
                                            <td>{{ item.phoneNumber }}</td>

                                            <td>
                                                <a class="text-primary"
                                                        @@click="editExecutive(item)">
                                                    <i class="la la-edit"></i>
                                                </a>

                                                <a class="text-danger ml-1"
                                                        @@click="deleteExecutive(item.id)">
                                                    <i class="la la-trash"></i>
                                                </a>
                                            </td>

                                        </tr>

                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>

<script src="~/js/school-manager/data-entry/ptaExecutives.js" asp-append-version="true"></script>