    <style>
        .card, .table {
            border-radius: 15px;
            border: 0.5px solid #e3e3e3;
        }
        .table-responsive {
            color: #0a0a0a;
        }
        .app-content{
            color: #0a0a0a;
        }
        /* EJ1 Grid Bootstrap theme – striped rows */
        .e-bootstrap .e-gridcontent tr.e-alt-row > td {
            background-color: #f8f9fa !important;
        }

        /* Normal rows */
        .e-bootstrap .e-gridcontent tr.e-row > td {
            background-color: #eef3fb !important;
        }

        /* Hover effect */
        .e-bootstrap .e-gridcontent tr.e-row:hover > td,
        .e-bootstrap .e-gridcontent tr.e-alt-row:hover > td {
            background-color: #e9ecef !important;
        }
        /*table header*/
       /* .e-bootstrap .e-gridheader th {
            background-color: #748fdd !important;
            color: white !important;
        }*/
        .bg-primary {
            background-color: #2f65a5 !important;
        }
        .e-bootstrap .e-gridtoolbar {
            background-color: #2f65a5 !important;
            color : white !important;
        }
        
        #searchResults .dropdown-item:hover {
            background-color: #f8f9fa;
            cursor: pointer;
        }

        #searchResults small {
            font-size: 11px;
            letter-spacing: 0.3px;
        }
        .footer {
            position: relative;
            z-index: 10;
        }
    </style>
</head>
<body class="vertical-layout vertical-menu 2-columns bg-white   menu-expanded fixed-navbar" data-open="click" data-menu="vertical-menu" data-col="2-columns">
<!-- fixed-top-->
<nav class="header-navbar navbar-expand-md navbar navbar-with-menu navbar-without-dd-arrow fixed-top navbar-semi-light bg-primary navbar-shadow">
    <div class="navbar-wrapper">
        <div class="navbar-header">
            <ul class="nav navbar-nav flex-row">
                <li class="nav-item mobile-menu d-md-none mr-auto"><a class="nav-link nav-menu-main menu-toggle hidden-xs" href="#"><i class="ft-menu font-large-1"></i></a></li>
                
                <li class="nav-item">
                    <div class="navbar-brand" >
                        <img class="brand-logo" alt="" src="/app-assets/images/topazLogo.png">
                        <h3 class="brand-text"> Topaz </h3>
                    </div>
                </li>
              
                <li class="nav-item d-md-none">
                    <a class="nav-link open-navbar-container" data-toggle="collapse" data-target="#navbar-mobile"><i class="la la-ellipsis-v"></i></a>
                </li>
            </ul>
        </div>
        <div class="navbar-container content">
            <div class="collapse navbar-collapse" id="navbar-mobile">
               
                <ul class="nav navbar-nav mr-auto float-left">
                    <li class="nav-item d-none d-md-block"><a class="nav-link nav-menu-main menu-toggle hidden-xs" href="#"><i class="ft-menu"></i></a></li>
                </ul>
                @*Academic Year*@
                    <div id="academicYearHeader" class="nav navbar-nav mr-auto float-left">
                        <h5 class="nav-item text-white font-weight-bold">{{ academicYearTitle }}</h5>
                    </div>
                    
                @*Search Bar*@
                <div class="nav navbar-nav ml-auto position-relative d-none d-lg-flex">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text text-white border-right-0" style="border-radius: 50px 0 0 50px; background: transparent;">
                                <i class="la la-search"></i> 
                            </span>
                        </div>
                        <input 
                            type="text" 
                            id="pageSearchInput" 
                            class="form-control border-left-0 text-white" 
                            placeholder="Search pages..." 
                            style="border-radius: 0 50px 50px 0; background: transparent;" 
                            autocomplete="off">
                    </div>

                    <!-- Dropdown -->
                    <div id="searchResults" 
                         class="dropdown-menu shadow" 
                         style="display:none; width: 300px; max-height: 300px; overflow-y: auto; border-radius: 0 0 10px 10px;"></div>
                </div>
                
                @await Component.InvokeAsync(typeof(TopazUserAreaViewComponent))


            </div>
        </div>
    </div>
</nav>

