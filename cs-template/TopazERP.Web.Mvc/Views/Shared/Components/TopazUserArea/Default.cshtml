@model TopazERP.Web.Views.Shared.Components.TopazUserArea.TopazUserAreaViewModel

@if (Model.LoginInformations.User != null)
{

    <ul class="nav navbar-nav float-right">
        <li class="dropdown dropdown-user nav-item">
            <a class="dropdown-toggle nav-link dropdown-user-link" href="#" data-toggle="dropdown">
                <span class="mr-1">
                    Hello,
                    <span class="user-name text-bold-700"> @Html.Raw(Model.GetShownLoginName()) </span>
                </span>
                <span class="avatar avatar-online">
                    <img src="https://res.cloudinary.com/rhyoliteprime/image/upload/v1533814738/images_6.png" alt="avatar"><i></i>
                </span>
            </a>
            <div class="dropdown-menu dropdown-menu-right">
                <a class="dropdown-item" href="@Url.Action("Profile", "Manage")"><i class="ft-user"></i> Edit Profile</a>
                <a class="dropdown-item" href="@Url.Action("Users", "Manage")"><i class="ft-users"></i> Manage Users</a>
                <a class="dropdown-item" href="@Url.Action("UpdatePassword", "Manage")"><i class="ft-shield"></i> Update Password </a>
                <a class="dropdown-item" href="@Url.Action("Modules", "Manage")"><i class="ft-check-square"></i> Module Manager </a>
                <div class="dropdown-divider"></div><a class="dropdown-item" href="@Url.Action("Logout", "Account")"><i class="ft-power"></i> Logout</a>
            </div>
        </li>
                       
    </ul>
}
 