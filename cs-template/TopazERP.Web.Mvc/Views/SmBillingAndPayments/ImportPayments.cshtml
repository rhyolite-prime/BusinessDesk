@{
    ViewBag.Title = "Import Payments";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}
<style>
     /* ✅ full-screen overlay inside app */
     .preview-loader-overlay {
         position: absolute;
         inset: 0;
         background: rgba(255, 255, 255, 0.75);
         z-index: 9999;
         display: flex;
         align-items: center;
         justify-content: center;
         backdrop-filter: blur(1px);
     }

     /* make sure #app can host an absolute overlay */
     #app {
         position: relative;
     }

     .preview-loader-card {
         background: #fff;
         border-radius: 12px;
         padding: 18px 22px;
         box-shadow: 0 8px 24px rgba(0,0,0,0.15);
         display: flex;
         align-items: center;
         gap: 12px;
     }

     .preview-loader-text {
         font-weight: 600;
         color: #0b1f5b; /* deep blue */
         font-size: 14px;
     }

     /* ✅ deep blue animated spinner */
     .deepblue-spinner {
         width: 34px;
         height: 34px;
         border-radius: 50%;
         border: 4px solid rgba(11, 31, 91, 0.18);
         border-top-color: #0b1f5b; /* deep blue */
         animation: deepblue-spin 0.85s linear infinite;
     }

     @@keyframes deepblue-spin {
         to { transform: rotate(360deg); }
     }
     .responsive-table {
         overflow-x: auto;
         width: 100%;
         border-top: 1px solid rgb(9 9 9 / 0.37);

     }
 </style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Import Payments</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Billings & Payments</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Import Payments
                            </li>
                        </ol>
                    </div>
                </div>
               
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Import Payments</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                           
                            <div class="card-body" id="app">
                                <div v-if="isPreviewLoading" class="preview-loader-overlay">
                                    <div class="preview-loader-card">
                                        <div class="deepblue-spinner"></div>
                                        <div class="preview-loader-text">Processing preview...</div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-3 mb-1">
                                        <label>Academic Year:</label>
                                        <searchable-dropdown
                                            :options="academicYears"
                                            v-model="academicYearId"
                                            text-field="name"
                                            value-field="id"
                                            placeholder="Select Year...">
                                        </searchable-dropdown>
                                    </div>
                                    <div class="col-md-3 mb-1">
                                        <label>Term:</label>
                                        <searchable-dropdown :options="terms" v-model="termId" text-field="name" value-field="id" placeholder="Select Term..."> </searchable-dropdown>
                                    </div>
                                    <div class="col-md-3 mb-1">
                                        <label>Payment Method <span class="text-danger">*</span></label>
                                        <searchable-dropdown :options="paymentMethods" v-model="paymentMethod" text-field="name" value-field="id" placeholder="Select..."> </searchable-dropdown>
                                    </div>
                                    <div class="col-md-3 mb-1">
                                        <label >Bank GL</label>
                                        <searchable-dropdown :options="accountsList" v-model="debitGlId" text-field="accountIdentifier" value-field="id" placeholder="Select..."> </searchable-dropdown>
                                    </div>
                                    <div class="col-md-3 mb-1">
                                        <label>Account Receivable GL</label>
                                        <searchable-dropdown :options="accountsList" v-model="creditGlId" text-field="accountIdentifier" value-field="id" placeholder="Select..."> </searchable-dropdown>
                                    </div>
                                    <div class="col-sm-4">

                                        <div class="form-group">
                                            <label class="text-amber"> <strong> Choose File: </strong>
                                                <a class="text-primary font-weight-bold"
                                                   @@click="downloadTemplate">
                                                    Download Template
                                                </a>
                                            </label>
                                            <input type="file" name="customFile" v-on:change="onFileUpload($event)" class="form-control" required :disabled="lockInputs">
                                        </div>

                                    </div>
                                    <div class="col-sm-2">
                                        <button class="btn btn-primary mt-2"
                                                :disabled="hasErrors || previewRows.length === 0 || lockInputs"
                                                @@click="importData">
                                            <i class="la la-file-import"></i> Import
                                        </button>
                                    </div>
                                </div>

                                <hr/>
                                <div class="responsive-table" v-if="importFinished">

                                    <div class="float-left my-2">
                                        <button type="button" class="btn btn-sm btn-primary" @@click="processPayments">
                                            <i class="la la-save"></i>Process
                                        </button>
                                    </div>

                                    <div class="table-responsive">
                                        <div id="dataTable"></div>
                                    </div>
                                </div>
                                <div v-if="previewRows.length > 0" class="e-bootstrap">
                                    <table class="table  table-responsive table-striped">
                                        <thead>
                                        <tr>
                                            <th>#</th>
                                            <th style="width: 5%">Reg No</th>
                                            <th style="width: 30%">Student Name</th>
                                            <th style="width: 15%">Reference #</th>
                                            <th style="width: 15%">Payment Amount</th>
                                            <th style="width: 15%">Transaction Date</th>
                                            <th style="width: 20%">Currency Name</th>
                                            <th style="width: 35%">Payment Description</th>
                                            <th style="width: 20%">Bank Name</th>
                                            <th style="width: 20%">Branch Name</th>
                                            <th style="width: 15%">Cheque Number</th>
                                            <th style="width: 15%">Cheque Date</th>
                                            <th>Status</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <template v-for="(row, index) in paginatedPreviewRows" :key="row.studentId">
                                            <!-- Data row -->
                                            <tr :class="{
                                                    'text-danger': row.error,  
                                                        }">
                                                <td>
                                                    {{ ((previewPage - 1) * previewPerPage) + index + 1 }}
                                                </td>
                                                <td>{{ row.studentIdentifier }}</td>
                                                <td>{{ row.studentName }}</td>
                                                <td>{{ row.referenceNumber }}</td>
                                                <td>{{ formatMoney(row.paymentAmount) }}</td>
                                                <td>{{ formatDate(row.paymentDate) }}</td>
                                                <td>{{ row.currencyName }}</td>
                                                <td>{{ row.description }}</td>
                                                <td>{{ row.bankName }}</td>
                                                <td>{{ row.branchName }}</td>
                                                <td>{{ row.chequeNumber }}</td>
                                                <td>{{ formatDate(row.chequeDate) }}</td>
                                                <td>
                                                    <span v-if="!row.error && !row.warning" class="text-success">OK</span>
                                                </td>
                                            </tr>

                                            <!-- Error/Warning row -->
                                            <tr v-if="row.error || row.warning">
                                                <td colspan="14" :class="{
                                                'text-danger': row.error,
                                                'text-primary': !row.error && row.warning
                                                }">
                                                    {{ row.error || row.warning }}
                                                </td>
                                            </tr>
                                        </template>
                                        </tbody>
                                    </table>
                                    <div class="d-flex justify-content-end align-items-center gap-2 mt-3">

                                        <button
                                            class="btn btn-primary btn-sm"
                                            :disabled="previewPage === 1"
                                            @@click="previewPage--">
                                            Prev
                                        </button>

                                        <span>
                                            Page {{ previewPage }} of {{ totalPreviewPages }}
                                        </span>

                                        <button
                                            class="btn btn-primary btn-sm"
                                            :disabled="previewPage === totalPreviewPages"
                                            @@click="previewPage++">
                                            Next
                                        </button>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/school-manager/bills-payment/import-payment.js" asp-append-version="true"></script>