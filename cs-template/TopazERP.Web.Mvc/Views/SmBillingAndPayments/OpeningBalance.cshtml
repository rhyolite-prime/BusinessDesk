@{
    ViewBag.Title = "Opening Balance";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

<style>
    .responsive-table {
        overflow-x: auto;
        width: 100%;
        border-top: 1px solid rgb(9 9 9 / 0.37);

    }
 .table th {
     color: #353535;
 }
 .crud-header{
     background-color: #2f65a5;
 }
 a:hover {
     cursor: pointer;
     color: #2f65a5;
 }

 
     .table thead th {
         vertical-align: middle;
         white-space: nowrap;
     }
 .crud-buttons a:hover{
     color: #ffffff;
     background-color: #28568c;
     border-radius: 4px;
     padding: 4px;
 }
 .table{
     font-size: 13px;
 }

</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Opening Balance</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Billings & Payments</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Opening Balance
                            </li>
                        </ol>
                    </div>
                </div>
               
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Opening Balance</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div>
                                <!-- Tab content -->
                                    <div id="all" >
                                        <div class="float-right mb-1">
                                            <a @@click="createBalance" class="btn btn-sm btn-outline-primary text-primary mr-1">
                                                <i class="la la-plus"></i>Add Opening Balance
                                            </a>
                                            <a href="@Url.Action("PostOpeningBalance", "SmBillingAndPayments")" class="btn btn-sm btn-outline-secondary mr-1">
                                                <i class="la la-sign-in-alt"></i>Post Opening Balance
                                            </a>
                                        </div>
                                        <div class="table-responsive">
                                            <div class="mt-1 crud-header rounded rounded-lg d-flex justify-content-between align-items-center p-2 flex-wrap gap-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <button
                                                        v-if="selectedBalances.length"
                                                        type="button"
                                                        class="btn btn-danger btn-sm"
                                                        @@click="deleteSelectedBalances"
                                                        :disabled="isLoading"
                                                    >
                                                        <i class="la la-trash me-1"></i>
                                                    </button>
                                                    <span
                                                        v-if="selectedBalances.length"
                                                        class="text-white small mx-1"
                                                    >
                                                        {{ selectedBalances.length }} selected
                                                    </span>
                                                    <div>
                                                        <input
                                                            style="width: 220px;"
                                                            class="form-control form-control-sm"
                                                            placeholder="Search Balance..."
                                                            v-model="searchText"
                                                        >
                                                    </div>
                                                </div>
                                               

                                               

                                            </div>
                                            <table class="table table-responsive table-striped table-hover">
                                                <thead>
                                                <tr>
                                                    <th style="width: 3%;" class="text-center">
                                                        <input
                                                            type="checkbox"
                                                            :checked="isAllSelected"
                                                            @@change="toggleSelectAll"
                                                        >
                                                    </th>
                                                    <th style="width:12%;">Student ID</th>
                                                    <th style="width:25%;">Student</th>
                                                    <th style="width:20%;">Class</th>
                                                    <th style="width:15%;">Date</th>
                                                    <th style="width:15%;">Amount</th>
                                                    <th style="width:20%;">Currency</th>
                                                    <th style="width:10%;">Rate</th>
                                                    <th style="width:10%;">FX Amt</th>
                                                    <th style="width:5%;">Action</th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                <tr v-for="b in paginatedData" :key="b.id">
                                                    <td class="text-center">
                                                        <input
                                                            type="checkbox"
                                                            :value="b.id"
                                                            v-model="selectedBalances"
                                                        >
                                                    </td>
                                                    <td>{{ b.studentIdentifier}}</td>
                                                    <td>{{ b.studentName }}</td>
                                                    <td>{{ b.className }}</td>
                                                    <td>{{ formatDate(b.date) }}</td>
                                                    <td class="text-end">{{ formatMoney(b.amount) }}</td>
                                                    <td>{{ b.currencyName }}</td>
                                                    <td class="text-end">{{ Number(b.rate).toFixed(4) }}</td>
                                                    <td class="text-end">{{ formatMoney(b.convertedAmount) }}</td>
                                                    <td>
                                                        <a v-if="!b.isPosted"
                                                           class="text-primary"
                                                           @@click="editBalance(b)">
                                                            <i class="la la-edit"></i>
                                                        </a>
                                                        <a
                                                            class="text-danger"
                                                            @@click="deleteBalance(b.id)">
                                                            <i class="la la-trash"></i>
                                                        </a>
                                                    </td>
                                                </tr>

                                                <tr v-if="!balanceData.length">
                                                    <td colspan="10" class="text-center">
                                                        No records found
                                                    </td>
                                                </tr>
                                                </tbody>
                                            </table>
                                            <div class="d-flex justify-content-end i">
                                                <button @@click="prevPage"
                                                        :disabled="page === 1"
                                                        class="btn btn-secondary btn-sm mr-2">
                                                    Prev
                                                </button>

                                                <span>Page {{ page }} of {{ totalPages }}</span>

                                                <button @@click="nextPage"
                                                        :disabled="page === totalPages"
                                                        class="btn btn-secondary btn-sm ml-2">
                                                    Next
                                                </button>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="my-1 responsive-table" id="form" >
                                        <p class="primary "><strong>Create/Update</strong></p>
                                        <div class="my-2">
                                            <div class="row g-2 mb-2">
                                                 <div class="col-md-3 mb-1">
                                                    <label>Academic Year <span class="text-danger">*</span></label>
                                                    <searchable-dropdown
                                                        :options="academicYears"
                                                        v-model="academicYearId"
                                                        text-field="name"
                                                        value-field="id"
                                                        placeholder="Select Year...">
                                                    </searchable-dropdown>
                                                </div>
                                                <div class="col-md-3 mb-1">
                                                    <label>Class <span class="text-danger">*</span></label>
                                                    <searchable-dropdown :options="classList" v-model="classId" text-field="name" value-field="id" placeholder="Select Class..."> </searchable-dropdown>
                                                </div>
                                                <div class="col-md-3 mb-1" >
                                                    <label>Student <span class="text-danger">*</span></label>
                                                    <searchable-dropdown :options="studentList" v-model="studentId" text-field="displayText" value-field="id" placeholder="Select..."> </searchable-dropdown>
                                                </div>
                                                <div class="col-md-3 mb-1">
                                                    <label>Date <span class="text-danger">*</span></label>
                                                    <input type="date" class="form-control"
                                                           v-model="date"/>
                                                </div>
                                                <div class="col-md-3 mb-1" >
                                                    <label>Currency <span class="text-danger">*</span></label>
                                                    <searchable-dropdown :options="currencies" v-model="currencyId" text-field="currencyName" value-field="id" placeholder="Select..."> </searchable-dropdown>
                                                </div>
                                                <div class="col-md-3 mb-1">
                                                    <label>Rate</label>
                                                    <input type="number" class="form-control "
                                                           v-model="rate" min="0" step="0.0001"/>
                                                </div>
                                                <div class="col-md-3 mb-1">
                                                    <label>Amount <span class="text-danger">*</span></label>
                                                    <input type="number" class="form-control " min="0" step="0.01"
                                                           v-model="amount" placeholder="0.00"/>
                                                </div>
                                            </div>

                                            <div class="float-right mb-2">
                                                <button type="button" class="btn btn-sm btn-warning mr-1" @@click="resetForm">
                                                    <i class="la la-refresh"></i>Reset
                                                </button>
                                                <button type="button" class="btn btn-sm btn-primary" @@click="saveBalance">
                                                    <i class="la la-plus"></i> Save
                                                </button>

                                            </div>
                                        </div>


                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@*<script src="~/js/components/shimmer-loader.js" asp-append-version="true"></script>*@
<script src="~/js/school-manager/bills-payment/opening-balances.js" asp-append-version="true"></script>