@{
    ViewBag.Title = "Multiple Fees & Bills SetUps";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

<style>
    .table td:first-child,
    .table th:first-child {
        position: sticky;
        left: 0;
        background: #fff;
        z-index: 2;
        color: #0a0af0;
    }
    .table th {
        color: #ffffff;
    }
   
    .select{
        border: none;
        width: 100%;
        background: transparent;
    }
    .input{
        border: none;
        width: 100%;
        background: transparent;
    }
    .select:focus{
        outline: none;
        box-shadow: none;
    }
</style>

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Multiple Fees & Bills SetUps</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Billings & Payments</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Multiple Fees & Bills SetUps
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Copy Fees & Bills Setup to Classes</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div>
                                      <!-- Nav tabs -->
                                <ul class="nav nav-tabs" id="feesTabs" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <a class="nav-link text-primary active" id="standard-tab"
                                           data-bs-toggle="tab" data-bs-target="#standard"
                                           role="tab" @@click="activeTab = 'standard'">Standard Fees</a>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <a class="nav-link text-primary" id="supplementary-tab"
                                           data-bs-toggle="tab" data-bs-target="#supplementary"
                                           role="tab" @@click="activeTab = 'supplementary'">Supplementary Fees</a>
                                    </li>

                                </ul>
                                <!-- Tab content -->
                                <div class="tab-content mt-1" id="feesTabsContent">
                                    <div class="row">
                                        <div class="col-md-3 e-bootstrap ">
                                            <label>Academic Year <span class="text-danger">*</span></label>
                                            <searchable-dropdown
                                                :options="academicYears"
                                                v-model="academicYearId"
                                                text-field="name"
                                                value-field="id"
                                                placeholder="Select Year...">
                                            </searchable-dropdown>
                                        </div>
                                        <div class="col-md-3 ">
                                            <label>Term <span class="text-danger">*</span></label>
                                            <searchable-dropdown :options="terms" v-model="termId" text-field="name" value-field="id" placeholder="Select Term..."> </searchable-dropdown>
                                        </div>
                                        <div class="col-md-3 e-bootstrap"
                                             v-if="activeTab !== 'boarding'">
                                            <label>Level:</label>
                                            <searchable-dropdown :options="levels" v-model="levelId" text-field="levelName" value-field="id" placeholder="Select..."> </searchable-dropdown>
                                        </div>
                                        <div class="col-md-3 e-bootstrap mb-1">
                                            <label>Classes With SetUp:</label>
                                            <searchable-dropdown :options="classesWithSetups" v-model="classId" text-field="name" value-field="id" placeholder="Select Class..."> </searchable-dropdown>
                                        </div>
                                    </div>
                                    <div class="tab-pane fade show active" id="standard" role="tabpanel">
                                        @*standard fees here*@
                                    </div>
                                    <div class="tab-pane fade" id="supplementary" role="tabpanel">
                                        @*supplementary fees here*@
                                    </div>
                                </div>
                                <div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <table class="table table-bordered table-responsive">

                                                <thead>
                                                <tr>
                                                    <th style="width:40px;">
                                                        <input type="checkbox"
                                                               v-model="selectAllClasses"
                                                               @@change="toggleAllClasses">
                                                    </th>

                                                    <th style="width: 1200px; color: #393939">Classes With No SetUp</th>
                                                </tr>
                                                </thead>

                                                <tbody>
                                                <tr v-for="c in filteredClassTable" :key="c.id">
                                                    <td>
                                                        <input type="checkbox"
                                                               :value="c.id"
                                                               v-model="selectedClassIds">
                                                    </td>
                                                    <td>{{ c.name }}</td>
                                                </tr>
                                                </tbody>

                                            </table>
                                        </div>
                                        <div class="col-md-6">
                                            <table class="table table-bordered table-responsive table-striped">

                                                <thead>
                                                <tr>
                                                    <th style="width: 920px;">Item</th>
                                                    <th style="width: 920px">Amount</th>
                                                </tr>
                                                </thead>

                                                <tbody>
                                                <tr v-for="(d, index) in activeDetails" :key="d.id">

                                                    <!-- ITEM -->
                                                    <td>
                                                        <select class="select" v-model="d.feeItemId">
                                                            <option value="">-- Select Item --</option>

                                                            <option v-for="item in feeItems"
                                                                    :key="item.id"
                                                                    :value="item.id"
                                                                    :disabled="foundExisting">
                                                                {{ item.name }}
                                                            </option>
                                                        </select>
                                                    </td>

                                                    <!-- AMOUNT -->
                                                    <td>
                                                        <input type="number"
                                                               class="input"
                                                               v-model="d.amount"
                                                               :disabled="foundExisting"/>
                                                    </td>


                                                </tr>
                                                </tbody>

                                                <!-- TOTAL -->
                                                <tfoot class="bg-light">
                                                <tr>
                                                    <th class="text-right">Total</th>

                                                    <th class="text-secondary">
                                                        {{ totalAmount.toLocaleString(undefined, {
                                                        minimumFractionDigits: 2,
                                                        maximumFractionDigits: 2
                                                        }) }}
                                                    </th>
                                                </tr>
                                                </tfoot>

                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <div class="float-right my-1">
                                    <div class=" text-end">
                                        <button class="btn btn-primary" @@click="saveFeeSetup">
                                            <i class="la la-save"></i> Save <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                                        </button>
                                    </div>
                                </div>
                                </div>
                              
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/school-manager/bills-payment/fee-setups-all.js" asp-append-version="true"></script>