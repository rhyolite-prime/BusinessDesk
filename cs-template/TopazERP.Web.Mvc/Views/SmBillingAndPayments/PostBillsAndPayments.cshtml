@{
    ViewBag.Title = "Post To GL";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Post To GL</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Billings & Payments</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Post To GL
                            </li>
                        </ol>
                    </div>
                </div>
               
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Post To GL</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div>
                                     <ul class="nav nav-tabs" id="feesTabs" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <a class="nav-link text-primary active" id="bills-tab"
                                           data-bs-toggle="tab" data-bs-target="#bills"
                                           role="tab" @@click="activeTab = 'bills'">Bills</a>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <a class="nav-link text-primary" id="payments-tab"
                                           data-bs-toggle="tab" data-bs-target="#payments"
                                           role="tab" @@click="activeTab = 'payments'">Payments</a>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <a class="nav-link text-primary" id="memo-tab"
                                           data-bs-toggle="tab" data-bs-target="#memos"
                                           role="tab" @@click="activeTab = 'memos'">Credit Memo</a>
                                    </li>
                                </ul>
                                <div class="tab-content mt-1" id="feesTabsContent">
                                    <div class="row mb-1">
                                        <div class="mb-1 m-2">
                                            <button type="button" class="btn btn-secondary " @@click="resetTables">
                                                <i class="la la-refresh"></i> Reset Table
                                            </button>
                                        </div>

                                    </div>
                                    <div class="tab-pane fade show active" id="bills" role="tabpanel">
                                        @*bills*@
                                        <div class="row mb-1">
                                            <div class="col-md-3 ">
                                                <label>Bill Type </label>
                                                <searchable-dropdown :options="billTypes" v-model="billTypeId" text-field="name" value-field="id" placeholder="Select..."> </searchable-dropdown>
                                            </div>
                                            <div class="mt-2">

                                                <button type="button" class="btn btn-primary" @@click="postBills">
                                                    <i class="la la-sign-in-alt"></i> Post
                                                </button>
                                            </div>
                                        </div>

                                        <div id="billDataTable"></div>
                                    </div>
                                    <div class="tab-pane fade" id="payments" role="tabpanel">
                                        @*payments*@
                                        <div class=" mb-1">
                                          
                                            <div >
                                                <button type="button" class="btn btn-primary" @@click="postPayments">
                                                    <i class="la la-sign-in-alt"></i> Post
                                                </button>
                                            </div>
                                        </div>
                                        <div id="paymentDataTable"></div>
                                    </div>
                                    <div class="tab-pane fade" id="memos" role="tabpanel">
                                        @*memos*@
                                        <div class=" mb-1">
                                          
                                            <div >
                                                <button type="button" class="btn btn-primary" @@click="postMemos">
                                                    <i class="la la-sign-in-alt"></i> Post
                                                </button>
                                            </div>
                                        </div>
                                        <div id="memoDataTable"></div>
                                    </div>
                                </div>
                                </div>
                               
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/school-manager/bills-payment/post-to-gl.js" asp-append-version="true"></script>