@{
    ViewBag.Title = "CreditMemo";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}
<style>
 .table th {
     color: #353535;
 }
 .crud-header{
     background-color: #2f65a5;
 }
 a:hover {
     cursor: pointer;
     color: #2f65a5;
 }

 
     .table thead th {
         vertical-align: middle;
         white-space: nowrap;
     }
 .crud-buttons a:hover{
     color: #ffffff;
     background-color: #28568c;
     border-radius: 4px;
     padding: 4px;
 }


</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Credit Memo</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Billings & Payments</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Credit Memo
                            </li>
                        </ol>
                    </div>
                </div>
               
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Credit Memo</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div v-if="isShimmerLoading" class="shimmer-wrapper">
                                    <div class="shimmer-row">
                                        <div class="shimmer-block tall"></div>
                                    </div>
                                    <div class="shimmer-row">
                                        <div class="shimmer-block short"></div>
                                        <div class="shimmer-block short"></div>
                                        <div class="shimmer-block short"></div>
                                    </div>
                                </div>
                                <div>
                               <!-- Tab content -->
                               <div id="all" >
                                   <div class="float-right mb-1">
                                       <a @@click="createPayment" class="btn btn-sm btn-outline-primary text-primary mr-1">
                                           <i class="la la-plus"></i>Create Credit Memo
                                       </a>
                                       <a href="@Url.Action("CancelCreditMemo", "SmBillingAndPayments")" class="btn btn-sm btn-outline-danger">
                                           <i class="la la-trash"></i>Cancel Credit Memos
                                       </a>
                                   </div>
                                   <div class="table-responsive">
                                       <div class="mt-1 crud-header rounded rounded-lg d-flex justify-content-start align-items-center p-1 flex-wrap">
                                           <div>
                                               <input style="width: 220px;" class="form-control form-control-sm" placeholder="Search memo..." v-model="searchText">
                                           </div>
                                       </div>
                                       <table class="table table-responsive table-striped table-hover">
                                           <thead>
                                           <tr>
                                               <th style="width:25%;">Student</th>
                                               <th style="width:15%;">Date</th>
                                               <th style="width:15%;">Batch #</th>
                                               <th style="width:15%;">Amount</th>
                                               <th style="width:15%;">Currency</th>
                                               <th style="width:10%;">Rate</th>
                                               <th style="width:10%;">FX Amt</th>
                                               <th style="width:5%;">Action</th>
                                           </tr>
                                           </thead>
                                           <tbody>
                                           <tr v-for="payment in paginatedData" :key="payment.id">
                                               <td>{{ payment.studentName }}</td>
                                               <td>{{ formatDate(payment.paymentDate) }}</td>
                                               <td>{{ payment.batchNumber }}</td>
                                               <td class="text-end">{{ formatMoney(payment.amountToCredit) }}</td>
                                               <td>{{ payment.currencyName }}</td>
                                               <td class="text-end">{{ Number(payment.buyRate).toFixed(4) }}</td>
                                               <td class="text-end">{{ formatMoney(payment.convertedAmount) }}</td>
                                               <td>
                                                   <a
                                                       class="text-primary"
                                                       @@click="editMemo(payment)">
                                                       <i class="la la-edit"></i>
                                                   </a>
                                               </td>
                                           </tr>

                                           <tr v-if="!paymentData.length">
                                               <td colspan="10" class="text-center">
                                                   No records found
                                               </td>
                                           </tr>
                                           </tbody>
                                       </table>
                                       <div class="d-flex justify-content-end i">
                                           <button @@click="prevPage"
                                                   :disabled="page === 1"
                                                   class="btn btn-secondary btn-sm mr-2">
                                               Prev
                                           </button>

                                           <span>Page {{ page }} of {{ totalPages }}</span>

                                           <button @@click="nextPage"
                                                   :disabled="page === totalPages"
                                                   class="btn btn-secondary btn-sm ml-2">
                                               Next
                                           </button>
                                       </div>
                                   </div>
                               </div>
                               <div class="my-1 responsive-table" id="form" >
                                        <p class="primary "><strong>Create/Update</strong></p>
                                        <div class="my-2">
                                            <div class="d-flex flex-wrap">
                                                <div class="form-check form-switch mr-2" v-if="!isEdit">
                                                    <input class="form-check-input" type="checkbox" id="byClassToggle"
                                                           v-model="byClass"/>
                                                    <label class="form-check-label " for="byClassToggle">
                                                        To Class
                                                    </label>
                                                </div>
                                                <div class="form-check form-switch mr-2">
                                                    <input class="form-check-input" type="checkbox" id="multiCurrencyToggle"
                                                           v-model="isMultiCurrency" disabled/>
                                                    <label class="form-check-label " for="multiCurrencyToggle">
                                                        Multi-currency payment
                                                    </label>
                                                </div>
                                                <div v-if="!byClass" class="d-flex align-items-center flex-wrap">
                                                    <p class="primary">Batch # - {{batchNumber}}</p>
                                                </div>
                                                   
                                            </div>

                                            <div class="row g-2 mb-2">
                                                <div class="col-md-3 mb-1">
                                                    <label>Academic Year <span class="text-danger">*</span></label>
                                                    <searchable-dropdown
                                                        :options="academicYears"
                                                        v-model="academicYearId"
                                                        text-field="name"
                                                        value-field="id"
                                                        placeholder="Select Year...">
                                                    </searchable-dropdown>
                                                </div>
                                                <div class="col-md-3 mb-1">
                                                    <label>Term <span class="text-danger">*</span></label>
                                                    <searchable-dropdown :options="terms" v-model="termId" text-field="name" value-field="id" placeholder="Select Term..."> </searchable-dropdown>
                                                </div>
                                                <div class="col-md-3 mb-1">
                                                    <label>Class <span class="text-danger">*</span></label>
                                                    <searchable-dropdown :options="classList" v-model="classId" text-field="name" value-field="id" placeholder="Select Class..."> </searchable-dropdown>
                                                </div>
                                                <div class="col-md-3 mb-1" v-if="!byClass">
                                                    <label>Student <span class="text-danger">*</span></label>
                                                    <searchable-dropdown :options="studentList" v-model="studentId" text-field="displayText" value-field="id" placeholder="Select..."> </searchable-dropdown>
                                                </div>
                                                <div class="col-md-3 mb-1">
                                                    <label>Payment Date <span class="text-danger">*</span></label>
                                                    <input type="date" class="form-control "
                                                           v-model="paymentDate"/>
                                                </div>
                                                <div class="col-md-3 mb-1">
                                                    <label>Amount Due</label>
                                                    <div class="input-group">
                                                        <p class="form-control ">{{ amountDue.toLocaleString(undefined, {
                                                            minimumFractionDigits: 2,
                                                            maximumFractionDigits: 2
                                                            }) }}</p>
                                                    </div>
                                                </div>
                                                <div class="col-md-3 mb-1">
                                                    <label>Payment Method <span class="text-danger">*</span></label>
                                                    <searchable-dropdown :options="paymentMethods" v-model="paymentMethod" text-field="name" value-field="id" placeholder="Select..."> </searchable-dropdown>
                                                </div>
                                                <div class="col-md-3 mb-1" >
                                                    <label>Currency <span class="text-danger">*</span></label>
                                                    <searchable-dropdown :options="currencies" v-model="currencyId" text-field="currencyName" value-field="id" placeholder="Select..."> </searchable-dropdown>
                                                </div>
                                                <div class="col-md-3 mb-1">
                                                    <label>Rate</label>
                                                    <input type="number" class="form-control "
                                                           v-model="rate" min="0" step="0.0001"/>
                                                </div>
                                                <div class="col-md-3 mb-1">
                                                    <label>Amount to Credit <span class="text-danger">*</span></label>
                                                    <input type="number" class="form-control " min="0" step="0.01"
                                                           v-model="amountToCredit" placeholder="0.00"/>
                                                </div>
                                                <div class="col-md-3 mb-1">
                                                    <label >Bank GL</label>
                                                    <searchable-dropdown :options="accountsList" v-model="debitGlId" text-field="accountIdentifier" value-field="id" placeholder="Select..."> </searchable-dropdown>
                                                </div>
                                                <div class="col-md-3 mb-1">
                                                    <label>Account Receivable GL</label>
                                                    <searchable-dropdown :options="accountsList" v-model="creditGlId" text-field="accountIdentifier" value-field="id" placeholder="Select..."> </searchable-dropdown>
                                                </div>
                                                <div class="col-md-12 mb-1">
                                                    <label>Description</label>
                                                    <input type="text" class="form-control "
                                                           v-model="description"/>
                                                </div>
                                                <div class="col-md-3 mb-1" v-show="paymentMethod !== 1">
                                                    <label>Bank</label>
                                                    <searchable-dropdown :options="banks" v-model="bankId" text-field="name" value-field="id" placeholder="Select..."> </searchable-dropdown>
                                                </div>
                                                <div class="col-md-3 mb-1" v-show="paymentMethod !== 1">
                                                    <label>Branch</label>
                                                    <searchable-dropdown :options="bankBranches" v-model="bankBranchId" text-field="name" value-field="id" placeholder="Select..."> </searchable-dropdown>
                                                </div>
                                                <div class="col-md-3 mb-1" v-show="paymentMethod !== 1">
                                                    <label>Cheque Number</label>
                                                    <input type="text" class="form-control"
                                                           v-model="chequeNumber" placeholder="CHQ-000"/>
                                                </div>
                                                <div class="col-md-3 mb-1" v-show="paymentMethod !== 1">
                                                    <label>Cheque Date</label>
                                                    <input type="date" class="form-control"
                                                           v-model="chequeDate"/>
                                                </div>
                                            </div>

                                            <div class="float-right mb-2">
                                                <button type="button" class="btn btn-sm btn-warning mr-1" @@click="resetForm">
                                                    <i class="la la-refresh"></i>Reset
                                                </button>
                                                <button type="button" class="btn btn-sm btn-primary" @@click="saveMemo">
                                                    <i class="la la-plus"></i> Save
                                                </button>

                                            </div>
                                        </div>


                                    </div>
                                  
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
@*<script src="~/js/components/shimmer-loader.js" asp-append-version="true"></script>*@
<script src="~/js/school-manager/bills-payment/credit-memo.js" asp-append-version="true"></script>