@{
    ViewBag.Title = "Cancel Payments";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}
<style>
    .responsive-table {
        overflow-x: auto;
        width: 100%;
      
    }
</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Cancel Payments</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Billings & Payments</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Cancel Payments
                            </li>
                        </ol>
                    </div>
                </div>
               
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Cancel Payments</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div class="responsive-table">

                                    <div class="float-left my-2">
                                        <button type="button" class="btn btn-sm btn-danger mr-1" @@click="cancelPayments">
                                            <i class="la la-trash"></i>Cancel
                                        </button>
                                    </div>

                                    <div class="table-responsive e-bootstrap">
                                        <div id="dataTable"></div>
                                    </div>
                                </div>


                            </div>
        
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/components/shimmer-loader.js" asp-append-version="true"></script>
<script src="~/js/school-manager/bills-payment/cancel-payments.js" asp-append-version="true"></script>