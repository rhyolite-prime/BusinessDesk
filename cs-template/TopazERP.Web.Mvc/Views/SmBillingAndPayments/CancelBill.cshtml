@{
    ViewBag.Title = "Cancel Bill";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

<style>
 .table th {
     color: #353535;
 }
 .crud-header{
     background-color: #2f65a5;
 }
 a:hover {
     cursor: pointer;
     color: #2f65a5;
 }
 
 
     .select{
         border: none;
         background-color: transparent;
         padding: 4px;
         
     }
     .table thead th {
         vertical-align: middle;
         white-space: nowrap;
     }

     .table thead th.sortable {
         cursor: pointer;
     }

     .table thead th.sortable:hover {
         background-color: #28568c;
     }
 .table-active {
     background-color: #e9f1fb !important;
 }
 .crud-buttons a:hover{
     color: #ffffff;
     background-color: #28568c;
     border-radius: 4px;
     padding: 4px;
 }
 .crud-buttons{
     display: flex;
     justify-content: space-between;
     align-items: center;
 }
 .select{
     border: none;
     background-color: transparent;
     padding: 4px;
     color: #f0ba0a;
 }


</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Cancel Bill</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Billings & Payments</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Cancel Bill
                            </li>
                        </ol>
                    </div>
                </div>
               
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Cancel Bill</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div>
                                    <div class="crud-header rounded rounded-lg p-1 row">
                                        <!-- Left: CRUD buttons -->
                                        <div class="col-sm-3 crud-buttons">
                                            <div>
                                                <a v-if="cancelBy === 'By Student'" class="text-white"
                                                   :disabled="selectedCancelCount === 0 || isCancelling"
                                                   @@click="cancelSelectedStudents">
                                                    <i class="la la-trash text-danger"></i>
                                                    <span v-if="selectedCancelCount"
                                                          class="text-white mx-1">
                                                        {{ selectedCancelCount }} selected
                                                    </span>
                                                </a>
                                                <a v-else class="text-white"
                                                   :disabled="selectedCancelCount === 0 || isCancelling"
                                                   @@click="cancelSelectedBills">
                                                    <i class="la la-trash"></i>
                                                    <span v-if="selectedCancelCount"
                                                          class="text-white mx-1">
                                                        {{ selectedCancelCount }} selected
                                                    </span>
                                                </a>
                                            </div>
                                            

                                            <div>
                                                <select id="cancelBy" v-model="cancelBy" class="select">
                                                    <option
                                                        v-for="option in cancelByOptions"
                                                        :key="option.id"
                                                        :value="option.name">
                                                        {{ option.name }}
                                                    </option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-sm-4 b " v-if="cancelBy === 'By Student'">
                                            <input id="billId"/>
                                        </div>
                                        <!-- Right: Search input -->
                                        <div class="col-sm-4">
                                            <div class="float-right">
                                                <input type="text"
                                                       class="form-control form-control-sm"
                                                       placeholder="Search..."
                                                       v-model="searchText">
                                            </div>
                                           
                                        </div>

                                    </div>
                                    <div  v-if="cancelBy !== 'By Student'">
                                        <table class="table table-hover  table-responsive">
                                            <thead>
                                            <tr>
                                                <th style="width:40px;">
                                                    <input type="checkbox"
                                                           :checked="allSelected"
                                                           :indeterminate.prop="someSelected"
                                                           @@change="toggleSelectAll">
                                                </th>
                                                <th style="width: 220px; cursor:pointer" @@click="sort('billNumber')">
                                                    Bill #
                                                </th>

                                                <th style="width: 220px; cursor:pointer" @@click="sort('billDate')">
                                                    Bill Date
                                                </th>

                                                <th style="width: 230px; cursor:pointer" @@click="sort('academicYearId')">
                                                    Academic Year
                                                </th>

                                                <th style="width: 230px; cursor:pointer" @@click="sort('termId')">
                                                    Term
                                                </th>
                                                <th style="width: 250px; cursor:pointer" @@click="sort('classId')">
                                                    Class
                                                </th>

                                                <th style="width: 220px; cursor:pointer" @@click="sort('batchNumber')">
                                                    Batch #
                                                </th>
                                                <th style="width: 220px; cursor:pointer" @@click="sort('billTypeId')">
                                                    BillType
                                                </th>
                                                <th style="width: 100px; cursor:pointer">
                                                    Posted?
                                                </th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            <tr v-if="!filteredData.length">
                                                <td colspan="8" class="text-center text-muted py-4">
                                                    No bills found.
                                                </td>
                                            </tr>
                                            <tr v-for="bill in paginatedData" :key="bill.id" :class="{ 'table-active': isSelected(bill.id) }">
                                                <td>
                                                    <input type="checkbox"
                                                           :value="bill.id"
                                                           v-model="selectedBills"/>
                                                </td>
                                                <td>{{ bill.billNumber }}</td>
                                                <td>{{ formatDate(bill.billDate) }}</td>
                                                <td>{{ getAcademicYearName(bill.academicYearId) }}</td>
                                                <td>{{ getTermName(bill.termId) }}</td>
                                                <td>{{ getClassName(bill.classId) }}</td>
                                                <td>{{ bill.batchNumber }}</td>
                                                <td>{{ getBillTypeName(bill.billTypeId) }}</td>
                                                <td>{{ bill.isPosted ? 'Yes' : 'No' }}</td>
                                            </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div v-if="cancelBy === 'By Student' && billId">

                                        <table class="table table-hover table-bordered table-responsive">
                                            <thead>
                                            <tr>
                                                <th width="40">
                                                    <input type="checkbox" @@change="toggleSelectAllStudents">
                                                </th>
                                                <th style="width: 220px; cursor:pointer" @@click="sort('studentIdentifier')">
                                                    Student Id
                                                </th>
                                                <th style="width: 520px; cursor:pointer" @@click="sort('name')">
                                                    Student
                                                </th>
                                                <th style="width: 250px; cursor:pointer" @@click="sort('className')">
                                                    Class
                                                </th>
                                                <th style="width: 220px; cursor:pointer" @@click="sort('amount')">
                                                    Amount
                                                </th>
                                                <th style="width: 220px; cursor:pointer" @@click="sort('discountAmount')">
                                                    Discount
                                                </th>
                                                <th style="width: 120px; cursor:pointer" @@click="sort('discountAmount')">
                                                    isPosted
                                                </th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            <tr v-if="!filteredData.length">
                                                <td colspan="8" class="text-center text-muted py-4">
                                                    No bills found.
                                                </td>
                                            </tr>
                                            <tr v-for="row in paginatedData" :key="row.id">
                                                <td>
                                                    <input type="checkbox" :value="row.id" v-model="selectedBillIds">
                                                </td>
                                                <td>{{ row.studentIdentifier }}</td>
                                                <td>{{ row.name }}</td>
                                                <td>{{ row.className }}</td>
                                                <td>{{ row.amount.toLocaleString(undefined, {
                                                    minimumFractionDigits: 2,
                                                    maximumFractionDigits: 2
                                                    }) }}</td>
                                                <td>{{ row.discountAmount.toLocaleString(undefined, {
                                                    minimumFractionDigits: 2,
                                                    maximumFractionDigits: 2
                                                    }) }}</td>
                                                <td>{{ row.isPosted ? 'Yes' : 'No' }}</td>
                                            </tr>
                                            </tbody>
                                        </table>

                                    </div>
                                    <div class="d-flex justify-content-end i">
                                        <button @@click="prevPage"
                                                :disabled="page === 1"
                                                class="btn btn-primary btn-sm mr-2">
                                            Prev
                                        </button>

                                        <span>Page {{ page }} of {{ totalPages }}</span>

                                        <button @@click="nextPage"
                                                :disabled="page === totalPages"
                                                class="btn btn-primary btn-sm ml-2">
                                            Next
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/components/shimmer-loader.js" asp-append-version="true"></script>
<script src="~/js/school-manager/bills-payment/cancel-bills.js" asp-append-version="true"></script>