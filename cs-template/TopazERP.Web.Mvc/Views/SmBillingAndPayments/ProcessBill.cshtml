@{
    ViewBag.Title = "ProcessBill";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}


<style>
 .table th {
     color: #353535;
 }
 .crud-header{
     background-color: #2f65a5;
 }
 a:hover {
     cursor: pointer;
     color: #2f65a5;
 }
 
 
     .select{
         border: none;
         background-color: transparent;
         padding: 4px;
         
     }
     .table thead th {
         vertical-align: middle;
         white-space: nowrap;
     }

     .table thead th.sortable {
         cursor: pointer;
     }

     .table thead th.sortable:hover {
         background-color: #28568c;
     }
 .table-active {
     background-color: #e9f1fb !important;
 }
 .crud-buttons a:hover{
     color: #ffffff;
     background-color: #28568c;
     border-radius: 4px;
     padding: 4px;
 }
 .bill-loader {
     position: fixed;
     inset: 0;
     background: rgba(255, 255, 255, 0.85);
     display: flex;
     flex-direction: column;
     align-items: center;
     justify-content: center;
     z-index: 9999;
 }

 .spinner {
     width: 48px;
     height: 48px;
     border: 4px solid #e5e5e5;
     border-top: 4px solid #2e86de;
     border-radius: 50%;
     animation: spin 0.8s linear infinite;
     margin-bottom: 12px;
 }

 .loader-text {
     font-size: 14px;
     color: #333;
     font-weight: 500;
     letter-spacing: 0.3px;
 }

 @@keyframes spin {
     to {
         transform: rotate(360deg);
     }
 }

</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Process Bills</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Billings & Payments</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Process Bills
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Process Bills</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div v-if="isLoading" class="bill-loader">
                                    <div class="spinner"></div>
                                    <div class="loader-text">Processing Bills...</div>
                                </div>
                               
                                <div>
                                    <!-- Nav tabs -->
                                    <ul class="nav nav-tabs" id="billsTabs" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <a class="nav-link text-primary active" id="standard-tab"
                                               data-bs-toggle="tab" data-bs-target="#standard"
                                               role="tab" @@click="activeTab = 'standard'">Standard Bills</a>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <a class="nav-link text-primary" id="supplementary-tab"
                                               data-bs-toggle="tab" data-bs-target="#supplementary"
                                               role="tab" @@click="activeTab = 'supplementary'">Supplementary Bills</a>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <a class="nav-link text-primary" id="boarding-tab"
                                               data-bs-toggle="tab" data-bs-target="#boarding"
                                               role="tab" @@click="activeTab = 'boarding'">Boarding Bills</a>
                                        </li>
                                    </ul>
                                    <!-- Tab content -->
                                    <div class="tab-content mt-1" id="billsTabsContent">
                                        @*<div class="d-flex gap-4 my-1" v-if="activeTab !== 'boarding'">
                                            <label for="scopes" class="mb-0">Bill Scope:</label>
                                            <div id="scopes" class="form-check" v-for="scope in billScopes" :key="scope.id">
                                                <input
                                                    type="radio"
                                                    name="billScope"
                                                    :id="scope.inputId"
                                                    :value="scope.id"
                                                    v-model="billScopeId">
                                                <label class="form-check-label ml-1" :for="scope.inputId">
                                                    {{ scope.name }}
                                                </label>
                                            </div>
                                            

                                        </div>*@
                                        <div v-if="activeTab === 'supplementary'" class="my-1">
                                            <label class="form-check-label ml-1" for="fixedBill"><strong>Fixed Bill:</strong></label>
                                            <input name="isFixedBill" class="ml-1" id="fixedBill" type="checkbox" v-model="isFixedBill"/>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-3">
                                                <label>Academic Year:</label>
                                                <searchable-dropdown
                                                    :options="academicYears"
                                                    v-model="academicYearId"
                                                    text-field="name"
                                                    value-field="id"
                                                    placeholder="Select Year...">
                                                </searchable-dropdown>
                                            </div>
                                            <div class="col-md-3">
                                                <label>Term:</label>
                                                <searchable-dropdown :options="terms" v-model="termId" text-field="name" value-field="id" placeholder="Select Term..."> </searchable-dropdown>
                                            </div>
                                            <div class="col-md-3" >
                                                <label>Level:</label>
                                                <searchable-dropdown :options="levels" v-model="levelId" text-field="levelName" value-field="id" placeholder="Select Level..."> </searchable-dropdown>
                                            </div>
                                            <div class="col-md-3" >
                                                <label>Class:</label>
                                                <searchable-dropdown :options="classList" v-model="classId" text-field="name" value-field="id" placeholder="Select Class..."> </searchable-dropdown>
                                            </div>
                                            @*<div class="col-md-3 e-bootstrap mb-1">
                                                <label>Batch Number:</label>
                                                <input id="batchNumber" type="text" v-model="batchNumber" class="form-control" disabled/>
                                            </div>
                                            <div class="col-md-3 e-bootstrap mb-1">
                                                <label>Bill Number:</label>
                                                <input id="billNumber" type="text" v-model="billNumber" class="form-control" disabled/>
                                            </div>*@
                                            <div class="col-md-3 e-bootstrap mb-1">
                                                <label>Bill Date:</label>
                                                <input id="billDate" type="date" v-model="billDate" class="form-control"/>
                                            </div>
                                            <div class="col-md-3" v-if="activeTab === 'supplementary'">
                                                <label>Supplementary Item:</label>
                                                <searchable-dropdown :options="supplementaryFeeItems" v-model="supplementaryItemId" text-field="name" value-field="id" placeholder="Select Item..."> </searchable-dropdown>
                                            </div>
                                        </div>

                                        <div class="tab-pane fade show active" id="standard" role="tabpanel">
                                            @*standard bills here*@
                                        </div>
                                        <div class="tab-pane fade" id="supplementary" role="tabpanel">
                                            @*supplementary bills here*@
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <table class="mt-1 table table-bordered table-responsive table-striped">
                                                        <thead>
                                                        <tr>
                                                            <th style="width: 20px;">
                                                                <input type="checkbox" v-model="selectAllFees">
                                                            </th>
                                                            <th style="width: 920px">Fee</th>
                                                            <th style="width: 920px">Amount</th>
                                                        </tr>
                                                        </thead>
                                                        <tbody>
                                                        <tr v-for="item in activeSupplementaryDetails" :key="item.feeItemId">
                                                            <td>
                                                                <input type="checkbox"
                                                                       :value="item.feeItemId"
                                                                       v-model="selectedFeeIds"/>
                                                            </td>
                                                            <td>{{ item.name }}</td>
                                                            <td>
                                                                <!-- isFixedBill true: allow input -->
                                                                <input
                                                                    v-if="isFixedBill"
                                                                    type="number"
                                                                    class="form-control form-control-sm"
                                                                    v-model.number="fixedBillAmount"
                                                                    min="0"
                                                                    placeholder="Enter amount"/>
                                                                <!-- isFixedBill false: display only -->
                                                                <span v-else>{{ item.amount }}</span>
                                                            </td>
                                                        </tr>
                                                        </tbody>
                                                        <tfoot class="bg-light">
                                                        <tr>
                                                            <th></th>
                                                            <th class="text-right">Total</th>
                                                            <th class="text-secondary">
                                                                {{ totalSupplementaryAmount.toLocaleString(undefined, {
                                                                minimumFractionDigits: 2,
                                                                maximumFractionDigits: 2
                                                                }) }}
                                                            </th>
                                                        </tr>
                                                        </tfoot>
                                                    </table>
                                                </div>
                                                <div class="col-md-12">
                                                    <div class="mt-1 crud-header rounded rounded-lg d-flex justify-content-start align-items-center p-1 flex-wrap">
                                                        <div class="mx-2 text-warning">{{dataCount}} - Students Found</div>
                                                        <div>
                                                            <input type="text"
                                                                   class="form-control form-control-sm"
                                                                   placeholder="Search..."
                                                                   v-model="searchText"
                                                                   style="width: 220px;">
                                                        </div>
                                                    </div>

                                                    <table class="table table-bordered table-responsive table-striped">
                                                        <thead>
                                                        <tr>
                                                            <th style="width: 20px;">
                                                                <input type="checkbox" v-model="selectAllStudents">
                                                            </th>
                                                            <th @@click="sort('studentId')" style="width: 1020px; cursor:pointer;">Student</th>
                                                            <th @@click="sort('classId')" style="width: 420px; cursor:pointer;">Class</th>

                                                            <!-- Discount columns: only when NOT fixed bill -->
                                                            <th style="width: 420px" v-if="!isFixedBill">Is Discounted</th>
                                                            <th @@click="sort('discountAmount')" style="width: 420px; cursor:pointer;" v-if="!isFixedBill">Discount Amount</th>
                                                            <th style="width: 420px" v-if="!isFixedBill">Discount %</th>

                                                            <th @@click="sort('amount')" style="width: 420px; cursor:pointer;">Amount</th>
                                                        </tr>
                                                        </thead>
                                                        <tbody>
                                                        <tr v-for="(s, index) in paginatedData" :key="s.id">

                                                            <!-- To Be Billed -->
                                                            <td>
                                                                <input type="checkbox" v-model="s.toBeBilled"/>
                                                            </td>

                                                            <!-- Student -->
                                                            <td>{{ formatStudentName(s) }}</td>

                                                            <!-- Class -->
                                                            <td>{{ s.className }}</td>

                                                            <!-- Discount checkbox: locked off for fixed bill -->
                                                            <td v-if="!isFixedBill">
                                                                <input type="checkbox" v-model="s.isDiscounted"/>
                                                            </td>

                                                            <!-- Discount Amount td -->
                                                            <td v-if="!isFixedBill">
                                                                <input
                                                                    v-if="s.isDiscounted"
                                                                    type="number"
                                                                    class="form-control form-control-sm"
                                                                    v-model.number="s.discountAmount"
                                                                    @@input="s.discountPercentage = 0"
                                                                    min="0"
                                                                    placeholder="Amount"/>
                                                                <span v-else class="text-muted">—</span>
                                                            </td>

                                                            <!-- Discount % td -->
                                                            <td v-if="!isFixedBill">
                                                                <input
                                                                    v-if="s.isDiscounted"
                                                                    type="number"
                                                                    class="form-control form-control-sm"
                                                                    v-model.number="s.discountPercentage"
                                                                    @@input="s.discountAmount = 0"
                                                                    min="0"
                                                                    max="100"
                                                                    placeholder="%"/>
                                                                <span v-else class="text-muted">—</span>
                                                            </td>

                                                            <!-- Final Amount -->
                                                            <td class="text-secondary">
                                                                {{ calculateStudentAmount(s).toLocaleString(undefined, {
                                                                minimumFractionDigits: 2,
                                                                maximumFractionDigits: 2
                                                                }) }}
                                                            </td>

                                                        </tr>
                                                        </tbody>
                                                        <tfoot class="bg-light">
                                                        <tr>
                                                            <th></th>
                                                            <th class="text-right"
                                                                :colspan="(billScopeId === 2 || billScopeId === 3) ? 1 : 0">
                                                                Total
                                                            </th>
                                                            <th></th>
                                                            <!-- spacers for discount columns -->
                                                            <th v-if="!isFixedBill"></th>
                                                            <th v-if="!isFixedBill"></th>
                                                            <th v-if="!isFixedBill"></th>
                                                            <th class="text-secondary">
                                                                {{ totalSupplementaryAmountStudents.toLocaleString(undefined, {
                                                                minimumFractionDigits: 2,
                                                                maximumFractionDigits: 2
                                                                }) }}
                                                            </th>
                                                        </tr>
                                                        </tfoot>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="tab-pane fade" id="boarding" role="tabpanel">
                                            @*boarding bills here*@
                                        </div>
                                    </div>
                                    <div class="row" v-if="activeTab !== 'supplementary'">
                                        <div class="col-md-6">
                                            <table class=" mt-1 table table-bordered table-responsive table-striped">
                                                <thead>
                                                <tr>
                                                    <th style="width: 20px;">
                                                        <input type="checkbox"
                                                               v-model="selectAllFees">
                                                    </th>
                                                    <th style="width: 920px">Fee</th>
                                                    <th style="width: 920px">Amount</th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                <tr v-for="item in activeDetails" :key="item.feeItemId">
                                                    <td>
                                                        <input type="checkbox"
                                                               :value="item.feeItemId"
                                                               v-model="selectedFeeIds"/>
                                                    </td>
                                                    <td>{{ item.name }}</td>
                                                    <td>{{ item.amount }}</td>
                                                </tr>
                                                </tbody>
                                                <tfoot class="bg-light">
                                                <tr>
                                                    <th></th>
                                                    <th class="text-right">Total</th>
                                                    <th class="text-secondary">
                                                        {{ totalAmount.toLocaleString(undefined, {
                                                        minimumFractionDigits: 2,
                                                        maximumFractionDigits: 2
                                                        }) }}
                                                    </th>
                                                </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                        @*Not Supplementary Bills Table*@
                                        <div class="col-md-12">
                                            <div class="mt-1 crud-header rounded rounded-lg d-flex justify-content-start align-items-center p-1 flex-wrap">
                                                <div class="mx-2 text-warning">{{dataCount}} - Students Found</div>
                                                <div>
                                                    <input type="text"
                                                           class="form-control form-control-sm"
                                                           placeholder="Search..."
                                                           v-model="searchText"
                                                           style="width: 220px;">
                                                </div>
                                            </div>
                                            <table class="table table-bordered table-responsive table-striped">
                                                <thead>
                                                <tr>
                                                    <th style="width: 20px;">
                                                        <input type="checkbox" v-model="selectAllStudents">
                                                    </th>

                                                    <th @@click="sort('studentId')" style="width: 1020px; cursor:pointer;">Student</th>
                                                    <th @@click="sort('classId')" style="width: 420px; cursor:pointer;">Class</th>
                                                    <th @@click="sort('amount')" style="width: 420px; cursor:pointer;">Amount</th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                <tr v-for="(s, index) in paginatedData" :key="s.id">

                                                    <!-- To Be Billed -->
                                                    <td>
                                                        <input type="checkbox" v-model="s.toBeBilled"/>
                                                    </td>
                                                    <!-- Student -->
                                                    <td>{{ formatStudentName(s) }}</td>
                                                    <!-- Class -->
                                                    <td>{{ s.className }}</td>

                                                    <!-- Amount -->
                                                    <td class="text-secondary">
                                                        {{ Number(s.amount || 0).toLocaleString(undefined, {
                                                        minimumFractionDigits: 2,
                                                        maximumFractionDigits: 2
                                                        }) }}
                                                    </td>

                                                </tr>
                                                </tbody>
                                                <tfoot class="bg-light">
                                                <tr>
                                                    <th></th>
                                                    <th></th>
                                                    <th class="text-right">Total</th>
                                                    <th class="text-secondary">
                                                        {{ totalAmountStudents.toLocaleString(undefined, {
                                                        minimumFractionDigits: 2,
                                                        maximumFractionDigits: 2
                                                        }) }}
                                                    </th>
                                                </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-end i">
                                        <button @@click="prevPage"
                                                :disabled="page === 1"
                                                class="btn btn-primary btn-sm mr-2">
                                            Prev
                                        </button>

                                        <span>Page {{ page }} of {{ totalPages }}</span>

                                        <button @@click="nextPage"
                                                :disabled="page === totalPages"
                                                class="btn btn-primary btn-sm ml-2">
                                            Next
                                        </button>
                                    </div>
                                    <div class="float-right my-1" v-if="!foundExistingBills">
                                        <div class="text-end">
                                            <button class="btn btn-sm btn-primary "
                                                    @@click="saveBills">
                                                <i class="la la-save"></i> Process
                                            </button>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/school-manager/bills-payment/process-bills.js" asp-append-version="true"></script>