@{
    ViewBag.Title = "Fees & Bills SetUp";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}
<style>
    .table td:first-child,
    .table th:first-child {
        position: sticky;
        left: 0;
        background: #fff;
        z-index: 2;
        color: #0a0af0;
    }
    .table th {
        color: #ffffff;
    }
   
    .select{
        border: none;
        width: 100%;
        background: transparent;
    }
    .input{
        border: none;
        width: 100%;
        background: transparent;
    }
    .select:focus{
        outline: none;
        box-shadow: none;
    }
</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Fees & Bills SetUps</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Billings & Payments</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Fees & Bills SetUps
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Fees & Bills SetUps</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div>
                                    <div class="float-right mb-1">
                                        <a href="@Url.Action("CreateFeeSetUp", "SmBillingAndPayments")" class="btn btn-sm btn-outline-primary mr-1 mb-1">
                                            <i class="la la-plus"></i>Create Fee SetUp
                                        </a>
                                        <a href="@Url.Action("UpdateFeeSetUp", "SmBillingAndPayments")" class="btn btn-sm btn-outline-warning mr-1 mb-1">
                                            <i class="la la-edit"></i>Edit Fee SetUps
                                        </a>
                                        <a href="@Url.Action("FeeSetUpToAll", "SmBillingAndPayments")" class="btn btn-sm btn-outline-secondary mb-1">
                                            <i class="la la-clipboard-list"></i>Apply Existing SetUp To Classes
                                        </a>
                                    </div>
                                    <div class="table-responsive">
                                        <div id="dataTable"></div>
                                    </div>
                                </div>
                               
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/school-manager/bills-payment/fee-setups.js" asp-append-version="true"></script>