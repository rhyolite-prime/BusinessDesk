@{
    ViewBag.Title = "Bill Footer";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}
<style>
 .table th {
     color: #353535;
 }
 .footerTable td:nth-child(1),
 .footerTable th:nth-child(1),
 .footerTable td:nth-child(2),
 .footerTable th:nth-child(2) {
     color: #0a0af0;
 }
 .crud-header{
     background-color: #2f65a5;
 }
 a:hover {
     cursor: pointer;
     color: #2f65a5;
 }

 
     .table thead th {
         vertical-align: middle;
         white-space: nowrap;
     }
 .crud-buttons a:hover{
     color: #ffffff;
     background-color: #28568c;
     border-radius: 4px;
     padding: 4px;
 }


</style>
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Bill Footer</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("SchoolManager", "Dashboard")" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Billings & Payments</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Bill Footer
                            </li>
                        </ol>
                    </div>
                </div>
               
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Bill Footer</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show" id="app">
                            <div class="card-body">
                                <div >
                                     <div class="float-right mb-2">
                                    <button class="btn btn-sm btn-outline-primary" @@click="scrollToForm">
                                        <i class="la la-plus"></i> Add New
                                    </button>
                                </div>
                                <!-- =================== Existing Bill Footers =================== -->
                                <div class="mb-4">
                                    <table class="table table-hover table-responsive footerTable">
                                        <thead>
                                        <tr>
                                            <th style="width: 40px;">#</th>
                                            <th style="width: 850px;">Message</th>
                                            <th style="width: 200px;">Students</th>
                                            <th style="width: 100px;">Actions</th>
                                        </tr>
                                        </thead>

                                        <tbody>
                                        <tr v-for="(footer,index) in paginatedFooterData" :key="footer.id">
                                            <td class="my-blue">{{ (footerPage - 1) * footerPerPage + index + 1 }}</td>
                                            <td class="my-blue">{{ footer.message }}</td>
                                            <td>
                                                {{ footer.toSchool ? 'All Students' : footer.details.length }}
                                            </td>
                                            <td>
                                                <a
                                                    class="text-primary me-1"
                                                    @@click="edit(footer)">
                                                    <i class="la la-edit"></i>
                                                </a>

                                                <a
                                                    class="text-danger"
                                                    @@click="remove(footer.id)">
                                                    <i class="la la-trash"></i>
                                                </a>
                                            </td>
                                        </tr>

                                        <tr v-if="!billFooters.length">
                                            <td colspan="8" class="text-center">
                                                No bill footers found
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                    <div class="d-flex justify-content-end i">
                                        <button @@click="prevFooterPage"
                                                :disabled="footerPage === 1"
                                                class="btn btn-secondary btn-sm mr-2">
                                            Prev
                                        </button>

                                        <span>Page {{ footerPage }} of {{ totalFooterPages }}</span>

                                        <button @@click="nextFooterPage"
                                                :disabled="footerPage === totalFooterPages"
                                                class="btn btn-secondary btn-sm ml-2">
                                            Next
                                        </button>
                                    </div>
                                </div>
                                <hr/>
                                <div id="billFooterForm">
                                    <p class="text-primary"><strong>Create / Update</strong></p>
                                    <div class="row mb-1">
                                        <div class="col-md-12">
                                            <div class="d-flex gap-4 mt-1">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" id="toSchool" v-model="toSchool">
                                                    <label class="form-check-label" for="toSchool"><strong>Apply To All</strong></label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-3 mb-2" >
                                            <label>Academic Year:</label>
                                            <searchable-dropdown :options="academicYears" v-model="academicYearId" text-field="name" value-field="id" placeholder="Select Year..."> </searchable-dropdown>
                                        </div>
                                        <div class="col-md-3">
                                            <label>Term:</label>
                                            <searchable-dropdown :options="terms" v-model="termId" text-field="name" value-field="id" placeholder="Select Term..."> </searchable-dropdown>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Bill Footer:</label>
                                            <input class="form-control" v-model="message" placeholder="e.g. Boarding fees due by the 15th...">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-semibold">Order Number</label>
                                            <input type="number" class="form-control" v-model.number="orderNumber">
                                        </div>
                                    </div>
                                    <!-- Students table with checkboxes -->
                                    <div v-if="!toSchool">
                                        <div class="text-muted small mt-1">
                                            <h6 class="mb-1">
                                                <i class="la la-user-friends"></i> Students — tick who this footer applies to
                                            </h6>
                                            <i class="la la-info-circle"></i>
                                            {{ billFooterDetails.length }} student(s) selected for this bill footer.
                                        </div>
                                        <div class="mt-1 crud-header rounded rounded-lg d-flex justify-content-start align-items-center p-1 flex-wrap">
                                            <div>
                                                <input style="width: 220px;" class="form-control form-control-sm" placeholder="Search students..." v-model="studentSearch">
                                            </div>
                                        </div>
                                        <table class="table table-sm table-hover align-middle table-responsive">
                                            <thead>
                                            <tr>
                                                <th style="width: 80px;" class="text-center">Applies</th>
                                                <th style="width: 40px;">#</th>
                                                <th style="width: 800px;">Student</th>
                                                <th style="width: 410px;">Class</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            <tr v-for="(row, i) in paginatedData" :key="row.s.id">
                                                <td class="text-center">
                                                    <input class="form-check-input" type="checkbox"
                                                           :checked="!!row.detail" @@change="toggleApply(row.s)">
                                                </td>
                                                <td>{{ (page - 1) * perPage + i + 1 }}</td>
                                                <td>{{ studentName(row.s.id) }}</td>
                                                <td>{{ getClassName(row.s.classId) }}</td>
                                            </tr>
                                            <tr v-if="!formRows.length">
                                                <td colspan="5" class="text-center text-muted py-3">No students found.</td>
                                            </tr>
                                            </tbody>
                                        </table>
                                        <div class="d-flex justify-content-end i">
                                            <button @@click="prevPage"
                                                    :disabled="page === 1"
                                                    class="btn btn-primary btn-sm mr-2">
                                                Prev
                                            </button>

                                            <span>Page {{ page }} of {{ totalPages }}</span>

                                            <button @@click="nextPage"
                                                    :disabled="page === totalPages"
                                                    class="btn btn-primary btn-sm ml-2">
                                                Next
                                            </button>
                                        </div>
                                    </div>

                                    <div class="float-right my-2">
                                        <button class="btn btn-warning btn-sm mr-1" @@click="resetForm">
                                            <i class="la la-refresh"></i> Reset
                                        </button>
                                        <button class="btn btn-primary btn-sm" @@click="saveBillFooter" :disabled="isLoading">
                                            <i class="la la-save"></i> {{ isEdit ? 'Update' : 'Save' }}
                                            <span v-if="isLoading" class="spinner-border spinner-border-sm ms-1"></span>
                                        </button>
                                    </div>
                                </div>
                                </div>
                               
                            </div>
                        </div>

    </div>
</div>
                            
                            <div>
       
                        </div>
                    </div>
                </div>
            </div>
</div>
<script src="~/js/components/shimmer-loader.js" asp-append-version="true"></script>
<script src="~/js/school-manager/bills-payment/bill-footers.js" asp-append-version="true"></script>