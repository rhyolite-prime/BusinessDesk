@{
    ViewBag.Title = "Bills";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Bills</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Billings & Payments</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Bills
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Student Bill Info</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                               
                                <div>
                                    <div class="float-right mb-1">
                                        <a href="@Url.Action("ProcessBill", "SmBillingAndPayments")" class="btn btn-sm btn-outline-primary mr-1">
                                            <i class="la la-sync"></i>Process Bills
                                        </a>
                                        <a href="@Url.Action("CancelBill", "SmBillingAndPayments")" class="btn btn-sm btn-outline-danger">
                                            <i class="la la-trash"></i>Cancel Bills
                                        </a>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4 mb-2">
                                            <label>Academic Year:</label>
                                            <searchable-dropdown
                                                :options="academicYears"
                                                v-model="academicYearId"
                                                text-field="name"
                                                value-field="id"
                                                placeholder="Select Year...">
                                            </searchable-dropdown>
                                        </div>
                                        <div class="col-md-4 mb-2">
                                            <label>Term:</label>
                                            <searchable-dropdown
                                                :options="terms"
                                                v-model="termId"
                                                text-field="name"
                                                value-field="id"
                                                placeholder="Select Term...">
                                            </searchable-dropdown>
                                        </div>
                                    </div>
                                    <div id="dataTable"></div>
                                </div>
                              
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="~/js/components/shimmer-loader.js" asp-append-version="true"></script>
<script src="~/js/school-manager/students/studentBillInfo.js" asp-append-version="true"></script>