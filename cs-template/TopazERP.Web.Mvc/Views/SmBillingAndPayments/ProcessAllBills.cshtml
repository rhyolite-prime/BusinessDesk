@{
    ViewBag.Title = "ProcessAllBills";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}
<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title">Process All Bills</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#">Billings & Payments</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Process All Bills
                            </li>
                        </ol>
                    </div>
                </div>
               
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Process All Bills</h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <!-- Nav tabs -->
                                <ul class="nav nav-tabs" id="feesTabs" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <a class="nav-link text-primary active" id="standard-tab" 
                                           data-bs-toggle="tab" data-bs-target="#standard" 
                                           role="tab" @@click="activeTab = 'standard'">Standard Bills</a>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <a class="nav-link text-primary" id="supplementary-tab" 
                                           data-bs-toggle="tab" data-bs-target="#supplementary" 
                                           role="tab" @@click="activeTab = 'supplementary'">Supplementary Bills</a>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <a class="nav-link text-primary" id="boarding-tab" 
                                           data-bs-toggle="tab" data-bs-target="#boardingMemo" 
                                           role="tab" @@click="activeTab = 'boarding'">Boarding Bills</a>
                                    </li>
                                </ul>
                                <P class="text-danger">Not Implemented...</P>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>