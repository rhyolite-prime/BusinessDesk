@{
    ViewBag.Title = "Update Pre Class Student";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Dashboard/SchoolManager/" class="text-primary"><i class="la la-home"></i> Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-primary" href="#"> Student SetUps </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Update Pre Class Student
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-body">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Update Student</h4>
                        </div>

                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <form>
                                    <div class="">
                                        <a :href="'/SmStudentSetups/StudentAllergy?studentId=' + form.id" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Allergies
                                        </a>
                                        <a :href="'/SmStudentSetups/StudentDisability?studentId=' + form.id" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Disabilities
                                        </a>
                                        <a :href="'/SmStudentSetups/StudentPosition?studentId=' + form.id" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Position(s)
                                        </a>
                                        <a :href="'/SmStudentSetups/ContactRelationships?StudentId=' + form.id" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Contacts & Guardian
                                        </a>
                                        <a :href="'/SmStudentSetups/StudentMedicals?StudentId=' + form.id" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Medicals
                                        </a>
                                        <a :href="'/SmStudentSetups/ChangeStatus?StudentId=' + form.id" class="btn btn-sm btn-primary">
                                            <i class="la la-user-cog"></i> Change Status
                                        </a>
                                    </div>
                                        <div class="row g-3">

                                        <!-- BASIC INFORMATION -->
                                        <div class="col-md-3 my-1">
                                            <label>Student Identifier</label>
                                            <input type="text" v-model="form.studentIdentifier" class="form-control" readonly>
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Index No.</label>
                                            <input type="text" v-model="form.indexNumber" class="form-control" readonly>
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>First Name</label><span class="text-danger">*</span>
                                            <input type="text" v-model="form.firstName" class="form-control" :class="{'is-invalid': errors.firstName}" required>
                                            <small v-if="errors.firstName" class="text-danger">
                                                {{ errors.firstName }}
                                            </small>
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Other Name</label>
                                            <input type="text" v-model="form.otherName" class="form-control">
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Last Name</label><span class="text-danger">*</span>
                                            <input type="text" v-model="form.lastName" class="form-control" :class="{'is-invalid': errors.lastName}" required>
                                            <small v-if="errors.lastName" class="text-danger">
                                                {{ errors.lastName }}
                                            </small>
                                        </div>

                                        <div class="col-md-3 my-1">
                                            <label>Date of Birth</label><span class="text-danger">*</span>
                                            <input 
                                                type="date" 
                                                v-model="form.dateOfBirth" 
                                                class="form-control"
                                                :class="{'is-invalid': errors.dateOfBirth}">
                                            <small v-if="errors.dateOfBirth" class="text-danger">
                                                {{ errors.dateOfBirth }}
                                            </small>
                                        </div>

                                        <div class="col-md-3 my-1">
                                            <label>Gender</label><span class="text-danger">*</span>
                                            <select v-model="form.gender" class="form-control" :class="{'is-invalid': errors.gender}"  placeholder="Select...">
                                                <option value="" disabled>Select...</option>
                                                <option value="Male">Male</option>
                                                <option value="Female">Female</option>
                                            </select>
                                            <small v-if="errors.gender" class="text-danger">
                                                {{ errors.gender }}
                                            </small>
                                        </div>

                                        <!-- LOCATION -->
                                        <div class="col-md-3 my-1 e-bootstrap">
                                            <label>Country</label><span class="text-danger">*</span>
                                            <input type="text" id="countryId" v-model="form.countryId" class="form-control" :class="{'is-invalid': errors.countryId}">
                                            <small v-if="errors.countryId" class="text-danger">
                                                {{ errors.countryId }}
                                            </small>
                                        </div>

                                        <div class="col-md-3 my-1 e-bootstrap">
                                            <label>City</label><span class="text-danger">*</span>
                                            <input type="text" id="cityId" v-model="form.cityId" class="form-control" :class="{'is-invalid': errors.cityId}">
                                            <small v-if="errors.cityId" class="text-danger">
                                                {{ errors.cityId }}
                                            </small>
                                        </div>

                                        <div class="col-md-3 my-1 e-bootstrap">
                                            <label>Location</label>
                                            <input type="text" id="locationId" v-model="form.locationId" class="form-control">
                                        </div>

                                        <div class="col-md-3 my-1">
                                            <label>House Number</label>
                                            <input type="text" v-model="form.houseNumber" class="form-control">
                                        </div>

                                        <div class="col-md-3 my-1">
                                            <label>Address</label><span class="text-danger">*</span>
                                            <input type="text" v-model="form.address" class="form-control" :class="{'is-invalid': errors.address}">
                                            <small v-if="errors.address" class="text-danger">
                                                {{ errors.address }}
                                            </small>
                                        </div>

                                        <!-- RELIGION -->
                                        <div class="col-md-3 my-1 e-bootstrap">
                                            <label>Religion</label><span class="text-danger">*</span>
                                            <input type="text" id="religionId" v-model="form.religionId" class="form-control" :class="{'is-invalid': errors.religionId}">
                                            <small v-if="errors.religionId" class="text-danger">
                                                {{ errors.religionId }}
                                            </small>
                                        </div>

                                        <!-- CLASS & ACADEMICS -->
                                        <div class="col-md-3 my-1 e-bootstrap">
                                            <label>Class</label><span class="text-danger">*</span>
                                            <input type="text" id="classId" v-model="form.classId" class="form-control" :class="{'is-invalid': errors.classId}">
                                            <small v-if="errors.classId" class="text-danger">
                                                {{ errors.classId }}
                                            </small>
                                        </div>

                                        <div class="col-md-3 my-1 e-bootstrap">
                                            <label>Academic Year</label><span class="text-danger">*</span>
                                            <input type="text" id="academicYearId" v-model="form.academicYearId" class="form-control" :class="{'is-invalid': errors.academicYearId}">
                                            <small v-if="errors.academicYearId" class="text-danger">
                                                {{ errors.academicYearId }}
                                            </small>
                                        </div>

                                        <div class="col-md-3 my-1">
                                            <label>Admission Date</label><span class="text-danger">*</span>
                                            <input type="date" v-model="form.admissionDate" class="form-control"  :class="{'is-invalid': errors.admissionDate}">
                                            <small v-if="errors.admissionDate" class="text-danger">
                                                {{ errors.admissionDate }}
                                            </small>
                                        </div>

                                        <div class="col-md-3 my-1 e-bootstrap">
                                            <label>Status</label><span class="text-danger">*</span>
                                            <input type="text" id="statusId" v-model="form.statusId" class="form-control" :class="{'is-invalid': errors.statusId}">
                                            <small v-if="errors.statusId" class="text-danger">
                                                {{ errors.statusId }}
                                            </small>
                                        </div>
                                        <div class="col-md-3 my-1 e-bootstrap">
                                            <label>House</label>
                                            <input type="text" id="houseId" v-model="form.houseId" class="form-control">
                                        </div>

                                        <!-- CHECKBOXES -->
                                        <div class="col-md-3 my-1">
                                            <label>Is Boarder</label><br>
                                            <input type="checkbox" v-model="form.isBoarder">
                                        </div>
                                        <div class="col-md-3 my-1 e-bootstrap">
                                            <label>Hostel</label>
                                            <input type="text" id="hostelId" v-model="form.hostelId" class="form-control">
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Is Parent Control</label><br>
                                            <input type="checkbox" v-model="form.isParentControl">
                                        </div>

                                        <!-- CONTACT -->
                                        @*<div class="col-md-3 my-1">
                                            <label>Contact Number</label>
                                            <input type="text" v-model="form.contactNumber" class="form-control">
                                          
                                        </div>*@

                                        <div class="col-md-3 my-1">
                                            <label>Phone Number</label>
                                            <input type="text" v-model="form.phoneNumber" class="form-control">
                                        </div>

                                        <!-- FINANCIAL -->
                                        <div class="col-md-3 my-1">
                                            <label>Balance Due</label>
                                            <input type="number" v-model="form.balanceDue" class="form-control">
                                        </div>

                                        <div class="col-md-3 my-1">
                                            <label>Balance Due Date</label>
                                            <input type="date" v-model="form.balanceDueDate" class="form-control">
                                        </div>

                                        <!-- NOTES -->
                                        <div class="col-md-6 my-1">
                                            <label>Notes</label>
                                            <textarea v-model="form.notes" class="form-control"></textarea>
                                        </div>
                                    </div>
                                    <div class="my-2 float-right">
                                        <a href="/SmStudentSetUps/PreClassStudents" class="btn btn-secondary"><i class="la la-times"></i>Cancel</a>
                                        <button type="button" @@click="updateStudent" class="btn btn-primary ml-1"><i class="la la-save"></i>Save</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script src="~/js/school-manager/students/updatePreClassStudents.js" asp-append-version="true"></script>
