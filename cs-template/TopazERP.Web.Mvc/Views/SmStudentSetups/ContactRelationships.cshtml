@{
    ViewBag.Title = "Student Contact Persons & Guardians";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-body" id="app">
            <div class="row">
                <div class="col-12">

                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Contact Persons - {{ studentName }}</h4>
                        </div>

                        <div class="card-content collapse show">
                            <div class="card-body">

                                <div class="my-1">
                                    <a :href="'/SmStudentSetups/EditStudent?id=' + form.studentId" class="text-primary text-xl">
                                       <i class="las la-arrow-alt-circle-left"></i> Go Back
                                    </a>
                                    <a :href="'/SmStudentSetups/StudentAllergy?studentId=' + form.studentId" class="btn btn-sm btn-outline-secondary">
                                        <i class="la la-plus"></i> Allergies
                                    </a>
                                    <a :href="'/SmStudentSetups/StudentDisability?studentId=' + form.studentId" class="btn btn-sm btn-outline-secondary">
                                        <i class="la la-plus"></i> Disabilities
                                    </a>
                                    <a :href="'/SmStudentSetups/StudentPosition?studentId=' + form.studentId" class="btn btn-sm btn-outline-secondary">
                                        <i class="la la-plus"></i> Position(s)
                                    </a>
                                    <a :href="'/SmStudentSetups/StudentMedicals?StudentId=' + form.studentId" class="btn btn-sm btn-outline-secondary">
                                        <i class="la la-plus"></i> Medicals
                                    </a>
                                    <a :href="'/SmStudentSetups/ChangeStatus?StudentId=' + form.studentId" class="btn btn-sm btn-primary">
                                        <i class="la la-user-cog"></i> Change Status
                                    </a>
                                </div>

                                <table class="table table-bordered table-striped table-sm table-responsive text-sm">
                                    <thead class="table-light">
                                    <tr class="text-sm">
                                        <th title="Is Legal Guardian">Is Legal...</th>
                                        <th>Relation</th>
                                        <th style="width: 450px;">Full Name</th>
                                        <th>Phone</th>
                                        <th>Email</th>
                                        <th>Work Place</th>
                                        <th>Work Phone</th>
                                        <th style="width: 200px">Action</th>
                                    </tr>
                                    </thead>

                                    <tbody>
                                    <tr v-for="item in contactList" :key="item.id">
                                        <td>
                                            <span v-if="item.isLegalGuardian" class="text-success">Yes</span>
                                            <span v-else class="text-muted">No</span>
                                        </td>
                                        <td>{{ item.relationshipName }}</td>
                                        <td>{{ item.firstName }} {{ item.otherNames }} {{ item.lastName }}</td>
                                        <td>{{ item.phoneNumber }}</td>
                                        <td>{{ item.email }}</td>

                                        <td>{{ item.placeOfWork }}</td>
                                        <td>{{ item.workPhone }}</td>
                                        <td>
                                            <a class="text-primary mr-2" @@click="editContact(item)">
                                                <i class="la la-edit"></i>
                                            </a>
                                            <a class="text-danger" @@click="deleteContact(item.id)">
                                                <i class="la la-trash"></i>
                                            </a>
                                        </td>
                                    </tr>

                                        <tr v-if="contactList.length === 0">
                                            <td colspan="10" class="text-center text-muted">No contact information added.</td>
                                        </tr>
                                    </tbody>
                                </table>

                                <hr />

                                <h5>Add / Edit Contact Person</h5>

                                <div class="row g-2">

                                    <div class="col-md-3">
                                        <label>Relationship</label>
                                        <input type="text" id="relationshipId"
                                               class="form-control"
                                               v-model="form.relationshipId"
                                               @@change="setRelationshipName" />
                                    </div>

                                    <div class="col-md-3">
                                        <label>Title</label>
                                        <input type="text" id="titleId"
                                               class="form-control"
                                               v-model="form.titleId"
                                               @@change="setTitleName" />
                                    </div>

                                    <div class="col-md-3">
                                        <label>First Name</label>
                                        <input type="text" class="form-control"
                                               v-model="form.firstName" />
                                    </div>

                                    <div class="col-md-3">
                                        <label>Last Name</label>
                                        <input type="text" class="form-control"
                                               v-model="form.lastName" />
                                    </div>

                                    <div class="col-md-3">
                                        <label>Other Names</label>
                                        <input type="text" class="form-control"
                                               v-model="form.otherNames" />
                                    </div>

                                    <div class="col-md-3">
                                        <label>Phone Number</label>
                                        <input type="text" class="form-control"
                                               v-model="form.phoneNumber" />
                                    </div>

                                    <div class="col-md-3">
                                        <label>Contact Number</label>
                                        <input type="text" class="form-control"
                                               v-model="form.contactNumber" />
                                    </div>

                                    <div class="col-md-3">
                                        <label>Email</label>
                                        <input type="email" class="form-control"
                                               v-model="form.email" />
                                    </div>

                                    <div class="col-md-3">
                                        <label>Place of Work</label>
                                        <input type="text" class="form-control"
                                               v-model="form.placeOfWork" />
                                    </div>

                                    <div class="col-md-3">
                                        <label>Work Phone</label>
                                        <input type="text" class="form-control"
                                               v-model="form.workPhone" />
                                    </div>

                                    <div class="col-md-3">
                                        <label>Legal Guardian?</label>
                                        <select class="form-control" v-model="form.isLegalGuardian">
                                            <option :value="true">Yes</option>
                                            <option :value="false">No</option>
                                        </select>
                                    </div>

                                </div>

                                <div class="my-2 float-right">
                                    <button type="button" class="btn btn-primary mr-1" @@click="saveContact">
                                        {{ form.id ? 'Update' : 'Save' }}
                                    </button>
                                    <button type="button" class="btn btn-secondary" @@click="resetForm">
                                        Reset
                                    </button>
                                </div>

                            </div>
                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<script>
    window.studentId = @Html.Raw(Json.Serialize(ViewBag.StudentId ?? ""));
</script>

<script src="~/js/school-manager/students/contactRelationships.js" asp-append-version="true"></script>
