@{
    ViewBag.Title = "Student Disabilities";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-body" id="app">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Student Disabilities - {{studentName}}</h4>
                        </div>

                        <div class="card-content collapse show">
                            <div class="card-body" >
                                <form>
                                    <div class="my-1">
                                        <a href="javascript:void(0);" class="text-primary text-xl" @@click="goBack">
                                            <i class="las la-arrow-alt-circle-left"></i> Go Back
                                        </a>
                                        <a :href="'/SmStudentSetups/StudentAllergy?studentId=' + form.studentId" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Allergies
                                        </a>
                                        <a :href="'/SmStudentSetups/StudentPosition?studentId=' + form.studentId" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Position(s)
                                        </a>
                                        <a :href="'/SmStudentSetups/ContactRelationships?StudentId=' + form.studentId" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Contacts & Guardian
                                        </a>
                                        <a :href="'/SmStudentSetups/StudentMedicals?StudentId=' + form.studentId" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Medicals
                                        </a>
                                        <a :href="'/SmStudentSetups/ChangeStatus?StudentId=' + form.studentId" class="btn btn-sm btn-primary">
                                            <i class="la la-user-cog"></i> Change Status
                                        </a>
                                    </div>
                                    <div>
                                        <table class="table-responsive table table-striped table-bordered table-hover align-middle">
                                            <thead class="table-light">
                                            <tr>
                                                <th style="width: 100%">Student Disability</th>
                                                <th style="width: 50px;">Remove</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            <tr v-for="item in studentDisabilities" :key="item.id">
                                                <td>{{ item.disabilityName }}</td>

                                                <td>
                                                    <a class="text-danger" @@click="deleteStudentDisability(item.id)">
                                                        <i class="la la-trash"></i>
                                                    </a>
                                                </td>
                                            </tr>

                                            <tr v-if="studentDisabilities.length === 0">
                                                <td colspan="2" class="text-center text-muted">
                                                    No disabilities assigned.
                                                </td>
                                            </tr>
                                            </tbody>
                                        </table>

                                    </div>
                                    <div class="row g-2">
                                        <div class="col-md-3 my-1 e-bootstrap">
                                            <label>Select Disability:</label>
                                            <input type="text" id="disabilityId"
                                                   v-model="form.disabilityId"
                                                   class="form-control"
                                                   @@change="setDisabilityName">
                                        </div>
                                    </div>

                                    <div class="my-1 float-right">
                                        <button type="button" @@click="saveStudentDisability" class="btn btn-success">Save</button>
                                        <a href="/SmStudentSetUps/StudentBio" class="btn btn-secondary">Cancel</a>
                                    </div>


                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<script>
    window.studentId = @Html.Raw(Json.Serialize(ViewBag.StudentId ?? ""));
</script>
<script src="~/js/school-manager/students/studentDisabilities.js" asp-append-version="true"></script>
