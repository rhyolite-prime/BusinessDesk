@{
    ViewBag.Title = "Change Student Status";
    Layout = "~/Views/Shared/Layout/_adminSchoolManagerLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-body" id="app">
            <div class="row">
                <div class="col-12">
                    <div class="card">

                        <div class="card-header">
                            <h4 class="card-title">Change Student Status – {{ studentName }}</h4>
                        </div>

                        <div class="card-content collapse show">
                            <div class="card-body">
                                <form>

                                    <div class="my-1">
                                        <a href="javascript:void(0);" class="text-primary text-xl" @@click="goBack">
                                            <i class="las la-arrow-alt-circle-left"></i> Go Back
                                        </a>
                                        <a :href="'/SmStudentSetups/StudentAllergies?studentId=' + form.studentId" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Allergies
                                        </a>
                                        <a :href="'/SmStudentSetups/StudentDisability?studentId=' + form.studentId" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Disabilities
                                        </a>
                                        <a :href="'/SmStudentSetups/StudentPosition?studentId=' + form.studentId" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Position(s)
                                        </a>
                                        <a :href="'/SmStudentSetups/ContactRelationships?StudentId=' + form.studentId" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Contacts & Guardian
                                        </a>
                                        <a :href="'/SmStudentSetups/StudentMedicals?StudentId=' + form.studentId" class="btn btn-sm btn-outline-secondary">
                                            <i class="la la-plus"></i> Medicals
                                        </a>
                                    </div>

                                    <!-- FORM -->
                                    <div class="row g-2">
                                        <div class="col-md-3 my-1">
                                            <label>Student Index:</label>
                                            <input type="text" v-model="form.studentIdentifier" class="form-control" disabled>
                                        </div>
                                        
                                        @*<div class="col-md-3 my-1">
                                            <label>Academic Year:</label>
                                            <input type="text" v-model="form.academicYearName"
                                                   class="form-control" disabled>
                                        </div>*@
                                        <div class="col-md-3 my-1 e-bootstrap">
                                            <label>Select Status:</label>
                                            <input type="text" id="statusId" v-model="form.statusId"
                                                   class="form-control" @@change="setStatusName">
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <label>Change Date:</label>
                                            <input type="date" v-model="form.changeDate" class="form-control"/>
                                        </div>
                                        <div class="col-md-6 my-1">
                                            <label>Reason:</label>
                                            <textarea v-model="form.reason" class="form-control"></textarea>
                                        </div>

                                        
                                    </div>

                                    <div class="my-1 float-right">
                                        <button type="button" class="btn btn-success" @@click="saveStatus">
                                            Change Status
                                        </button>
                                        <button type="button" class="btn btn-secondary" @@click="resetForm">
                                            Reset
                                        </button>
                                    </div>

                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    window.studentId = @Html.Raw(Json.Serialize(ViewBag.StudentId ?? ""));
</script>

<script src="~/js/school-manager/students/changeStatus.js" asp-append-version="true"></script>
