@using TopazERP
@using Abp.Authorization.Users
@using Abp.Web.Security.AntiForgery
@inject IAbpAntiForgeryManager AbpAntiForgeryManager
@{
    ViewBag.Title = "Modules";
    AbpAntiForgeryManager.SetCookie(Context);
    Layout = "~/Views/Shared/Layout/_adminNeutralLayout.cshtml";
}


<div class="row pl-5 pr-5 pt-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header" style="background-color:#3498DB">
                <h4 class="card-title"> <b> <font size="4" color="white"> Topaz Applications </font> </b>  </h4>
                <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                <div class="heading-elements">
                    <ul class="list-inline mb-0">

                        <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
                        <li><a data-action="expand"><i class="ft-maximize"></i></a></li>

                    </ul>
                </div>
            </div>

            <div class="card-content collapse show">

                <div class="card-body">

                    <div class="row">
                        <div class="col-md-4 col-sm-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="form-group">
                                            <h5>Record, store and query accounting journal entries and generate financial statements. </h5>
                                            <p>
                                            <p>
                                                <a href="/Dashboard/GeneralLedger" class="btn btn-lg btn-block font-medium-1 btn-outline-success mb-1 block-spinner-only"> General Ledger </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="form-group">
                                            <h5> Perform payroll calculations &amp; maintains labor distribution. </h5>
                                            <p>
                                            <p>
                                                <a href="/Dashboard/Payroll" class="btn btn-lg btn-block font-medium-1 btn-outline-warning mb-1 block-default-message">Payroll</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="form-group">
                                            <h5> Manage Amounts owned to suppliers, due dates and available discounts </h5>
                                            <p> </p>
                                            <a href="/Dashboard/Ap" class="btn btn-lg btn-block font-medium-1 btn-outline-danger mb-1 block-custom-message"> Accounts Payable </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 col-sm-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="form-group">
                                            <h5> Enables efficient tracking of receivables to identify potential problems in advance. </h5>
                                            <p> </p>
                                            <a href="/Dashboard/Ar" class="btn btn-lg btn-block font-medium-1 btn-outline-danger mb-1 block-msg-animation">Accounts Receivable </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-4 col-sm-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="form-group">
                                            <h5> A multi warehouse/location inventory control and analysis system. </h5>
                                            <p> </p>
                                            <button class="btn btn-lg btn-block font-medium-1 btn-outline-warning mb-1 block-multiple-msgs"> Stock Manager </button>
                                            <div class="multiple-msgs" style="display: none; padding: 15px 0;">
                                                <div class="text-bold-600">
                                                    <span class="ft-refresh-cw icon-spin text-left"></span>&nbsp; Loading ...
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="form-group">
                                            <h5> A module to manage any kind of asset owned by a organization. </h5>
                                            <p> </p>
                                            <button class="btn btn-lg btn-block font-medium-1 btn-outline-success mb-1 block-non-centered-msg"> Asset Manager </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr>
                    <div class="row">
                        <div class="col-md-4 col-sm-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        <div class="form-group">
                                            <h5>Manage students, classes, bills and payments with a centralized, easy-to-use interface.</h5>
                                            <p> </p>
                                            <a href="/Dashboard/SchoolManager" class="btn btn-lg btn-block font-medium-1 btn-outline-primary mb-1 block-custom-message"> School Manager </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>

</div>