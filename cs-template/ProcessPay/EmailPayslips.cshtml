@{
    ViewBag.Title = "Email Payslips";
    Layout = "~/Views/Shared/Layout/_adminPayrollLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Email Payslips </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#"> Process Pay </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Email Payslips
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Email Payslips </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">


                                <div class="row">

                                    <div class="col-sm-1"></div>

                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label> <strong> Send : </strong> </label>
                                            <div class="input-group">
                                                <input type="number" class="form-control" v-model="batchSize" placeholder="Batch Size">
                                                <div class="input-group-append">
                                                    <span class="input-group-text">email(s)</span>
                                                </div>
                                                <div class="input-group-append">
                                                    <span class="input-group-text">every</span>
                                                </div>
                                                <input type="number" class="form-control" v-model="intervalCount" placeholder="Interval Count">
                                                <select class="form-control" v-model="intervalType">
                                                    <option value="minute">Minute(s)</option>
                                                    <option value="hour">Hour(s)</option>
                                                    <option value="day">Day(s)</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    

                                    <div class="col-sm-3">

                                        <div class="form-group mt-1">

                                            <button type="button" :disabled="isLoading" class="btn btn-primary mt-1" v-on:click="dispatchPayslips()">

                                                Email Payslips
                                                <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>

                                            </button>

                                        </div>

                                    </div>

                                </div>
                                
                                <div id="dataTable"></div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<script src="~/js/payroll/process-pay/email-payslips.js" asp-append-version="true"></script>