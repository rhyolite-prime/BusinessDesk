@{
    ViewBag.Title = "Process Special Earnings";
    Layout = "~/Views/Shared/Layout/_adminPayrollLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Process Pay </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#"> Process Special Earnings  </a>
                            </li>
                            
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Process Special Earnings  </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">

                                    <div class="col-sm-1"></div>

                                    <div class="col-sm-2">

                                        <div class="form-group">
                                            <label>  Month: </label>

                                            <select disabled class="form-control mb-3" v-model="month">
                                                <option value="1"> January </option>
                                                <option value="2"> February </option>
                                                <option value="3"> March </option>
                                                <option value="4"> April </option>
                                                <option value="5"> May </option>
                                                <option value="6"> June </option>
                                                <option value="7"> July </option>
                                                <option value="8"> August </option>
                                                <option value="9"> September </option>
                                                <option value="10"> October </option>
                                                <option value="11"> November </option>
                                                <option value="12"> December </option>
                                            </select>

                                        </div>

                                    </div>

                                    <div class="col-sm-2">

                                        <div class="form-group">
                                            <label> Year: </label>
                                            <input type="number" readonly class="form-control" name="year" value="@DateTime.Now.Year" placeholder="@DateTime.Now.Year">
                                        </div>
                                    </div>
                                    
                                    <div class="col-sm-3">
                                        
                                        <div class="form-group">
                                            <label> Earning Type: </label>

                                            <select class="form-control mb-3" v-model="earningTypeId">
                                                <option value=""> Select Earning Type </option>
                                                 <option :value="earningType.id" v-for="earningType in earningTypeList"> {{earningType.name}} </option>
                                                
                                            </select>

                                        </div>

                                    </div>

                                    <div class="col-sm-3">

                                        <div class="form-group mt-1">

                                            <button type="button" :disabled="isLoading" class="btn btn-primary mt-1" v-on:click="processPay()">

                                                {{processingText}}

                                                <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>

                                            </button>

                                        </div>

                                    </div>

                                </div>

                                <hr />

                                <fieldset class="form-group">

                                    <legend><span> Payroll results </span></legend>

                                    <div id="dataTable"> </div>

                                </fieldset>

                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>



<script src="~/libs/vuelidate/vuelidate.min.js"></script>
<script src="~/libs/vuelidate/validators.min.js"></script>

<script src="~/js/payroll/process-pay/special-earnings.js" asp-append-version="true"></script>