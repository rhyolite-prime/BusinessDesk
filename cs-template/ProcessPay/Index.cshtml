@{
    ViewBag.Title = "Process Pay";
    Layout = "~/Views/Shared/Layout/_adminPayrollLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Process Pay </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#">  Process Pay  </a>
                            </li>
                            
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Process Pay  </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">

                                    <div class="col-sm-2"></div>

                                    <div class="col-sm-2">

                                        <div class="form-group">
                                            <label> Month: </label>

                                            <select disabled class="form-control mb-3" v-model="month">
                                                <option value="1"> January </option>
                                                <option value="2"> February </option>
                                                <option value="3"> March </option>
                                                <option value="4"> April </option>
                                                <option value="5"> May </option>
                                                <option value="6"> June </option>
                                                <option value="7"> July </option>
                                                <option value="8"> August </option>
                                                <option value="9"> September </option>
                                                <option value="10"> October </option>
                                                <option value="11"> November </option>
                                                <option value="12"> December </option>
                                            </select>

                                        </div>

                                    </div>

                                    <div class="col-sm-2">

                                        <div class="form-group">
                                            <label> Year: </label>
                                            <input type="number" readonly class="form-control" v-model="year" placeholder="@DateTime.Now.Year">
                                        </div>
                                    </div>

                                    <div class="col-sm-3">

                                        <div class="form-group mt-1">

                                            <button type="button" :disabled="isLoading" class="btn btn-primary mt-1" v-on:click="processPay()">

                                                {{processingText}}

                                                <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>

                                            </button>

                                        </div>

                                    </div>

                                </div>

                                <hr/>
                                
                                <ul class="nav nav-tabs mb-3" id="employeeTab" role="tablist">
                                    <li class="nav-item">
                                        <a class="nav-link active" id="employee-list-tab" data-toggle="tab" href="#employee-list" role="tab" aria-controls="employee-list" aria-selected="true">Employees</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="payroll-results-tab" data-toggle="tab" href="#payroll-results" role="tab" aria-controls="payroll-results" aria-selected="false">Payroll Results</a>
                                    </li>
                                </ul>
                                <div class="tab-content" id="employeeTabContent">
                                    <div class="tab-pane fade show active" id="employee-list" role="tabpanel" aria-labelledby="employee-list-tab">

                                        <div id="employeesDataTable"> </div>
                                        
                                    </div>
                                    <div class="tab-pane fade" id="payroll-results" role="tabpanel" aria-labelledby="payroll-results-tab">

                                        <div id="payrollResultsDataTable"> </div>
                                        
                                    </div>
                                </div>



                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>



<script src="~/libs/vuelidate/vuelidate.min.js"></script>
<script src="~/libs/vuelidate/validators.min.js"></script>

<script src="~/js/payroll/process-pay/index.js" asp-append-version="true"></script>