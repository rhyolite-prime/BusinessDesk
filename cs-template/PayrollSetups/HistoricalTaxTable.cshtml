@{
    ViewBag.Title = "Historical Tax Table";
    Layout = "~/Views/Shared/Layout/_adminPayrollLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Tax Table </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#">Payroll  Setups</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Historical Tax Table
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body" id="app">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Historical Tax Table  </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">

                            <div class="row">

                                <div class="col-sm-2">  </div>

                                <div class="col-sm-3">

                                    <div class="form-group">

                                        <label> <strong> Select Tax History: </strong>  </label>

                                        <input id="taxHistoryId" v-model="taxHistoryId" type="text" class="form-control" />

                                    </div>

                                </div>


                                <div class="col-sm-2 mt-1">

                                   
                                    <div class="form-group mt-1">

                                        <button class="btn btn-danger mr-1" :disabled="isDeleteProcessing" v-on:click="clearTaxHistory()"><i class="ft-trash"></i> Clear History  <i class="la la-circle-o-notch spinner" v-if="isDeleteProcessing"></i> </button>
                                    </div>

                                 </div>

                                <div class="col-sm-2 mt-1">

                                    <div class="form-group mt-1">
                                         
                                        <button class="btn btn-primary mr-1" :disabled="isTaxHistoryRestoring" v-on:click="restoreTaxHistory()"> <i class="ft-refresh-cw"></i> Restore History  <i class="la la-circle-o-notch spinner" v-if="isTaxHistoryRestoring"></i> </button>

                                    </div>

                                </div>

                            </div>

                            <hr/>

                            <div class="card-body">

                                <div id="dataTable"></div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>


           

        </div>
    </div>
</div>


<script src="~/js/payroll/setups/historical-tax-table.js" asp-append-version="true"></script>
