@{
    ViewBag.Title = "Loan Types";
    Layout = "~/Views/Shared/Layout/_adminPayrollLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> IRS Signature </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#">Payroll  Setups</a>
                            </li>
                            <li class="breadcrumb-item active">
                                IRS Signature
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> IRS Signature  </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">

                                    <div class="col-sm-1">  </div>

                                    <div class="col-sm-3">

                                        <div class="form-group">
                                            <label> <b> Name: </b> </label>
                                            <input type="text" class="form-control" v-model="name" placeholder="Name">
                                        </div>

                                        <div class="form-group">
                                            <label> <b> Title: </b> </label>
                                            <input type="text" class="form-control" v-model="title" placeholder="Title">

                                        </div>

                                        <button type="button" :disabled="isLoading" v-on:click="createOrUpdateIrsSignature()" class="alignright btn btn-primary mt-3">
                                            Submit

                                            <i class="la la-circle-o-notch spinner" v-if="isLoading"></i>
                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>

<script src="~/js/payroll/setups/irs-signature.js" asp-append-version="true"></script>
