@{
    ViewBag.Title = "Initialize Data";
    Layout = "~/Views/Shared/Layout/_adminPayrollLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Initialize Data </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#"> Payroll Setups </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Initialize Data 
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Initialize Data  </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                                <div class="row">

                                    <div class="col-sm-6">
                                        
                                        <div class="form-group text-center" style="border: 1px solid #cacfe7; border-radius: 10px; padding: 0.75rem 1rem; justify-content: center">
                                        
                                            <div class="form-check">
                                                <label class="form-check-label">
                                                    <input class="form-check-input" type="checkbox" v-model="isTaxable" name="IsTaxable"> <br /> <strong> Is Taxable ?: </strong>
                                                </label>
                                            </div>
                                        
                                        </div>
                                        
                                    </div>
                                    
                                    <div class="col-sm-6">
                                        
                                        <div class="form-group text-center" style="border: 1px solid #cacfe7; border-radius: 10px; padding: 0.75rem 1rem; justify-content: left">
                                                                                
                                            <label class="form-check-label">
                                                <input class="form-check-input" type="checkbox" v-model="isTaxable" name="IsTaxable"> <br /> <strong> Is Taxable ?: </strong>
                                            </label>
                                                                                
                                        </div>
                                        
                                    </div>
                                     

                                </div>


                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>
 


<script src="~/js/payroll/setups/initialize-data.js" asp-append-version="true"></script>