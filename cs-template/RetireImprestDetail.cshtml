@{
    ViewBag.Title = "Retire Imprest Detail";
    Layout = "~/Views/Shared/Layout/_adminLedgerLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> @ViewBag.Title </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="#">Home</a></li>
                            <li class="breadcrumb-item"><a href="#">General Ledger</a></li>
                            <li class="breadcrumb-item"><a href="/LedgerDataEntry/Imprest">Imprest</a></li>
                            <li class="breadcrumb-item active">@ViewBag.Title</li>
                        </ol>
                    </div>
                </div>
            </div>
            <div class="content-header-right col-md-6 col-12 mb-2 text-right">
                <a href="/LedgerDataEntry/Imprest" class="btn btn-secondary"><i class="fa fa-arrow-left"></i> Back to Imprests</a>
            </div>
        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Edit Retirement </h4>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <div v-if="isShimmerLoading" class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="sr-only">Loading...</span>
                                    </div>
                                </div>
                                
                                <form id="retireForm" v-show="!isShimmerLoading">
                                    <fieldset class="mb-3" style="border: 1px solid #ced4da; padding: 10px; border-radius: 5px;">
                                        <legend style="width: auto; padding: 0 10px; font-size: 1.1rem; font-weight: 500;">Retirement Summary</legend>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group row">
                                                    <label class="col-md-4 col-form-label"> <strong>Retirement Date:</strong> </label>
                                                    <div class="col-md-8">
                                                        <input type="date" class="form-control" v-model="form.retirementDate" />
                                                    </div>
                                                </div>
                                                <div class="form-group row">
                                                    <label class="col-md-4 col-form-label"> <strong>Retired By:</strong>  </label>
                                                    <div class="col-md-8">
                                                        <input type="text" class="form-control" v-model="form.retiredBy" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group row">
                                                    <label class="col-md-4 col-form-label"> <strong>Total Amount Retired:</strong>  </label>
                                                    <div class="col-md-8">
                                                        <input type="number" class="form-control text-right bg-light" v-model="totalAmountRetired" readonly />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </fieldset>
                                    
                                    <fieldset class="mb-3" style="border: 1px solid #ced4da; padding: 10px; border-radius: 5px;">
                                        <legend style="width: auto; padding: 0 10px; font-size: 1.1rem; font-weight: 500;">Retirement Details</legend>
                                        
                                        <table class="table table-bordered table-sm">
                                            <thead class="bg-light">
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Receipt No</th>
                                                    <th>Description</th>
                                                    <th>Amount</th>
                                                    <th width="50"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr v-for="(detail, index) in form.details" :key="index">
                                                    <td><input type="date" class="form-control form-control-sm" v-model="detail.receiptDate" /></td>
                                                    <td><input type="text" class="form-control form-control-sm" v-model="detail.receiptNo" /></td>
                                                    <td><input type="text" class="form-control form-control-sm" v-model="detail.description" /></td>
                                                    <td><input type="number" class="form-control form-control-sm text-right" v-model="detail.amount" min="0" step="0.01" /></td>
                                                    <td class="text-center">
                                                        <button type="button" class="btn btn-sm btn-danger" v-on:click="removeDetail(index)">
                                                            <i class="fa fa-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td colspan="5" class="text-right">
                                                        <button type="button" class="btn btn-sm btn-info" v-on:click="addDetail()">
                                                            <i class="fa fa-plus"></i> Add Line
                                                        </button>
                                                    </td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </fieldset>
                                    
                                    <div class="form-actions text-right">
                                        <button type="button" class="btn btn-primary" v-on:click="updateRetirement()">
                                            <i class="la la-check-square-o"></i> Save Changes
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/gl/data-entry/retire-imprest-detail.js" asp-append-version="true"></script>
