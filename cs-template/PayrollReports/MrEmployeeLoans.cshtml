@{
    ViewBag.Title = "Reports | Employee Loans";
    Layout = "~/Views/Shared/Layout/_adminPayrollLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Employee Loans </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#"> Reports </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Employee Loans
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Employee Loans   </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">

                               
                                <div class="row">

                                    
                                    <div class="col-sm-2 mx-3">

                                        <div class="form-group text-left" style="width: 180px; border: 1px solid #cacfe7; border-radius: 10px; padding: 0.75rem 1rem; justify-content: center">
                                            <div class="radio " >
                                                <label><input type="radio" v-model="reportType" name="ReportType" value="summary-report"> &nbsp;&nbsp; <b> Summary Report </b></label>
                                            </div>
                                            <div class="radio" style="width: 150px; display: inline-block;">
                                                <label><input type="radio" v-model="reportType" name="ReportType" value="loan-type"> &nbsp;&nbsp; <b>  By Loan Type </b></label>
                                            </div>
                                            <div class="radio" style="width: 150px; display: inline-block;">
                                                <label><input type="radio" v-model="reportType" name="ReportType" value="By-employee"> &nbsp;&nbsp; <b>  By EmployeeId </b></label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-sm-3" v-show="reportType == 'loan-type'">

                                        <div class="form-group">
                                            <label> <strong> Loan Type: </strong>  </label>
                                            <select class="form-control mb-3" v-model="loanTypeId" ref="loanTypeId">
                                                <option value=""> Loan Type </option>
                                                <option :value="loanType.id" v-for="loanType in loanTypeList">{{loanType.name}}</option>
                                            </select>
                                        </div>

                                    </div>
                                    <div class="col-sm-3" v-show="reportType == 'By-employee'">

                                        <div class="form-group">

                                            <label> <strong> Select Employee: </strong>  </label>

                                            <input id="employeeId" v-model="employeeId" type="text" class="form-control" />

                                        </div>

                                    </div>

                                    <div class="col-sm-3" >

                                        <div class="form-group">
                                            <label> <strong>Start Date:</strong> </label>
                                            <input v-model="startDate" ref="startDate" type="date" class="form-control" />

                                        </div>

                                    </div>
                                    <div class="col-sm-3" >

                                        <div class="form-group">
                                            <label> <strong> End Date: </strong> </label>
                                            <input v-model="endDate" ref="endDate" type="date" class="form-control" />

                                        </div>

                                    </div>

                                    <div class="col-sm-2 mt-1">

                                        <div class="form-group mt-1">

                                            <button type="button" class="alignright btn btn-primary" v-on:click="getReportData()"> Search </button>

                                        </div>

                                    </div>

                                </div>

                                <hr />

                                <div style="height:auto;width:auto;min-height:500px;" id="reportView">  </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>




<script src="~/js/payroll/monthly-reports/employee-loans.js" asp-append-version="true"></script>