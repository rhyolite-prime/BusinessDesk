@{
    ViewBag.Title = "Employee Deductions";
    Layout = "~/Views/Shared/Layout/_adminPayrollLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Employee Deductions </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#"> Home </a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#"> Import Data </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Employee Deductions
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-body">
            <!-- Basic Tables start -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Employee Deductions </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body">

                                <form asp-controller="PayrollImportData" asp-action="UploadEmployeeDeductions" enctype="multipart/form-data" method="post">

                                    <div class="row">

                                        <div class="col-sm-2"> </div>

                                        <div class="col-sm-4">

                                            <div class="form-group">
                                                <label> <strong> Choose File: </strong>  <a style="color:#3498DB;" href="@Url.Action("DownloadEmployeeDeductionsUploadSample","PayrollImportData")"> <b> Download Template </b></a> </label>
                                                <input type="file" name="customFile" v-on:change="onFileUpload($event)" class="form-control" required>
                                            </div>

                                        </div>


                                        <div class="col-sm-1">

                                            <div class="form-group mt-1">
                                                <br />
                                                <button type="submit" value="Upload" id="uploadBtn" :disabled="enableUpload" class="btn btn-primary mt-1"> Import </button>

                                            </div>

                                        </div>

                                    </div>

                                </form>


                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>


 
@if (Model != null)
{
    <script>

        $(function () {
            swal("Data Successfully Imported..!", "", "success");
        });

    </script>


}

<script src="~/js/payroll/import-data/import.js" asp-append-version="true"></script>
