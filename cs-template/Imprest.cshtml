@{
    ViewBag.Title = "Imprest";
    Layout = "~/Views/Shared/Layout/_adminLedgerLayout.cshtml";
}


<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> Imprest </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="#">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#">General Ledger </a>
                            </li>
                            <li class="breadcrumb-item active">
                                Imprest
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
            <div class="content-header-right col-md-6 col-12 mb-2 text-right">
                <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#createVoucherModal">
                    <i class="ft-plus"></i> Create Imprest
                </button>
            </div>

        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> Imprest </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            
                            <div class="card-body" id="app">

                                <div class="row">

                                    <div class="col-md-3">
                                        <label>Start Date</label>
                                        <input type="date" v-model="filters.startDate" class="form-control"/>
                                    </div>

                                    <div class="col-md-3">
                                        <label>End Date</label>
                                        <input type="date" v-model="filters.endDate" class="form-control"/>
                                    </div>

                                    <div class="col-md-2 d-flex align-items-end" v-on:click="getImprests()">
                                        <button type="button" class="btn btn-primary btn-block">
                                            <i class="ft-filter"></i> Filter
                                        </button>
                                    </div>
                                    
                                    <div v-if="selectedItems[activeTab].length > 0" class="col-md-3 d-flex align-items-end">
                                        <div class="dropdown w-100">
                                            <button class="btn btn-primary dropdown-toggle w-100" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                <i class="ft-settings"></i> Actions ({{ selectedItems[activeTab].length }})
                                            </button>
                                            <div class="dropdown-menu w-100">
                                                <a class="dropdown-item text-success" href="#" v-on:click.prevent="postSelected()">
                                                    <i class="fa fa-check-circle"></i> Post Selected to GL
                                                </a>
                                                <div class="dropdown-divider"></div>
                                                <a class="dropdown-item text-danger" href="#" v-on:click.prevent="deleteSelected()">
                                                    <i class="fa fa-trash"></i> Delete Selected
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    
                                </div>

                                <hr/>
                                
                                <ul class="nav nav-tabs nav-linetriangle no-hover-bg" role="tablist">
                                    <li class="nav-item">
                                        <a class="nav-link active" id="disbursements-tab" data-toggle="tab" href="#disbursements" aria-controls="disbursements" role="tab" aria-selected="true">Disbursements</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="retirements-tab" data-toggle="tab" href="#retirements" aria-controls="retirements" role="tab" aria-selected="false">Retirements</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="refunds-tab" data-toggle="tab" href="#refunds" aria-controls="refunds" role="tab" aria-selected="false">Refunds</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="writeoffs-tab" data-toggle="tab" href="#writeoffs" aria-controls="writeoffs" role="tab" aria-selected="false">Writeoffs</a>
                                    </li>
                                </ul>
                                
                                <div class="tab-content px-1 pt-1">
                                    <div class="tab-pane active" id="disbursements" role="tabpanel" aria-labelledby="disbursements-tab">
                                        <div id="dataTable"></div>
                                    </div>
                                    <div class="tab-pane" id="retirements" role="tabpanel" aria-labelledby="retirements-tab">
                                        <div id="retirementsTable"></div>
                                    </div>
                                    <div class="tab-pane" id="refunds" role="tabpanel" aria-labelledby="refunds-tab">
                                        <div id="refundsTable"></div>
                                    </div>
                                    <div class="tab-pane" id="writeoffs" role="tabpanel" aria-labelledby="writeoffs-tab">
                                        <div id="writeoffsTable"></div>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="createVoucherModal" tabindex="-1" role="dialog" aria-labelledby="createVoucherModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="createVoucherModalLabel">Accountable Imprests</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
          <div class="list-group">
              
              <a href="/LedgerDataEntry/AddImprest" class="list-group-item list-group-item-action">
                  <h5 class="list-group-item-heading">Add Imprest</h5>
              </a>
              <a href="/LedgerDataEntry/RetireImprest" class="list-group-item list-group-item-action">
                  <h5 class="list-group-item-heading">Retire an Imprest</h5>
              </a>
              <a href="/LedgerDataEntry/RefundImprest" class="list-group-item list-group-item-action">
                  <h5 class="list-group-item-heading">Refund an Imprest</h5>
              </a>
              <a href="/LedgerDataEntry/WriteOffImprest" class="list-group-item list-group-item-action">
                  <h5 class="list-group-item-heading">Writeoff an Imprest</h5>
              </a>
              <a href="/LedgerDataEntry/ViewOutstandingImprest" class="list-group-item list-group-item-action">
                  <h5 class="list-group-item-heading">View Outstanding Imprest</h5>
              </a>

              <a href="/LedgerDataEntry/ConvertOutstandingBalanceToPayrollLoans" class="list-group-item list-group-item-action">
                  <h5 class="list-group-item-heading">Convert Outstanding Balance To Payroll Loans</h5>
              </a>

              <a href="/LedgerDataEntry/TransferImprestFromPaymentVouchers" class="list-group-item list-group-item-action">
                  <h5 class="list-group-item-heading">Transfer from Payment Vouchers</h5>
              </a>

              <a href="/LedgerDataEntry/PostImprestToGl" class="list-group-item list-group-item-action">
                  <h5 class="list-group-item-heading">Post Imprest Transactions To GL</h5>
              </a>
          </div>
      </div>
    </div>
  </div>
</div>


<script src="~/js/gl/data-entry/all-imprest.js" asp-append-version="true"></script>