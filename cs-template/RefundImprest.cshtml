@{
    ViewBag.Title = "Refund Imprest";
    Layout = "~/Views/Shared/Layout/_adminLedgerLayout.cshtml";
}

<div class="app-content content">
    <div class="content-wrapper">
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title"> @ViewBag.Title </h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="#">Home</a></li>
                            <li class="breadcrumb-item"><a href="#">General Ledger</a></li>
                            <li class="breadcrumb-item"><a href="/LedgerDataEntry/Imprest">Imprest</a></li>
                            <li class="breadcrumb-item active">@ViewBag.Title</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-body">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> @ViewBag.Title </h4>
                            <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                            <div class="heading-elements">
                                <ul class="list-inline mb-0">
                                    <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                    <li><a data-action="close"><i class="ft-x"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-content collapse show">
                            <div class="card-body" id="app">
                                <!-- Loading Overlay -->
                                <div v-if="isShimmerLoading" class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="sr-only">Loading...</span>
                                    </div>
                                </div>
                                
                                <div v-show="!isShimmerLoading">
                                    <!-- Employee Bio Card -->
                                    <div v-if="selectedEmployee" class="card mb-4 border-primary shadow-sm" style="border-radius: 12px;">
                                        <div class="card-body p-3 position-relative">
                                            <button type="button" class="close text-danger position-absolute" style="top: 10px; right: 15px; font-size: 1.2rem;" v-on:click="clearSelectedEmployee" title="Remove Employee">
                                                <span>&times;</span>
                                            </button>
                                            <div class="d-flex align-items-center">
                                                <div class="mr-3 ml-2">
                                                    <img src="https://res.cloudinary.com/dusydqiob/image/upload/v1788800656/Images/user_avatar.png" 
                                                         alt="Employee Photo" 
                                                         class="rounded-circle" 
                                                         style="width: 75px; height: 75px; object-fit: cover; border: 3px solid #007bff; padding: 2px;">
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="row align-items-center mb-1">
                                                        <div class="col-auto pr-2">
                                                            <h5 class="mb-0 font-weight-bold">{{ selectedEmployee.firstName }} {{ selectedEmployee.lastName }}</h5>
                                                        </div>
                                                        <div class="col-auto px-1">
                                                            <span class="badge badge-info" style="border-radius: 10px; font-weight: normal;">{{ selectedEmployee.departmentName || 'N/A' }}</span>
                                                        </div>
                                                        <div class="col-auto px-1">
                                                            <span class="badge badge-success" style="border-radius: 10px; font-weight: normal;">{{ selectedEmployee.statusName || 'N/A' }}</span>
                                                        </div>
                                                    </div>
                                                    <div class="row text-muted" style="font-size: 0.85rem;">
                                                        <div class="col-auto pr-3 mb-1">
                                                            <i class="la la-id-card mr-1"></i><strong>{{ selectedEmployee.employeeIdentifier || 'N/A' }}</strong>
                                                        </div>
                                                        <div class="col-auto pr-3 mb-1">
                                                            <i class="la la-envelope mr-1"></i>{{ selectedEmployee.companyEmail || selectedEmployee.personalEmail || 'N/A' }}
                                                        </div>
                                                        <div class="col-auto pr-3 mb-1">
                                                            <i class="la la-phone mr-1"></i>{{ selectedEmployee.primaryPhoneNumber || 'N/A' }}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <!-- LEFT COLUMN - Employee List -->
                                        <div class="col-md-3">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5 class="card-title mb-0">
                                                        Employees 
                                                        <span class="badge badge-primary">{{ employeeCount }}</span>
                                                    </h5>
                                                </div>
                                                <!-- Search Box -->
                                                <div class="px-1 pb-2">
                                                    <input type="text" class="form-control" placeholder="Search employees..." v-model="employeeSearch" @@input="filterEmployees" style="width: 100%;">
                                                </div>
                                                <div class="card-body p-0" style="max-height: 550px; overflow-y: auto;">
                                                    <div v-if="filteredEmployeeList.length === 0" class="text-center p-3">
                                                        <span class="text-muted">No employees found</span>
                                                        <div v-if="employeeSearch" class="mt-2">
                                                            <button class="btn btn-sm btn-link" v-on:click="employeeSearch = ''; filterEmployees();">
                                                                <i class="la la-undo"></i> Clear search
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <div v-for="emp in filteredEmployeeList" 
                                                         :key="emp.id" 
                                                         class="employee-item p-2 border-bottom"
                                                         :class="{ 'bg-light border-primary': selectedEmployee && selectedEmployee.id === emp.id }"
                                                         v-on:click="selectEmployee(emp)"
                                                         style="cursor: pointer; transition: all 0.2s;">
                                                        <div class="d-flex align-items-center">
                                                            <div class="avatar mr-2">
                                                                <span class="avatar-content bg-primary text-white rounded-circle p-2" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                                                    {{ getInitials(emp) }}
                                                                </span>
                                                            </div>
                                                            <div class="flex-grow-1">
                                                                <div class="d-flex justify-content-between">
                                                                    <strong>{{ emp.firstName }} {{ emp.lastName }}</strong>
                                                                    <span v-if="selectedEmployee && selectedEmployee.id === emp.id" class="text-primary">
                                                                        <i class="la la-check-circle"></i>
                                                                    </span>
                                                                </div>
                                                                <div class="d-flex justify-content-between">
                                                                    <small class="text-muted">{{ emp.employeeIdentifier || 'N/A' }}</small>
                                                                    <small class="text-muted">{{ emp.departmentName || 'N/A' }}</small>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- VERTICAL DIVIDER -->
                                        <div class="col-md-1 d-flex justify-content-center">
                                            <div class="vertical-divider"></div>
                                        </div>

                                        <!-- RIGHT COLUMN - Imprest Form -->
                                        <div class="col-md-8">
                                            <form id="refundForm" v-if="selectedEmployee">
                                                <fieldset class="mb-3" style="border: 1px solid #ced4da; padding: 10px; border-radius: 5px;">
                                                    <legend style="width: auto; padding: 0 10px; font-size: 1.1rem; font-weight: 500;">Pick an Imprest to Refund</legend>
                                                    
                                                    <div class="row">
                                                        <div class="col-md-6">
                                                            <div class="form-group row">
                                                                <label class="col-md-4 col-form-label"> <strong>Imprest:</strong>  </label>
                                                                <div class="col-md-8">
                                                                    <select class="form-control" v-model="imprestForm.imprestId" @@change="onImprestChange">
                                                                        <option disabled value="">Select Imprest</option>
                                                                        <option v-for="imp in employeeImprests" :value="imp.id">{{ imp.imprestNo || imp.id }}</option>
                                                                    </select>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="form-group row">
                                                                <label class="col-md-4 col-form-label"> <strong>Category:</strong>  </label>
                                                                <div class="col-md-8">
                                                                    <input type="text" class="form-control bg-light" v-model="imprestForm.categoryName" readonly />
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="row">
                                                        <div class="col-md-6">
                                                            <div class="form-group row">
                                                                <label class="col-md-4 col-form-label"> <strong>Amount Disbursed:</strong>  </label>
                                                                <div class="col-md-8">
                                                                    <input type="number" class="form-control text-right bg-light" v-model="imprestForm.amountDisbursed" readonly />
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="form-group row">
                                                                <label class="col-md-4 col-form-label"> <strong>Outstanding:</strong>  </label>
                                                                <div class="col-md-8">
                                                                    <input type="number" class="form-control text-right bg-light" v-model="imprestForm.outstanding" readonly />
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </fieldset>

                                                <fieldset class="mb-3" style="border: 1px solid #ced4da; padding: 10px; border-radius: 5px;">
                                                    <legend style="width: auto; padding: 0 10px; font-size: 1.1rem; font-weight: 500;">Refund Info</legend>

                                                    <div class="row">
                                                        <div class="col-md-6">
                                                            <div class="form-group row">
                                                                <label class="col-md-4 col-form-label"> <strong>Refund Date:</strong> </label>
                                                                <div class="col-md-8">
                                                                    <input type="date" class="form-control" v-model="imprestForm.refundDate" />
                                                                </div>
                                                            </div>
                                                            <div class="form-group row">
                                                                <label class="col-md-4 col-form-label"> <strong>Amount:</strong>  </label>
                                                                <div class="col-md-8">
                                                                    <input type="number" class="form-control text-right" v-model="imprestForm.amount" min="0" step="0.01" />
                                                                </div>
                                                            </div>
                                                            <div class="form-group row">
                                                                <label class="col-md-4 col-form-label"> <strong>Currency:</strong>  </label>
                                                                <div class="col-md-8">
                                                                    <select class="form-control" v-model="imprestForm.currencyId">
                                                                        <option disabled value="">Select Currency</option>
                                                                        <option v-for="curr in currencyList" :value="curr.id">{{ curr.currencyName }}</option>
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group row">
                                                                <label class="col-md-4 col-form-label"> <strong>Authorized By:</strong>  </label>
                                                                <div class="col-md-8">
                                                                    <select class="form-control" v-model="imprestForm.authorizedBy">
                                                                        <option value="">Select Approver</option>
                                                                        <option v-for="emp in employeeList" :value="emp.id">{{ emp.firstName }} {{ emp.lastName }}</option>
                                                                    </select>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="form-group row" style="height: 40px;">
                                                                <!-- Empty space to align with Refund Date -->
                                                            </div>
                                                            <div class="form-group row" style="height: 40px;">
                                                                <!-- Empty space to align with Amount -->
                                                            </div>
                                                            <div class="form-group row">
                                                                <label class="col-md-4 col-form-label"> <strong>Rate:</strong>  </label>
                                                                <div class="col-md-8">
                                                                    <input type="number" class="form-control text-right" v-model="imprestForm.rate" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="row mb-2">
                                                        <div class="col-md-12 d-flex justify-content-center">
                                                            <div class="custom-control custom-radio custom-control-inline mr-4">
                                                                <input type="radio" id="companyRefund" name="refundType" value="CompanyRefundEmployee" class="custom-control-input" v-model="imprestForm.refundType">
                                                                <label class="custom-control-label font-weight-bold" for="companyRefund">Company Refund Employee</label>
                                                            </div>
                                                            <div class="custom-control custom-radio custom-control-inline">
                                                                <input type="radio" id="employeeRefund" name="refundType" value="EmployeeRefundCompany" class="custom-control-input" v-model="imprestForm.refundType">
                                                                <label class="custom-control-label font-weight-bold" for="employeeRefund">Employee Refund Company</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </fieldset>

                                                <fieldset class="mb-3" style="border: 1px solid #ced4da; padding: 10px; border-radius: 5px;">
                                                    <legend style="width: auto; padding: 0 10px; font-size: 1.1rem; font-weight: 500;">Receipt Details</legend>

                                                    <div class="row">
                                                        <div class="col-md-6">
                                                            <div class="form-group row">
                                                                <label class="col-md-4 col-form-label"> <strong>Receipt Date:</strong>  </label>
                                                                <div class="col-md-8">
                                                                    <input type="date" class="form-control" v-model="imprestForm.receiptDate" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="form-group row">
                                                                <label class="col-md-4 col-form-label"> <strong>Receipt No:</strong>  </label>
                                                                <div class="col-md-8">
                                                                    <input type="text" class="form-control" v-model="imprestForm.receiptNo" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </fieldset>

                                                <div class="row mb-3 mt-3">
                                                    <div class="col-md-12">
                                                        <div class="form-group row">
                                                            <label class="col-md-2 col-form-label"> <strong>Refund Received By:</strong> </label>
                                                            <div class="col-md-10">
                                                                <input type="text" class="form-control bg-light" v-model="imprestForm.refundReceivedBy" readonly placeholder="Auto-populated" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <fieldset class="mb-3" style="border: 1px solid #ced4da; padding: 10px; border-radius: 5px;">
                                                    <legend style="width: auto; padding: 0 10px; font-size: 1.1rem; font-weight: 500;">Posting Info</legend>

                                                    <div class="row">
                                                        <div class="col-md-6">
                                                            <div class="form-group row">
                                                                <label class="col-md-4 col-form-label"> <strong>Credit G/L:</strong>  </label>
                                                                <div class="col-md-8">
                                                                    <select class="form-control" v-model="imprestForm.creditAccountId">
                                                                        <option disabled value="">Select Account</option>
                                                                        <option v-for="acc in accountsList" :value="acc.id">{{ acc.accountIdentifier }}</option>
                                                                    </select>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="form-group row">
                                                                <label class="col-md-4 col-form-label"> <strong>Debit G/L:</strong>  </label>
                                                                <div class="col-md-8">
                                                                    <select class="form-control" v-model="imprestForm.debitAccountId">
                                                                        <option disabled value="">Select Account</option>
                                                                        <option v-for="acc in accountsList" :value="acc.id">{{ acc.accountIdentifier }}</option>
                                                                    </select>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </fieldset>

                                                <!-- ACTION BUTTONS -->
                                                <hr/>
                                                <div class="row mt-3">
                                                    <div class="col-12 text-right">
                                                        <button type="button" class="btn btn-danger mr-1" v-on:click="cancelForm">
                                                            <i class="la la-times"></i> Cancel
                                                        </button>

                                                        <button type="button" class="btn btn-warning mr-1" v-on:click="resetForm">
                                                            <i class="la la-refresh"></i> Reset
                                                        </button>

                                                        <button type="button" v-on:click="saveRefund" class="btn btn-primary" :disabled="isSubmitting || !selectedEmployee || !imprestForm.imprestId">
                                                            <i class="la la-save"></i>
                                                            <span v-if="isSubmitting">Saving...</span>
                                                            <span v-else>Save</span>
                                                        </button>
                                                    </div>
                                                </div>
                                            </form>
                                            
                                            <div v-else class="text-center p-5 text-muted">
                                                <i class="la la-user-circle" style="font-size: 4rem; opacity: 0.5;"></i>
                                                <h4 class="mt-2">Please select an employee</h4>
                                                <p>Select an employee from the list to process an imprest refund.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .employee-item:hover {
        background-color: #f8f9fa;
        transform: translateX(3px);
    }
    .employee-item.bg-light {
        background-color: #e8f0fe !important;
    }
    .avatar-content {
        font-weight: bold;
        font-size: 14px;
    }
    .card-header .badge {
        font-size: 12px;
        margin-left: 5px;
    }
    
    .px-1.pb-2 .form-control {
        border-radius: 4px;
        border: 1px solid #e0e0e0;
        padding: 8px 12px;
        font-size: 14px;
        transition: all 0.3s ease;
    }
    
    .px-1.pb-2 .form-control:focus {
        border-color: #007bff;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
    }
    
    .vertical-divider {
        width: 2px;
        height: 100%;
        min-height: 400px;
        background: linear-gradient(to bottom, 
            rgba(222, 226, 230, 0) 0%, 
            rgba(222, 226, 230, 0.8) 20%, 
            rgba(222, 226, 230, 0.8) 80%, 
            rgba(222, 226, 230, 0) 100%
        );
        border-radius: 2px;
        position: relative;
    }
    
    .vertical-divider::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 10px;
        height: 10px;
        background: #007bff;
        border-radius: 50%;
        opacity: 0.5;
    }
    
    .vertical-divider::after {
        content: '⋮';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: #007bff;
        font-size: 20px;
        font-weight: bold;
        opacity: 0.3;
    }
    
    @@media (max-width: 768px) {
        .vertical-divider {
            display: none;
        }
        
        .col-md-1 {
            display: none;
        }
        
        .col-md-8 {
            flex: 0 0 100%;
            max-width: 100%;
        }
        
        .col-md-3 {
            flex: 0 0 100%;
            max-width: 100%;
            margin-bottom: 20px;
        }
    }
</style>

<script src="~/js/gl/data-entry/refund-imprest.js" asp-append-version="true"></script>
